<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@android:color/transparent"
    android:paddingLeft="5dp"
    android:paddingRight="5dp"
    android:layout_width="32dp"
    android:layout_height="500dp"
    android:paddingHorizontal="5dp">
    <ImageView
        android:id="@+id/cas_native_icon"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:layout_weight="3"
        android:layout_marginHorizontal="4dp">
        <TextView
            android:id="@+id/cas_native_headline"
            style="@style/com.cleveradssolutions.nativeAds.AutoScrollingTextView.Title"/>
        <include layout="@layout/cas_native_ad_info_line"/>
    </LinearLayout>
    <View
        android:id="@+id/cas_native_body_divider"
        style="@style/CleverAdsSolutionsDivider"/>
    <TextView
        android:textSize="11sp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/cas_native_body"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:maxLines="2"
        android:layout_weight="2"/>
    <com.cleveradssolutions.sdk.nativead.CASMediaView
        android:id="@+id/cas_native_media_content"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:layout_marginHorizontal="2dp"/>
    <TextView
        android:textSize="10sp"
        android:textColor="#80000000"
        android:layout_gravity="bottom"
        android:id="@+id/cas_native_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:singleLine="true"
        android:layout_marginHorizontal="2dp"/>
    <Button
        android:textSize="10sp"
        android:textColor="@android:color/white"
        android:id="@+id/cas_native_cta"
        android:padding="4dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:maxWidth="140dp"
        android:minWidth="80dp"
        android:minHeight="32dp"
        android:singleLine="true"
        android:textAllCaps="false"/>
    <com.cleveradssolutions.sdk.nativead.CASChoicesView
        android:id="@+id/cas_native_ad_choices"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>
