<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@+id/fixturesFragment">
    <fragment
        android:label="Event Fragment"
        android:name="com.sports.live.football.tv.ui.app.fragments.EventFragment"
        android:id="@+id/event">
        <action
            android:id="@+id/action_event_to_channel"
            app:destination="@+id/channel"
            app:enterAnim="@anim/enter_activity"
            app:exitAnim="@anim/exit_activity"
            app:popEnterAnim="@anim/enter_activity"
            app:popExitAnim="@anim/exit_activity"/>
        <action
            android:id="@+id/action_event_to_player"
            app:destination="@+id/player"/>
        <action
            android:id="@+id/action_event_to_notificationFragment"
            app:destination="@+id/notificationFragment"/>
        <action
            android:id="@+id/action_event_to_favouriteFragment"
            app:destination="@+id/favouriteFragment"/>
    </fragment>
    <fragment
        android:label="Category Fragment"
        android:name="com.sports.live.football.tv.ui.app.fragments.CategoryFragment"
        android:id="@+id/categoriesFragment">
        <action
            android:id="@+id/action_categoriesFragment_to_channel"
            app:destination="@+id/channel"
            app:enterAnim="@anim/enter_activity"
            app:exitAnim="@anim/exit_activity"
            app:popEnterAnim="@anim/enter_activity"
            app:popExitAnim="@anim/exit_activity"/>
        <action
            android:id="@+id/action_categoriesFragment_to_notificationFragment"
            app:destination="@+id/notificationFragment"/>
    </fragment>
    <fragment
        android:label="More Fragment"
        android:name="com.sports.live.football.tv.ui.app.fragments.MoreFragment"
        android:id="@+id/moreFragment"/>
    <fragment
        android:label="Notification Fragment"
        android:name="com.sports.live.football.tv.ui.app.fragments.NotificationFragment"
        android:id="@+id/notificationFragment"/>
    <fragment
        android:label="Favourite Fragment"
        android:name="com.sports.live.football.tv.ui.app.fragments.FavouriteFragment"
        android:id="@+id/favouriteFragment">
        <action
            android:id="@+id/action_favouriteFragment_to_channel"
            app:destination="@+id/channel"/>
    </fragment>
    <fragment
        android:label="channel Fragment"
        android:name="com.sports.live.football.tv.ui.app.fragments.ChannelFragment"
        android:id="@+id/channel">
        <argument
            android:name="getEvent"
            app:argType="com.sports.live.football.tv.models.Event"
            app:nullable="true"/>
        <action
            android:id="@+id/action_channel_to_player"
            app:destination="@+id/player"/>
        <argument
            android:name="getCategory"
            app:argType="com.sports.live.football.tv.models.Category"
            app:nullable="true"/>
        <argument
            android:name="channelList"
            app:argType="com.sports.live.football.tv.models.Channel[]"
            app:nullable="true"/>
        <action
            android:id="@+id/action_channel_to_player2"
            app:destination="@+id/player2"/>
    </fragment>
    <fragment
        android:label="matches_fragment"
        android:name="com.sports.live.football.tv.ui.app.fragments.MatchesFragment"
        android:id="@+id/fixturesFragment">
        <action
            android:id="@+id/action_fixturesFragment_to_matchDetailFragment"
            app:destination="@+id/matchDetailFragment"/>
    </fragment>
    <activity
        android:label="player Fragment"
        android:name="com.sports.live.football.tv.ui.app.activities.PlayerScreen"
        android:id="@+id/player">
        <argument
            android:name="baseURL"
            android:defaultValue="abc"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="linkAppend"
            android:defaultValue="abc"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="channleType"
            android:defaultValue="abc"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="channel_time"
            android:defaultValue="0L"
            app:argType="long"/>
    </activity>
    <activity
        android:label="player Fragment"
        android:name="com.sports.live.football.tv.ui.app.activities.PlayerScreenMedia3"
        android:id="@+id/player2">
        <argument
            android:name="baseURL"
            android:defaultValue="abc"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="linkAppend"
            android:defaultValue="abc"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="channleType"
            android:defaultValue="abc"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="channel_time"
            android:defaultValue="0L"
            app:argType="long"/>
    </activity>
    <fragment
        android:label="fragment_match_detail"
        android:name="com.sports.live.football.tv.ui.app.fragments.MatchDetailFragment"
        android:id="@+id/matchDetailFragment">
        <argument
            android:name="matchID"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="matchDetail"
            app:argType="com.sports.live.football.tv.models.FootballMatches"
            app:nullable="true"/>
    </fragment>
</navigation>
