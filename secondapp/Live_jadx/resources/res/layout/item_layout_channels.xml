<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/whole_layout"
    android:tag="layout/item_layout_channels_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="24sp"
    android:layout_marginStart="24sp"
    android:layout_marginEnd="24sp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="6dp"
    app:cardElevation="8dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.cardview.widget.CardView
            android:id="@+id/channelImageIcon"
            android:layout_width="130sp"
            android:layout_height="90sp"
            android:layout_margin="10sp"
            app:cardCornerRadius="8sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/channelImg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:contentDescription="@string/channelimage"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/tv_placeholder"/>
        </androidx.cardview.widget.CardView>
        <TextView
            android:textSize="@dimen/_14sdp"
            android:textColor="@color/colorPrimary"
            android:ellipsize="end"
            android:id="@+id/channelName"
            android:layout_width="0sp"
            android:layout_height="0sp"
            android:layout_marginBottom="2dp"
            android:maxLines="2"
            android:fontFamily="@font/cambriab_bold"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            app:layout_constraintBottom_toTopOf="@+id/dateOfChannel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/channelImageIcon"
            app:layout_constraintTop_toTopOf="@+id/channelImageIcon"
            app:layout_constraintVertical_bias="0"/>
        <TextView
            android:textSize="@dimen/_12sdp"
            android:textColor="@color/black"
            android:id="@+id/dateOfChannel"
            android:layout_width="0sp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cambria"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            app:layout_constraintBottom_toBottomOf="@+id/channelImageIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/channelImageIcon"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
