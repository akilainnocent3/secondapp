<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="10sp"
        android:textColor="#4285f4"
        android:id="@+id/cas_native_ad_badge"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:id="@+id/cas_native_advertiser"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="70dp"
        android:minWidth="40dp"
        android:paddingHorizontal="2dp"
        style="@style/com.cleveradssolutions.nativeAds.AutoScrollingTextView"/>
    <TextView
        android:textSize="10sp"
        android:textColor="#80000000"
        android:layout_gravity="center_vertical"
        android:id="@+id/cas_native_rating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"/>
    <TextView
        android:textSize="10sp"
        android:textColor="#80000000"
        android:id="@+id/cas_native_reviews"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:singleLine="true"
        android:paddingStart="5dp"
        android:paddingEnd="2dp"/>
    <TextView
        android:gravity="center"
        android:id="@+id/cas_native_store"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="40dp"
        android:paddingHorizontal="2dp"
        style="@style/com.cleveradssolutions.nativeAds.AutoScrollingTextView"/>
</LinearLayout>
