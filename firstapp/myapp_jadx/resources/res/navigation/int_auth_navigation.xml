<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/int_auth_navigation"
    app:startDestination="@+id/int_auth_loading_fragment">
    <fragment
        android:label="INTAuthLoadingFragment"
        android:name="com.sportybet.android.account.international.login.INTAuthLoadingFragment"
        android:id="@+id/int_auth_loading_fragment">
        <action
            android:id="@+id/to_int_login_fragment"
            app:destination="@+id/int_login_fragment"
            app:popUpTo="@+id/int_auth_navigation"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/to_latam_registration"
            app:destination="@+id/latam_sign_up_email_fragment"
            app:popUpTo="@+id/int_auth_navigation"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/to_reset_password"
            app:destination="@+id/reset_pwd_confirm_fragment"
            app:popUpTo="@+id/int_auth_navigation"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:label="INTLoginFragment"
        android:name="com.sportybet.android.account.international.login.INTLoginFragment"
        android:id="@+id/int_login_fragment">
        <action
            android:id="@+id/to_reset_pwd_confirm_fragment"
            app:destination="@+id/reset_pwd_confirm_fragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/to_int_verify_fragment"
            app:destination="@+id/int_verify_fragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/to_verify_2fa_fragment"
            app:destination="@+id/verify_2fa_fragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/to_latam_registration"
            app:destination="@+id/latam_sign_up_email_fragment"
            app:popUpTo="@+id/int_login_fragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:label="ResetPwdConfirmFragment"
        android:name="com.sportybet.android.account.international.resetpwd.ResetPwdConfirmFragment"
        android:id="@+id/reset_pwd_confirm_fragment">
        <action
            android:id="@+id/to_int_verify_fragment"
            app:destination="@+id/int_verify_fragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <argument
            android:name="email"
            android:defaultValue=""
            app:argType="string"/>
    </fragment>
    <fragment
        android:label="Verify2faFragment"
        android:name="com.sportybet.android.account.mfa.Verify2FAFragment"
        android:id="@+id/verify_2fa_fragment"/>
    <fragment
        android:label="INTVerifyFragment"
        android:name="com.sportybet.android.account.international.verify.INTVerifyFragment"
        android:id="@+id/int_verify_fragment">
        <action
            android:id="@+id/to_reset_pwd_fragment"
            app:destination="@+id/reset_pwd_fragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/int_login_fragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/to_registration_validation_fragment"
            app:destination="@+id/registration_validation_fragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/int_auth_navigation"
            app:popUpToInclusive="true"/>
        <argument
            android:name="email"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="verify_token"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="type"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="token"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="cpf"
            android:defaultValue=""
            app:argType="string"/>
        <deepLink app:uri="test.easebet.com/int/m/ops/emailToken?view={type}&amp;token={token}"/>
        <deepLink app:uri="sportybet.com/int/m/ops/emailToken?view={type}&amp;token={token}"/>
    </fragment>
    <fragment
        android:label="RegistrationValidationFragment"
        android:name="com.sportybet.android.account.latam.validation.presentation.RegistrationValidationFragment"
        android:id="@+id/registration_validation_fragment">
        <argument
            android:name="email"
            app:argType="string"/>
        <argument
            android:name="cpf"
            app:argType="string"/>
        <argument
            android:name="phoneNumber"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="phoneCountryCode"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="isResumptionFlow"
            android:defaultValue="false"
            app:argType="boolean"/>
    </fragment>
    <fragment
        android:label="ResetPwdFragment"
        android:name="com.sportybet.android.account.international.resetpwd.ui.ResetPwdFragment"
        android:id="@+id/reset_pwd_fragment">
        <argument
            android:name="email"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="token"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="from_deeplink"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="from_settings_password"
            android:defaultValue="false"
            app:argType="boolean"/>
    </fragment>
    <fragment
        android:label="LatamSignUpEmailFragment"
        android:name="com.sportybet.android.account.latam.signup.presentation.LatamSignUpEmailFragment"
        android:id="@+id/latam_sign_up_email_fragment">
        <argument
            android:name="status"
            android:defaultValue="@null"
            app:argType="com.sportybet.android.account.international.data.model.RegistrationStatusResponse"
            app:nullable="true"/>
        <argument
            android:name="email"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="password"
            android:defaultValue=""
            app:argType="string"/>
        <action
            android:id="@+id/to_personal_info_fragment"
            app:destination="@+id/personal_info_fragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/to_int_verify_fragment"
            app:destination="@+id/int_verify_fragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/to_registration_validation_fragment"
            app:destination="@+id/registration_validation_fragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/to_int_login_fragment"
            app:destination="@+id/int_login_fragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:label="PersonalInfoFragment"
        android:name="com.sportybet.android.account.latam.personalinfo.presentation.PersonalInfoFragment"
        android:id="@+id/personal_info_fragment">
        <argument
            android:name="email"
            app:argType="string"/>
        <argument
            android:name="cpf"
            app:argType="string"/>
        <argument
            android:name="password"
            app:argType="string"/>
        <argument
            android:name="fullName"
            app:argType="string"/>
        <argument
            android:name="dob"
            app:argType="string"/>
        <argument
            android:name="zipcode"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="street"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="city"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="state"
            android:defaultValue=""
            app:argType="string"/>
        <action
            android:id="@+id/to_int_verify_fragment"
            app:destination="@+id/int_verify_fragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
</navigation>
