<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:startColor="#22252d"
                android:endColor="#22252d"
                android:angle="90"
                android:centerColor="#22252d"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#22252d"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>
</layer-list>
