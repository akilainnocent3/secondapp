<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#c8c8c8"
                android:endColor="#dfdfdf"
                android:angle="360"
                android:type="sweep"
                android:gradientRadius="360"
                android:centerColor="#979797"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/custom_background_type1_quaternary_type3"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
</layer-list>
