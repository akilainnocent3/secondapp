<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item
                android:height="20dp"
                android:width="20dp"
                android:drawable="@drawable/ic_any_win_disable"/>
        </layer-list>
    </item>
    <item android:state_enabled="true">
        <layer-list>
            <item
                android:height="20dp"
                android:width="20dp"
                android:drawable="@drawable/ic_any_win_active"/>
        </layer-list>
    </item>
</selector>
