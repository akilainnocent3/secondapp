<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/>
            <stroke
                android:width="1dp"
                android:color="#faa702"/>
            <gradient
                android:startColor="#f5a200"
                android:endColor="#905f00"
                android:angle="270"
                android:type="linear"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/>
            <gradient
                android:startColor="#ffb31f"
                android:endColor="#00f5a200"
                android:angle="0"
                android:type="radial"
                android:centerY="0"
                android:gradientRadius="100dp"/>
        </shape>
    </item>
</layer-list>
