<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_tertiary"/>
            <stroke
                android:width="1dp"
                android:color="@color/brand_secondary_disable"/>
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_tertiary"/>
            <stroke
                android:width="1dp"
                android:color="@color/warning_primary"/>
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/background_general_primary"/>
            <stroke
                android:width="1dp"
                android:color="@color/brand_secondary"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/background_general_primary"/>
            <stroke
                android:width="1dp"
                android:color="@color/line_type1_primary"/>
        </shape>
    </item>
</selector>
