<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#ffff3232"
                android:endColor="#ffe04040"
                android:angle="90"/>
            <corners android:radius="50dp"/>
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="4dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#9c1c09"
                android:endColor="#ffe04040"
                android:angle="90"
                android:centerY="0.2"/>
            <corners android:radius="46dp"/>
        </shape>
    </item>
</layer-list>
