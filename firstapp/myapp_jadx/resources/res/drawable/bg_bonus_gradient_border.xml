<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#66ffda33"
                android:endColor="#66ffdd63"
                android:angle="0"
                android:type="linear"
                android:centerColor="#66ffffff"/>
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#111111"/>
        </shape>
    </item>
</layer-list>
