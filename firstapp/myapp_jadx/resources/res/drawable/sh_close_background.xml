<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp"/>
            <stroke
                android:width="1dp"
                android:color="#fa0202"/>
            <gradient
                android:startColor="#b80000"
                android:endColor="#7a0000"
                android:angle="270"
                android:type="linear"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp"/>
            <gradient
                android:startColor="#ff0000"
                android:endColor="#00ff0000"
                android:angle="0"
                android:type="radial"
                android:centerY="0"
                android:gradientRadius="45dp"/>
        </shape>
    </item>
</layer-list>
