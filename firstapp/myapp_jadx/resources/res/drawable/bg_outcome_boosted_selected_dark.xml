<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#99fac111"
                android:endColor="#00fac111"
                android:angle="270"
                android:type="linear"/>
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_quinary"/>
        </shape>
    </item>
</layer-list>
