<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android" xmlns:motion="http://schemas.android.com/apk/res-auto">
    <Transition
        motion:autoTransition="jumpToStart"
        motion:constraintSetEnd="@+id/end1"
        motion:constraintSetStart="@+id/start1"
        motion:duration="1000"
        motion:motionInterpolator="linear">
        <KeyFrameSet>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="0"
                motion:motionTarget="@+id/view_3"/>
            <KeyAttribute
                android:alpha="0.8"
                motion:framePosition="7"
                motion:motionTarget="@+id/view_3"/>
            <KeyAttribute
                android:alpha="0.9"
                motion:framePosition="10"
                motion:motionTarget="@+id/view_3"/>
            <KeyAttribute
                android:alpha="1"
                motion:framePosition="15"
                motion:motionTarget="@+id/view_3"/>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="0"
                motion:motionTarget="@+id/view_2"/>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="50"
                motion:motionTarget="@+id/view_2"/>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="45"
                motion:motionTarget="@+id/view_3"/>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="100"
                motion:motionTarget="@+id/view_3"/>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="50"
                motion:motionTarget="@+id/view_2"/>
            <KeyAttribute
                android:alpha="0.8"
                motion:framePosition="60"
                motion:motionTarget="@+id/view_2"/>
            <KeyAttribute
                android:alpha="0.9"
                motion:framePosition="70"
                motion:motionTarget="@+id/view_2"/>
            <KeyAttribute
                android:alpha="1"
                motion:framePosition="90"
                motion:motionTarget="@+id/view_2"/>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="91"
                motion:motionTarget="@+id/view_2"/>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="100"
                motion:motionTarget="@+id/view_2"/>
        </KeyFrameSet>
    </Transition>
    <ConstraintSet android:id="@+id/start1">
        <Constraint
            android:id="@+id/view_3"
            android:layout_width="1.6dp"
            android:layout_height="@dimen/_13sdp"
            android:rotation="230"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintTop_toTopOf="parent"/>
        <Constraint
            android:id="@+id/view_2"
            android:layout_width="1.6dp"
            android:layout_height="@dimen/_13sdp"
            android:alpha="0"
            android:rotation="230"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintTop_toBottomOf="@+id/view_3"/>
    </ConstraintSet>
    <ConstraintSet android:id="@+id/end1">
        <Constraint
            android:id="@+id/view_3"
            android:layout_width="1.6dp"
            android:layout_height="@dimen/_13sdp"
            android:rotation="230"
            motion:layout_constraintBottom_toBottomOf="@+id/view_2"
            motion:layout_constraintStart_toStartOf="parent"/>
        <Constraint
            android:id="@+id/view_2"
            android:layout_width="1.6dp"
            android:layout_height="@dimen/_13sdp"
            android:rotation="230"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintStart_toStartOf="parent"/>
    </ConstraintSet>
</MotionScene>
