<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android" xmlns:motion="http://schemas.android.com/apk/res-auto">
    <Transition
        android:id="@+id/transition_ball_p2_to_p1_oof"
        motion:constraintSetEnd="@+id/end_p2_to_p1_oof"
        motion:constraintSetStart="@+id/start"
        motion:duration="2000">
        <KeyFrameSet>
            <KeyPosition
                motion:framePosition="10"
                motion:keyPositionType="pathRelative"
                motion:motionTarget="@+id/ball_p1_to_p2"
                motion:percentX="0.16"
                motion:percentY="0.05"/>
            <KeyPosition
                motion:framePosition="40"
                motion:keyPositionType="pathRelative"
                motion:motionTarget="@+id/ball_p1_to_p2"
                motion:percentX="0.4"
                motion:percentY="0.05"/>
        </KeyFrameSet>
    </Transition>
    <Transition
        android:id="@+id/transition_ball_p1_to_p2_oof"
        motion:constraintSetEnd="@+id/end_p1_to_p2_oof"
        motion:constraintSetStart="@+id/start"
        motion:duration="200">
        <KeyFrameSet>
            <KeyPosition
                motion:framePosition="10"
                motion:keyPositionType="pathRelative"
                motion:motionTarget="@+id/ball_p1_to_p2"
                motion:percentX="0.1"
                motion:percentY="-0.02"/>
            <KeyPosition
                motion:framePosition="20"
                motion:keyPositionType="pathRelative"
                motion:motionTarget="@+id/ball_p1_to_p2"
                motion:percentX="0.3"
                motion:percentY="-0.05"/>
        </KeyFrameSet>
    </Transition>
    <Transition
        android:id="@+id/transition_ball_serve"
        motion:constraintSetEnd="@+id/end"
        motion:constraintSetStart="@+id/start"
        motion:duration="600">
        <KeyFrameSet>
            <KeyPosition
                motion:framePosition="5"
                motion:keyPositionType="pathRelative"
                motion:motionTarget="@+id/ball_p1_to_p2"
                motion:percentX="0.05"
                motion:percentY="-0.02"/>
            <KeyPosition
                motion:framePosition="15"
                motion:keyPositionType="pathRelative"
                motion:motionTarget="@+id/ball_p1_to_p2"
                motion:percentX="0.15"
                motion:percentY="0.05"/>
            <KeyPosition
                motion:framePosition="25"
                motion:keyPositionType="pathRelative"
                motion:motionTarget="@+id/ball_p1_to_p2"
                motion:percentX="0.25"
                motion:percentY="0.1"/>
            <KeyPosition
                motion:framePosition="35"
                motion:keyPositionType="pathRelative"
                motion:motionTarget="@+id/ball_p1_to_p2"
                motion:percentX="0.35"
                motion:percentY="-0.01"/>
            <KeyPosition
                motion:framePosition="50"
                motion:keyPositionType="pathRelative"
                motion:motionTarget="@+id/ball_p1_to_p2"
                motion:percentX="0.5"
                motion:percentY="-0.06"/>
            <KeyPosition
                motion:framePosition="65"
                motion:keyPositionType="pathRelative"
                motion:motionTarget="@+id/ball_p1_to_p2"
                motion:percentX="0.65"
                motion:percentY="-0.01"/>
            <KeyPosition
                motion:framePosition="75"
                motion:keyPositionType="pathRelative"
                motion:motionTarget="@+id/ball_p1_to_p2"
                motion:percentX="0.75"
                motion:percentY="0.1"/>
            <KeyPosition
                motion:framePosition="85"
                motion:keyPositionType="pathRelative"
                motion:motionTarget="@+id/ball_p1_to_p2"
                motion:percentX="0.85"
                motion:percentY="0.05"/>
            <KeyPosition
                motion:framePosition="99"
                motion:keyPositionType="pathRelative"
                motion:motionTarget="@+id/ball_p1_to_p2"
                motion:percentX="0.99"
                motion:percentY="-0.02"/>
        </KeyFrameSet>
    </Transition>
    <Transition
        android:id="@+id/transition_ball_p1_to_p2"
        motion:constraintSetEnd="@+id/end"
        motion:constraintSetStart="@+id/start"
        motion:duration="200">
        <KeyFrameSet>
            <KeyPosition
                motion:framePosition="5"
                motion:keyPositionType="pathRelative"
                motion:motionTarget="@+id/ball_p1_to_p2"
                motion:percentX="0.12"
                motion:percentY="-0.02"/>
            <KeyPosition
                motion:framePosition="20"
                motion:keyPositionType="pathRelative"
                motion:motionTarget="@+id/ball_p1_to_p2"
                motion:percentX="0.32"
                motion:percentY="0"/>
            <KeyPosition
                motion:framePosition="35"
                motion:keyPositionType="pathRelative"
                motion:motionTarget="@+id/ball_p1_to_p2"
                motion:percentX="0.52"
                motion:percentY="0.07"/>
            <KeyPosition
                motion:framePosition="40"
                motion:keyPositionType="pathRelative"
                motion:motionTarget="@+id/ball_p1_to_p2"
                motion:percentX="0.72"
                motion:percentY="0.13"/>
            <KeyPosition
                motion:framePosition="75"
                motion:keyPositionType="pathRelative"
                motion:motionTarget="@+id/ball_p1_to_p2"
                motion:percentX="0.73"
                motion:percentY="0.13"/>
            <KeyPosition
                motion:framePosition="90"
                motion:keyPositionType="pathRelative"
                motion:motionTarget="@+id/ball_p1_to_p2"
                motion:percentX="0.84"
                motion:percentY="0.07"/>
        </KeyFrameSet>
    </Transition>
    <Transition
        android:id="@+id/transition_ball_p2_to_p1"
        motion:constraintSetEnd="@+id/start"
        motion:constraintSetStart="@+id/end"
        motion:duration="200">
        <KeyFrameSet>
            <KeyPosition
                motion:framePosition="5"
                motion:keyPositionType="pathRelative"
                motion:motionTarget="@+id/ball_p1_to_p2"
                motion:percentX="0.12"
                motion:percentY="0.04"/>
            <KeyPosition
                motion:framePosition="20"
                motion:keyPositionType="pathRelative"
                motion:motionTarget="@+id/ball_p1_to_p2"
                motion:percentX="0.33"
                motion:percentY="0.045"/>
            <KeyPosition
                motion:framePosition="35"
                motion:keyPositionType="pathRelative"
                motion:motionTarget="@+id/ball_p1_to_p2"
                motion:percentX="0.56"
                motion:percentY="-0.02"/>
            <KeyPosition
                motion:framePosition="40"
                motion:keyPositionType="pathRelative"
                motion:motionTarget="@+id/ball_p1_to_p2"
                motion:percentX="0.69"
                motion:percentY="-0.09"/>
            <KeyPosition
                motion:framePosition="75"
                motion:keyPositionType="pathRelative"
                motion:motionTarget="@+id/ball_p1_to_p2"
                motion:percentX="0.74"
                motion:percentY="-0.12"/>
            <KeyPosition
                motion:framePosition="90"
                motion:keyPositionType="pathRelative"
                motion:motionTarget="@+id/ball_p1_to_p2"
                motion:percentX="0.86"
                motion:percentY="-0.04"/>
        </KeyFrameSet>
    </Transition>
    <Transition
        android:id="@+id/transition_ball_p1_to_p2_net"
        motion:constraintSetEnd="@+id/end_p1_to_p2_oof"
        motion:constraintSetStart="@+id/start"
        motion:duration="200">
        <KeyFrameSet>
            <KeyPosition
                motion:framePosition="10"
                motion:keyPositionType="pathRelative"
                motion:motionTarget="@+id/ball_p1_to_p2"
                motion:percentX="0.1"
                motion:percentY="-0.02"/>
            <KeyPosition
                motion:framePosition="20"
                motion:keyPositionType="pathRelative"
                motion:motionTarget="@+id/ball_p1_to_p2"
                motion:percentX="0.3"
                motion:percentY="-0.05"/>
        </KeyFrameSet>
    </Transition>
    <Transition
        android:id="@+id/transition_ball_p2_to_p1_net"
        motion:constraintSetEnd="@+id/end_p1_to_p2_oof"
        motion:constraintSetStart="@+id/start"
        motion:duration="200">
        <KeyFrameSet>
            <KeyPosition
                motion:framePosition="10"
                motion:keyPositionType="pathRelative"
                motion:motionTarget="@+id/ball_p1_to_p2"
                motion:percentX="0.1"
                motion:percentY="-0.02"/>
            <KeyPosition
                motion:framePosition="20"
                motion:keyPositionType="pathRelative"
                motion:motionTarget="@+id/ball_p1_to_p2"
                motion:percentX="0.3"
                motion:percentY="-0.05"/>
        </KeyFrameSet>
    </Transition>
    <ConstraintSet android:id="@+id/start">
        <Constraint
            android:id="@+id/ball_p1_to_p2"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:elevation="@dimen/_2sdp"
            motion:layout_constraintStart_toEndOf="@+id/left_space_1"
            motion:layout_constraintTop_toBottomOf="@+id/top_space_1"/>
    </ConstraintSet>
    <ConstraintSet android:id="@+id/end">
        <Constraint
            android:id="@+id/ball_p1_to_p2"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:elevation="@dimen/_2sdp"
            motion:layout_constraintEnd_toStartOf="@+id/right_space_1"
            motion:layout_constraintTop_toBottomOf="@+id/top_space_1"/>
    </ConstraintSet>
    <ConstraintSet android:id="@+id/end_p1_to_p2_oof">
        <Constraint
            android:id="@+id/ball_p1_to_p2"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginTop="20dp"
            android:elevation="@dimen/_2sdp"
            motion:layout_constraintEnd_toEndOf="@+id/right_space_1"
            motion:layout_constraintTop_toBottomOf="@+id/top_space_1"/>
    </ConstraintSet>
    <ConstraintSet android:id="@+id/end_p2_to_p1_oof">
        <Constraint
            android:id="@+id/ball_p1_to_p2"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginTop="20dp"
            android:elevation="@dimen/_2sdp"
            motion:layout_constraintStart_toStartOf="@+id/left_space_1"
            motion:layout_constraintTop_toBottomOf="@+id/top_space_1"/>
    </ConstraintSet>
</MotionScene>
