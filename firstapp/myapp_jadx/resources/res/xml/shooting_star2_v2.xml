<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android" xmlns:motion="http://schemas.android.com/apk/res-auto">
    <Transition
        android:id="@+id/transition1"
        motion:autoTransition="animateToEnd"
        motion:constraintSetEnd="@+id/end"
        motion:constraintSetStart="@+id/start"
        motion:duration="1000"
        motion:motionInterpolator="linear">
        <KeyFrameSet>
            <KeyAttribute
                android:scaleX="0"
                android:scaleY="0"
                motion:framePosition="0"
                motion:motionTarget="@+id/shooting_star1"/>
            <KeyAttribute
                android:scaleX="6"
                android:scaleY="6"
                motion:framePosition="50"
                motion:motionTarget="@+id/shooting_star1"/>
            <KeyAttribute
                android:scaleX="5"
                android:scaleY="5"
                motion:framePosition="90"
                motion:motionTarget="@+id/shooting_star1"/>
            <KeyAttribute
                android:scaleX="2.5"
                android:scaleY="2.5"
                motion:framePosition="100"
                motion:motionTarget="@+id/shooting_star1"/>
        </KeyFrameSet>
    </Transition>
    <Transition
        android:id="@+id/transition2"
        motion:autoTransition="animateToStart"
        motion:constraintSetEnd="@+id/end"
        motion:constraintSetStart="@+id/start"
        motion:duration="10000"
        motion:motionInterpolator="linear">
        <KeyFrameSet>
            <KeyAttribute
                android:scaleX="0"
                android:scaleY="0"
                motion:framePosition="0"
                motion:motionTarget="@+id/shooting_star1"/>
            <KeyAttribute
                android:scaleX="0"
                android:scaleY="0"
                motion:framePosition="50"
                motion:motionTarget="@+id/shooting_star1"/>
            <KeyAttribute
                android:scaleX="0"
                android:scaleY="0"
                motion:framePosition="100"
                motion:motionTarget="@+id/shooting_star1"/>
        </KeyFrameSet>
    </Transition>
    <ConstraintSet android:id="@+id/start">
        <Constraint
            android:id="@+id/shooting_star1"
            android:layout_width="10dp"
            android:layout_height="10dp"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintTop_toTopOf="parent"/>
    </ConstraintSet>
    <ConstraintSet android:id="@+id/end">
        <Constraint
            android:id="@+id/shooting_star1"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="8dp"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintStart_toStartOf="parent"/>
    </ConstraintSet>
</MotionScene>
