<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android" xmlns:motion="http://schemas.android.com/apk/res-auto">
    <Transition
        android:id="@+id/hero_transition"
        motion:constraintSetEnd="@+id/end"
        motion:constraintSetStart="@+id/start"
        motion:duration="200"
        motion:motionInterpolator="linear">
        <KeyFrameSet>
            <KeyAttribute
                android:scaleX="0.2"
                android:scaleY="0.2"
                motion:framePosition="0"
                motion:motionTarget="@+id/hero"/>
            <KeyAttribute
                android:translationX="-30dp"
                android:translationY="10dp"
                motion:framePosition="0"
                motion:motionTarget="@+id/hero"/>
            <KeyAttribute
                android:translationX="20dp"
                android:translationY="0dp"
                motion:framePosition="100"
                motion:motionTarget="@+id/hero"/>
            <KeyAttribute
                android:scaleX="0.9"
                android:scaleY="0.9"
                motion:framePosition="100"
                motion:motionTarget="@+id/hero"/>
            <KeyPosition
                motion:framePosition="95"
                motion:keyPositionType="pathRelative"
                motion:motionTarget="@+id/hero"
                motion:percentY="0.01"/>
        </KeyFrameSet>
    </Transition>
    <Transition
        android:id="@+id/valentine_transition"
        motion:constraintSetEnd="@+id/end"
        motion:constraintSetStart="@+id/start"
        motion:duration="200"
        motion:motionInterpolator="linear">
        <KeyFrameSet>
            <KeyAttribute
                android:scaleX="0.3"
                android:scaleY="0.3"
                motion:framePosition="0"
                motion:motionTarget="@+id/valentine"/>
            <KeyAttribute
                android:translationX="0dp"
                android:translationY="30dp"
                motion:framePosition="0"
                motion:motionTarget="@+id/valentine"/>
            <KeyAttribute
                android:translationX="40dp"
                android:translationY="0dp"
                motion:framePosition="100"
                motion:motionTarget="@+id/valentine"/>
            <KeyAttribute
                android:scaleX="0.9"
                android:scaleY="0.9"
                motion:framePosition="100"
                motion:motionTarget="@+id/valentine"/>
            <KeyPosition
                motion:framePosition="95"
                motion:keyPositionType="pathRelative"
                motion:motionTarget="@+id/valentine"
                motion:percentY="0.05"/>
        </KeyFrameSet>
    </Transition>
    <ConstraintSet android:id="@+id/start">
        <Constraint
            android:id="@+id/hero"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:rotation="10"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintStart_toStartOf="parent"/>
        <Constraint
            android:id="@+id/valentine"
            android:layout_width="70dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/_20sdp"
            android:layout_marginStart="-20dp"
            motion:layout_constraintBottom_toBottomOf="@+id/hero"
            motion:layout_constraintStart_toEndOf="@+id/hero"
            motion:layout_constraintTop_toTopOf="@+id/hero"/>
    </ConstraintSet>
    <ConstraintSet android:id="@+id/end">
        <Constraint
            android:id="@+id/hero"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:rotation="10"
            motion:layout_constraintEnd_toStartOf="@+id/hero_view_1"
            motion:layout_constraintTop_toBottomOf="@+id/hero_view_2"/>
        <Constraint
            android:id="@+id/valentine"
            android:layout_width="70dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/_25sdp"
            android:layout_marginBottom="-10dp"
            android:layout_marginStart="-20dp"
            motion:layout_constraintBottom_toBottomOf="@+id/hero"
            motion:layout_constraintStart_toEndOf="@+id/hero"
            motion:layout_constraintTop_toTopOf="@+id/hero"/>
    </ConstraintSet>
</MotionScene>
