<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/relative_layout_main"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/title_bar"
        android:background="?attr/colorTitleBar"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/btn_back"
            android:background="?android:attr/selectableItemBackground"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="20dp"
            android:textStyle="bold"
            android:textColor="?attr/colorTitleBarText"
            android:gravity="center_vertical"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="@string/common_functions__withdraw"
            android:singleLine="true"
            android:lineSpacingExtra="8dp"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <TextView
        android:textAppearance="@style/H1_B"
        android:textColor="@color/text_type1_primary"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/common_otp_verify__verify_mobile_number"
        android:layout_below="@+id/title_bar"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textAppearance="@style/B1_R"
        android:textColor="@color/text_type1_primary"
        android:gravity="center"
        android:id="@+id/tv_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="32dp"
        android:layout_below="@+id/tv_title"/>
    <com.sporty.android.common_ui.widgets.SmsInputView
        android:id="@+id/otp_view"
        android:background="@drawable/sms_input_selector"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="30dp"
        android:layout_below="@+id/tv_subtitle"
        app:box_color="@color/text_type1_secondary"
        app:box_color_fill="@color/brand_secondary"
        app:box_count="6"
        app:radius="3dp"
        app:text_color="@color/text_type1_primary"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/warning_primary"
        android:gravity="center"
        android:id="@+id/error_tint"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/common_feedback__incorrect_code_please_try_again"
        android:layout_below="@+id/otp_view"/>
    <com.sporty.android.common_ui.widgets.CountdownButton
        android:id="@+id/btn_resend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_below="@+id/error_tint"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textAppearance="@style/B1_R"
        android:textColor="@color/text_type1_secondary"
        android:gravity="center"
        android:id="@+id/tv_remain_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="32dp"
        android:layout_below="@+id/btn_resend"/>
    <View
        android:id="@+id/view_line"
        android:background="@color/line_type1_primary"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="24dp"
        android:layout_below="@+id/tv_remain_time"/>
    <TextView
        android:textAppearance="@style/B1_R"
        android:textColor="@color/text_type1_secondary"
        android:gravity="center"
        android:id="@+id/tv_hint"
        android:longClickable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="32dp"
        android:layout_below="@+id/view_line"/>
</RelativeLayout>
