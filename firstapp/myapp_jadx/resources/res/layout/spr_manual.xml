<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/manual_hint"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/B2_M"
        android:textColor="@color/text_type1_primary"
        android:id="@+id/manual_hint_text"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/transaction_space_large"
        android:layout_marginRight="@dimen/transaction_space_large"
        android:text="@string/page_transaction__need_to_speed_up_your_payment"
        android:layout_marginHorizontal="@dimen/transaction_space_large"
        android:paddingVertical="8dp"
        app:layout_constraintEnd_toStartOf="@+id/manual_hint_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/manual_hint_btn"
        android:layout_width="wrap_content"
        android:layout_height="25dp"
        android:layout_marginLeft="@dimen/transaction_space_large"
        android:layout_marginRight="@dimen/transaction_space_large"
        android:text="@string/page_transaction__fix_status"
        android:layout_marginHorizontal="@dimen/transaction_space_large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.App.CommonButton.Contained.Small"/>
</androidx.constraintlayout.widget.ConstraintLayout>
