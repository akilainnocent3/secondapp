<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/top_most_layout"
    android:background="@drawable/sh_bg_all_bets_v2"
    android:paddingLeft="6dp"
    android:paddingTop="5dp"
    android:paddingRight="6dp"
    android:paddingBottom="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:minHeight="28dp"
    android:paddingHorizontal="6dp"
    android:paddingVertical="5dp">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/account_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="0x7f0807c6"
            android:scaleType="fitXY"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:textSize="@dimen/_8ssp"
            android:textColor="@color/white"
            android:layout_gravity="center"
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            style="@style/TextPrimaryRegular"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/_8ssp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_bet_win"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lines="1"
        android:layout_weight="1"
        android:paddingStart="5dp"
        android:autoSizeTextType="uniform"
        android:autoSizeStepGranularity="@dimen/_1ssp"
        android:autoSizeMinTextSize="@dimen/_6ssp"
        android:autoSizeMaxTextSize="@dimen/_8ssp"
        style="@style/TextPrimaryRegular"/>
    <TextView
        android:textSize="@dimen/_8ssp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_coeff"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingEnd="5dp"
        style="@style/TextPrimaryRegular"/>
    <TextView
        android:textSize="@dimen/_8ssp"
        android:textColor="@color/white"
        android:gravity="end"
        android:id="@+id/tv_win"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lines="1"
        android:layout_weight="1"
        android:paddingEnd="5dp"
        android:autoSizeTextType="uniform"
        android:autoSizeStepGranularity="@dimen/_1ssp"
        android:autoSizeMinTextSize="@dimen/_6ssp"
        android:autoSizeMaxTextSize="@dimen/_8ssp"
        style="@style/TextPrimaryRegular"/>
</LinearLayout>
