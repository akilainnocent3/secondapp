<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/sg_transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/parent_container"
        android:background="@drawable/card_bet_v2"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.cardview.widget.CardView
            android:id="@+id/wc_flag"
            android:background="@color/sg_transparent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="0dp"
            android:backgroundTint="@color/sg_transparent"
            app:cardBackgroundColor="@color/sg_transparent"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">
            <ImageView
                android:id="@+id/wc_flag_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>
        </androidx.cardview.widget.CardView>
        <View
            android:id="@+id/view_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent="0.0277"
            app:layout_constraintTop_toTopOf="parent"/>
        <include
            android:id="@+id/tab_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_1"
            layout="@layout/sh_tab_ou_v2"/>
        <com.sportygames.sportyherov2.components.OverUnderComponent
            android:id="@+id/over_under_component1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tab_button"/>
        <com.sportygames.sportyherov2.components.OverUnderComponent
            android:id="@+id/over_under_component2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tab_button"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/retry_fetch_all"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tab_button">
            <ImageView
                android:id="@+id/img_retry_fetch_all"
                android:layout_width="@dimen/_80sdp"
                android:layout_height="@dimen/_80sdp"
                android:src="@drawable/ic_broken_chip"
                app:layout_constraintBottom_toTopOf="@+id/something_went_wrong"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"/>
            <TextView
                android:textSize="@dimen/_11sdp"
                android:textColor="@color/sidebet_something_went_wrong"
                android:gravity="center"
                android:id="@+id/something_went_wrong"
                android:tag="@string/error_something_wrong_oh_try_again_cms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="180dp"
                android:text="@string/common_feedback_something_went_wrong_please_try_again"
                android:lines="2"
                app:layout_constraintBottom_toTopOf="@+id/try_again"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/img_retry_fetch_all"/>
            <Button
                android:textSize="@dimen/_11sdp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/try_again"
                android:tag="@string/try_again_cms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/try_again"
                android:textAllCaps="false"
                android:backgroundTint="#087f2d"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/something_went_wrong"
                style="@style/TextPrimaryRegular"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
