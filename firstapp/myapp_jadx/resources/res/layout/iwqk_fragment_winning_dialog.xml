<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#cc000000"
    android:clickable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/close_win_dlg"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_centerHorizontal="true"
        android:layout_marginEnd="33dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_you_win"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:srcCompat="@drawable/ic_icon_cancel"/>
    <TextView
        android:textSize="45dp"
        android:textStyle="bold"
        android:textColor="@color/text_type2_primary"
        android:gravity="center_horizontal"
        android:id="@+id/tv_you_win"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/common_functions__you_win"
        android:letterSpacing="0.05"
        app:layout_constraintBottom_toTopOf="@+id/tv_return_amount"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/close_win_dlg"/>
    <TextView
        android:textSize="32dp"
        android:textStyle="bold"
        android:textColor="@color/text_type2_primary"
        android:gravity="center_horizontal"
        android:id="@+id/tv_return_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.02"
        app:layout_constraintBottom_toTopOf="@+id/img"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_you_win"/>
    <ImageView
        android:id="@+id/img"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/image_height"
        android:translationZ="-2dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_view_details"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_return_amount"/>
    <Button
        android:textSize="14dp"
        android:id="@+id/btn_view_details"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:text="@string/page_instant_virtual__view_details"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_next_round"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img"
        style="@style/Widget.App.CommonButton.Contained"/>
    <Button
        android:textSize="14dp"
        android:id="@+id/btn_next_round"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:text="@string/page_instant_virtual__next_round"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_view_details"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/btn_view_details"
        style="@style/Widget.App.CommonButton.Contained"/>
</androidx.constraintlayout.widget.ConstraintLayout>
