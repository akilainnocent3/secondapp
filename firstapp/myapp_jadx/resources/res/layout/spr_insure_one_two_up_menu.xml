<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    android:radius="2dp"
    android:elevation="2dp"
    app:cardElevation="2dp"
    app:cardMaxElevation="2dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/background_general_primary"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <CheckBox
            android:textColor="@color/cmn_checkbox_text_color"
            android:id="@+id/one_up_checkbox"
            android:paddingLeft="2dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:button="@drawable/ic_sporty_insure_option_check_box"
            android:minHeight="16dp"
            android:text="@string/common_bet_ways__1up"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/B2_R"/>
        <TextView
            android:textColor="@color/text_type1_secondary"
            android:ellipsize="end"
            android:id="@+id/one_up_dash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="16dp"
            android:text="@string/common_dash"
            android:maxLines="1"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/one_up_checkbox"
            app:layout_constraintStart_toEndOf="@+id/one_up_checkbox"
            app:layout_constraintTop_toTopOf="@+id/one_up_checkbox"
            style="@style/C1_R"/>
        <TextView
            android:textColor="@color/text_type1_secondary"
            android:ellipsize="end"
            android:id="@+id/one_up_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="16dp"
            android:text="@string/common_bet_ways__early_payout"
            android:maxLines="1"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/one_up_dash"
            app:layout_constraintStart_toEndOf="@+id/one_up_dash"
            app:layout_constraintTop_toTopOf="@+id/one_up_dash"
            style="@style/C1_R"/>
        <View
            android:id="@+id/one_up_overlay"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/one_up_checkbox"
            app:layout_constraintEnd_toEndOf="@+id/one_up_text"
            app:layout_constraintStart_toStartOf="@+id/one_up_checkbox"
            app:layout_constraintTop_toTopOf="@+id/one_up_checkbox"/>
        <CheckBox
            android:textColor="@color/cmn_checkbox_text_color"
            android:id="@+id/two_up_checkbox"
            android:paddingLeft="2dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:button="@drawable/ic_sporty_insure_option_check_box"
            android:minHeight="16dp"
            android:text="@string/common_bet_ways__2up"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/one_up_checkbox"
            style="@style/B2_R"/>
        <TextView
            android:textColor="@color/text_type1_secondary"
            android:ellipsize="end"
            android:id="@+id/two_up_dash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="16dp"
            android:text="@string/common_dash"
            android:maxLines="1"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/two_up_checkbox"
            app:layout_constraintStart_toEndOf="@+id/two_up_checkbox"
            app:layout_constraintTop_toTopOf="@+id/two_up_checkbox"
            style="@style/C1_R"/>
        <TextView
            android:textColor="@color/text_type1_secondary"
            android:ellipsize="end"
            android:id="@+id/two_up_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="16dp"
            android:text="@string/common_bet_ways__early_payout"
            android:maxLines="1"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/two_up_dash"
            app:layout_constraintStart_toEndOf="@+id/two_up_dash"
            app:layout_constraintTop_toTopOf="@+id/two_up_dash"
            style="@style/C1_R"/>
        <View
            android:id="@+id/two_up_overlay"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/two_up_checkbox"
            app:layout_constraintEnd_toEndOf="@+id/two_up_text"
            app:layout_constraintStart_toStartOf="@+id/two_up_checkbox"
            app:layout_constraintTop_toTopOf="@+id/two_up_checkbox"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
