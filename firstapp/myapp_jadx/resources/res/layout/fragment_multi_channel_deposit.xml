<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.sportybet.android.widget.HintView
        android:id="@+id/hint_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.sporty.android.common_ui.widgets.IconTextSelectorButton
        android:id="@+id/mobile_selector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        app:icon="@drawable/ic_mobile_money"
        app:iconTint="@color/text_type1_secondary"
        app:layout_constraintTop_toBottomOf="@+id/hint_view"/>
    <com.sporty.android.common_ui.widgets.IconTextSelectorButton
        android:id="@+id/channel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        app:icon="@drawable/icon_default"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mobile_selector"/>
    <TextView
        android:textSize="10sp"
        android:textStyle="normal"
        android:textColor="@color/warning_primary"
        android:id="@+id/phone_warning"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:minHeight="11dp"
        android:fontFamily="sans-serif"
        app:layout_constraintLeft_toLeftOf="@+id/channel"
        app:layout_constraintTop_toBottomOf="@+id/channel"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_primary"
        android:gravity="center"
        android:id="@+id/balance_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginRight="10dp"
        android:minHeight="19dp"
        android:text="Balance (GHS)"
        android:fontFamily="sans-serif"
        app:layout_constraintRight_toLeftOf="@+id/balance"
        app:layout_constraintTop_toBottomOf="@+id/channel"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_primary"
        android:gravity="center"
        android:id="@+id/balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="19dp"
        android:fontFamily="sans-serif"
        app:layout_constraintRight_toRightOf="@+id/channel"
        app:layout_constraintTop_toTopOf="@+id/balance_label"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/text_type1_primary"
        android:id="@+id/bounty_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/channel"
        app:layout_constraintTop_toTopOf="@+id/balance_label"/>
    <com.sportybet.feature.payment.impl.deposit.presentation.widget.QuickInputItemListView
        android:id="@+id/quick_input_item_list_view"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintEnd_toEndOf="@+id/channel"
        app:layout_constraintStart_toStartOf="@+id/channel"
        app:layout_constraintTop_toBottomOf="@+id/bounty_title"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/amount_top_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="balance_label, quick_input_item_list_view"/>
    <FrameLayout
        android:id="@+id/amount_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:layout_constraintLeft_toLeftOf="@+id/channel"
        app:layout_constraintRight_toRightOf="@+id/channel"
        app:layout_constraintTop_toBottomOf="@+id/amount_top_barrier">
        <com.sporty.android.common_ui.widgets.ClearEditText
            android:textSize="14dp"
            android:textStyle="normal"
            android:gravity="center"
            android:id="@+id/amount"
            android:background="@drawable/bg_outlined_line_type1_secondary_2_radius"
            android:paddingLeft="110dp"
            android:paddingRight="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:maxLines="1"
            android:lineSpacingExtra="0sp"
            android:inputType="numberDecimal"
            android:imeOptions="actionDone"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="normal"
            android:textColor="@color/text_color_text_type1_primary"
            android:gravity="center_vertical"
            android:id="@+id/amount_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:minHeight="48dp"
            android:lineSpacingExtra="0sp"
            android:fontFamily="sans-serif-medium"/>
    </FrameLayout>
    <TextView
        android:textSize="10sp"
        android:textStyle="normal"
        android:textColor="@color/warning_primary"
        android:id="@+id/amount_warning"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:minHeight="11dp"
        android:fontFamily="sans-serif"
        app:layout_constraintLeft_toLeftOf="@+id/channel"
        app:layout_constraintTop_toBottomOf="@+id/amount_container"/>
    <com.sportybet.feature.payment.impl.deposit.presentation.widget.AmountQuickAddingButtonGroup
        android:id="@+id/deposit_amount_quick_adding_buttons"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintLeft_toLeftOf="@+id/channel"
        app:layout_constraintRight_toRightOf="@+id/channel"
        app:layout_constraintTop_toBottomOf="@+id/amount_warning"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/text_type1_secondary"
        android:id="@+id/bounty_threshold_description"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="@+id/channel"
        app:layout_constraintStart_toStartOf="@+id/channel"
        app:layout_constraintTop_toBottomOf="@+id/deposit_amount_quick_adding_buttons"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bounty_details_layout"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="23dp"
        app:layout_constraintEnd_toEndOf="@+id/channel"
        app:layout_constraintStart_toStartOf="@+id/channel"
        app:layout_constraintTop_toBottomOf="@+id/amount_warning">
        <TextView
            android:textSize="12dp"
            android:textColor="@color/text_type1_secondary"
            android:id="@+id/charges_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/text_type1_primary"
            android:id="@+id/charges_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/charges_label"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/text_type1_secondary"
            android:id="@+id/total_receive_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/charges_label"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/text_type1_primary"
            android:id="@+id/amount_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/total_receive_label"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/next_top_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="bounty_threshold_description, bounty_details_layout"/>
    <com.sporty.android.common_ui.widgets.CustomProgressButton
        android:id="@+id/next"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:minHeight="48dp"
        app:layout_constraintLeft_toLeftOf="@+id/channel"
        app:layout_constraintRight_toRightOf="@+id/channel"
        app:layout_constraintTop_toBottomOf="@+id/next_top_barrier"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/deposit_banner_compose_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="@+id/next"
        app:layout_constraintStart_toStartOf="@+id/next"
        app:layout_constraintTop_toBottomOf="@+id/next"/>
    <com.sportybet.android.widget.SimpleDescriptionListView
        android:orientation="vertical"
        android:id="@+id/description_list_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintLeft_toLeftOf="@+id/channel"
        app:layout_constraintRight_toRightOf="@+id/channel"
        app:layout_constraintTop_toBottomOf="@+id/deposit_banner_compose_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
