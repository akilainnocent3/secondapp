<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.Guideline
                    android:orientation="vertical"
                    android:id="@+id/guideline_begin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintGuide_begin="16dp"/>
                <androidx.constraintlayout.widget.Guideline
                    android:orientation="vertical"
                    android:id="@+id/guideline_end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintGuide_end="16dp"/>
                <com.sportybet.android.widget.HintView
                    android:id="@+id/hint_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/compose_phone_channel_hint"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.constraintlayout.widget.Barrier
                    android:id="@+id/hint_bottom_barrier"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:barrierDirection="bottom"
                    app:constraint_referenced_ids="hint_view, compose_phone_channel_hint"/>
                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/withdraw_alert_hint"
                    android:background="@color/transparent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="@+id/guideline_end"
                    app:layout_constraintStart_toStartOf="@+id/guideline_begin"
                    app:layout_constraintTop_toBottomOf="@+id/hint_bottom_barrier"/>
                <com.sporty.android.common_ui.widgets.IconTextSelectorButton
                    android:id="@+id/mobile_selector"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:icon="@drawable/ic_mobile_money"
                    app:iconTint="@color/text_type1_secondary"
                    app:layout_constraintEnd_toStartOf="@+id/guideline_end"
                    app:layout_constraintStart_toEndOf="@+id/guideline_begin"
                    app:layout_constraintTop_toBottomOf="@+id/withdraw_alert_hint"/>
                <com.sporty.android.common_ui.widgets.IconTextSelectorButton
                    android:id="@+id/channel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:icon="@drawable/icon_default"
                    app:layout_constraintEnd_toStartOf="@+id/guideline_end"
                    app:layout_constraintStart_toEndOf="@+id/guideline_begin"
                    app:layout_constraintTop_toBottomOf="@+id/mobile_selector"/>
                <TextView
                    android:textSize="12dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="center"
                    android:id="@+id/balance_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:layout_marginRight="10dp"
                    android:minHeight="19dp"
                    android:fontFamily="sans-serif"
                    app:layout_constraintRight_toLeftOf="@+id/balance"
                    app:layout_constraintTop_toBottomOf="@+id/channel"/>
                <TextView
                    android:textSize="12dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="center"
                    android:id="@+id/balance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="19dp"
                    android:fontFamily="sans-serif"
                    app:layout_constraintRight_toRightOf="@+id/channel"
                    app:layout_constraintTop_toTopOf="@+id/balance_label"/>
                <TextView
                    android:textSize="12dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="center"
                    android:id="@+id/withdrawable_balance_label"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="10dp"
                    android:minHeight="19dp"
                    android:text="@string/app_common__withdraw_balance_label"
                    android:fontFamily="sans-serif"
                    app:layout_constraintRight_toLeftOf="@+id/withdrawable_balance"
                    app:layout_constraintTop_toBottomOf="@+id/balance_label"/>
                <TextView
                    android:textSize="12dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="center"
                    android:id="@+id/withdrawable_balance"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="19dp"
                    android:fontFamily="sans-serif"
                    app:layout_constraintRight_toRightOf="@+id/channel"
                    app:layout_constraintTop_toTopOf="@+id/withdrawable_balance_label"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/withdrawable_help"
                    android:padding="10dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="19dp"
                    app:layout_constraintBottom_toBottomOf="@+id/withdrawable_balance_label"
                    app:layout_constraintRight_toLeftOf="@+id/withdrawable_balance_label"
                    app:layout_constraintTop_toTopOf="@+id/withdrawable_balance_label"
                    app:srcCompat="@drawable/ic_help_outline_black_19dp"
                    app:tint="@color/text_type1_primary"/>
                <FrameLayout
                    android:id="@+id/amount_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:layout_constraintLeft_toLeftOf="@+id/channel"
                    app:layout_constraintRight_toRightOf="@+id/channel"
                    app:layout_constraintTop_toBottomOf="@+id/withdrawable_balance_label">
                    <com.sporty.android.common_ui.widgets.ClearEditText
                        android:textAppearance="@style/B1_R"
                        android:gravity="center"
                        android:id="@+id/amount"
                        android:background="@drawable/bg_outlined_line_type1_secondary_2_radius"
                        android:paddingLeft="110dp"
                        android:paddingRight="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:maxLines="1"
                        android:lineSpacingExtra="0dp"
                        android:inputType="numberDecimal"
                        android:imeOptions="actionDone"/>
                    <TextView
                        android:textSize="14dp"
                        android:textStyle="normal"
                        android:textColor="@color/text_type1_primary"
                        android:gravity="center_vertical"
                        android:id="@+id/amount_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:minHeight="48dp"
                        android:lineSpacingExtra="0dp"
                        android:fontFamily="sans-serif-medium"/>
                </FrameLayout>
                <TextView
                    android:textSize="10dp"
                    android:textStyle="normal"
                    android:textColor="@color/warning_primary"
                    android:id="@+id/amount_warning"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:minHeight="11dp"
                    android:fontFamily="sans-serif"
                    app:layout_constraintLeft_toLeftOf="@+id/amount_container"
                    app:layout_constraintRight_toRightOf="@+id/amount_container"
                    app:layout_constraintTop_toBottomOf="@+id/amount_container"/>
                <com.sportybet.android.widget.ProgressButton
                    android:id="@+id/next"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:minHeight="48dp"
                    android:text="@string/common_functions__withdraw"
                    app:layout_constraintLeft_toLeftOf="@+id/channel"
                    app:layout_constraintRight_toRightOf="@+id/channel"
                    app:layout_constraintTop_toBottomOf="@+id/amount_warning"
                    app:layout_goneMarginTop="20dp"/>
                <TextView
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/wh_tax_description"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/page_payment__withdraw_gh_tax_info"
                    app:layout_constraintEnd_toEndOf="@+id/next"
                    app:layout_constraintStart_toStartOf="@+id/next"
                    app:layout_constraintTop_toBottomOf="@+id/next"
                    style="@style/C1_R"/>
                <com.sportybet.android.widget.SimpleDescriptionListView
                    android:id="@+id/description_list_view"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:layout_constraintLeft_toLeftOf="@+id/channel"
                    app:layout_constraintRight_toRightOf="@+id/channel"
                    app:layout_constraintTop_toBottomOf="@+id/wh_tax_description"/>
                <com.sporty.android.common_ui.widgets.AspectRatioImageView
                    android:id="@+id/withdraw_banner"
                    android:background="@android:color/white"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="20dp"
                    android:scaleType="fitXY"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/description_list_view"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <FrameLayout
        android:id="@+id/anti_interaction_mask"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.sporty.android.common_ui.widgets.LoadingViewNew
        android:id="@+id/loading_mask"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/init_mask"
        android:background="@color/background_general_primary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.sporty.android.common_ui.widgets.LoadingViewNew
        android:id="@+id/init_failed_mask"
        android:background="@color/background_general_primary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
