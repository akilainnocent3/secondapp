<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_streak_upgrade_hint"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="4dp">
    <ImageView
        android:id="@+id/streak_upgrade_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_streak_upgrade"
        android:contentDescription="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/text_inverse_primary"
        android:id="@+id/streak_upgrade_title"
        android:paddingBottom="2dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/streak_upgrade_icon"
        app:layout_constraintEnd_toStartOf="@+id/streak_upgrade_arrow"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/streak_upgrade_icon"
        app:layout_constraintTop_toTopOf="@+id/streak_upgrade_icon"
        style="@style/B2_B"/>
    <ImageView
        android:id="@+id/streak_upgrade_arrow"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="@drawable/ic__arrow_chevron_right"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="@+id/streak_upgrade_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/streak_upgrade_icon"
        app:tint="@color/icon_inverse_primary"/>
    <TextView
        android:textColor="@color/text_inverse_primary"
        android:id="@+id/streak_upgrade_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/streak_upgrade_icon"
        app:layout_constraintTop_toBottomOf="@+id/streak_upgrade_title"
        style="@style/B2_R"/>
</androidx.constraintlayout.widget.ConstraintLayout>
