<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_layout"
    android:background="?attr/chatBackground"
    android:layout_width="match_parent"
    android:layout_height="95dp">
    <TextView
        android:textSize="16dp"
        android:textColor="?attr/chatTextPrimary"
        android:gravity="center"
        android:id="@+id/first_item"
        android:layout_width="0dp"
        android:layout_height="47dp"
        android:text="@string/common_functions__reply"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/divider"
        android:background="@color/line_type1_primary"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/first_item"/>
    <TextView
        android:textSize="16dp"
        android:textColor="?attr/chatTextPrimary"
        android:gravity="center"
        android:id="@+id/second_item"
        android:layout_width="0dp"
        android:layout_height="47dp"
        android:text="@string/common_functions__copy"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider"/>
</androidx.constraintlayout.widget.ConstraintLayout>
