<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#f2f3f5"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/bottom_layout"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_alignParentBottom="true"
        layout="@layout/my_favorite_bottom_layout"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#353a45"
        android:gravity="center_vertical"
        android:id="@+id/title"
        android:paddingLeft="20dp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/wap_setting__my_odds_range_title"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/absolute_type1"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="146dp"
        android:layout_below="@+id/title">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="12dp"
                android:textColor="@color/text_type1_secondary"
                android:id="@+id/odds_range_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Odds Range"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"/>
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/brand_secondary"
                android:id="@+id/odds_range_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1-40"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <com.sportybet.android.widget.seekbar.RangeSeekBar
                android:id="@+id/range_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rsb_gravity="bottom"
                app:rsb_mode="range"
                app:rsb_progress_color="@color/brand_secondary"
                app:rsb_step_auto_bonding="true"
                app:rsb_step_color="@color/transparent_white"
                app:rsb_step_height="1dp"
                app:rsb_step_width="1dp"
                app:rsb_steps="14"
                app:rsb_thumb_drawable="@drawable/thumb_green_alpha"
                app:rsb_thumb_height="18dp"
                app:rsb_thumb_inactivated_drawable="@drawable/thumb_activated"
                app:rsb_thumb_width="18dp"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/text_type1_secondary"
                    android:id="@+id/filter_min"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"/>
                <TextView
                    android:textColor="@color/text_type1_secondary"
                    android:id="@+id/filter_max"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/component_odds_filters__max"
                    android:layout_alignParentRight="true"/>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
    <com.sporty.android.common_ui.widgets.LoadingViewNew
        android:id="@+id/loading"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:layout_centerInParent="true"/>
</RelativeLayout>
