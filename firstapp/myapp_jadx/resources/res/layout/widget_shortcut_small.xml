<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_filled_background_general_primary_20_radius"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="end"
        android:layout_width="152dp"
        android:layout_height="152dp"
        android:src="@drawable/img_s_logo_small"/>
    <LinearLayout
        android:theme="@style/AppTheme"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="20dp">
        <ImageView
            android:id="@+id/shortcut_widget_logo"
            android:layout_width="81dp"
            android:layout_height="15dp"
            android:src="@drawable/ic_sportybet_logo"/>
        <GridView
            android:id="@+id/shortcut_widget_grid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:horizontalSpacing="8dp"
            android:verticalSpacing="8dp"
            android:numColumns="2"/>
    </LinearLayout>
</FrameLayout>
