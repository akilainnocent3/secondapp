<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/constraintlayout_gift_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:minHeight="110dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_top_area"
        android:background="@color/discount_gift_primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header">
        <TextView
            android:textSize="12dp"
            android:textStyle="normal"
            android:textColor="@color/text_type2_primary"
            android:id="@+id/tv_gift_condition"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/tv_gift_button_layout"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/tv_gift_button_layout"
            android:layout_width="76dp"
            android:layout_height="26dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="12dp"
                android:textStyle="bold"
                android:textColor="@color/discount_gift_primary"
                android:gravity="center"
                android:id="@+id/selected_text"
                android:background="@drawable/spr_bg_white_rect2"
                android:layout_width="76dp"
                android:layout_height="26dp"
                android:text="@string/gift__use"/>
            <ImageView
                android:id="@+id/selected"
                android:visibility="gone"
                android:layout_width="76dp"
                android:layout_height="26dp"
                android:scaleType="center"
                android:adjustViewBounds="true"
                app:srcCompat="@drawable/spr_betslip_gift_seleted"/>
        </FrameLayout>
        <TextView
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="@color/text_type2_primary"
            android:gravity="center"
            android:id="@+id/tv_gift_currency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_gift_condition"
            app:layout_goneMarginLeft="12dp"
            app:layout_goneMarginStart="12dp"
            app:layout_goneMarginTop="12dp"/>
        <TextView
            android:textSize="20dp"
            android:textColor="@color/text_type2_primary"
            android:id="@+id/tv_gift_cash"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="3dp"
            android:layout_marginRight="8dp"
            android:fontFamily="sans-serif-black"
            android:layout_marginHorizontal="8dp"
            app:layout_constraintLeft_toRightOf="@+id/tv_gift_currency"
            app:layout_constraintRight_toLeftOf="@+id/tv_gift_date"
            app:layout_constraintTop_toBottomOf="@+id/tv_gift_condition"
            app:layout_goneMarginTop="9dp"/>
        <TextView
            android:textSize="12dp"
            android:textStyle="normal"
            android:textColor="@color/text_inverse_primary"
            android:gravity="end|center_vertical"
            android:id="@+id/tv_gift_date"
            android:paddingBottom="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="12dp"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_gift_button_layout"
            app:layout_constraintVertical_bias="1"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_bottom_area"
        android:background="@drawable/iwqk_gift_bottom"
        android:paddingBottom="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_top_area">
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/discount_gift_primary"
            android:id="@+id/tv_gift_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#9ca0ab"
            android:id="@+id/tv_gift_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            app:layout_constrainedWidth="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/tv_more"
            app:layout_constraintTop_toBottomOf="@+id/tv_gift_type"/>
        <TextView
            android:textSize="12dp"
            android:textStyle="normal"
            android:textColor="@color/free_bet_gift_primary"
            android:id="@+id/tv_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common_functions__more"
            app:layout_constraintRight_toLeftOf="@+id/iv_more_arrow"
            app:layout_constraintTop_toTopOf="@+id/tv_gift_title"/>
        <ImageView
            android:id="@+id/iv_more_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginRight="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_more"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_more"
            app:srcCompat="@drawable/spr_arrow_gift_blue_down"
            app:tint="@color/free_bet_gift_primary"/>
        <TextView
            android:textSize="12dp"
            android:textStyle="normal"
            android:textColor="@color/text_type1_secondary"
            android:id="@+id/tv_gift_content"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="12dp"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_gift_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/unusable_gifts_mask"
        android:background="@color/background_type1_quaternary"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_primary"
        android:id="@+id/header"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:minHeight="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
