<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/text_type1_primary"
    android:paddingLeft="33dp"
    android:paddingRight="21dp"
    android:paddingBottom="50dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="top"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginTop="24dp"
        android:text="@string/jackpot__how_to_play_jackpot"
        android:lineSpacingExtra="0.8sp"
        android:fontFamily="sans-serif"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="#ffffff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/jackpot__help_param1"
        android:lineSpacingExtra="10sp"
        android:fontFamily="sans-serif"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="top"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginTop="24dp"
        android:text="@string/jackpot__how_to_take_part"
        android:lineSpacingExtra="0.8sp"
        android:fontFamily="sans-serif"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="#ffffff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/jackpot__help_param2"
        android:lineSpacingExtra="10sp"
        android:fontFamily="sans-serif"/>
</LinearLayout>
