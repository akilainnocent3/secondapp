<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/absolute_type1"
    android:paddingLeft="24dp"
    android:paddingRight="24dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="@color/text_type1_primary"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="21dp"
        android:text="@string/common_info_setting__set_username"
        android:lineSpacingExtra="8sp"
        android:fontFamily="sans-serif"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_primary"
        android:id="@+id/desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="21dp"
        android:text="@string/common_info_setting__set_username_desc"
        android:layout_below="@+id/title"
        android:lineSpacingExtra="8sp"
        android:fontFamily="sans-serif"/>
    <com.sportybet.plugin.realsports.results.ResultsClearEditText
        android:textSize="14sp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_primary"
        android:textColorHint="@color/text_type1_secondary"
        android:gravity="center"
        android:id="@+id/set_nick_edit"
        android:background="@drawable/bg_outlined_line_type1_secondary"
        android:paddingLeft="10dp"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="5dp"
        android:hint="@string/common_info_setting__set_username_hint"
        android:singleLine="true"
        android:layout_below="@+id/desc"
        android:imeOptions="actionDone"
        android:fontFamily="sans-serif"/>
    <TextView
        android:textSize="10sp"
        android:textStyle="normal"
        android:textColor="@color/brand_primary"
        android:id="@+id/hint_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_below="@+id/set_nick_edit"
        android:fontFamily="sans-serif"/>
    <FrameLayout
        android:id="@+id/save_container"
        android:layout_width="75dp"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:layout_below="@+id/hint_tv"
        android:layout_alignParentRight="true">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_color_brand_secondary"
            android:gravity="center"
            android:id="@+id/save_btn"
            android:background="?android:attr/selectableItemBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/common_functions__save"
            android:textAllCaps="true"
            android:fontFamily="sans-serif"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/progress_bar"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/cancel_container"
        android:layout_width="75dp"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:layout_toLeftOf="@+id/save_container"
        android:layout_below="@+id/hint_tv">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_color_brand_secondary"
            android:gravity="center"
            android:id="@+id/cancel_btn"
            android:background="?android:attr/selectableItemBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/common_functions__cancel"
            android:fontFamily="sans-serif"/>
    </FrameLayout>
</RelativeLayout>
