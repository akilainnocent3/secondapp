<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_rounded_corners_top"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingLeft="20dp"
        android:paddingTop="26dp"
        android:paddingRight="20dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:paddingHorizontal="20dp"
        app:layout_constraintBottom_toTopOf="@+id/setting_list"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="18dp"
            android:textStyle="bold"
            android:textColor="@color/text_type1_tertiary"
            android:gravity="center_vertical"
            android:id="@+id/bet_settings"
            android:background="@color/background_general_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/component_betslip__bet_settings"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <ImageView
            android:id="@+id/close"
            android:padding="2dp"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_icon_cancel"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="@color/icon_secondary"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/setting_list"
        android:background="@drawable/bg_rounded_corners"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="24dp"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/text_type1_primary"
            android:gravity="center_vertical"
            android:id="@+id/my_stakes"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/wap_setting__my_stakes"
            android:paddingStart="12dp"
            app:layout_constraintBottom_toTopOf="@+id/divider1"
            app:layout_constraintEnd_toEndOf="@+id/btn_goto_my_stakes"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/B1_M"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btn_goto_my_stakes"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/my_stakes"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/my_stakes"
            app:srcCompat="@drawable/ic__arrow_chevron_right"
            app:tint="@color/text_secondary"/>
        <View
            android:id="@+id/divider1"
            android:background="@color/line_type1_primary"
            android:layout_width="0dp"
            android:layout_height="1dp"
            app:layout_constraintBottom_toTopOf="@+id/remove_suspend_switch"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.sporty.android.common_ui.widgets.ItemToggleView
            android:id="@+id/remove_suspend_switch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/component_betslip__auto_remove_suspended_events"
            app:layout_constraintBottom_toTopOf="@+id/divider2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <View
            android:id="@+id/divider2"
            android:background="@color/line_type1_primary"
            android:layout_width="0dp"
            android:layout_height="1dp"
            app:layout_constraintBottom_toTopOf="@+id/odds_change_switch"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.sporty.android.common_ui.widgets.ItemToggleView
            android:id="@+id/odds_change_switch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/component_betslip__accept_odds_changes"
            app:layout_constraintBottom_toBottomOf="@+id/divider3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <View
            android:id="@+id/divider3"
            android:background="@color/line_type1_primary"
            android:layout_width="0dp"
            android:layout_height="1dp"
            app:layout_constraintBottom_toTopOf="@+id/retain_current_selection_switch"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.sporty.android.common_ui.widgets.ItemToggleView
            android:id="@+id/retain_current_selection_switch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/component_betslip__combine_selections_when_rebet_remix"
            app:layout_constraintBottom_toBottomOf="@+id/divider4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <View
            android:id="@+id/divider4"
            android:background="@color/line_type1_primary"
            android:layout_width="0dp"
            android:layout_height="1dp"
            app:layout_constraintBottom_toTopOf="@+id/default_gift_switch"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.sporty.android.common_ui.widgets.ItemToggleView
            android:id="@+id/default_gift_switch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/component_betslip__gift_is_selected_by_default"
            app:layout_constraintBottom_toTopOf="@+id/bottom_space"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <Space
            android:id="@+id/bottom_space"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
