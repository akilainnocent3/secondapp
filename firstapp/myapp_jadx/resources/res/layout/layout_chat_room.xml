<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_layout"
    android:background="?attr/chatBackground"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_area"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="40dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageButton
            android:id="@+id/btn_close"
            android:background="@android:color/transparent"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerInside"
            android:contentDescription="close"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/icon_cancel"
            app:tint="@color/icon_secondary"/>
        <ImageButton
            android:id="@+id/country_filter_icon"
            android:background="@android:color/transparent"
            android:padding="10dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginRight="8dp"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/btn_close"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/icon_secondary"/>
        <ImageButton
            android:id="@+id/btn_info"
            android:background="@android:color/transparent"
            android:padding="10dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginRight="8dp"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/country_filter_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/icon_secondary"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chat_recycle_view"
        android:visibility="visible"
        android:scrollbars="vertical"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_area"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_area"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/error_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_area"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_area">
        <ImageView
            android:id="@+id/img_status_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="40dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/icon_nodata"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/text_type1_secondary"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/live__comment_empty_hint"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/img_status_icon"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:layout_constraintBottom_toTopOf="@+id/bottom_area"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_area"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/country_filter_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/custom_absolute_type1_type4"
        app:cardElevation="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_area">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_country_filter"
            android:layout_width="180dp"
            android:layout_height="98dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_area">
            <TextView
                android:textSize="12dp"
                android:textStyle="bold"
                android:textColor="@color/text_type1_primary"
                android:gravity="center_vertical"
                android:id="@+id/text_filter"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginLeft="10dp"
                android:text="@string/live__view_comments_from"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <include
                android:id="@+id/all_country"
                android:layout_width="0dp"
                android:layout_height="34dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/text_filter"
                layout="@layout/item_country"/>
            <include
                android:id="@+id/my_country"
                android:layout_width="0dp"
                android:layout_height="34dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/all_country"
                layout="@layout/item_country"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <ImageButton
        android:id="@+id/jump_to_bottom"
        android:background="@drawable/shape_jump_to_bottom"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_area"
        app:layout_constraintRight_toRightOf="parent"
        app:srcCompat="@drawable/icon_arrow_2_down"/>
    <View
        android:id="@+id/overlay_bottom"
        android:background="#80000000"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_area"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_area"
        android:background="?attr/chatBackground"
        android:paddingTop="12dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <View
            android:id="@+id/top_divider"
            android:background="@color/background_type2_tertiary"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="1.5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/booking_code_preview"/>
        <include
            android:id="@+id/booking_code_preview"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/item_comment_image_view"/>
        <ImageView
            android:gravity="center"
            android:id="@+id/input_share_btn"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:paddingStart="8dp"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/input"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/input"
            app:srcCompat="@drawable/ic_live_code_share"/>
        <EditText
            android:textSize="14dp"
            android:textColor="@color/text_type1_secondary"
            android:textColorHint="@color/text_type1_secondary"
            android:id="@+id/input"
            android:background="@drawable/shape_input"
            android:paddingLeft="32dp"
            android:paddingTop="6dp"
            android:paddingRight="16dp"
            android:paddingBottom="6dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="8dp"
            android:minHeight="42dp"
            android:hint="@string/live__start_chatting"
            android:maxLines="3"
            android:maxLength="@integer/live_chat_text_max_length"
            android:inputType="textMultiLine"
            app:layout_constraintEnd_toStartOf="@+id/btn_send"
            app:layout_constraintStart_toEndOf="@+id/input_share_btn"
            app:layout_constraintTop_toBottomOf="@+id/booking_code_preview"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/text_type1_secondary"
            android:gravity="top"
            android:id="@+id/text_length_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginEnd="48dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/input"/>
        <ImageView
            android:id="@+id/img_edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/input"
            app:layout_constraintLeft_toLeftOf="@+id/input"
            app:layout_constraintTop_toTopOf="@+id/input"
            app:srcCompat="@drawable/icon_edit"
            app:tint="@color/text_type1_secondary"/>
        <ImageButton
            android:id="@+id/btn_send"
            android:background="@android:color/transparent"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/input"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/input"
            app:srcCompat="@drawable/icon_send"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
