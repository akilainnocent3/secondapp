<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sub_parent_bets"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_150sdp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/header_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="4"
        app:layout_constraintBottom_toTopOf="@+id/recycler_view_bets"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">
        <TextView
            android:textSize="8sp"
            android:textColor="@color/white"
            android:gravity="start"
            android:id="@+id/header_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="4dp"
            style="@style/TextPrimaryRegular"/>
        <TextView
            android:textSize="8sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/header_bet_win"
            android:tag="@string/bet_text_small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="6dp"
            style="@style/TextPrimaryRegular"/>
        <TextView
            android:textSize="8sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/header_coeff"
            android:tag="@string/coeff_cms"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingEnd="10dp"
            style="@style/TextPrimaryRegular"/>
        <TextView
            android:textSize="8sp"
            android:textColor="@color/white"
            android:gravity="end"
            android:id="@+id/header_win"
            android:tag="@string/win_cms"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingEnd="12dp"
            style="@style/TextPrimaryRegular"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_bets"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:layout_marginVertical="5dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_row"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/no_bets_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_row">
        <ImageView
            android:id="@+id/img_poker_chips"
            android:layout_width="@dimen/_70sdp"
            android:layout_height="@dimen/_80sdp"
            android:src="@drawable/no_data_chips"/>
        <TextView
            android:textSize="@dimen/_12ssp"
            android:textColor="@color/color_474747"
            android:gravity="center"
            android:id="@+id/tv_no_bets"
            android:tag="@string/no_bets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-5dp"
            style="@style/TextPrimaryRegular"/>
    </LinearLayout>
    <com.github.ybq.android.spinkit.SpinKitView
        android:id="@+id/loader"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_32sdp"
        android:layout_marginTop="60dp"
        app:SpinKit_Color="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_row"
        style="@style/SpinKitStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
