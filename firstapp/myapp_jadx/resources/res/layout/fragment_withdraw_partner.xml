<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.sportybet.android.widget.HintView
                    android:id="@+id/hint_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.sporty.android.common_ui.widgets.CombEditText
                    android:id="@+id/partner_code"
                    android:background="@drawable/bg_outlined_line_type1_secondary_2_radius"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="22dp"
                    android:layout_marginRight="16dp"
                    android:minHeight="48dp"
                    android:layout_marginHorizontal="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/hint_view"/>
                <TextView
                    android:textSize="10sp"
                    android:textStyle="normal"
                    android:textColor="@color/warning_primary"
                    android:id="@+id/partner_code_warning"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:minHeight="11dp"
                    android:fontFamily="sans-serif"
                    app:layout_constraintEnd_toEndOf="@+id/partner_code"
                    app:layout_constraintStart_toStartOf="@+id/partner_code"
                    app:layout_constraintTop_toBottomOf="@+id/partner_code"/>
                <TextView
                    android:textSize="12dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="center"
                    android:id="@+id/balance_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginRight="10dp"
                    android:minHeight="19dp"
                    android:fontFamily="sans-serif"
                    app:layout_constraintRight_toLeftOf="@+id/balance"
                    app:layout_constraintTop_toBottomOf="@+id/partner_code"/>
                <TextView
                    android:textSize="12dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="center"
                    android:id="@+id/balance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="19dp"
                    android:fontFamily="sans-serif"
                    app:layout_constraintRight_toRightOf="@+id/partner_code"
                    app:layout_constraintTop_toTopOf="@+id/balance_label"/>
                <FrameLayout
                    android:id="@+id/amount_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:layout_constraintLeft_toLeftOf="@+id/partner_code"
                    app:layout_constraintRight_toRightOf="@+id/partner_code"
                    app:layout_constraintTop_toBottomOf="@+id/balance">
                    <TextView
                        android:textSize="14dp"
                        android:textStyle="normal"
                        android:textColor="@color/text_type1_primary"
                        android:gravity="center_vertical"
                        android:id="@+id/amount_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:minHeight="48dp"
                        android:lineSpacingExtra="0dp"
                        android:fontFamily="sans-serif-medium"/>
                    <com.sporty.android.common_ui.widgets.ClearEditText
                        android:textAppearance="@style/B1_R"
                        android:gravity="center"
                        android:id="@+id/amount"
                        android:background="@drawable/bg_outlined_line_type1_secondary_2_radius"
                        android:paddingLeft="110dp"
                        android:paddingRight="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:maxLines="1"
                        android:drawablePadding="8dp"
                        android:lineSpacingExtra="0dp"
                        android:inputType="numberDecimal"
                        android:imeOptions="actionDone"
                        app:cancalDrawableSize="16dp"/>
                </FrameLayout>
                <TextView
                    android:textSize="10dp"
                    android:textStyle="normal"
                    android:textColor="@color/warning_primary"
                    android:id="@+id/amount_warning"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:minHeight="11dp"
                    android:fontFamily="sans-serif"
                    app:layout_constraintLeft_toLeftOf="@+id/amount_container"
                    app:layout_constraintRight_toRightOf="@+id/amount_container"
                    app:layout_constraintTop_toBottomOf="@+id/amount_container"/>
                <com.sportybet.android.widget.ProgressButton
                    android:id="@+id/next"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:minHeight="48dp"
                    android:text="@string/common_functions__withdraw"
                    app:layout_constraintLeft_toLeftOf="@+id/partner_code"
                    app:layout_constraintRight_toRightOf="@+id/partner_code"
                    app:layout_constraintTop_toBottomOf="@+id/amount_warning"
                    app:layout_goneMarginTop="20dp"/>
                <TextView
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/wh_tax_description"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/page_payment__withdraw_gh_tax_info"
                    app:layout_constraintEnd_toEndOf="@+id/next"
                    app:layout_constraintStart_toStartOf="@+id/next"
                    app:layout_constraintTop_toBottomOf="@+id/next"
                    style="@style/C1_R"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/brand_quaternary"
                    android:gravity="center"
                    android:id="@+id/request_list_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="46dp"
                    android:minHeight="20dp"
                    android:text="@string/page_withdraw__my_request_list_check_pin_code__NG"
                    app:layout_constraintEnd_toEndOf="@+id/partner_code"
                    app:layout_constraintStart_toStartOf="@+id/partner_code"
                    app:layout_constraintTop_toBottomOf="@+id/wh_tax_description"/>
                <com.sportybet.android.widget.SimpleDescriptionListView
                    android:id="@+id/description_list_view"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    app:layout_constraintLeft_toLeftOf="@+id/partner_code"
                    app:layout_constraintRight_toRightOf="@+id/partner_code"
                    app:layout_constraintTop_toBottomOf="@+id/request_list_button"/>
                <com.sporty.android.common_ui.widgets.AspectRatioImageView
                    android:id="@+id/withdraw_banner"
                    android:background="@android:color/white"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="20dp"
                    android:scaleType="fitXY"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/description_list_view"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <FrameLayout
        android:id="@+id/anti_interaction_mask"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.sporty.android.common_ui.widgets.LoadingViewNew
        android:id="@+id/loading_mask"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/init_mask"
        android:background="@color/background_general_primary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.sporty.android.common_ui.widgets.LoadingViewNew
        android:id="@+id/init_failed_mask"
        android:background="@color/background_general_primary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
