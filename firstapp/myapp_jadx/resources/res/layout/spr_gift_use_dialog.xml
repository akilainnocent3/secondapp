<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/H3_B"
        android:textColor="@color/text_type1_primary"
        android:gravity="center"
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="23dp"
        android:layout_marginRight="20dp"
        android:text="@string/gift__how_to_use_gifts_from_betslip"/>
    <TextView
        android:textAppearance="@style/B2_R"
        android:textColor="@color/text_type1_primary"
        android:gravity="center"
        android:id="@+id/dialog_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="20dp"
        android:text="@string/gift__there_are_3_types_of_gifts_which_could_be_used_as_your_stake"
        android:layout_below="@+id/dialog_title"/>
    <ImageView
        android:id="@+id/betslip_image"
        android:layout_width="240dp"
        android:layout_height="112dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="20dp"
        android:layout_below="@+id/dialog_content"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/brand_secondary"
        android:gravity="center"
        android:id="@+id/cancel"
        android:background="@drawable/spr_bg_green_rect"
        android:layout_width="114dp"
        android:layout_height="44dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="24dp"
        android:text="@string/common_functions__cancel"
        android:layout_below="@+id/betslip_image"
        android:layout_alignParentLeft="true"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/brand_tertiary"
        android:gravity="center"
        android:id="@+id/bet_now"
        android:background="@drawable/spr_bg_green_rect_solid"
        android:layout_width="114dp"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="20dp"
        android:text="@string/gift__bet_now"
        android:layout_below="@+id/betslip_image"
        android:layout_alignParentRight="true"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/brand_quaternary"
        android:gravity="center"
        android:id="@+id/use_gift"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="32dp"
        android:text="@string/gift__how_to_use"
        android:layout_below="@+id/cancel"
        android:layout_centerHorizontal="true"
        app:drawableRightCompat="@drawable/right_arrow_normal"
        app:drawableTint="@color/brand_quaternary"/>
</RelativeLayout>
