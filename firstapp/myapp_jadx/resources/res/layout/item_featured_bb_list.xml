<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="4dp"
    android:layout_marginRight="4dp"
    android:layout_marginBottom="9dp"
    android:elevation="16dp"
    android:layout_marginHorizontal="4dp"
    app:cardBackgroundColor="@color/background_type1_quaternary"
    app:cardCornerRadius="0dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/ivBBTitle"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_bet_builder_list_logo"
            android:layout_marginStart="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/tvBBTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvBBTitle"/>
        <TextView
            android:textAppearance="@style/B1_B"
            android:textSize="@dimen/text_size_14dp"
            android:textStyle="italic|bold"
            android:textColor="@color/text_inverse_brand_sub"
            android:ellipsize="end"
            android:id="@+id/tvBBTitle"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/bet_builder__bet_builder"
            android:maxLines="1"
            android:layout_marginStart="2dp"
            android:paddingVertical="7dp"
            app:layout_constraintStart_toEndOf="@+id/ivBBTitle"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.sportybet.plugin.realsports.widget.OutcomeButton
            android:textSize="14sp"
            android:textColor="@color/spr_prematch_toggle_txt"
            android:gravity="center"
            android:id="@+id/btnOdds"
            android:background="@drawable/bg_filled_brand_secondary_variable_type1_with_brand_secondary"
            android:layout_width="96dp"
            android:layout_height="28dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/tvBBTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvBBTitle"/>
        <View
            android:id="@+id/vRvMarginProvider"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/rvSubCards"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/rvSubCards"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSubCards"
            android:paddingBottom="8dp"
            android:scrollbars="vertical"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="1dp"
            android:nestedScrollingEnabled="false"
            android:layout_marginHorizontal="1dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvBBTitle"/>
        <View
            android:id="@+id/view_fade_edge"
            android:background="@drawable/bg_code_hub_fade_edge_gradient"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/rvSubCards"/>
        <View
            android:id="@+id/view_top_fade_edge"
            android:background="@drawable/bg_code_hub_fade_edge_gradient"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:scaleY="-1"
            app:layout_constraintTop_toTopOf="@+id/rvSubCards"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
