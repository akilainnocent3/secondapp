<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/sports_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="4dp"
        app:srcCompat="@drawable/ic_mm_football"
        app:tint="@color/text_type2_primary"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/background_type2_primary"
        android:gravity="center_horizontal"
        android:id="@+id/sub_with_badge_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="@color/text_type2_primary"
        android:gravity="center"
        android:id="@+id/count_badge"
        android:background="@drawable/iwqk_bg_gray_circle"
        android:padding="1dp"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:fontFamily="sans-serif-medium"/>
</merge>
