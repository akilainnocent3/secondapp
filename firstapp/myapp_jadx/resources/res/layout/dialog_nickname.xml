<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/card_nickname"
    android:paddingBottom="0dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/_20sdp"
        android:textColor="@color/sb_black"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/set_nickname"
        android:tag="@string/nickname_set_cms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_16sdp"
        android:layout_marginRight="@dimen/_16sdp"
        android:text="Set Nickname"
        style="@style/TextPrimaryRegular"/>
    <TextView
        android:textColor="@color/sb_black"
        android:layout_gravity="center"
        android:id="@+id/note"
        android:tag="@string/nickname_note_cms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_12sdp"
        android:layout_marginRight="@dimen/_16sdp"
        android:text="Give yourself a cool nickname to start chatting."
        style="@style/TextSecondaryRegular"/>
    <TextView
        android:textSize="@dimen/_8sdp"
        android:textColor="@color/sb_black"
        android:gravity="right"
        android:id="@+id/nickname_count"
        android:paddingTop="@dimen/_2sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:layout_marginRight="@dimen/_16sdp"
        android:text="0/15"
        style="@style/TextSecondaryBold"/>
    <com.google.android.material.textfield.TextInputEditText
        android:textSize="@dimen/_12ssp"
        android:textStyle="bold"
        android:textColor="@color/fbg_coupon_text4_color"
        android:textColorHint="#d1cdc1"
        android:id="@+id/nick_name"
        android:tag="@string/enter_nickname_cms"
        android:background="@drawable/rounded_edittext"
        android:paddingLeft="@dimen/_8sdp"
        android:paddingRight="@dimen/_8sdp"
        android:descendantFocusability="beforeDescendants"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_30sdp"
        android:layout_marginLeft="@dimen/_16sdp"
        android:layout_marginRight="@dimen/_16sdp"
        android:hint="Enter Nickname"
        android:includeFontPadding="false"
        android:maxLength="15"
        android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz1234567890">
        <requestFocus/>
    </com.google.android.material.textfield.TextInputEditText>
    <TextView
        android:textSize="@dimen/_8ssp"
        android:textColor="@android:color/holo_red_dark"
        android:id="@+id/error_txt"
        android:tag="@string/nickname_error_cms"
        android:paddingTop="@dimen/_2sdp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_16sdp"
        android:layout_marginRight="@dimen/_16sdp"
        android:text="Nickname is required"
        android:includeFontPadding="false"
        android:layout_below="@+id/fbg_gift_item_partial_amount"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sdp"
        android:weightSum="2">
        <TextView
            android:textSize="@dimen/_13ssp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/cancel_button"
            android:tag="@string/cancel_chat_cms"
            android:background="@drawable/card_cancel"
            android:padding="@dimen/_6sdp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/_36sdp"
            android:text="@string/fbg_cancel_button_text"
            android:layout_weight="1"
            android:textAllCaps="true"
            style="@style/TextPrimaryBold"/>
        <TextView
            android:textSize="@dimen/_13ssp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/save_nickname"
            android:tag="@string/save_chat_cms"
            android:background="@drawable/card_save"
            android:padding="@dimen/_6sdp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/_36sdp"
            android:text="Save"
            android:layout_weight="1"
            android:textAllCaps="true"
            android:backgroundTint="#0f9737"
            style="@style/TextPrimaryBold"/>
    </LinearLayout>
</LinearLayout>
