<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:isScrollContainer="false">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bvn_verify_btn_rect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="#0f1115"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.Guideline
                android:orientation="horizontal"
                android:id="@+id/background_guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.5"/>
            <ImageView
                android:id="@+id/top_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/down_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
            <ImageView
                android:id="@+id/back_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="8dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_action_bar_back"/>
            <TextView
                android:textSize="16dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/info_btn"
                android:background="@drawable/bvn_verify_btn_rect"
                android:layout_width="52dp"
                android:layout_height="22dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="16dp"
                android:text="@string/common_functions__info"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/down_bg"
                app:layout_constraintTop_toTopOf="@+id/top_bg">
                <ImageView
                    android:id="@+id/light_image"
                    android:layout_width="wrap_content"
                    android:layout_height="350dp"
                    android:layout_marginBottom="60dp"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true"
                    app:layout_constraintBottom_toBottomOf="@+id/gift_image"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/gift_image"
                    android:layout_width="190dp"
                    android:layout_height="208dp"
                    android:scaleType="fitXY"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="36dp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/gift_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/component_bvn__verify_birthday_to_receive_gifts"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/gift_image"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/message"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:layout_constraintBottom_toTopOf="@+id/dob_picker_container"
                    app:layout_constraintLeft_toLeftOf="@+id/dob_picker_container"
                    app:layout_constraintRight_toRightOf="@+id/dob_picker_container"
                    app:layout_constraintTop_toBottomOf="@+id/gift_title"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/dob_picker_container"
                    android:background="@drawable/bvn_text_success_bg"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginLeft="35dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="35dp"
                    android:layout_marginBottom="12dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/message">
                    <TextView
                        android:textSize="14dp"
                        android:textStyle="bold"
                        android:textColor="#1b1e25"
                        android:gravity="center"
                        android:id="@+id/dob_title"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="17dp"
                        android:text="@string/page_withdraw__dob"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="14dp"
                        android:textStyle="bold"
                        android:textColor="#353a45"
                        android:gravity="center"
                        android:id="@+id/dob_tv"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="20dp"
                        android:maxLines="1"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/dob_title"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/dob_picker"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_marginRight="12dp"
                        android:tint="@color/text_type1_secondary"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/spr_arrow_gift_blue_down"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/bvn_edittext_container"
                    android:background="@drawable/bvn_text_success_bg"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginLeft="35dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="35dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/dob_picker_container">
                    <TextView
                        android:textSize="14dp"
                        android:textStyle="bold"
                        android:textColor="#1b1e25"
                        android:gravity="center"
                        android:id="@+id/bvn_title"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="17dp"
                        android:text="@string/page_withdraw__bvn"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.sporty.android.common_ui.widgets.BankVerifyNumberEditText
                        android:textSize="14dp"
                        android:textStyle="bold"
                        android:textColor="#353a45"
                        android:gravity="start|center_vertical"
                        android:id="@+id/bvn_edittext"
                        android:background="@android:color/transparent"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="20dp"
                        android:maxLines="1"
                        android:inputType="number"
                        android:imeOptions="actionDone"
                        app:layout_constraintEnd_toStartOf="@+id/bvn_edit_cleaner"
                        app:layout_constraintStart_toEndOf="@+id/bvn_title"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/bvn_edit_cleaner"
                        android:padding="5dp"
                        android:visibility="gone"
                        android:layout_width="27dp"
                        android:layout_height="27dp"
                        android:layout_marginRight="10dp"
                        android:tint="@color/text_type1_secondary"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_cancel_black_24dp"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#ffffff"
                    android:gravity="left"
                    android:id="@+id/bvn_message"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/component_bvn__please_enter_bvn_matches_phone_verify_dob"
                    app:layout_constraintLeft_toLeftOf="@+id/dob_picker_container"
                    app:layout_constraintRight_toRightOf="@+id/dob_picker_container"
                    app:layout_constraintTop_toBottomOf="@+id/bvn_edittext_container"/>
                <Button
                    android:textColor="#ffffff"
                    android:id="@+id/verify_btn"
                    android:background="@drawable/bvn_unverify_btn_rect"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginLeft="35dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="35dp"
                    android:layout_marginBottom="20dp"
                    android:text="@string/component_bvn__verify_now"
                    android:textAllCaps="false"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/bvn_message"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
