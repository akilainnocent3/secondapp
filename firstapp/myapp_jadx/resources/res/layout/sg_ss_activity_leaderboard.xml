<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#ffffff"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/title_layout"
        android:layout_width="match_parent"
        android:layout_height="56sp"
        layout="@layout/sg_ss_layout_title"/>
    <RelativeLayout
        android:id="@+id/my_leader_board"
        android:background="#dde7f9"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="48sp"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/my_rank"
            android:background="@drawable/sg_coin_blue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16sp"
            android:text="1"
            android:shadowColor="#3affffff"
            android:shadowDy="2"
            android:layout_centerVertical="true"
            android:fontFamily="@font/roboto_medium"/>
        <ImageView
            android:id="@+id/my_country"
            android:layout_width="28sp"
            android:layout_height="20sp"
            android:layout_marginLeft="16sp"
            android:layout_marginRight="12sp"
            android:layout_toRightOf="@+id/my_rank"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="normal"
            android:textColor="#de000000"
            android:id="@+id/my_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10sp"
            android:text="name"
            android:lines="1"
            android:layout_toRightOf="@+id/my_country"
            android:layout_centerVertical="true"
            android:lineSpacingExtra="8sp"
            android:fontFamily="@font/roboto"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="normal"
            android:textColor="#de000000"
            android:gravity="right"
            android:id="@+id/my_score"
            android:layout_width="64sp"
            android:layout_height="wrap_content"
            android:layout_marginRight="16sp"
            android:text="100"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:lineSpacingExtra="8sp"
            android:fontFamily="@font/roboto"/>
    </RelativeLayout>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeToRefresh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/my_leader_board"
        android:layout_below="@+id/title_layout">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:scrollbars="vertical"
            android:fadingEdgeLength="10dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:requiresFadingEdge="vertical"/>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</RelativeLayout>
