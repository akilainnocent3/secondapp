<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/trans_grey_container"
    android:background="@color/warning_tertiary"
    android:paddingTop="13dp"
    android:paddingBottom="13dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingEnd="4dp"
    android:paddingVertical="13dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/trans_warn"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:tint="@color/text_type2_primary"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/spr_ic_error_black_24dp"
        app:tint="@color/warning_primary"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="@color/text_type1_tertiary"
        android:id="@+id/trans_grey_title"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@+id/trans_warn"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/text_type1_tertiary"
        android:gravity="center"
        android:id="@+id/trans_verify_btn"
        android:background="@drawable/spr_withdraw_grey_btn_bg"
        android:padding="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="52dp"
        android:minHeight="22dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/B2_M"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/text_type1_tertiary"
        android:id="@+id/trans_grey_details"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/trans_verify_btn"
        app:layout_constraintStart_toEndOf="@+id/trans_warn"
        app:layout_constraintTop_toBottomOf="@+id/trans_grey_title"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/trans_compose_banner"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
