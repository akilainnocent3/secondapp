<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_container"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/translucent_background"
        android:background="@drawable/bg_iv_betslip_transition"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_betslip_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <android.widget.Space
            android:id="@+id/view_top_empty_area"
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="@dimen/iwqk_betslip_top_grey_area_mini_height_68_dp"
            app:layout_constraintBottom_toTopOf="@+id/layout_top_area"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_top_area"
            android:background="@color/custom_background_type2_secondary_type1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/view_top_empty_area">
            <ImageButton
                android:id="@+id/collapse_icon"
                android:background="?android:attr/selectableItemBackground"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingBottom="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/spr_arrow_down_white_32_32dp"/>
            <TextView
                android:textSize="12dp"
                android:textStyle="normal"
                android:textColor="@color/text_type2_primary"
                android:gravity="center"
                android:id="@+id/iwqk_remove_all"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginLeft="15dp"
                android:text="@string/component_betslip__remove_all"
                android:drawablePadding="4dp"
                app:drawableLeftCompat="@drawable/spr_trash"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/subtitle_layout"/>
            <TextView
                android:textSize="12dp"
                android:textStyle="normal"
                android:textColor="@color/text_type2_primary"
                android:gravity="center"
                android:id="@+id/bet_settings"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/component_betslip__bet_settings"
                android:drawablePadding="4dp"
                android:layout_marginEnd="15dp"
                app:drawableRightCompat="@drawable/ic_bet_settings"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/subtitle_layout"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/subtitle_layout"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="@color/text_type2_primary"
                    android:gravity="center"
                    android:id="@+id/bet_number"
                    android:background="@drawable/spr_bg_circle_sporty_40dp_green"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginLeft="15dp"
                    android:fontFamily="sans-serif"/>
                <TextView
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="@color/text_type2_primary"
                    android:gravity="center"
                    android:id="@+id/subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginLeft="8dp"
                    android:text="@string/common_functions__betslip"
                    android:fontFamily="sans-serif"/>
            </LinearLayout>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/highlight"
                android:gravity="end"
                android:id="@+id/tv_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="17dp"
                app:layout_constraintBottom_toBottomOf="@+id/subtitle_layout"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/subtitle_layout"/>
            <LinearLayout
                android:gravity="end|center_vertical"
                android:orientation="horizontal"
                android:id="@+id/guest_auth_layout"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="17dp"
                app:layout_constraintBottom_toBottomOf="@+id/subtitle_layout"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/subtitle_layout">
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/highlight"
                    android:id="@+id/tv_register"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/common_functions__register"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/highlight"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="|"
                    android:paddingHorizontal="6dp"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/highlight"
                    android:id="@+id/tv_login"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/common_functions__log_in"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/tab_layout"
                android:background="@color/custom_background_type2_secondary_type1"
                android:paddingLeft="4.5dp"
                android:paddingRight="4.5dp"
                android:layout_width="match_parent"
                android:layout_height="@dimen/iwqk_bet_slip_tab_layout_height_36_dp"
                android:layout_below="@+id/subtitle_layout"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iwqk_remove_all">
                <Button
                    android:textSize="14dp"
                    android:textStyle="bold"
                    android:textColor="@color/text_color_text_type2_secondary_with_text_type1_primary"
                    android:gravity="center"
                    android:id="@+id/single_tab"
                    android:background="@drawable/iwqk_betslip_type_selector"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/component_betslip__singles"
                    android:layout_weight="1"
                    android:textAllCaps="false"/>
                <Button
                    android:textSize="14dp"
                    android:textStyle="bold"
                    android:textColor="@color/text_color_text_type2_secondary_with_text_type1_primary"
                    android:gravity="center"
                    android:id="@+id/multiple_tab"
                    android:background="@drawable/iwqk_betslip_type_selector"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/component_betslip__multiple"
                    android:layout_weight="1"
                    android:textAllCaps="false"/>
                <Button
                    android:textSize="14dp"
                    android:textStyle="bold"
                    android:textColor="@color/text_color_text_type2_secondary_with_text_type1_primary"
                    android:gravity="center"
                    android:id="@+id/system_tab"
                    android:background="@drawable/iwqk_betslip_type_selector"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/component_betslip__system"
                    android:layout_weight="1"
                    android:textAllCaps="false"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.sporty.android.common_ui.widgets.NonSwipeableViewPager
            android:id="@+id/view_pager"
            android:background="@color/absolute_type1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layout_top_area"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
