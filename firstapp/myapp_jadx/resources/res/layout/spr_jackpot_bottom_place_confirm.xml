<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#353a45"
    android:layout_width="match_parent"
    android:layout_height="156dp">
    <TextView
        android:textSize="14sp"
        android:textStyle="normal"
        android:textColor="#ffffff"
        android:gravity="center_vertical"
        android:id="@+id/balance_name_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:text="@string/component_betslip__confirm_to_pay"
        android:layout_centerHorizontal="true"
        android:lineSpacingExtra="6sp"
        android:fontFamily="sans-serif-medium"/>
    <TextView
        android:textSize="20sp"
        android:textStyle="normal"
        android:textColor="#ffffff"
        android:gravity="end|center_vertical"
        android:id="@+id/jackpot_account_balance_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/app_common__zero"
        android:layout_below="@+id/balance_name_text"
        android:layout_centerHorizontal="true"
        android:lineSpacingExtra="0sp"
        android:fontFamily="sans-serif-medium"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="normal"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/jackpot_cancel"
        android:background="@drawable/spr_shape_jackpot_clear_item_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginBottom="10dp"
        android:minWidth="100dp"
        android:minHeight="48dp"
        android:text="@string/common_functions__cancel"
        android:layout_alignParentLeft="true"
        android:layout_alignParentBottom="true"
        android:fontFamily="sans-serif"
        android:layout_marginStart="16dp"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/jackpot_confirm"
        android:background="@drawable/bg_filled_brand_secondary_2_radius_with_brand_secondary_disable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="16dp"
        android:minHeight="48dp"
        android:text="@string/common_functions__confirm"
        android:layout_toRightOf="@+id/jackpot_cancel"
        android:layout_alignTop="@+id/jackpot_cancel"
        android:layout_alignParentRight="true"
        android:textAllCaps="false"
        android:fontFamily="sans-serif"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="10dp"
        android:layout_toEndOf="@+id/jackpot_cancel"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
