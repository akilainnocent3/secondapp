<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/background_type2_primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="14sp"
        android:textStyle="normal"
        android:textColor="@color/text_type2_secondary"
        android:gravity="center"
        android:id="@+id/sporty_type"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="9dp"
        android:minWidth="70dp"
        android:fontFamily="sans-serif"/>
    <com.sportybet.plugin.jackpot.widget.SpinnerTextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_type2_primary"
        android:gravity="center_vertical"
        android:id="@+id/result_spinner"
        android:background="@drawable/bg_filled_background_type2_secondary_2_radius_with_brand_secondary_stroke"
        android:paddingLeft="8dp"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="9dp"
        android:layout_marginRight="7dp"
        android:layout_toRightOf="@+id/sporty_type"
        android:layout_alignParentTop="true"
        android:lineSpacingExtra="2.8sp"
        android:fontFamily="sans-serif"
        android:paddingStart="8dp"/>
    <TextView
        android:textSize="10dp"
        android:textStyle="normal"
        android:textColor="@color/text_type2_secondary"
        android:gravity="center_vertical"
        android:id="@+id/result_tip_info"
        android:background="@color/brand_secondary_variable_type2"
        android:paddingLeft="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginLeft="3dp"
        android:drawablePadding="10dp"
        android:layout_below="@+id/result_spinner"
        android:fontFamily="sans-serif"
        app:drawableLeftCompat="@drawable/spr_info"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_type2_secondary"
        android:gravity="center_vertical"
        android:id="@+id/winnings_title"
        android:background="@color/background_type2_secondary"
        android:paddingLeft="14dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:text="@string/jackpot__winnings"
        android:layout_below="@+id/result_tip_info"
        android:fontFamily="sans-serif"
        android:paddingStart="14dp"/>
    <RelativeLayout
        android:id="@+id/winning_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/winnings_title">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/winnings_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="11dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/void_result_hint"
            android:background="@color/highlight"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="13dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_jackpot"
                app:tint="@color/custom_text_type1_primary_type5"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/custom_text_type1_tertiary_type3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/jackpot__no_more_than_one_event_hint"/>
        </LinearLayout>
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/results_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="50dp"
        android:layout_below="@+id/winning_content"/>
    <com.sportybet.plugin.jackpot.widget.LoadingView
        android:id="@+id/jackpot_results_loading"
        android:background="@color/background_type2_primary"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/result_spinner"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="normal"
        android:textColor="#9ca0ab"
        android:gravity="center"
        android:id="@+id/previous_no_data"
        android:background="@color/background_type2_primary"
        android:paddingLeft="40dp"
        android:paddingRight="40dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/common_feedback__no_data_available"
        android:layout_below="@+id/result_tip_info"
        android:fontFamily="sans-serif"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"/>
</RelativeLayout>
