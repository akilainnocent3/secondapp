<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="@dimen/_300sdp">
    <androidx.cardview.widget.CardView
        android:id="@+id/error_dialog_content"
        android:padding="@dimen/_8sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_16sdp"
        android:layout_marginRight="@dimen/_16sdp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="@dimen/_8sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="vertical"
            android:background="@color/white"
            android:paddingTop="@dimen/_20sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/_14ssp"
                android:textColor="@color/color_212121"
                android:gravity="center"
                android:id="@+id/error_message"
                android:tag="@string/err_login"
                android:paddingLeft="@dimen/_16sdp"
                android:paddingRight="@dimen/_16sdp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_20sdp"
                android:text="Error! Please login to start game."
                android:lineSpacingExtra="@dimen/_3sdp"
                android:textAlignment="center"
                android:paddingHorizontal="@dimen/_16sdp"
                style="@style/TextPrimaryMedium"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatButton
                    android:textSize="@dimen/_14ssp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/neg_button"
                    android:tag="@string/exit_btn_cms"
                    android:background="@color/color_2c2c2c"
                    android:padding="@dimen/_10sdp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_dialog_exit"
                    android:layout_weight="0.33"
                    android:textAllCaps="false"
                    android:textAlignment="center"
                    style="@style/TextPrimaryMedium"/>
                <androidx.appcompat.widget.AppCompatButton
                    android:textSize="@dimen/_14ssp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/pos_button"
                    android:tag="@string/login_btn_cms"
                    android:background="@color/try_again_color"
                    android:padding="@dimen/_10sdp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_dialog_login"
                    android:layout_weight="0.67"
                    android:textAllCaps="false"
                    android:textAlignment="center"
                    style="@style/TextPrimaryMedium"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.cardview.widget.CardView>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/error_dialog_close"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/white"
        app:fabSize="normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/error_dialog_content"
        app:layout_constraintVertical_bias="0.7"
        app:srcCompat="@drawable/close_icon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
