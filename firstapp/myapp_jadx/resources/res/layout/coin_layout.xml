<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/coin"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/gift_coin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.77"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.77"/>
    <FrameLayout
        android:id="@+id/coin_mask_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/coin"
        app:layout_constraintEnd_toEndOf="@+id/coin"
        app:layout_constraintStart_toStartOf="@+id/coin"
        app:layout_constraintTop_toTopOf="@+id/coin">
        <ImageView
            android:id="@+id/coin_mask"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/gift_coin"
            android:alpha="0"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
