<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.Guideline
                    android:orientation="vertical"
                    android:id="@+id/guideline_begin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintGuide_begin="16dp"/>
                <androidx.constraintlayout.widget.Guideline
                    android:orientation="vertical"
                    android:id="@+id/guideline_end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintGuide_end="16dp"/>
                <com.sportybet.android.widget.HintView
                    android:id="@+id/hint_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/compose_phone_channel_hint"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.constraintlayout.widget.Barrier
                    android:id="@+id/hint_bottom_barrier"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:barrierDirection="bottom"
                    app:constraint_referenced_ids="hint_view, compose_phone_channel_hint"/>
                <com.sporty.android.common_ui.widgets.IconTextSelectorButton
                    android:id="@+id/mobile_selector"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:icon="@drawable/ic_mobile_money"
                    app:iconTint="@color/text_type1_secondary"
                    app:layout_constraintEnd_toStartOf="@+id/guideline_end"
                    app:layout_constraintStart_toEndOf="@+id/guideline_begin"
                    app:layout_constraintTop_toBottomOf="@+id/hint_bottom_barrier"/>
                <com.sporty.android.common_ui.widgets.IconTextSelectorButton
                    android:id="@+id/channel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:icon="@drawable/icon_default"
                    app:layout_constraintEnd_toStartOf="@+id/guideline_end"
                    app:layout_constraintStart_toEndOf="@+id/guideline_begin"
                    app:layout_constraintTop_toBottomOf="@+id/mobile_selector"/>
                <TextView
                    android:textAppearance="@style/B2_R"
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/balance_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:minHeight="21dp"
                    android:layout_marginEnd="4dp"
                    app:layout_constraintEnd_toStartOf="@+id/balance"
                    app:layout_constraintTop_toBottomOf="@+id/channel"/>
                <TextView
                    android:textAppearance="@style/B2_R"
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/balance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="21dp"
                    app:layout_constraintBottom_toBottomOf="@+id/balance_label"
                    app:layout_constraintEnd_toStartOf="@+id/guideline_end"
                    app:layout_constraintTop_toTopOf="@+id/balance_label"/>
                <TextView
                    android:textSize="15dp"
                    android:textColor="#353a45"
                    android:id="@+id/bounty_title"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@+id/channel"
                    app:layout_constraintTop_toTopOf="@+id/balance_label"/>
                <com.sportybet.feature.payment.impl.deposit.presentation.widget.QuickInputItemListView
                    android:id="@+id/quick_input_item_list_view"
                    android:paddingBottom="10dp"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:layout_marginBottom="10dp"
                    app:layout_constraintEnd_toEndOf="@+id/channel"
                    app:layout_constraintStart_toStartOf="@+id/channel"
                    app:layout_constraintTop_toBottomOf="@+id/bounty_title"/>
                <androidx.constraintlayout.widget.Barrier
                    android:id="@+id/amount_top_barrier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:barrierDirection="bottom"
                    app:constraint_referenced_ids="balance_label, quick_input_item_list_view"/>
                <FrameLayout
                    android:id="@+id/amount_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:layout_constraintEnd_toStartOf="@+id/guideline_end"
                    app:layout_constraintStart_toEndOf="@+id/guideline_begin"
                    app:layout_constraintTop_toBottomOf="@+id/amount_top_barrier">
                    <com.sporty.android.common_ui.widgets.ClearEditText
                        android:textAppearance="@style/B1_R"
                        android:gravity="center"
                        android:id="@+id/amount"
                        android:background="@drawable/bg_outlined_line_type1_secondary_2_radius"
                        android:paddingLeft="110dp"
                        android:paddingRight="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:maxLines="1"
                        android:lineSpacingExtra="0sp"
                        android:inputType="numberDecimal"
                        android:imeOptions="actionDone"/>
                    <TextView
                        android:textSize="14dp"
                        android:textStyle="normal"
                        android:textColor="@color/text_type1_primary"
                        android:gravity="center_vertical"
                        android:id="@+id/amount_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:minHeight="48dp"
                        android:lineSpacingExtra="0sp"
                        android:fontFamily="sans-serif-medium"/>
                </FrameLayout>
                <TextView
                    android:textSize="10sp"
                    android:textStyle="normal"
                    android:textColor="@color/warning_primary"
                    android:id="@+id/amount_warning"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:minHeight="11dp"
                    android:fontFamily="sans-serif"
                    app:layout_constraintEnd_toEndOf="@+id/channel"
                    app:layout_constraintStart_toStartOf="@+id/channel"
                    app:layout_constraintTop_toBottomOf="@+id/amount_container"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/text_type1_secondary"
                    android:id="@+id/bounty_threshold_description"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:layout_constraintEnd_toEndOf="@+id/channel"
                    app:layout_constraintStart_toStartOf="@+id/channel"
                    app:layout_constraintTop_toBottomOf="@+id/amount_warning"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/bounty_details_layout"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="23dp"
                    app:layout_constraintEnd_toEndOf="@+id/channel"
                    app:layout_constraintStart_toStartOf="@+id/channel"
                    app:layout_constraintTop_toBottomOf="@+id/amount_warning">
                    <TextView
                        android:textSize="12dp"
                        android:textColor="@color/text_type1_secondary"
                        android:id="@+id/charges_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="@color/text_type1_primary"
                        android:id="@+id/charges_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/charges_label"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="@color/text_type1_secondary"
                        android:id="@+id/total_receive_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/charges_label"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="@color/text_type1_primary"
                        android:id="@+id/amount_details"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/total_receive_label"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.Barrier
                    android:id="@+id/next_top_barrier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:barrierDirection="bottom"
                    app:constraint_referenced_ids="bounty_threshold_description, bounty_details_layout"/>
                <com.sportybet.feature.payment.impl.deposit.presentation.widget.AmountQuickAddingButtonGroup
                    android:id="@+id/deposit_amount_quick_adding_buttons"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:layout_constraintEnd_toStartOf="@+id/guideline_end"
                    app:layout_constraintStart_toEndOf="@+id/guideline_begin"
                    app:layout_constraintTop_toBottomOf="@+id/next_top_barrier"/>
                <com.sportybet.android.widget.ProgressButton
                    android:textAppearance="@style/B1_M"
                    android:id="@+id/next"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/common_functions__top_up_now"
                    android:paddingVertical="12dp"
                    app:layout_constraintEnd_toStartOf="@+id/guideline_end"
                    app:layout_constraintStart_toEndOf="@+id/guideline_begin"
                    app:layout_constraintTop_toBottomOf="@+id/deposit_amount_quick_adding_buttons"/>
                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/deposit_banner_compose_view"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:layout_constraintEnd_toEndOf="@+id/next"
                    app:layout_constraintStart_toStartOf="@+id/next"
                    app:layout_constraintTop_toBottomOf="@+id/next"/>
                <com.sportybet.android.widget.SimpleDescriptionListView
                    android:orientation="vertical"
                    android:id="@+id/description_list_view"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="10dp"
                    app:layout_constraintEnd_toStartOf="@+id/guideline_end"
                    app:layout_constraintStart_toEndOf="@+id/guideline_begin"
                    app:layout_constraintTop_toBottomOf="@+id/deposit_banner_compose_view"/>
                <com.sportybet.android.widget.BubbleView
                    android:id="@+id/newFeatureAlertView"
                    android:visibility="gone"
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-12dp"
                    app:closable="true"
                    app:descriptionText="@string/page_payment__setup_multiple_mobile_numbers_for_deposit_tip"
                    app:layout_constraintEnd_toStartOf="@+id/guideline_end"
                    app:layout_constraintTop_toBottomOf="@+id/mobile_selector"
                    app:title="@string/page_payment__add_a_new_mobile_number"
                    app:trianglePosition="top_right"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <FrameLayout
        android:id="@+id/anti_interaction_mask"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.sporty.android.common_ui.widgets.LoadingViewNew
        android:id="@+id/loading_mask"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/init_mask"
        android:background="@color/background_general_primary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.sporty.android.common_ui.widgets.LoadingViewNew
        android:id="@+id/init_failed_mask"
        android:background="@color/background_general_primary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
