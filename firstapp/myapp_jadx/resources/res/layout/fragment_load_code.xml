<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_general_primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/load_code_panel"
                android:background="@color/background_type1_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/booking_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="20dp"
                    android:text="@string/component_betslip__please_insert_booking_code"
                    android:fontFamily="sans-serif"
                    android:layout_marginStart="20dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/booking_title_info"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginLeft="9dp"
                    android:layout_marginTop="2dp"
                    app:layout_constraintBottom_toBottomOf="@+id/booking_title"
                    app:layout_constraintLeft_toRightOf="@+id/booking_title"
                    app:layout_constraintTop_toTopOf="@+id/booking_title"
                    app:srcCompat="@drawable/ic_info_vector"
                    app:tint="@color/text_type1_primary"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/booking_container"
                    android:background="@drawable/bg_booking_code_panel_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginHorizontal="20dp"
                    app:layout_constraintTop_toBottomOf="@+id/booking_title">
                    <com.sportybet.plugin.realsports.widget.ClearEditText
                        android:textColor="@color/text_type1_primary"
                        android:textColorHint="@color/text_disable_type1_primary"
                        android:ellipsize="end"
                        android:id="@+id/booking_edit_text"
                        android:background="@android:color/transparent"
                        android:paddingLeft="12dp"
                        android:paddingRight="7dp"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:hint="@string/common_functions__booking_code"
                        android:singleLine="true"
                        android:drawablePadding="7dp"
                        android:imeOptions="actionDone"
                        android:paddingStart="12dp"
                        android:paddingEnd="7dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toLeftOf="@+id/booking_loading_btn"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/B1_M"/>
                    <com.sportybet.android.widget.ProgressButton
                        android:id="@+id/booking_loading_btn"
                        android:background="@drawable/bg_progress_button_no_radius"
                        android:layout_width="80dp"
                        android:layout_height="44dp"
                        android:layout_marginTop="1dp"
                        android:layout_marginRight="1dp"
                        android:layout_marginBottom="1dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:textSize="10dp"
                    android:textStyle="normal"
                    android:textColor="@color/warning_primary"
                    android:gravity="start|center_vertical"
                    android:id="@+id/booking_error_text"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:minHeight="20dp"
                    android:text="@string/page_load_code__load_bundle_error"
                    android:maxLines="2"
                    android:layout_below="@+id/booking_container"
                    android:layout_alignLeft="@+id/booking_container"
                    android:layout_alignRight="@+id/booking_container"
                    android:lineSpacingExtra="0dp"
                    android:fontFamily="sans-serif"
                    android:layout_alignStart="@+id/booking_container"
                    android:layout_alignEnd="@+id/booking_container"
                    android:paddingHorizontal="5dp"
                    app:layout_constraintLeft_toLeftOf="@+id/booking_container"
                    app:layout_constraintTop_toBottomOf="@+id/booking_container"/>
                <TextView
                    android:textSize="12dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/load_tip_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/page_load_code__odds_or_availabilities_may_change"
                    android:layout_marginHorizontal="16dp"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/booking_error_text"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/description_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/load_code_panel">
                <TextView
                    android:textSize="18dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/line01"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginRight="16dp"
                    android:text="@string/page_load_code__how_to_get_a_booking_code"
                    android:layout_marginHorizontal="16dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/line02"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:text="@string/common_functions__step1"
                    app:layout_constraintLeft_toLeftOf="@+id/line01"
                    app:layout_constraintRight_toRightOf="@+id/line01"
                    app:layout_constraintTop_toBottomOf="@+id/line01"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/line022"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/page_load_code__go_to_our_website_mobile_web_app"
                    android:layout_below="@+id/line01"
                    app:layout_constraintLeft_toLeftOf="@+id/line01"
                    app:layout_constraintRight_toRightOf="@+id/line01"
                    app:layout_constraintTop_toBottomOf="@+id/line02"/>
                <TextView
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/line03"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/common_functions__step2"
                    app:layout_constraintLeft_toLeftOf="@+id/line01"
                    app:layout_constraintRight_toRightOf="@+id/line01"
                    app:layout_constraintTop_toBottomOf="@+id/line022"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/line33"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/page_load_code__make_the_selections_you_want_to_bet_on"
                    app:layout_constraintLeft_toLeftOf="@+id/line01"
                    app:layout_constraintRight_toRightOf="@+id/line01"
                    app:layout_constraintTop_toBottomOf="@+id/line03"/>
                <TextView
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/line04"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/common_functions__step3"
                    app:layout_constraintLeft_toLeftOf="@+id/line01"
                    app:layout_constraintRight_toRightOf="@+id/line01"
                    app:layout_constraintTop_toBottomOf="@+id/line33"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/line042"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/page_load_code__click_on_the_book_bet_button_on_web_website_mobile_web_app"
                    app:layout_constraintLeft_toLeftOf="@+id/line01"
                    app:layout_constraintRight_toRightOf="@+id/line01"
                    app:layout_constraintTop_toBottomOf="@+id/line04"/>
                <ImageView
                    android:id="@+id/load_code_instruct"
                    android:layout_width="164dp"
                    android:layout_height="164dp"
                    android:layout_marginTop="30dp"
                    android:src="@drawable/spr_instruct"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/line042"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/description_view_int"
                android:paddingTop="17dp"
                android:paddingBottom="17dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="17dp"
                app:layout_constraintTop_toBottomOf="@+id/load_code_panel">
                <TextView
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/txt_label_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginHorizontal="16dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/B1_R"/>
                <TextView
                    android:textStyle="bold"
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/txt_label_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintLeft_toLeftOf="@+id/txt_label_1"
                    app:layout_constraintRight_toRightOf="@+id/txt_label_1"
                    app:layout_constraintTop_toBottomOf="@+id/txt_label_1"
                    style="@style/B1_R"/>
                <TextView
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/txt_number_1"
                    android:paddingRight="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1."
                    app:layout_constraintLeft_toLeftOf="@+id/txt_label_1"
                    app:layout_constraintTop_toTopOf="@+id/txt_label_3"
                    style="@style/B1_R"/>
                <TextView
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/txt_label_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:layout_constraintEnd_toEndOf="@+id/txt_label_1"
                    app:layout_constraintStart_toEndOf="@+id/txt_number_1"
                    app:layout_constraintTop_toBottomOf="@+id/txt_label_2"
                    style="@style/B1_R"/>
                <ImageView
                    android:id="@+id/img_int_1"
                    android:layout_width="182dp"
                    android:layout_height="119dp"
                    android:src="@drawable/spr_instruct"
                    app:layout_constraintLeft_toLeftOf="@+id/txt_label_3"
                    app:layout_constraintTop_toBottomOf="@+id/txt_label_3"/>
                <TextView
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/txt_number_2"
                    android:paddingRight="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2."
                    app:layout_constraintLeft_toLeftOf="@+id/txt_label_1"
                    app:layout_constraintTop_toTopOf="@+id/txt_label_4"
                    style="@style/B1_R"/>
                <TextView
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/txt_label_4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:layout_constraintEnd_toEndOf="@+id/txt_label_1"
                    app:layout_constraintStart_toEndOf="@+id/txt_number_2"
                    app:layout_constraintTop_toBottomOf="@+id/img_int_1"
                    style="@style/B1_R"/>
                <ImageView
                    android:id="@+id/img_int_2"
                    android:layout_width="182dp"
                    android:layout_height="119dp"
                    android:src="@drawable/spr_instruct"
                    app:layout_constraintLeft_toLeftOf="@+id/txt_label_4"
                    app:layout_constraintTop_toBottomOf="@+id/txt_label_4"/>
                <TextView
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/txt_number_3"
                    android:paddingRight="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3."
                    app:layout_constraintLeft_toLeftOf="@+id/txt_label_1"
                    app:layout_constraintTop_toTopOf="@+id/txt_label_5"
                    style="@style/B1_R"/>
                <TextView
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/txt_label_5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:layout_constraintEnd_toEndOf="@+id/txt_label_1"
                    app:layout_constraintStart_toEndOf="@+id/txt_number_3"
                    app:layout_constraintTop_toBottomOf="@+id/img_int_2"
                    style="@style/B1_R"/>
                <ImageView
                    android:id="@+id/img_int_3"
                    android:layout_width="182dp"
                    android:layout_height="119dp"
                    android:src="@drawable/spr_instruct"
                    app:layout_constraintLeft_toLeftOf="@+id/txt_label_5"
                    app:layout_constraintTop_toBottomOf="@+id/txt_label_5"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/txt_label_6"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="@+id/txt_label_1"
                    app:layout_constraintRight_toRightOf="@+id/txt_label_1"
                    app:layout_constraintTop_toBottomOf="@+id/img_int_3"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textColor="@color/text_type1_primary"
                android:id="@+id/txt_recent_code_label"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/page_load_code__last_loaded_code"
                android:layout_marginStart="16dp"
                app:layout_constraintTop_toBottomOf="@+id/load_code_panel"
                style="@style/B1_B"/>
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/recent_code_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/txt_recent_code_label"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <com.sporty.android.common_ui.widgets.LoadingViewNew
        android:id="@+id/loading_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
