<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/sh_header_bg"
    android:padding="8dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/backicon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="0x7f080122"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.08"/>
    <FrameLayout
        android:id="@+id/wallet_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="1dp"
        android:layout_marginStart="@dimen/_8sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.966"
        app:layout_constraintStart_toEndOf="@+id/backicon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.226">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/wallet_frame"
            android:background="@drawable/sh_card_amount"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="5dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_10ssp"
                android:textColor="@color/color_E4B321"
                android:ellipsize="end"
                android:id="@+id/amount"
                android:paddingLeft="@dimen/_6sdp"
                android:paddingRight="@dimen/_6sdp"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:maxLines="1"
                android:paddingHorizontal="@dimen/_6sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextPrimaryBold"/>
            <com.github.ybq.android.spinkit.SpinKitView
                android:id="@+id/loader"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_15sdp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                app:SpinKit_Color="@color/white"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/SpinKitStyle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_7ssp"
            android:textColor="@color/color_E4B321"
            android:layout_gravity="top|center_horizontal"
            android:id="@+id/currency_code"
            android:background="@color/sb_black_100"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NGN"
            android:includeFontPadding="false"
            style="@style/TextPrimaryBold"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/_10ssp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/wallet_add_money_button"
        android:tag="@string/addmoney_text_cms"
        android:background="@drawable/add_money_header_bg"
        android:paddingLeft="@dimen/_4sdp"
        android:paddingRight="@dimen/_4sdp"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="Add Money"
        android:lines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeMinTextSize="@dimen/_6sdp"
        android:paddingHorizontal="@dimen/_4sdp"
        android:autoSizeMaxTextSize="@dimen/_16sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.82"
        app:layout_constraintStart_toEndOf="@+id/backicon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.21"/>
    <ImageView
        android:id="@+id/main_title"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/chat"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/chat_icon"
        android:layout_marginEnd="@dimen/_13sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/navigation"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/navigation"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="0x7f080514"
        android:layout_marginEnd="@dimen/_2sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/circle"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/_6sdp"
        android:src="@drawable/circle_red"
        app:layout_constraintRight_toRightOf="@+id/navigation"
        app:layout_constraintTop_toTopOf="@+id/navigation"/>
</androidx.constraintlayout.widget.ConstraintLayout>
