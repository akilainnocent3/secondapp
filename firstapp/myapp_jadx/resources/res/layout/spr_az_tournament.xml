<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/title_container"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <com.sporty.android.common_ui.widgets.CommonTitleBar
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@color/brand_primary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageButton
            android:id="@+id/home"
            android:background="?android:attr/selectableItemBackground"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="16dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            app:srcCompat="@drawable/ic_home"
            app:tint="@android:color/white"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/az_tour_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/az_tour_swipe_refresh_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="16dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type2_tertiary"
                    android:gravity="start"
                    android:id="@+id/az_no_match"
                    android:paddingLeft="40dp"
                    android:paddingTop="160dp"
                    android:paddingRight="40dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/az_menu__no_data"
                    android:fontFamily="sans-serif"
                    android:paddingStart="40dp"
                    android:paddingEnd="40dp"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/az_tour_recycler_view"
                    android:scrollbars="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="68dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                <TextView
                    android:enabled="false"
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="@color/text_color_brand_tertiary"
                    android:gravity="center"
                    android:layout_gravity="bottom|center_horizontal"
                    android:id="@+id/az_tour_display_btn"
                    android:background="@drawable/bg_filled_brand_secondary"
                    android:padding="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/az_menu__display_btn"
                    android:textAllCaps="false"
                    android:fontFamily="sans-serif"/>
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </FrameLayout>
</LinearLayout>
