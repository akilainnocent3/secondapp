<?xml version="1.0" encoding="utf-8"?>
<com.sportygames.sportysoccer.widget.FullButtonLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/sg_btn_play"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16dp"
        android:textStyle="normal"
        android:textColor="@android:color/white"
        android:gravity="center_horizontal"
        android:id="@+id/ss_full_button_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:layout_centerInParent="true"
        android:lineSpacingExtra="2sp"/>
    <ImageView
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="2dp"
        android:src="@drawable/sg_arrow_circle_right"
        android:layout_toRightOf="@+id/ss_full_button_text"
        android:layout_centerVertical="true"/>
</com.sportygames.sportysoccer.widget.FullButtonLayout>
