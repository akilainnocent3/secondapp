<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:id="@+id/layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintHeight_default="percent"
                app:layout_constraintHeight_percent="0.91"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <nl.dionsegijn.konfetti.xml.KonfettiView
                    android:id="@+id/bottle_konfetti"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintHeight_default="percent"
                    app:layout_constraintHeight_percent="0.61"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <com.sportygames.commons.components.GameHeader
                        android:gravity="center"
                        android:id="@+id/game_header"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        app:game_title="Spin da&apos; Bottle"
                        app:layout_constraintHeight_default="percent"
                        app:layout_constraintHeight_percent="0.13"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_weight="1"/>
                    <com.sportygames.commons.components.GiftToast
                        android:id="@+id/gift_toast_bar"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:translationZ="999dp"
                        android:elevation="@dimen/_8sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <View
                        android:id="@+id/view_margin"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        app:layout_constraintHeight_percent="0.085"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.sportygames.commons.components.WalletText
                        android:gravity="center"
                        android:id="@+id/wallet_textView"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_marginLeft="@dimen/_16sdp"
                        app:currency="NG"
                        app:layout_constraintHeight_default="percent"
                        app:layout_constraintHeight_percent="0.18"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/view_margin"
                        app:layout_constraintVertical_weight="1.5"
                        style="@style/TextPrimaryBold"/>
                    <androidx.compose.ui.platform.ComposeView
                        android:id="@+id/games_campaign_progress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/_6sdp"
                        app:layout_constraintBottom_toBottomOf="@+id/wallet_textView"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/wallet_textView"
                        app:layout_constraintWidth_percent="0.375"
                        style="@style/TextPrimaryBold"/>
                    <View
                        android:id="@+id/view_margin2"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        app:layout_constraintHeight_percent="0.15"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/view_margin"/>
                    <TextView
                        android:textColor="@color/add_button_color"
                        android:gravity="bottom"
                        android:id="@+id/add_money"
                        android:tag="@string/addmoney_text_cms"
                        android:paddingRight="@dimen/_10ssp"
                        android:visibility="invisible"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginLeft="@dimen/_26sdp"
                        android:text="Add Money"
                        android:shadowColor="#000"
                        android:shadowDx="10"
                        android:shadowDy="10"
                        android:shadowRadius="10"
                        android:autoSizeTextType="uniform"
                        app:layout_constraintHeight_default="percent"
                        app:layout_constraintHeight_percent="0.05"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/view_margin2"
                        style="@style/TextPrimaryBold"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/table"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toTopOf="@+id/view_margin3"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHeight_percent="0.2"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/add_money"
                        app:layout_constraintVertical_weight="3">
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/table_image"
                            android:tag="@string/bg_board_cms"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:adjustViewBounds="true"
                            android:layout_centerInParent="true"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <View
                        android:id="@+id/view_margin3"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintHeight_percent="0"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cardlay"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginBottom="@dimen/_22sdp"
                        app:layout_constraintBottom_toBottomOf="@+id/table"
                        app:layout_constraintEnd_toEndOf="@+id/table"
                        app:layout_constraintHeight_default="percent"
                        app:layout_constraintHeight_percent="0.4"
                        app:layout_constraintStart_toStartOf="@+id/table"
                        app:layout_constraintTop_toTopOf="@+id/table"
                        app:layout_constraintWidth_percent="0.9">
                        <ImageView
                            android:id="@+id/dice2"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_centerVertical="true"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHeight_percent="0.4"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintWidth_percent="0.4"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_14ssp"
                        android:textColor="#59ffffff"
                        android:gravity="center_horizontal"
                        android:id="@+id/pay_text"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:maxHeight="20dp"
                        android:minHeight="14dp"
                        android:text="PAYS 2X"
                        android:lineSpacingExtra="0dp"
                        app:layout_constraintHeight_default="percent"
                        app:layout_constraintHeight_percent="0.1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/cardlay"
                        app:layout_constraintVertical_weight="1.5"
                        app:layout_constraintWidth_percent="1"
                        style="@style/TextPrimaryBold"/>
                    <ImageView
                        android:gravity="center_horizontal"
                        android:id="@+id/loose_text"
                        android:visibility="invisible"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:src="@drawable/spin_text"
                        android:maxHeight="16dp"
                        android:minHeight="14dp"
                        android:text="Loose if tripple appears"
                        android:lineSpacingExtra="0dp"
                        app:layout_constraintHeight_default="percent"
                        app:layout_constraintHeight_percent="0.055"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/pay_text"
                        app:layout_constraintVertical_weight="1"
                        app:layout_constraintWidth_percent="1"
                        style="@style/TextPrimaryBold"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintHeight_default="percent"
                    app:layout_constraintHeight_percent="0.39"
                    app:layout_constraintStart_toStartOf="parent">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_10sdp"
                        android:textColor="@color/error_red_clr"
                        android:gravity="bottom|center_horizontal"
                        android:id="@+id/error_text"
                        android:tag="@string/amount_higher_cms"
                        android:visibility="invisible"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginBottom="@dimen/_4sdp"
                        android:text="@string/bet_amount_exceed"
                        android:lineSpacingExtra="0dp"
                        app:layout_constraintBottom_toTopOf="@+id/bet_amountbox"
                        app:layout_constraintHeight_default="percent"
                        app:layout_constraintHeight_percent="0.15"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintVertical_weight="1"
                        app:layout_constraintWidth_percent="1"
                        style="@style/TextPrimaryBold"/>
                    <com.sportygames.commons.components.BetBoxContainer
                        android:gravity="center"
                        android:id="@+id/bet_amountbox"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintBottom_toTopOf="@+id/chip_slider"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHeight_percent="0.15"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintWidth_percent="0.7"/>
                    <com.sportygames.commons.components.ChipSlider
                        android:gravity="center"
                        android:id="@+id/chip_slider"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:maxHeight="@dimen/_80sdp"
                        app:layout_constraintBottom_toTopOf="@+id/betchip_container"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHeight_default="percent"
                        app:layout_constraintHeight_percent="0.36"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintWidth_percent="0.75"
                        app:seekbar_drawable="@drawable/bottle_seek_bar"/>
                    <com.sportygames.commons.components.BetChipContainer
                        android:id="@+id/betchip_container"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginBottom="@dimen/_4sdp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHeight_default="percent"
                        app:layout_constraintHeight_percent="0.35"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintVertical_weight="1"
                        app:layout_constraintWidth_percent="0.75"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/chip_overlay"
                        android:background="@color/sg_transparent"
                        android:focusable="true"
                        android:visibility="gone"
                        android:clickable="true"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHeight_default="percent"
                        app:layout_constraintHeight_percent="0.36"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintVertical_weight="1"
                        app:layout_constraintWidth_percent="0.75"/>
                    <com.sportygames.spindabottle.components.RoundResult
                        android:gravity="center"
                        android:id="@+id/eo_round_result"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHeight_default="percent"
                        app:layout_constraintHeight_percent="1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.75"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/uplay"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHeight_default="percent"
                app:layout_constraintHeight_percent="0.1"
                app:layout_constraintStart_toStartOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/select_up_btn"
                    android:background="@color/even_color"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/select_down_btn"
                    app:layout_constraintHeight_default="percent"
                    app:layout_constraintHeight_percent="0.8"
                    app:layout_constraintStart_toStartOf="parent">
                    <TextView
                        android:textSize="@dimen/_17ssp"
                        android:textColor="@color/white"
                        android:gravity="bottom|center_horizontal"
                        android:id="@+id/up"
                        android:tag="@string/up_cms"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:text="@string/up"
                        android:includeFontPadding="false"
                        android:autoSizeTextType="uniform"
                        android:autoSizeStepGranularity="@dimen/_1ssp"
                        android:autoSizeMinTextSize="@dimen/_12ssp"
                        android:autoSizeMaxTextSize="@dimen/_17ssp"
                        app:layout_constraintBottom_toTopOf="@+id/pay_up"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TextPrimaryBold"/>
                    <TextView
                        android:textSize="@dimen/_10ssp"
                        android:textColor="@color/white"
                        android:gravity="top|center_horizontal"
                        android:id="@+id/pay_up"
                        android:tag="@string/pay2x_cms"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:text="@string/pays_2x"
                        android:includeFontPadding="false"
                        android:autoSizeTextType="uniform"
                        android:autoSizeStepGranularity="@dimen/_1ssp"
                        android:autoSizeMinTextSize="@dimen/_6ssp"
                        android:autoSizeMaxTextSize="@dimen/_10ssp"
                        app:layout_constraintBottom_toTopOf="@+id/view1"
                        app:layout_constraintHeight_percent="0.233"
                        style="@style/TextPrimaryBold"/>
                    <View
                        android:id="@+id/view1"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintHeight_percent="0.186"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/select_down_btn"
                    android:background="@color/odd_color"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_default="percent"
                    app:layout_constraintHeight_percent="0.8"
                    app:layout_constraintStart_toEndOf="@+id/select_up_btn">
                    <TextView
                        android:textSize="@dimen/_17ssp"
                        android:textColor="@color/white"
                        android:gravity="bottom|center_horizontal"
                        android:id="@+id/down"
                        android:tag="@string/down_cms"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:text="@string/down"
                        android:includeFontPadding="false"
                        android:autoSizeTextType="uniform"
                        android:autoSizeStepGranularity="@dimen/_1ssp"
                        android:autoSizeMinTextSize="@dimen/_12ssp"
                        android:autoSizeMaxTextSize="@dimen/_17ssp"
                        app:layout_constraintBottom_toTopOf="@+id/pay_down"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TextPrimaryBold"/>
                    <TextView
                        android:textSize="@dimen/_10ssp"
                        android:textColor="@color/white"
                        android:gravity="top|center_horizontal"
                        android:id="@+id/pay_down"
                        android:tag="@string/pay2x_cms"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:text="@string/pays_2x"
                        android:includeFontPadding="false"
                        android:autoSizeTextType="uniform"
                        android:autoSizeStepGranularity="@dimen/_1ssp"
                        android:autoSizeMinTextSize="@dimen/_6ssp"
                        android:autoSizeMaxTextSize="@dimen/_10ssp"
                        app:layout_constraintBottom_toTopOf="@+id/view2"
                        app:layout_constraintHeight_percent="0.233"
                        style="@style/TextPrimaryBold"/>
                    <View
                        android:id="@+id/view2"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintHeight_percent="0.186"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/evenoddnew"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHeight_default="percent"
                app:layout_constraintHeight_percent="0.1"
                app:layout_constraintStart_toStartOf="parent">
                <TextView
                    android:textSize="@dimen/_16ssp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/rebet_btn"
                    android:tag="@string/rebet_btn_cms"
                    android:background="@color/rebet_bottle_color"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:text="@string/rebet"
                    android:textAllCaps="false"
                    android:autoSizeTextType="uniform"
                    android:autoSizeStepGranularity="@dimen/_1ssp"
                    android:autoSizeMinTextSize="@dimen/_12ssp"
                    android:autoSizeMaxTextSize="@dimen/_16ssp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/new_round_btn"
                    app:layout_constraintHeight_default="percent"
                    app:layout_constraintHeight_percent="0.8"
                    app:layout_constraintStart_toStartOf="parent"
                    style="@style/TextPrimaryMedium"/>
                <TextView
                    android:textSize="@dimen/_16ssp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/new_round_btn"
                    android:tag="@string/new_round_btn_cms"
                    android:background="@color/new_round_bottle_color"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:text="@string/new_round"
                    android:textAllCaps="false"
                    android:autoSizeTextType="uniform"
                    android:autoSizeStepGranularity="@dimen/_1ssp"
                    android:autoSizeMinTextSize="@dimen/_12ssp"
                    android:autoSizeMaxTextSize="@dimen/_16ssp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_default="percent"
                    app:layout_constraintHeight_percent="0.8"
                    app:layout_constraintStart_toEndOf="@+id/rebet_btn"
                    style="@style/TextPrimaryMedium"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.google.android.material.navigation.NavigationView
            android:layout_gravity="right"
            android:id="@+id/navigationView"
            android:visibility="visible"
            android:layout_width="@dimen/_200sdp"
            android:layout_height="match_parent">
            <com.sportygames.commons.components.SGHamburgerMenu
                android:id="@+id/hamburger_menu"
                android:background="@color/trans_black_color"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:outlineSpotShadowColor="@color/trans_black_color"
                android:outlineAmbientShadowColor="@color/trans_black_color"
                app:header_color="@color/spin_ham_menu_header_color"
                app:nav_color="@color/spin_ham_menu_bg_color"/>
        </com.google.android.material.navigation.NavigationView>
    </androidx.drawerlayout.widget.DrawerLayout>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/flContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.sportygames.commons.components.ProgressMeterComponent
        android:id="@+id/progress_meter_component"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/onboarding_images"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
