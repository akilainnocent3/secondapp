<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="@color/background_general_primary"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="35dp"
        android:layout_marginRight="35dp"
        android:layout_marginHorizontal="35dp">
        <LinearLayout
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/home_team_logo"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/iwqk_team_logo_base_colour"/>
            <TextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@color/text_type1_primary"
                android:gravity="right"
                android:id="@+id/home_team_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/iv_live_event_name_margin"
                android:minWidth="42dp"
                android:layout_marginStart="@dimen/iv_live_event_name_margin"/>
        </LinearLayout>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/iv_live_event_score_margin"
            android:layout_marginStart="@dimen/iv_live_event_score_margin">
            <TextView
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="@color/text_type1_primary"
                android:id="@+id/home_team_score_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="@color/text_type1_primary"
                android:id="@+id/home_team_score_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </RelativeLayout>
        <TextView
            android:textSize="20dp"
            android:textStyle="bold"
            android:textColor="@color/text_type1_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" - "/>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/iv_live_event_score_margin"
            android:layout_marginEnd="@dimen/iv_live_event_score_margin">
            <TextView
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="@color/text_type1_primary"
                android:id="@+id/away_team_score_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="@color/text_type1_primary"
                android:id="@+id/away_team_score_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@color/text_type1_primary"
                android:gravity="left"
                android:id="@+id/away_team_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="42dp"/>
            <ImageView
                android:id="@+id/away_team_logo"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginLeft="@dimen/iv_live_event_name_margin"
                android:src="@drawable/iwqk_team_logo_base_colour"
                android:layout_marginStart="@dimen/iv_live_event_name_margin"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/divider_line"
        android:background="@color/background_type1_primary"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="10dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/user_selected_mark"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginLeft="@dimen/iv_live_user_selected_mark_margin"
        android:src="@drawable/iwqk_live_score_soccer"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/iv_live_user_selected_mark_margin"
        android:layout_alignParentStart="true"/>
    <ImageView
        android:id="@+id/arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true"
        app:tint="@color/absolute_type2"/>
</RelativeLayout>
