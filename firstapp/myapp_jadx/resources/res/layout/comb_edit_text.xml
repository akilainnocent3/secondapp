<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp">
    <ImageView
        android:id="@+id/image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_credit_card_unify"
        app:tint="@color/text_type1_secondary"/>
    <TextView
        android:textSize="10sp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_secondary"
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="6dp"
        android:minHeight="12dp"
        android:lineSpacingExtra="4sp"
        android:fontFamily="sans-serif"
        app:layout_constraintLeft_toRightOf="@+id/image"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.sporty.android.common_ui.widgets.SecureEditText
        android:textSize="14sp"
        android:textStyle="bold"
        android:id="@+id/edit_text"
        android:background="@null"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="5dp"
        android:maxLines="1"
        android:singleLine="true"
        android:lineSpacingExtra="0sp"
        android:inputType="number"
        android:imeOptions="actionDone"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/label"
        app:layout_constraintRight_toLeftOf="@+id/card_name"
        app:layout_constraintTop_toBottomOf="@+id/label"
        app:layout_goneMarginLeft="12dp"
        app:layout_goneMarginTop="0dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/clear"
        android:padding="10dp"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginRight="5dp"
        android:tint="@color/text_type1_secondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/tooltip"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_cancel_black_24dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/tooltip"
        android:padding="10dp"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginRight="5dp"
        android:tint="@color/text_type1_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_pay_tooltip"/>
    <ImageView
        android:id="@+id/card_icon"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginRight="16dp"
        app:layout_constraintRight_toLeftOf="@+id/clear"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_primary"
        android:gravity="end"
        android:id="@+id/card_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        android:minHeight="14dp"
        android:fontFamily="sans-serif"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/card_icon"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
