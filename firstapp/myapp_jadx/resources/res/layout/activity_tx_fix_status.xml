<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/app_bar"
        android:background="?attr/colorTitleBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/back"
            android:background="?android:attr/selectableItemBackground"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_close_white_24dp"/>
    </RelativeLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/content_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textAppearance="@style/H1_B"
                android:textColor="@color/text_type1_primary"
                android:gravity="center_horizontal"
                android:id="@+id/title_text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="32dp"
                android:layout_marginTop="32dp"
                android:layout_marginRight="32dp"
                android:text="@string/page_transaction__how_to_fix_my_pending_transaction"
                android:layout_marginHorizontal="32dp"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.sporty.android.common_ui.widgets.ClearEditText
                android:textAppearance="@style/B1_M"
                android:id="@+id/transaction_no_edit_text"
                android:background="@drawable/bg_outlined_line_type1_secondary_2_radius"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginTop="32dp"
                android:hint="@string/page_transaction__enter_transaction_no"
                android:maxLines="1"
                android:drawablePadding="12dp"
                android:inputType="text"
                android:imeOptions="actionDone"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="10dp"
                android:paddingHorizontal="16dp"
                app:cancalDrawableSize="16dp"
                app:layout_constraintEnd_toStartOf="@+id/confirm_button"
                app:layout_constraintHorizontal_weight="0.64"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/title_text_view"/>
            <com.sportybet.android.widget.ProgressButton
                android:id="@+id/confirm_button"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:text="@string/common_functions__confirm"
                android:layout_marginEnd="32dp"
                android:paddingHorizontal="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/transaction_no_edit_text"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="0.36"
                app:layout_constraintStart_toEndOf="@+id/transaction_no_edit_text"
                app:layout_constraintTop_toTopOf="@+id/transaction_no_edit_text"
                app:loadingText=""/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/update_ussd_group"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="transaction_no_edit_text,confirm_button"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:paddingTop="24dp"
                android:paddingBottom="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingVertical="24dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintTop_toBottomOf="@+id/transaction_no_edit_text"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</LinearLayout>
