<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="@color/background_type2_primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/action_bar_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/action_bar_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/simple_action_bar"/>
    <com.sportybet.plugin.lgg.GiftGrabView
        android:id="@+id/gift_grab_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar_container"/>
    <com.sportybet.plugin.realsports.widget.banner.CustomSwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gift_grab_view">
        <com.donkingliang.consecutivescroller.ConsecutiveScrollerLayout
            android:id="@+id/nestedscrollview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            app:isPermanent="true">
            <RelativeLayout
                android:id="@+id/chat_scroll"
                android:background="@color/background_type2_primary"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="10dp"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="12dp"
                    android:textStyle="normal"
                    android:textColor="@color/absolute_type1"
                    android:gravity="center_vertical"
                    android:id="@+id/no_chat_hint"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="10dp"
                    android:text="@string/live__no_chat_hint"
                    android:layout_toLeftOf="@+id/right_chat_icon"
                    android:layout_alignParentLeft="true"
                    android:lineSpacingExtra="4sp"
                    android:fontFamily="sans-serif"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/delay_info_hint_container"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@+id/right_chat_icon"
                    android:paddingHorizontal="8dp">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_settlement_delay_hint"
                        app:tint="@color/text_type1_secondary"/>
                    <TextView
                        android:textColor="@color/text_type1_secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/live__this_match_may_take_up_tip"
                        android:layout_marginStart="4dp"
                        style="@style/C2_R"/>
                </LinearLayout>
                <TextView
                    android:textSize="12dp"
                    android:textStyle="normal"
                    android:textColor="@color/brand_secondary_variable_type3"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/right_chat_icon"
                    android:background="@drawable/spr_chat_green_rect"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginRight="12dp"
                    android:minWidth="70dp"
                    android:text="@string/common_functions__chat"
                    android:maxLines="1"
                    android:drawablePadding="2dp"
                    android:layout_alignParentRight="true"
                    android:fontFamily="sans-serif"/>
            </RelativeLayout>
            <include
                android:id="@+id/event_header_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_isSticky="true"
                layout="@layout/spr_live_event_header"/>
            <com.sportybet.plugin.realsports.event.widget.LiveEventControlsHeaderView
                android:id="@+id/event_header_controls_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_isSticky="true"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/expandable_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include
                    android:id="@+id/live_event_score_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    layout="@layout/spr_live_event_score"/>
                <com.sportybet.plugin.event.view.LiveEventVideoView
                    android:id="@+id/live_event_video_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/live_event_score_container"/>
                <com.sportybet.plugin.event.view.LiveEventMatchWebView
                    android:id="@+id/live_tracker_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="360dp"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.sportybet.plugin.event.view.LiveEventMatchWebView
                    android:id="@+id/live_stats_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="360dp"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.sportybet.plugin.event.view.LiveEventMatchWebView
                    android:id="@+id/live_games_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="360dp"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:id="@+id/hide_side_bg"
                    android:background="#353a45"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    app:layout_constraintTop_toBottomOf="@+id/live_tracker_view"/>
                <RelativeLayout
                    android:id="@+id/hide"
                    android:background="@drawable/spr_shape_hide"
                    android:visibility="gone"
                    android:layout_width="53dp"
                    android:layout_height="16dp"
                    android:layout_marginBottom="3dp"
                    android:layout_centerHorizontal="true"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/hide_side_bg">
                    <TextView
                        android:textSize="10dp"
                        android:textStyle="normal"
                        android:textColor="#dcdee5"
                        android:id="@+id/hide_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="4dp"
                        android:text="@string/common_functions__hide"
                        android:layout_alignParentLeft="true"
                        android:layout_alignParentTop="true"
                        android:textAllCaps="false"
                        android:fontFamily="sans-serif"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="4dp"
                        android:layout_alignParentStart="true"/>
                    <ImageView
                        android:id="@+id/image"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="6dp"
                        android:layout_toRightOf="@+id/hide_txt"
                        android:layout_marginEnd="6dp"
                        android:layout_toEndOf="@+id/hide_txt"
                        app:srcCompat="@drawable/spr_ic_arrow_drop_up_white_24dp"/>
                </RelativeLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/market_tab_container"
                android:background="@color/background_type2_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_isSticky="true">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/market_search_image_view"
                    android:background="?android:attr/selectableItemBackground"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="center"
                    app:srcCompat="@drawable/ic_market_search"
                    app:tint="@color/white"/>
                <View
                    android:layout_gravity="center_vertical"
                    android:background="@color/border_secondary"
                    android:layout_width="1dp"
                    android:layout_height="20dp"/>
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/market_group_tabs"
                    android:background="@color/background_type2_primary"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    app:tabBackground="@color/background_type2_primary"
                    app:tabIconTint="@color/white"
                    app:tabIndicatorColor="@color/brand_secondary"
                    app:tabMode="scrollable"
                    app:tabPaddingEnd="10dp"
                    app:tabPaddingStart="10dp"
                    app:tabSelectedTextColor="@color/white"
                    app:tabTextAppearance="@style/CustomTabAppearance"
                    app:tabTextColor="@color/white"/>
            </LinearLayout>
            <View
                android:id="@+id/divider"
                android:background="@color/border_secondary"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                app:layout_isSticky="true"/>
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/market_search_view"
                android:background="@color/background_type2_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_isSticky="true"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>
        </com.donkingliang.consecutivescroller.ConsecutiveScrollerLayout>
    </com.sportybet.plugin.realsports.widget.banner.CustomSwipeRefreshLayout>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.25"/>
    <View
        android:id="@+id/overlay_top"
        android:background="#80000000"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/fragment_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/overlay_bottom"
        android:background="#80000000"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar_container"/>
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guideline"/>
    <ImageView
        android:id="@+id/refresh_btn"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginLeft="30dp"
        android:layout_marginBottom="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:srcCompat="@drawable/spr_ic_refresh"/>
    <com.sportybet.android.widget.LoadingView
        android:id="@+id/loading_view"
        android:background="@color/background_type2_primary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gift_grab_view"
        app:loadingLayout="@layout/spr_loading_live_event"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/odds_filter_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
