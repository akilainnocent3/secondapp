<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:scrollbarStyle="outsideInset"
    android:background="@color/background_general_primary"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18dp"
            android:textStyle="bold"
            android:textColor="@color/text_type1_primary"
            android:gravity="start"
            android:id="@+id/flexible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/component_betslip__flexible"
            android:drawablePadding="3dp"
            app:drawableLeftCompat="@drawable/ic_flexible_active"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="@style/B2_R"
            android:textColor="@color/text_type1_primary"
            android:id="@+id/flexible_info_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/component_betslip__flex_intro_1_v2"
            app:layout_constraintEnd_toEndOf="@+id/flexible"
            app:layout_constraintStart_toStartOf="@+id/flexible"
            app:layout_constraintTop_toBottomOf="@+id/flexible"
            app:layout_goneMarginTop="0dp"/>
        <TextView
            android:textAppearance="@style/B2_R"
            android:textColor="@color/text_type1_primary"
            android:id="@+id/flexible_info_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/component_betslip__flex_intro_2_v2"
            app:layout_constraintEnd_toEndOf="@+id/flexible_info_1"
            app:layout_constraintStart_toStartOf="@+id/flexible_info_1"
            app:layout_constraintTop_toBottomOf="@+id/flexible_info_1"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/card_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="4dp"
            android:layout_marginHorizontal="4dp"
            app:cardBackgroundColor="@color/background_general_primary"
            app:cardCornerRadius="4dp"
            app:cardElevation="8dp"
            app:layout_constraintEnd_toEndOf="@+id/flexible_info_2"
            app:layout_constraintStart_toStartOf="@+id/flexible_info_2"
            app:layout_constraintTop_toBottomOf="@+id/flexible_info_2">
            <RelativeLayout
                android:id="@+id/flexibet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_below="@+id/sporty_insure">
                <TextView
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:textColor="@color/text_type1_primary"
                    android:ellipsize="end"
                    android:id="@+id/flexibet_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/component_betslip__options_to_be_correct"
                    android:layout_toLeftOf="@+id/arrow_down"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="sans-serif-medium"/>
                <com.sportybet.android.widget.ArrowButton
                    android:id="@+id/arrow_up"
                    android:background="@drawable/spr_arrow_background"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    app:upArrow="true"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="center"
                    android:id="@+id/flexibet_num"
                    android:layout_width="47dp"
                    android:layout_height="32dp"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="2dp"
                    android:singleLine="false"
                    android:layout_toLeftOf="@+id/arrow_up"
                    android:layout_alignParentTop="true"/>
                <com.sportybet.android.widget.ArrowButton
                    android:id="@+id/arrow_down"
                    android:background="@drawable/spr_arrow_background"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_toLeftOf="@+id/flexibet_num"
                    android:layout_alignParentTop="true"
                    android:layout_centerVertical="true"
                    app:upArrow="false"/>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
        <TextView
            android:textAppearance="@style/B2_R"
            android:textColor="@color/text_type1_primary"
            android:id="@+id/flexible_info_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/component_betslip__player_can_receive_ths_cashback"
            app:layout_constraintEnd_toEndOf="@+id/flexible_info_2"
            app:layout_constraintStart_toStartOf="@+id/flexible_info_2"
            app:layout_constraintTop_toBottomOf="@+id/card_view"/>
        <TextView
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="@color/text_type1_primary"
            android:id="@+id/flexible_rule_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/component_betslip__flexible_info_rule_1"
            app:layout_constraintStart_toStartOf="@+id/flexible_info_3"
            app:layout_constraintTop_toBottomOf="@+id/flexible_info_3"/>
        <LinearLayout
            android:gravity="end|center_vertical"
            android:id="@+id/ic_container_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/flexible_rule_1"
            app:layout_constraintEnd_toEndOf="@+id/flexible_info_3"
            app:layout_constraintLeft_toRightOf="@+id/flexible_rule_1"
            app:layout_constraintTop_toTopOf="@+id/flexible_rule_1">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                app:srcCompat="@drawable/ic_greed_dot"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                app:srcCompat="@drawable/ic_red_x"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                app:srcCompat="@drawable/ic_red_x"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                app:srcCompat="@drawable/ic_greed_dot"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="4dp"
                app:srcCompat="@drawable/ic_greed_dot"/>
        </LinearLayout>
        <TextView
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="@color/text_type1_primary"
            android:id="@+id/flexible_rule_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/component_betslip__flexible_info_rule_2"
            app:layout_constraintEnd_toEndOf="@+id/flexible_rule_1"
            app:layout_constraintStart_toStartOf="@+id/flexible_rule_1"
            app:layout_constraintTop_toBottomOf="@+id/flexible_rule_1"/>
        <LinearLayout
            android:gravity="end|center_vertical"
            android:id="@+id/ic_container_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/flexible_rule_2"
            app:layout_constraintEnd_toEndOf="@+id/flexible_info_3"
            app:layout_constraintLeft_toRightOf="@+id/flexible_rule_2"
            app:layout_constraintTop_toTopOf="@+id/flexible_rule_2">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                app:srcCompat="@drawable/ic_greed_dot"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                app:srcCompat="@drawable/ic_greed_dot"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                app:srcCompat="@drawable/ic_greed_dot"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                app:srcCompat="@drawable/ic_red_x"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="4dp"
                app:srcCompat="@drawable/ic_greed_dot"/>
        </LinearLayout>
        <TextView
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="@color/text_type1_primary"
            android:id="@+id/flexible_rule_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/component_betslip__flexible_info_rule_3"
            app:layout_constraintEnd_toEndOf="@+id/flexible_rule_2"
            app:layout_constraintStart_toStartOf="@+id/flexible_rule_2"
            app:layout_constraintTop_toBottomOf="@+id/flexible_rule_2"/>
        <LinearLayout
            android:gravity="end|center_vertical"
            android:id="@+id/ic_container_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/flexible_rule_3"
            app:layout_constraintEnd_toEndOf="@+id/flexible_info_3"
            app:layout_constraintLeft_toRightOf="@+id/flexible_rule_3"
            app:layout_constraintTop_toTopOf="@+id/flexible_rule_3">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                app:srcCompat="@drawable/ic_greed_dot"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                app:srcCompat="@drawable/ic_greed_dot"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                app:srcCompat="@drawable/ic_greed_dot"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                app:srcCompat="@drawable/ic_greed_dot"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="4dp"
                app:srcCompat="@drawable/ic_greed_dot"/>
        </LinearLayout>
        <TextView
            android:textSize="10dp"
            android:textColor="@color/text_type1_primary"
            android:id="@+id/tv_game_win"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/component_betslip__flex_intro_game_win"
            android:drawablePadding="4dp"
            android:layout_marginStart="8dp"
            app:drawableLeftCompat="@drawable/ic_greed_dot"
            app:layout_constraintStart_toStartOf="@+id/flexible_rule_3"
            app:layout_constraintTop_toBottomOf="@+id/flexible_rule_3"/>
        <TextView
            android:textSize="10dp"
            android:textColor="@color/text_type1_primary"
            android:id="@+id/tv_game_lost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/component_betslip__flex_intro_game_lost"
            android:drawablePadding="4dp"
            android:layout_marginStart="16dp"
            app:drawableLeftCompat="@drawable/ic_red_x"
            app:layout_constraintStart_toEndOf="@+id/tv_game_win"
            app:layout_constraintTop_toBottomOf="@+id/flexible_rule_3"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
