<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_type1_secondary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="center"
        android:id="@+id/sports_no_item_text"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:text="@string/wap_home__no_odds_available"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/sport_divider_line"
            android:background="@color/line_type1_primary"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_alignParentTop="true"/>
        <ImageView
            android:gravity="center_vertical"
            android:id="@+id/virtual_img"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_below="@+id/sport_divider_line"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"/>
        <ImageView
            android:gravity="center_vertical"
            android:id="@+id/simulate_img"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="-7dp"
            android:layout_marginTop="6dp"
            android:layout_toRightOf="@+id/virtual_img"
            android:layout_below="@+id/sport_divider_line"
            android:layout_toEndOf="@+id/virtual_img"/>
        <ImageView
            android:gravity="center_vertical"
            android:id="@+id/top_team_img"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="-7dp"
            android:layout_marginTop="6dp"
            android:src="@drawable/spr_sports_hot"
            android:layout_toRightOf="@+id/simulate_img"
            android:layout_below="@+id/sport_divider_line"
            android:layout_toEndOf="@+id/simulate_img"/>
        <ImageView
            android:gravity="center_vertical"
            android:id="@+id/odds_boost_img"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="-7dp"
            android:layout_marginTop="6dp"
            android:src="@drawable/spr_odds_boost"
            android:layout_toRightOf="@+id/top_team_img"
            android:layout_below="@+id/sport_divider_line"
            android:layout_toEndOf="@+id/top_team_img"/>
        <com.sportybet.plugin.realsports.event.LiveTimerTextView
            android:textSize="10dp"
            android:textStyle="normal"
            android:textColor="@color/custom_text_type1_primary_type1"
            android:gravity="center_vertical"
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_marginLeft="9dp"
            android:layout_marginTop="6dp"
            android:drawablePadding="8dp"
            android:layout_toRightOf="@+id/odds_boost_img"
            android:layout_below="@+id/sport_divider_line"
            android:lineSpacingExtra="6.8sp"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="10dp"
            android:textStyle="normal"
            android:textColor="@color/text_type1_secondary"
            android:gravity="center_vertical"
            android:id="@+id/id"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_marginLeft="8dp"
            android:layout_toRightOf="@+id/time"
            android:layout_alignTop="@+id/time"
            android:lineSpacingExtra="4.8sp"
            android:fontFamily="sans-serif"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@+id/time"/>
        <TextView
            android:textSize="10dp"
            android:textStyle="normal"
            android:textColor="@color/text_type1_secondary"
            android:gravity="center_vertical"
            android:id="@+id/category_tournament_name"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="10dp"
            android:singleLine="true"
            android:layout_toLeftOf="@+id/stats_img"
            android:layout_toRightOf="@+id/id"
            android:layout_alignTop="@+id/time"
            android:lineSpacingExtra="4.8sp"
            android:fontFamily="sans-serif"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="10dp"
            android:layout_toStartOf="@+id/stats_img"
            android:layout_toEndOf="@+id/id"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/stats_img"
            android:padding="2dp"
            android:visibility="gone"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="8dp"
            android:scaleType="fitCenter"
            android:layout_alignParentTop="true"
            android:layout_marginEnd="8dp"
            android:layout_alignParentEnd="true"
            app:srcCompat="@drawable/ic_codehub_statistic"
            app:tint="@color/text_type1_secondary"/>
        <View
            android:id="@+id/sports_spinner_bg"
            android:background="@color/custom_background_type1_primary_type2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"
            android:layout_marginBottom="-4dp"
            android:layout_alignLeft="@+id/sports_grid"
            android:layout_alignTop="@+id/sports_grid"
            android:layout_alignRight="@+id/sports_grid"
            android:layout_alignBottom="@+id/sports_grid"
            android:layout_marginStart="-4dp"
            android:layout_marginEnd="-4dp"
            android:elevation="2dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/sports_grid"
            android:layout_width="197dp"
            android:layout_height="34dp"
            android:layout_marginTop="7dp"
            android:layout_marginRight="10dp"
            android:layout_below="@+id/time"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"
            android:elevation="2dp">
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <com.sportybet.plugin.realsports.widget.OutcomeButton
                    android:textSize="14dp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:id="@+id/o1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="sans-serif"
                    style="@style/Widget.App.OutcomeButton.PreMatches"/>
                <com.sportybet.plugin.realsports.widget.ListenableSpinner
                    android:gravity="center"
                    android:id="@+id/sports_spinner"
                    android:background="@drawable/bg_fiilled_brand_secondary_3_radius"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:spinnerMode="dropdown"/>
            </FrameLayout>
            <com.sportybet.plugin.realsports.widget.OutcomeButton
                android:textSize="14dp"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/o2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="1dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:layout_marginStart="1dp"
                style="@style/Widget.App.OutcomeButton.PreMatches"/>
            <com.sportybet.plugin.realsports.widget.OutcomeButton
                android:textSize="14dp"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/o3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="1dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:layout_marginStart="1dp"
                style="@style/Widget.App.OutcomeButton.PreMatches"/>
            <com.sportybet.plugin.realsports.widget.OutcomeButton
                android:textSize="14dp"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/o4"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="1dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:layout_marginStart="1dp"
                style="@style/Widget.App.OutcomeButton.PreMatches"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/left_content"
            android:paddingLeft="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:layout_marginRight="2dp"
            android:layout_toLeftOf="@+id/sports_grid"
            android:layout_below="@+id/time"
            android:layout_toStartOf="@+id/sports_grid">
            <TextView
                android:textSize="12dp"
                android:textStyle="normal"
                android:textColor="@color/custom_text_type1_primary_type1"
                android:gravity="start|center_vertical"
                android:id="@+id/home_team"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:singleLine="true"
                android:lineSpacingExtra="4.8sp"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:textSize="12dp"
                android:textStyle="normal"
                android:textColor="@color/custom_text_type1_primary_type1"
                android:gravity="start|center_vertical"
                android:id="@+id/away_team"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:lineSpacingExtra="4.8sp"
                android:fontFamily="sans-serif-medium"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp">
                <TextView
                    android:textSize="10dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_secondary"
                    android:id="@+id/market_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginEnd="6dp"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/sporty_tv"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    app:srcCompat="@drawable/ic_sporty_tv"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/sporty_fm"
                    android:visibility="gone"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    app:srcCompat="@drawable/ic_sporty_fm"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/sporty_gift"
                    android:visibility="gone"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    app:srcCompat="@drawable/ic_sporty_gift"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="12dp"
            android:textStyle="normal"
            android:textColor="@color/text_type1_secondary"
            android:gravity="center_horizontal"
            android:id="@+id/comments_count"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="16dp"
            android:singleLine="true"
            android:layout_below="@+id/sports_grid"
            android:layout_alignParentRight="true"
            android:lineSpacingExtra="4.8sp"
            android:fontFamily="sans-serif"
            android:layout_marginEnd="16dp"
            android:layout_alignParentEnd="true"/>
        <include
            android:id="@+id/one_up_promo_tag"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="6dp"
            android:layout_below="@+id/comments_count"
            android:layout_alignParentRight="true"
            android:layout_marginEnd="10dp"
            android:layout_alignParentEnd="true"
            layout="@layout/view_one_up_promo_tag"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="normal"
            android:textColor="#2d333c"
            android:gravity="center"
            android:id="@+id/sports_view_all_text"
            android:background="@drawable/spr_view_all_selector"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="20dp"
            android:text="@string/common_functions__view_all"
            android:drawablePadding="10dp"
            android:layout_below="@+id/sports_grid"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</FrameLayout>
