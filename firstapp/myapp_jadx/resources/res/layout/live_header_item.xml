<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_type2_primary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/market_tab"
        android:layout_width="0dp"
        android:layout_height="44dp"
        app:layout_constraintEnd_toStartOf="@+id/market_option_divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tabIndicatorHeight="3dp"
        app:tabMode="scrollable"
        app:tabTextAppearance="@style/CustomTabAppearance"
        style="@style/Widget.App.TabLayout.Live"/>
    <View
        android:id="@+id/market_option_divider"
        android:background="@color/line_type1_secondary"
        android:visibility="gone"
        android:layout_width="1dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/market_tab"
        app:layout_constraintEnd_toStartOf="@+id/one_up_two_up_switch"
        app:layout_constraintStart_toEndOf="@+id/market_tab"
        app:layout_constraintTop_toTopOf="@+id/market_tab"/>
    <com.sportybet.android.widget.OneUpTwoUpSwitch
        android:layout_gravity="center_vertical"
        android:id="@+id/one_up_two_up_switch"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/market_tab"
        app:layout_constraintEnd_toStartOf="@+id/ou_early_goals_switch"
        app:layout_constraintStart_toEndOf="@+id/market_option_divider"
        app:layout_constraintTop_toTopOf="@+id/market_tab"/>
    <com.sportybet.android.widget.OUEarlyGoalsSwitch
        android:layout_gravity="center_vertical"
        android:id="@+id/ou_early_goals_switch"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/market_tab"
        app:layout_constraintEnd_toStartOf="@+id/quick_market_entrance"
        app:layout_constraintStart_toEndOf="@+id/one_up_two_up_switch"
        app:layout_constraintTop_toTopOf="@+id/market_tab"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/quick_market_entrance"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/market_tab"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/market_tab"
        app:srcCompat="@drawable/ic_quick_market"/>
    <androidx.appcompat.widget.AppCompatCheckBox
        android:textSize="12dp"
        android:textColor="@android:color/white"
        android:id="@+id/collapse_status"
        android:paddingLeft="10dp"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="@string/common_functions__collapse_all"
        android:paddingStart="10dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/market_tab"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/event_sorting_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/collapse_status"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/collapse_status"/>
    <include
        android:id="@+id/market_title"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        app:layout_constraintTop_toBottomOf="@+id/collapse_status"
        layout="@layout/spr_live_market_title"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/event_stream_types_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/market_title"/>
    <com.sportybet.android.widget.BubbleView
        android:id="@+id/market_option_feature_alert"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-10dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:closable="true"
        app:descriptionText="@string/component_betslip__early_goal_tip_desc"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/market_tab"
        app:title="@string/component_betslip__early_goal_tip_title"
        app:trianglePosition="top_right"/>
</androidx.constraintlayout.widget.ConstraintLayout>
