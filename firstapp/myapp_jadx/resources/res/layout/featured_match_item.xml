<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/custom_background_type1_quaternary_type1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginBottom="8dp"
    android:layout_marginEnd="8dp"
    android:elevation="2dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_sim"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="-7dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_hot"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="-7dp"
        app:layout_constraintStart_toEndOf="@+id/img_sim"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_best_odds"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="-7dp"
        app:layout_constraintStart_toEndOf="@+id/img_hot"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_live_boost"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="-7dp"
        app:layout_constraintStart_toEndOf="@+id/img_best_odds"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_sporty_tv"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toEndOf="@+id/img_live_boost"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_sporty_tv"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_sporty_fm"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toEndOf="@+id/img_sporty_tv"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_sporty_fm"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_sporty_gift"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toEndOf="@+id/img_sporty_fm"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_sporty_gift"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/bg_brand_sub_primary_d_lighter"
        android:ellipsize="end"
        android:id="@+id/league"
        android:paddingLeft="8dp"
        android:paddingTop="2dp"
        android:paddingRight="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingHorizontal="8dp"
        app:layout_constraintEnd_toStartOf="@+id/img_stats"
        app:layout_constraintStart_toEndOf="@+id/img_sporty_gift"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_stats"
        android:padding="2dp"
        android:visibility="gone"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:scaleType="fitCenter"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/league"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_codehub_statistic"
        app:tint="@color/spr_stats_icon_prematch"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/text_tertiary"
        android:gravity="center"
        android:id="@+id/live_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toTopOf="@+id/live_tag"
        app:layout_constraintEnd_toEndOf="@+id/live_time"
        app:layout_constraintStart_toStartOf="@+id/live_tag"/>
    <com.sportybet.plugin.realsports.event.LiveTimerTextView
        android:textSize="10dp"
        android:textColor="@color/text_secondary"
        android:gravity="center_vertical"
        android:id="@+id/live_time"
        android:background="@drawable/spr_gray_rect_bg"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:includeFontPadding="false"
        android:paddingHorizontal="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/live_tag"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/live_tag"
        app:layout_constraintTop_toTopOf="@+id/live_tag"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/text_inverse_tertiary"
        android:gravity="center"
        android:id="@+id/live_tag"
        android:background="@color/bg_brand_sub_quaternary"
        android:layout_width="wrap_content"
        android:layout_height="12dp"
        android:text="@string/common_functions__live"
        android:includeFontPadding="false"
        android:translationX="1dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/live_time"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.36"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_live"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="live_score, live_time, live_tag"/>
    <View
        android:id="@+id/divider"
        android:background="@color/absolute_type2"
        android:layout_width="1dp"
        android:layout_height="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.3"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="@color/absolute_type2"
        android:id="@+id/prematch_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/divider"
        app:layout_constraintEnd_toStartOf="@+id/divider"
        app:layout_constraintTop_toTopOf="@+id/divider"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/absolute_type2"
        android:id="@+id/prematch_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/divider"
        app:layout_constraintStart_toEndOf="@+id/divider"
        app:layout_constraintTop_toTopOf="@+id/divider"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_prematch"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="divider, prematch_time, prematch_date"/>
    <TextView
        android:textStyle="bold"
        android:textColor="@color/bg_brand_sub_primary_d_base"
        android:gravity="center"
        android:id="@+id/market_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="108dp"
        android:maxHeight="35dp"
        android:minHeight="30dp"
        android:drawablePadding="2dp"
        android:lineSpacingMultiplier="0.8"
        android:paddingStart="8dp"
        app:autoSizeMaxTextSize="12dp"
        app:autoSizeMinTextSize="9dp"
        app:autoSizeStepGranularity="1dp"
        app:autoSizeTextType="uniform"
        app:drawableEndCompat="@drawable/ic_info_filled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline_away"
        app:layout_constraintStart_toStartOf="@+id/guideline_home"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.55"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_team_home"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/team_home"
        app:layout_constraintStart_toStartOf="@+id/team_home"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.245"
        app:srcCompat="@drawable/ic_default_league_logo_home"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/text_secondary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/team_home"
        android:paddingLeft="4dp"
        android:paddingTop="1dp"
        android:paddingRight="4dp"
        android:paddingBottom="1dp"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:maxLines="2"
        android:lineSpacingMultiplier="0.8"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="1dp"
        android:paddingHorizontal="4dp"
        android:paddingVertical="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline_home"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.55"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_team_away"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/team_away"
        app:layout_constraintStart_toStartOf="@+id/team_away"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.245"
        app:srcCompat="@drawable/ic_default_league_logo_away"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/text_secondary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/team_away"
        android:paddingLeft="4dp"
        android:paddingTop="1dp"
        android:paddingRight="4dp"
        android:paddingBottom="1dp"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:maxLines="2"
        android:lineSpacingMultiplier="0.8"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="8dp"
        android:paddingHorizontal="4dp"
        android:paddingVertical="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline_away"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.55"/>
    <com.sportybet.plugin.realsports.widget.OutcomeView
        android:id="@+id/ov1"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="@dimen/feature_match_outcome_padding"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ov2"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Widget.App.OutcomeButton.FeaturedMatches"/>
    <com.sportybet.plugin.realsports.widget.OutcomeView
        android:id="@+id/ov2"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:layout_marginBottom="4dp"
        android:layout_marginHorizontal="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ov3"
        app:layout_constraintStart_toEndOf="@+id/ov1"
        style="@style/Widget.App.OutcomeButton.FeaturedMatches"/>
    <com.sportybet.plugin.realsports.widget.OutcomeView
        android:id="@+id/ov3"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="@dimen/feature_match_outcome_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ov2"
        style="@style/Widget.App.OutcomeButton.FeaturedMatches"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_home"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.34"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_away"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.66"/>
    <TextView
        android:textColor="@color/link_inverse_primary"
        android:gravity="end|center_vertical"
        android:id="@+id/see_details"
        android:background="@color/bg_surface_primary"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:text="@string/common_functions__see_details"
        android:drawablePadding="4dp"
        android:paddingEnd="4dp"
        app:drawableEndCompat="@drawable/ic_chevron_right"
        app:drawableTint="@color/link_inverse_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/B2_B"/>
</androidx.constraintlayout.widget.ConstraintLayout>
