<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/guideline_begin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_begin="16dp"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/guideline_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_end="16dp"/>
            <com.sportybet.android.widget.HintView
                android:id="@+id/mobile_money_top_hint_widget"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:layout_constraintEnd_toStartOf="@+id/guideline_end"
                app:layout_constraintStart_toEndOf="@+id/guideline_begin"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/mobile_money_deposit_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:layout_constraintEnd_toEndOf="@+id/guideline_end"
                app:layout_constraintStart_toStartOf="@+id/guideline_begin"
                app:layout_constraintTop_toBottomOf="@+id/mobile_money_top_hint_widget"/>
            <TextView
                android:textStyle="normal"
                android:textColor="@color/text_type1_primary"
                android:gravity="center"
                android:id="@+id/mobile_money_deposit_balance_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="10dp"
                app:layout_constraintEnd_toStartOf="@+id/mobile_money_deposit_balance"
                app:layout_constraintTop_toBottomOf="@+id/mobile_money_deposit_header"
                style="@style/B2_M"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="normal"
                android:textColor="@color/text_type1_primary"
                android:gravity="center"
                android:id="@+id/mobile_money_deposit_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="@+id/mobile_money_deposit_amount_container"
                app:layout_constraintTop_toTopOf="@+id/mobile_money_deposit_balance_label"
                style="@style/B2_M"/>
            <FrameLayout
                android:id="@+id/mobile_money_deposit_amount_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="@+id/guideline_end"
                app:layout_constraintStart_toStartOf="@+id/guideline_begin"
                app:layout_constraintTop_toBottomOf="@+id/mobile_money_deposit_balance_label">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="center_vertical"
                    android:id="@+id/mobile_money_deposit_amount_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:minHeight="48dp"
                    android:text="@string/common_functions__amount"
                    android:lineSpacingExtra="0sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="12dp"/>
                <com.sporty.android.common_ui.widgets.ClearEditText
                    android:textSize="14sp"
                    android:textStyle="normal"
                    android:textColor="@color/absolute_type2"
                    android:textColorHint="@color/text_type1_secondary"
                    android:gravity="center"
                    android:id="@+id/mobile_money_deposit_amount"
                    android:background="@drawable/comb_edit_text_bg"
                    android:paddingLeft="110dp"
                    android:paddingRight="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:maxLines="1"
                    android:maxLength="13"
                    android:drawablePadding="8dp"
                    android:lineSpacingExtra="0sp"
                    android:inputType="numberDecimal"
                    android:imeOptions="actionDone"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="110dp"
                    android:paddingEnd="12dp"
                    app:cancalDrawableSize="16dp"/>
            </FrameLayout>
            <TextView
                android:textSize="10dp"
                android:textStyle="normal"
                android:textColor="@color/warning_primary"
                android:id="@+id/mobile_money_deposit_amount_warning"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:minHeight="11dp"
                android:fontFamily="sans-serif"
                app:layout_constraintEnd_toEndOf="@+id/mobile_money_deposit_amount_container"
                app:layout_constraintStart_toStartOf="@+id/mobile_money_deposit_amount_container"
                app:layout_constraintTop_toBottomOf="@+id/mobile_money_deposit_amount_container"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_type1_primary"
                android:gravity="right"
                android:id="@+id/mobile_money_deposit_kyc_hint"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="21dp"
                android:layout_marginRight="16dp"
                android:minHeight="20dp"
                android:text="@string/page_payment__you_will_need_kyc_verification_for_this_deposit_to_credit"
                android:maxLines="2"
                app:layout_constraintEnd_toEndOf="@+id/mobile_money_deposit_amount_container"
                app:layout_constraintStart_toStartOf="@+id/mobile_money_deposit_amount_container"
                app:layout_constraintTop_toBottomOf="@+id/mobile_money_deposit_amount_warning"/>
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/mobile_money_deposit_quick_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/mobile_money_deposit_kyc_hint"/>
            <com.sportybet.android.widget.ProgressButton
                android:id="@+id/mobile_money_deposit_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minHeight="48dp"
                app:layout_constraintEnd_toEndOf="@+id/mobile_money_deposit_amount_container"
                app:layout_constraintStart_toStartOf="@+id/mobile_money_deposit_amount_container"
                app:layout_constraintTop_toBottomOf="@+id/mobile_money_deposit_quick_input"/>
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/deposit_banner_compose_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:layout_constraintEnd_toEndOf="@+id/mobile_money_deposit_button"
                app:layout_constraintStart_toStartOf="@+id/mobile_money_deposit_button"
                app:layout_constraintTop_toBottomOf="@+id/mobile_money_deposit_button"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/mobile_money_deposit_description_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                app:layout_constraintEnd_toEndOf="@+id/mobile_money_deposit_amount_container"
                app:layout_constraintStart_toStartOf="@+id/mobile_money_deposit_amount_container"
                app:layout_constraintTop_toBottomOf="@+id/deposit_banner_compose_view"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/placeholder_compose_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/dialogs_compose_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
