<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/background_type1_quaternary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/brand_quaternary"
        android:gravity="start|center_vertical"
        android:id="@+id/results_title_name"
        android:paddingLeft="18dp"
        android:paddingRight="17dp"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:singleLine="true"
        android:fontFamily="sans-serif"
        android:paddingStart="18dp"
        android:paddingEnd="17dp"/>
    <View
        android:id="@+id/diver_line2"
        android:background="@color/line_type1_primary"
        android:paddingLeft="18dp"
        android:paddingRight="17dp"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/results_title_name"
        android:paddingStart="18dp"
        android:paddingEnd="17dp"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="normal"
        android:textColor="@color/text_type2_tertiary"
        android:gravity="start|center_vertical"
        android:id="@+id/results_no_data"
        android:paddingLeft="40dp"
        android:paddingRight="40dp"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_below="@+id/diver_line2"
        android:fontFamily="sans-serif"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"/>
</RelativeLayout>
