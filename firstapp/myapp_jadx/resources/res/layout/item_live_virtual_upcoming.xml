<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_type2_primary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_live_virtual"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/text_type1_secondary"
        android:id="@+id/txt_tournament"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/img_live_virtual"
        app:layout_constraintStart_toEndOf="@+id/img_live_virtual"
        app:layout_constraintTop_toTopOf="@+id/img_live_virtual"/>
    <ImageView
        android:id="@+id/img_stopwatch"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginTop="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_live_virtual"
        app:srcCompat="@drawable/ic_stopwatch"
        app:tint="@color/absolute_type1"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/absolute_type1"
        android:id="@+id/txt_time"
        android:background="@drawable/log_out_rounded_corner"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingHorizontal="4dp"
        app:layout_constraintEnd_toEndOf="@+id/img_stopwatch"
        app:layout_constraintStart_toStartOf="@+id/img_stopwatch"
        app:layout_constraintTop_toBottomOf="@+id/img_stopwatch"/>
    <ImageView
        android:id="@+id/img_home"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:src="@drawable/flag_gh"
        app:layout_constraintEnd_toStartOf="@+id/img_stopwatch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/img_stopwatch"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/absolute_type1"
        android:id="@+id/txt_home"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="@+id/img_home"
        app:layout_constraintStart_toStartOf="@+id/img_home"
        app:layout_constraintTop_toBottomOf="@+id/img_home"/>
    <ImageView
        android:id="@+id/img_away"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:src="@drawable/flag_ke"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/img_stopwatch"
        app:layout_constraintTop_toTopOf="@+id/img_stopwatch"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/absolute_type1"
        android:id="@+id/txt_away"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="@+id/img_away"
        app:layout_constraintStart_toStartOf="@+id/img_away"
        app:layout_constraintTop_toBottomOf="@+id/img_away"/>
    <View
        android:background="@color/cmn_pale_grey_two_15"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="10dp"
        android:layout_marginHorizontal="10dp"
        app:layout_constraintTop_toBottomOf="@+id/txt_home"/>
</androidx.constraintlayout.widget.ConstraintLayout>
