<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_general_primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.sportybet.android.instantwin.presentation.widget.ActionBar
        android:id="@+id/action_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/action_bar_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/league_tab_bar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar"
        layout="@layout/iwqk_layout_league_tab_bar"/>
    <TextView
        android:textAppearance="@style/H4_M"
        android:textColor="@color/white"
        android:id="@+id/ticket_details"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/component_betslip__sim_ticket_details"
        app:layout_constraintBottom_toBottomOf="@+id/league_tab_bar"
        app:layout_constraintEnd_toEndOf="@+id/league_tab_bar"
        app:layout_constraintStart_toStartOf="@+id/league_tab_bar"
        app:layout_constraintTop_toTopOf="@+id/league_tab_bar"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/show_off_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="show_off_layout,show_off_divider"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/show_off_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/league_tab_bar">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:src="@drawable/bg_iv_show_off_banner_start"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:src="@drawable/bg_iv_show_off_banner_end"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/show_off_coin"
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="@style/B1_B"
            android:textColor="@color/text_type1_tertiary"
            android:id="@+id/show_off_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/page_instant_virtual__show_off_banner_light_style_title"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="4dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/show_off_description"
            app:layout_constraintEnd_toStartOf="@+id/show_off_button"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/show_off_coin"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textAppearance="@style/B1_B"
            android:textColor="@color/brand_quinary"
            android:id="@+id/show_off_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/page_instant_virtual__show_off_banner_light_style_highlight"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="4dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/show_off_button"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/show_off_coin"
            app:layout_constraintTop_toBottomOf="@+id/show_off_title"/>
        <Button
            android:textAppearance="@style/B1_B"
            android:textColor="@color/background_type2_primary"
            android:id="@+id/show_off_button"
            android:background="@drawable/spr_yellow_btn_bg"
            android:paddingLeft="22dp"
            android:paddingTop="12dp"
            android:paddingRight="22dp"
            android:paddingBottom="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="102dp"
            android:minHeight="40dp"
            android:text="@string/page_instant_virtual__show_off"
            android:layout_marginEnd="12dp"
            android:paddingHorizontal="22dp"
            android:paddingVertical="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:loadingText=""
            style="@style/Widget.App.CommonButton"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/show_off_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:dividerColor="@color/line_type1_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/show_off_layout"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/bet_result_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/constraintlayout_bet_result_bottom_buttons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/show_off_divider"/>
    <FrameLayout
        android:id="@+id/fragment_container"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/bet_result_list"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bet_result_list"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintlayout_bet_result_bottom_buttons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textAppearance="@style/H4_M"
            android:textColor="@color/text_inverse_primary"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/textview_bet_result_left_button"
            android:background="@color/bg_inverse_secondary"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/page_instant_virtual__view_details"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/commonbutton_bet_result_right_button"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.sporty.android.common_ui.widgets.CommonButton
            android:gravity="center"
            android:id="@+id/commonbutton_bet_result_right_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/component_betslip__place_bet"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="2"
            app:layout_constraintStart_toEndOf="@+id/textview_bet_result_left_button"
            style="@style/Widget.App.CommonButton.NoRadius.Default.TwoLines"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
