<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textSize="14dp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_secondary"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/results_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/wap_search__failed"
        android:fontFamily="sans-serif"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/brand_secondary"
        android:gravity="center"
        android:id="@+id/results_retry"
        android:background="@drawable/spr_selector_reload_bg"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="30dp"
        android:text="@string/common_functions__reload"
        android:textAllCaps="false"
        android:fontFamily="sans-serif"/>
</merge>
