<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <android.widget.Space
        android:id="@+id/anchor"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
    <RelativeLayout
        android:id="@+id/title_root"
        android:background="@color/brand_primary"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/back_icon"
            android:background="?android:attr/selectableItemBackground"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_action_bar_back"/>
        <TextView
            android:textSize="20dp"
            android:textStyle="normal"
            android:textColor="@color/text_type2_primary"
            android:gravity="center_vertical"
            android:id="@+id/back_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/common_functions__results"
            android:singleLine="true"
            android:layout_toRightOf="@+id/back_icon"
            android:lineSpacingExtra="8sp"
            android:fontFamily="sans-serif-medium"
            android:layout_toEndOf="@+id/back_icon"/>
        <ImageButton
            android:gravity="center_vertical"
            android:id="@+id/search_icon"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginRight="8dp"
            android:layout_toLeftOf="@+id/home"
            android:layout_marginEnd="8dp"
            app:srcCompat="@drawable/ic_action_bar_search"/>
        <ImageButton
            android:id="@+id/home"
            android:background="?android:attr/selectableItemBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            app:srcCompat="@drawable/ic_home"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/previous_btn"
        android:background="@drawable/spr_selector_results_btn_bg"
        android:layout_width="80dp"
        android:layout_height="36dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="12dp"
        android:layout_below="@+id/title_root"/>
    <ImageView
        android:id="@+id/next_btn"
        android:background="@drawable/spr_selector_results_btn_bg"
        android:layout_width="80dp"
        android:layout_height="36dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="10dp"
        android:layout_below="@+id/title_root"
        android:layout_alignParentRight="true"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="normal"
        android:textColor="@color/brand_tertiary"
        android:gravity="center"
        android:id="@+id/date_selector"
        android:background="@drawable/spr_selector_results_btn_bg"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="4dp"
        android:layout_toLeftOf="@+id/next_btn"
        android:layout_toRightOf="@+id/previous_btn"
        android:layout_below="@+id/title_root"
        android:fontFamily="sans-serif-medium"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="@color/brand_quaternary"
        android:gravity="center"
        android:id="@+id/results_change_league"
        android:background="@color/background_type1_primary"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="9dp"
        android:text="@string/common_functions__change"
        android:maxLines="1"
        android:layout_below="@+id/previous_btn"
        android:layout_alignParentRight="true"
        android:lineSpacingExtra="4.8sp"
        android:fontFamily="sans-serif"
        android:paddingHorizontal="8dp"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/text_type1_primary"
        android:gravity="start"
        android:id="@+id/select_option_text"
        android:background="@color/background_type1_primary"
        android:padding="9dp"
        android:paddingLeft="9dp"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginLeft="9dp"
        android:layout_marginTop="10dp"
        android:text="@string/live_result__results_default_selected"
        android:singleLine="true"
        android:layout_toLeftOf="@+id/results_change_league"
        android:layout_below="@+id/previous_btn"
        android:layout_alignParentLeft="true"
        android:layout_marginStart="9dp"
        android:layout_toStartOf="@+id/results_change_league"
        android:layout_alignParentStart="true"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/results_search_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/select_option_text"/>
    <com.sportybet.plugin.realsports.results.ResultsLoadingView
        android:id="@+id/results_loading_view"
        android:background="@color/background_type1_secondary"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/select_option_text"/>
</RelativeLayout>
