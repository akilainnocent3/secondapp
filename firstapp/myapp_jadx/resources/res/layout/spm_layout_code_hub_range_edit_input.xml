<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <EditText
        android:textAppearance="@style/B1_M"
        android:textColor="@color/text_type1_primary"
        android:gravity="center_horizontal"
        android:id="@+id/etRangeBegin"
        android:background="@color/background_type1_tertiary"
        android:padding="4dp"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:hint="@null"
        android:selectAllOnFocus="true"
        android:inputType="number"
        android:imeOptions="actionDone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/B1_B"
        android:textColor="@color/text_type1_primary"
        android:id="@+id/tvTilde"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="~"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/etRangeEnd"
        app:layout_constraintStart_toEndOf="@+id/etRangeBegin"
        app:layout_constraintTop_toTopOf="parent"/>
    <EditText
        android:textAppearance="@style/B1_M"
        android:textColor="@color/text_type1_primary"
        android:gravity="center_horizontal"
        android:id="@+id/etRangeEnd"
        android:background="@color/background_type1_tertiary"
        android:padding="4dp"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:hint="@null"
        android:selectAllOnFocus="true"
        android:inputType="number"
        android:imeOptions="actionDone"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvTilde"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
