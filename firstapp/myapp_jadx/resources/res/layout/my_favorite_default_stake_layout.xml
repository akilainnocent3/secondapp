<?xml version="1.0" encoding="utf-8"?>
<com.sportybet.plugin.myfavorite.widget.DefaultStakeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/edit_container"
        android:background="@drawable/my_stake_bg"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="44dp"
        android:layout_marginRight="44dp">
        <TextView
            android:textAppearance="@style/B1_R"
            android:textColor="@color/text_disable_type1_primary"
            android:id="@+id/currency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_centerVertical="true"/>
        <EditText
            android:textAppearance="@style/B1_R"
            android:textColor="@color/text_type1_primary"
            android:gravity="end"
            android:id="@+id/input_stake"
            android:background="@android:color/transparent"
            android:longClickable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:maxLines="1"
            android:layout_toRightOf="@+id/currency"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <TextView
        android:textColor="@color/warning_primary"
        android:id="@+id/err_msg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="44dp"
        android:layout_marginRight="44dp"
        android:layout_marginHorizontal="44dp"/>
    <FrameLayout
        android:id="@+id/keyboard_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp">
        <com.sportybet.plugin.realsports.betslip.virtualkeyboard.KeyboardView
            android:id="@+id/custom_number_keyboard"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:upperSpaceVisible="false"/>
    </FrameLayout>
</com.sportybet.plugin.myfavorite.widget.DefaultStakeLayout>
