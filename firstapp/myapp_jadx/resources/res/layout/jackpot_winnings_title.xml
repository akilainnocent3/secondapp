<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@color/background_type2_primary"
    android:layout_width="match_parent"
    android:layout_height="62dp">
    <android.widget.Space
        android:id="@+id/left_anchor"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
    <android.widget.Space
        android:id="@+id/right_anchor"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/text_type2_secondary"
        android:gravity="center_vertical"
        android:id="@+id/result_title"
        android:background="@color/background_type2_secondary"
        android:paddingLeft="16dp"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:text="@string/jackpot__results"
        android:fontFamily="sans-serif"
        android:paddingStart="16dp"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="normal"
        android:textColor="@color/text_color_text_type2_tertiary_with_text_type1_primary"
        android:gravity="center_horizontal"
        android:id="@+id/date_match"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="10dp"
        android:text="@string/jackpot__correct_events"
        android:layout_below="@+id/result_title"
        android:fontFamily="sans-serif"
        android:layout_marginStart="32dp"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="normal"
        android:textColor="@color/text_color_text_type2_tertiary_with_text_type1_primary"
        android:gravity="center_horizontal"
        android:id="@+id/result_result"
        android:layout_width="40dp"
        android:layout_height="match_parent"
        android:layout_marginRight="24dp"
        android:text="@string/common_functions__result"
        android:layout_alignTop="@+id/date_match"
        android:layout_alignParentRight="true"
        android:fontFamily="sans-serif"
        android:layout_marginEnd="24dp"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="normal"
        android:textColor="@color/text_color_text_type2_tertiary_with_text_type1_primary"
        android:gravity="center_horizontal"
        android:id="@+id/result_score"
        android:layout_width="50dp"
        android:layout_height="match_parent"
        android:layout_marginRight="108dp"
        android:text="@string/bet_history__score"
        android:layout_alignTop="@+id/date_match"
        android:layout_alignParentRight="true"
        android:fontFamily="sans-serif"
        android:layout_marginEnd="108dp"
        android:layout_alignParentEnd="true"/>
    <View
        android:background="@color/background_type2_tertiary"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="10dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"/>
</RelativeLayout>
