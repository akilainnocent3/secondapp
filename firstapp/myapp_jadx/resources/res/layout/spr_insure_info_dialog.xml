<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:tabBackground="@color/transparent">
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tabBackground="@color/transparent"
        app:tabGravity="start"
        app:tabIndicatorHeight="0dp"
        app:tabMinWidth="0dp"
        app:tabMode="scrollable"
        app:tabPaddingEnd="0dp"
        app:tabPaddingStart="0dp"
        app:tabRippleColor="@null"/>
    <ImageView
        android:id="@+id/tab_left_arrow"
        android:background="@drawable/spr_betslip_type_selector"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_arrow_chevron_left"
        android:paddingVertical="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/tab_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="@color/icon_inverse_primary"/>
    <ImageView
        android:id="@+id/tab_right_arrow"
        android:background="@drawable/spr_betslip_type_selector"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="32dp"
        android:src="@drawable/ic__arrow_chevron_right"
        android:paddingVertical="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/tab_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/icon_inverse_primary"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="0dp"
        android:layout_height="310dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tab_layout"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/close"
        android:padding="10dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:layout_marginVertical="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewPager"
        app:srcCompat="@drawable/ic_close_white_24dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
