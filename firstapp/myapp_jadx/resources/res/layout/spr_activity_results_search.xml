<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/title_bar"
        android:background="@color/brand_primary"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <TextView
            android:textSize="12dp"
            android:textStyle="normal"
            android:textColor="#ffffff"
            android:gravity="center_vertical"
            android:id="@+id/results_cancel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="9dp"
            android:text="@string/common_functions__cancel"
            android:lineSpacingExtra="4.8sp"
            android:fontFamily="sans-serif"
            android:layout_marginStart="9dp"/>
        <com.sportybet.plugin.realsports.results.ResultsClearEditText
            android:textSize="@dimen/result_search_hint_text_size"
            android:textColor="@color/text_type1_primary"
            android:textColorHint="@color/text_type1_secondary"
            android:id="@+id/results_edit_text"
            android:background="@drawable/spr_shape_edit_bg"
            android:paddingLeft="11dp"
            android:paddingRight="7dp"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginLeft="56dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="60dp"
            android:layout_marginBottom="8dp"
            android:hint="@string/live_result__placeholder_enter_game_id"
            android:maxLines="1"
            android:drawablePadding="7dp"
            android:inputType="textNoSuggestions"
            android:imeOptions="actionDone"
            android:paddingStart="11dp"
            android:paddingEnd="7dp"
            android:layout_marginStart="56dp"
            android:layout_marginEnd="60dp"
            android:importantForAutofill="no"/>
        <ImageButton
            android:gravity="center_vertical"
            android:id="@+id/results_search_icon"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginRight="19dp"
            android:layout_alignParentRight="true"
            android:layout_marginEnd="19dp"
            android:layout_alignParentEnd="true"
            app:srcCompat="@drawable/ic_action_bar_search"/>
    </RelativeLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/title_bar">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/results_search_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="12dp"
            android:textStyle="normal"
            android:textColor="#e41827"
            android:gravity="center"
            android:id="@+id/results_hint_view"
            android:background="#fee9ed"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="3dp"
            android:lineSpacingExtra="0sp"
            android:fontFamily="sans-serif"/>
        <com.sportybet.plugin.realsports.results.ResultsLoadingView
            android:id="@+id/results_search_loading_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</RelativeLayout>
