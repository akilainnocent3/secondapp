<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/_11ssp"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/min_text"
        android:tag="@string/min_text_caps_cms"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="Min"
        app:layout_constraintBottom_toTopOf="@+id/min_amount"
        app:layout_constraintHeight_percent="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.13"
        style="@style/TextPrimaryMediumMin"/>
    <TextView
        android:textSize="@dimen/_11ssp"
        android:gravity="top|center_horizontal"
        android:id="@+id/min_amount"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="--"
        app:layout_constraintBottom_toBottomOf="@+id/rounded_bet_container_linear"
        app:layout_constraintHeight_percent="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.13"
        style="@style/TextPrimaryMediumMin"/>
    <TextView
        android:textSize="@dimen/_11ssp"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/max_text"
        android:tag="@string/max_text_caps_cms"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="Max"
        app:layout_constraintBottom_toTopOf="@+id/max_amount"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.5"
        app:layout_constraintWidth_percent="0.13"
        style="@style/TextPrimaryMediumMin"/>
    <TextView
        android:textSize="@dimen/_11ssp"
        android:gravity="top|center_horizontal"
        android:id="@+id/max_amount"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="--"
        app:layout_constraintBottom_toBottomOf="@+id/rounded_bet_container_linear"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.5"
        app:layout_constraintWidth_percent="0.13"
        style="@style/TextPrimaryMediumMin"/>
    <com.sportygames.commons.utils.CircularCardView
        android:id="@+id/rounded_bet_container_linear"
        android:background="#414141"
        android:clipChildren="false"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:backgroundTint="#414141"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.74"
        app:shapeAppearanceOverlay="@style/circle">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/_3sdp"
            android:layout_marginBottom="@dimen/_3sdp"
            android:layout_marginVertical="@dimen/_3sdp">
            <androidx.recyclerview.widget.RecyclerView
                android:orientation="horizontal"
                android:id="@+id/chip_list"
                android:background="@android:color/transparent"
                android:longClickable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:nestedScrollingEnabled="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.sportygames.commons.utils.CircularCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
