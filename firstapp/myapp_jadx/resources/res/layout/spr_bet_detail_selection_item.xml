<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_general_primary"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingEnd="16dp"
    android:paddingVertical="12dp">
    <View
        android:id="@+id/bet_detail_top_divider"
        android:background="@color/line_type1_primary"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/bet_detail_status_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/delayed_settle_icon"
        android:layout_width="12dp"
        android:layout_height="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/bet_detail_status_icon"
        app:layout_constraintEnd_toEndOf="@+id/bet_detail_status_icon"
        app:srcCompat="@drawable/ic_selection_status_delayed_settle"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="58dp"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="@color/custom_text_type2_primary_type2"
        android:gravity="center_horizontal"
        android:id="@+id/bet_detail_index"
        android:background="@drawable/spr_shape_red_circle_item_18_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif"
        android:backgroundTint="@color/text_type1_tertiary"
        app:layout_constraintLeft_toRightOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginLeft="8dp"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="@color/custom_brand_tertiary_type4"
        android:id="@+id/bet_detail_live"
        android:background="@color/custom_focus_type1"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="10dp"
        android:text="@string/component_betslip__live"
        android:fontFamily="sans-serif"
        android:paddingHorizontal="2dp"
        app:layout_constraintLeft_toRightOf="@+id/bet_detail_index"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/first_line_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="bet_detail_index,bet_detail_live"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_secondary"
        android:id="@+id/bet_detail_game_id_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:fontFamily="sans-serif"
        app:layout_constraintLeft_toRightOf="@+id/guideline"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/first_line_barrier"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_primary"
        android:id="@+id/bet_detail_match_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:fontFamily="sans-serif"
        app:layout_constraintLeft_toRightOf="@+id/guideline"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bet_detail_game_id_date"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_secondary"
        android:id="@+id/game_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="64dp"
        android:lineSpacingExtra="4dp"
        android:fontFamily="sans-serif"
        app:layout_constraintLeft_toRightOf="@+id/guideline"
        app:layout_constraintTop_toBottomOf="@+id/bet_detail_match_name"
        app:layout_goneMarginLeft="8dp"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/absolute_type2"
        android:ellipsize="end"
        android:id="@+id/bet_detail_game_score"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lines="1"
        android:fontFamily="sans-serif"
        android:layout_marginStart="10dp"
        app:layout_constraintLeft_toRightOf="@+id/game_label"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/game_label"
        app:layout_goneMarginLeft="8dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/bet_detail_selection_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/guideline"
        app:layout_constraintTop_toBottomOf="@+id/bet_detail_game_score"/>
</androidx.constraintlayout.widget.ConstraintLayout>
