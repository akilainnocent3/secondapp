<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.sportybet.android.widget.HintView
                    android:id="@+id/hint_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.sportybet.android.widget.HintView
                    android:id="@+id/secondary_hint_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginHorizontal="16dp"
                    app:layout_constraintTop_toBottomOf="@+id/hint_view"/>
                <com.sporty.android.common_ui.widgets.CombText
                    android:id="@+id/bank"
                    android:background="@drawable/bg_icon_text_selector_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="22dp"
                    android:layout_marginRight="16dp"
                    android:minHeight="48dp"
                    android:layout_marginHorizontal="16dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/secondary_hint_view"/>
                <TextView
                    android:textSize="10dp"
                    android:textStyle="normal"
                    android:textColor="@color/warning_primary"
                    android:id="@+id/bank_warning"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:minHeight="11dp"
                    android:text="@string/page_payment__invalid_card_number"
                    android:fontFamily="sans-serif"
                    app:layout_constraintLeft_toLeftOf="@+id/bank"
                    app:layout_constraintTop_toBottomOf="@+id/bank"/>
                <com.sporty.android.common_ui.widgets.CombEditText
                    android:id="@+id/account"
                    android:background="@drawable/bg_icon_text_selector_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:minHeight="48dp"
                    app:layout_constraintLeft_toLeftOf="@+id/bank"
                    app:layout_constraintRight_toRightOf="@+id/bank"
                    app:layout_constraintTop_toBottomOf="@+id/bank_warning"/>
                <TextView
                    android:textSize="10dp"
                    android:textStyle="normal"
                    android:textColor="#e63442"
                    android:id="@+id/account_warning"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:minHeight="11dp"
                    android:text="@string/page_withdraw__invalid_expiry_date"
                    android:fontFamily="sans-serif"
                    app:layout_constraintLeft_toLeftOf="@+id/account"
                    app:layout_constraintTop_toBottomOf="@+id/account"/>
                <FrameLayout
                    android:id="@+id/switch_container"
                    android:focusable="true"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:minWidth="150dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/account">
                    <TextView
                        android:textSize="14dp"
                        android:textStyle="normal"
                        android:textColor="@color/brand_secondary"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="14dp"
                        android:text="@string/page_payment__switch_bank_account"
                        android:fontFamily="sans-serif"/>
                </FrameLayout>
                <TextView
                    android:textSize="12dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="center"
                    android:id="@+id/balance_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:layout_marginRight="10dp"
                    android:minHeight="19dp"
                    android:fontFamily="sans-serif"
                    app:layout_constraintRight_toLeftOf="@+id/balance"
                    app:layout_constraintTop_toBottomOf="@+id/switch_container"/>
                <TextView
                    android:textSize="12dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="center"
                    android:id="@+id/balance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="19dp"
                    android:fontFamily="sans-serif"
                    app:layout_constraintRight_toRightOf="@+id/bank"
                    app:layout_constraintTop_toTopOf="@+id/balance_label"/>
                <FrameLayout
                    android:id="@+id/amount_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:layout_constraintLeft_toLeftOf="@+id/bank"
                    app:layout_constraintRight_toRightOf="@+id/bank"
                    app:layout_constraintTop_toBottomOf="@+id/balance_label">
                    <com.sporty.android.common_ui.widgets.ClearEditText
                        android:textAppearance="@style/B1_R"
                        android:gravity="center"
                        android:id="@+id/amount"
                        android:background="@drawable/bg_outlined_line_type1_secondary_2_radius"
                        android:paddingLeft="110dp"
                        android:paddingRight="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:maxLines="1"
                        android:drawablePadding="8dp"
                        android:lineSpacingExtra="0dp"
                        android:inputType="numberDecimal"
                        android:imeOptions="actionDone"
                        app:cancalDrawableSize="16dp"/>
                    <TextView
                        android:textSize="14dp"
                        android:textStyle="normal"
                        android:textColor="@color/text_type1_primary"
                        android:gravity="center_vertical"
                        android:id="@+id/amount_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:minHeight="48dp"
                        android:lineSpacingExtra="0dp"
                        android:fontFamily="sans-serif-medium"/>
                </FrameLayout>
                <TextView
                    android:textSize="10dp"
                    android:textStyle="normal"
                    android:textColor="#e63442"
                    android:id="@+id/amount_warning"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:minHeight="11dp"
                    android:fontFamily="sans-serif"
                    app:layout_constraintLeft_toLeftOf="@+id/bank"
                    app:layout_constraintRight_toRightOf="@+id/bank"
                    app:layout_constraintTop_toBottomOf="@+id/amount_container"/>
                <com.sportybet.android.widget.ProgressButton
                    android:id="@+id/next"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:text="@string/common_functions__top_up_now"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintLeft_toLeftOf="@+id/bank"
                    app:layout_constraintRight_toRightOf="@+id/bank"
                    app:layout_constraintTop_toBottomOf="@+id/amount_warning"/>
                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/deposit_banner_compose_view"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:layout_constraintEnd_toEndOf="@+id/next"
                    app:layout_constraintStart_toStartOf="@+id/next"
                    app:layout_constraintTop_toBottomOf="@+id/next"/>
                <com.sportybet.android.widget.SimpleDescriptionListView
                    android:id="@+id/description_list_view"
                    android:paddingBottom="16dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:layout_constraintLeft_toLeftOf="@+id/bank"
                    app:layout_constraintRight_toRightOf="@+id/bank"
                    app:layout_constraintTop_toBottomOf="@+id/deposit_banner_compose_view"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <FrameLayout
        android:id="@+id/anti_interaction_mask"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.sporty.android.common_ui.widgets.LoadingViewNew
        android:id="@+id/loading_mask"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/init_mask"
        android:background="@color/background_general_primary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.sporty.android.common_ui.widgets.LoadingViewNew
        android:id="@+id/init_failed_mask"
        android:background="@color/background_general_primary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
