<?xml version="1.0" encoding="utf-8"?>
<com.sportygames.sportysoccer.widget.HtmlTextLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="#008f00"
        android:id="@+id/index"
        android:layout_width="34sp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:text="1"
        android:layout_alignBaseline="@+id/text"
        android:lineSpacingExtra="4sp"
        android:fontFamily="@font/roboto"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="normal"
        android:textColor="#8b000000"
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sg_sporty_soccer_real_money_mode_definition_msg1"
        android:layout_toRightOf="@+id/index"
        android:lineSpacingExtra="6sp"
        android:fontFamily="@font/roboto"/>
</com.sportygames.sportysoccer.widget.HtmlTextLayout>
