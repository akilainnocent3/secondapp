<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/sb_black_100"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_34sdp"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/sg_fragment_lobby_toolbar"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/sg_banner_viewpager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_alignParentTop="true"
        android:overScrollMode="never"
        app:layout_constraintDimensionRatio="H,45:8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_layout"/>
    <com.sportygames.lobby.views.LobbyBannerPlaceHolder
        android:id="@+id/banner_shimmer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_alignParentTop="true"
        android:overScrollMode="never"
        app:background_color="@color/shimmer_black_light"
        app:layout_constraintDimensionRatio="H,45:8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_layout"/>
    <include
        android:id="@+id/sg_search_tooltip"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_minus48sdp"
        android:layout_alignTop="@+id/tab_relative"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/_8sdp"
        android:translationZ="999dp"
        app:layout_constraintBottom_toTopOf="@+id/tab_relative"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/sg_search_tooltip"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/notification_layout"
        android:background="@color/notification_color_dark"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_33sdp"
        app:layout_constraintTop_toBottomOf="@+id/sg_banner_viewpager">
        <ImageView
            android:id="@+id/not_image"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:src="@drawable/notification_dark"
            android:layout_marginStart="@dimen/_12sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/lobby_noti_bg"
            android:scaleType="fitXY"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.3"/>
        <com.sportygames.lobby.utils.VerticalViewPager
            android:id="@+id/notification_list"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/_8sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/not_image"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.sportygames.lobby.views.LobbyBannerPlaceHolder
        android:id="@+id/notification_shimmer"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_33sdp"
        app:background_color="@color/shimmer_black_dark"
        app:layout_constraintTop_toBottomOf="@+id/sg_banner_viewpager"/>
    <RelativeLayout
        android:id="@+id/tab_relative"
        android:paddingLeft="@dimen/_10sdp"
        android:paddingRight="@dimen/_10sdp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/notification_layout">
        <include
            android:id="@+id/sg_search_tab"
            android:layout_width="@dimen/_46sdp"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            layout="@layout/custom_lobby_tab_layout"/>
        <com.sportygames.sportyherov2.utils.FadingEdgeLayout
            android:id="@+id/fade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/sg_search_tab"
            app:fel_edge="left"
            app:fel_size_left="@dimen/_30sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/sg_tab_layout"
                android:background="@color/sb_black_100"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_60sdp"
                android:layout_toEndOf="@+id/sg_search_tab"
                app:layout_constraintHeight_default="percent"
                app:tabBackground="@color/sb_black_100"
                app:tabGravity="fill"
                app:tabIndicatorColor="@color/white"
                app:tabMaxWidth="0dp"
                app:tabMinWidth="@dimen/_50sdp"
                app:tabPaddingEnd="6dp"
                app:tabPaddingStart="0dp"
                app:tabSelectedTextColor="@android:color/background_light"
                app:tabTextAppearance="@style/CustomTextAppearanceTab"
                app:tabTextColor="@color/tab_color"/>
        </com.sportygames.sportyherov2.utils.FadingEdgeLayout>
        <View
            android:id="@+id/sg_view"
            android:background="@color/tab_view_color"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.4dp"
            android:layout_marginLeft="@dimen/_16ssp"
            android:layout_marginRight="@dimen/_16ssp"
            android:layout_marginBottom="@dimen/_7sdp"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lobby_category_shimmer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_9sdp"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        app:layout_constraintHeight_percent="0.1"
        app:layout_constraintTop_toBottomOf="@+id/notification_layout"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/sg_viewpager"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tab_relative"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lobby_list_shimmer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/_6sdp"
        android:layout_marginRight="@dimen/_6sdp"
        android:verticalSpacing="2dp"
        android:numColumns="2"
        android:layout_marginHorizontal="@dimen/_6sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tab_relative"/>
    <FrameLayout
        android:orientation="vertical"
        android:id="@+id/search_fragment"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@+id/notification_layout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/notification_layout"/>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_container_error"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_layout"
        style="@style/SwipeLayout">
        <include
            android:id="@+id/include_layout"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/swipe_container_error"
            android:layout_centerInParent="true"
            layout="@layout/sg_error_layout"/>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
