            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/flew_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="-4dp"
                app:layoutDescription="@xml/flew"
                app:layout_constraintBottom_toTopOf="@+id/coefficient"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <TextView
                    android:textSize="@dimen/_16sdp"
                    android:gravity="center"
                    android:id="@+id/flew_text"
                    android:tag="@string/flew_away_cms"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Flew Away"
                    android:textAllCaps="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    style="@style/TextPrimaryBold"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.cardview.widget.CardView
            android:id="@+id/ic_rain_timer"
            android:visibility="gone"
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:layout_marginStart="@dimen/_6sdp"
            app:cardBackgroundColor="@color/rain_bg_timer"
            app:cardCornerRadius="4dp"
            app:cardElevation="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_gravity="center"
                android:padding="1dp"
                android:layout_width="30dp"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_gravity="top|center_horizontal"
                    android:id="@+id/ic_cloud_next"
                    android:layout_width="30dp"
                    android:layout_height="27dp"
                    android:src="@drawable/ic_rain_cloud_timer_next"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/ic_cloud_active"
                    android:visibility="gone"
                    android:layout_width="30dp"
                    android:layout_height="27dp"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/ic_rain_cloud_timer_active"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="9sp"
                    android:textColor="@color/rain_dark_yellow_text"
                    android:layout_gravity="bottom|center_horizontal"
                    android:id="@+id/rain_timer"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    style="@style/TextPrimaryMedium"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
        <View
            android:id="@+id/view_bottom2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHeight_percent="0.32"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
