<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/_12sdp">
    <ImageView
        android:id="@+id/wave_1"
        android:layout_width="@dimen/_3sdp"
        android:layout_height="@dimen/_6sdp"
        android:src="@drawable/rush_loader"
        android:layout_marginStart="@dimen/_2sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/wave_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ImageView
        android:id="@+id/wave_2"
        android:layout_width="@dimen/_3sdp"
        android:layout_height="@dimen/_6sdp"
        android:src="@drawable/rush_loader"
        android:layout_marginStart="@dimen/_2sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/wave_3"
        app:layout_constraintStart_toEndOf="@+id/wave_1"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/wave_3"
        android:layout_width="@dimen/_3sdp"
        android:layout_height="@dimen/_6sdp"
        android:src="@drawable/rush_loader"
        android:layout_marginStart="@dimen/_2sdp"
        android:layout_marginEnd="@dimen/_2sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/wave_2"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
