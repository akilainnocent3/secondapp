<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/background_type2_secondary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14sp"
        android:textStyle="normal"
        android:textColor="@color/text_color_text_type2_primary"
        android:id="@+id/combination_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="10dp"
        android:text="@string/jackpot__combinations"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="16dp"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="normal"
        android:textColor="@color/text_color_text_type2_primary"
        android:gravity="end|center_vertical"
        android:id="@+id/jackpot_combination_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:text="@string/app_common__zero"
        android:layout_alignTop="@+id/combination_text"
        android:layout_alignParentRight="true"
        android:lineSpacingExtra="6sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginEnd="10dp"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="normal"
        android:textColor="@color/text_color_text_type2_primary"
        android:id="@+id/stake_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/bet_history__total_stake"
        android:layout_below="@+id/combination_text"
        android:layout_alignLeft="@+id/combination_text"
        android:fontFamily="sans-serif-medium"
        android:layout_alignStart="@+id/combination_text"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="normal"
        android:textColor="@color/text_color_text_type2_primary"
        android:gravity="end|center_vertical"
        android:id="@+id/jackpot_stake_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:layout_alignTop="@+id/stake_text"
        android:layout_alignParentRight="true"
        android:lineSpacingExtra="6sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginEnd="10dp"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="normal"
        android:textColor="@color/brand_quinary"
        android:gravity="center_vertical"
        android:id="@+id/gift_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:minHeight="26dp"
        android:text="@string/gift__l_gift"
        android:layout_below="@+id/stake_text"
        android:fontFamily="sans-serif-medium"
        android:layout_marginEnd="9dp"
        android:layout_alignParentEnd="true"/>
    <CheckBox
        android:id="@+id/gift_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:button="@drawable/ic_sporty_check_box"
        android:minHeight="16dp"
        android:drawablePadding="2dp"
        android:layout_alignTop="@+id/gift_textview"
        android:layout_alignBottom="@+id/gift_textview"
        android:paddingEnd="2dp"
        android:layout_marginEnd="4dp"
        android:layout_toStartOf="@+id/gift_textview"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="normal"
        android:textColor="@color/brand_secondary_variable_type3"
        android:gravity="center"
        android:id="@+id/jackpot_rush"
        android:background="@drawable/bg_outlined_brand_secondary_variable_type3_2_radius"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="18dp"
        android:layout_marginRight="16dp"
        android:text="@string/jackpot__jackpot_rush"
        android:layout_below="@+id/gift_textview"
        android:fontFamily="sans-serif-medium"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="normal"
        android:textColor="@color/text_type2_tertiary"
        android:gravity="center"
        android:id="@+id/jackpot_clear_btn"
        android:background="@drawable/bg_outlined_line_type2_primary_2_radius"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:minHeight="48dp"
        android:text="@string/jackpot__clear_all"
        android:layout_below="@+id/jackpot_rush"
        android:layout_alignParentLeft="true"
        android:fontFamily="sans-serif"
        android:layout_marginStart="16dp"
        android:layout_alignParentStart="true"/>
    <com.sportybet.android.widget.ProgressButton
        android:id="@+id/jackpot_place_btn"
        android:background="@drawable/bg_filled_brand_secondary_with_background_disable_type1_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="16dp"
        android:minHeight="48dp"
        android:layout_toRightOf="@+id/jackpot_clear_btn"
        android:layout_alignTop="@+id/jackpot_clear_btn"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        android:layout_toEndOf="@+id/jackpot_clear_btn"/>
    <View
        android:id="@+id/jackpot_disabled_overlay"
        android:background="@color/background_type2_secondary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/combination_text"
        android:layout_alignBottom="@+id/jackpot_place_btn"
        android:alpha="0.7"/>
</RelativeLayout>
