<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_general_primary"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="8dp"
    android:layout_marginRight="8dp">
    <TextView
        android:textSize="12dp"
        android:textColor="@color/text_type1_secondary"
        android:gravity="center_vertical"
        android:id="@+id/flex_one_cut_info"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:drawablePadding="4dp"
        android:fontFamily="sans-serif-medium"
        app:drawableLeftCompat="@drawable/ic_flexible_active"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/text_type1_tertiary"
        android:id="@+id/match"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_below="@+id/flex_one_cut_info"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/text_type1_primary"
        android:gravity="center_vertical"
        android:id="@+id/expand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:text="@string/bet_history__show_match_details"
        android:drawableRight="@drawable/spr_ic_arrow_drop_down_green_24dp"
        android:layout_below="@+id/match"
        android:layout_alignParentRight="true"
        android:drawableTint="@color/brand_secondary"/>
    <View
        android:id="@+id/divider_line"
        android:background="@color/line_type1_primary"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/expand"/>
</RelativeLayout>
