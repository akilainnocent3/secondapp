<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_type2_primary"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/stats"
        android:background="@drawable/spr_bg_tracker_btn"
        android:paddingLeft="10dp"
        android:paddingTop="3dp"
        android:paddingRight="10dp"
        android:paddingBottom="3dp"
        android:layout_width="46dp"
        android:layout_height="28dp"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:layout_alignParentEnd="true"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/spr_stats"
        app:tint="@color/event_state_color"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/match_tracker"
        android:background="@drawable/spr_bg_tracker_btn"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="46dp"
        android:layout_height="28dp"
        android:scaleType="center"
        android:layout_marginEnd="4dp"
        android:layout_toStartOf="@+id/stats"
        android:paddingHorizontal="10dp"
        app:layout_constraintEnd_toStartOf="@+id/stats"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/spr_ic_match_tracker_selector"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/games"
        android:background="@drawable/spr_bg_tracker_btn"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:visibility="gone"
        android:layout_width="46dp"
        android:layout_height="28dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/common_functions__games"
        android:layout_marginEnd="4dp"
        android:paddingHorizontal="10dp"
        app:layout_constraintEnd_toStartOf="@+id/streaming"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/tab_games_selector"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/streaming"
        android:background="@drawable/spr_bg_tracker_btn"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="46dp"
        android:layout_height="28dp"
        android:scaleType="center"
        android:layout_marginEnd="4dp"
        android:layout_toStartOf="@+id/match_tracker"
        android:paddingHorizontal="10dp"
        app:layout_constraintEnd_toStartOf="@+id/match_tracker"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/spr_ic_stv_selector"/>
    <com.sporty.android.sportyfm.ui.widget.RadioPlaybackMiniPanel
        android:id="@+id/radioPlaybackPanel"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_alignParentStart="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
