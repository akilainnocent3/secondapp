<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/trans_black_60"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintLeft_toLeftOf="parent"
    app:layout_constraintRight_toRightOf="parent">
    <androidx.cardview.widget.CardView
        android:id="@+id/dialog_content"
        android:padding="@dimen/_8sdp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/_10ssp"
        android:layout_marginRight="@dimen/_10ssp"
        app:cardCornerRadius="@dimen/_8sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.16"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:background="@color/trans_black_60"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_12sdp"
                android:textColor="@color/sg_button_text_color"
                android:gravity="center"
                android:id="@+id/message_text"
                android:background="@color/white"
                android:paddingLeft="@dimen/_12ssp"
                android:paddingRight="@dimen/_12ssp"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:singleLine="false"
                android:lineSpacingExtra="@dimen/_3sdp"
                app:layout_constraintHeight_percent="0.6"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="1"
                style="@style/TextPrimaryMedium"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:id="@+id/button_layout"
                android:background="@color/color_404040"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHeight_percent="0.4"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent="0.5">
                <TextView
                    android:textSize="@dimen/_10ssp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/cancel_button"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:text="Confirm"
                    android:maxLines="1"
                    android:textAlignment="center"
                    android:autoSizeTextType="uniform"
                    android:autoSizeStepGranularity="@dimen/_1ssp"
                    android:autoSizeMinTextSize="@dimen/_10ssp"
                    android:autoSizeMaxTextSize="@dimen/_12ssp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_percent="0.9"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TextPrimaryMedium"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:id="@+id/confirm_layout"
                android:background="@color/swipe_color"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHeight_percent="0.4"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintWidth_percent="0.5">
                <TextView
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/confirm_button"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:text="Confirm"
                    android:maxLines="1"
                    android:textAlignment="center"
                    android:autoSizeTextType="uniform"
                    android:autoSizeStepGranularity="@dimen/_1ssp"
                    android:autoSizeMinTextSize="@dimen/_10ssp"
                    android:autoSizeMaxTextSize="@dimen/_12ssp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_percent="0.9"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TextPrimaryMedium"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
