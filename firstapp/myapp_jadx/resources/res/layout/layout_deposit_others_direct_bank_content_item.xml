<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/idbi_tv_steps"
        android:longClickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="16dp"
        android:lineSpacingExtra="4dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="16dp"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_color_brand_tertiary"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/idbi_tv_visit_deposit"
        android:background="@drawable/bg_fiilled_brand_secondary_3_radius"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:text="@string/common_payment_providers__visit_gtbank_to_deposit__NG"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/text_color_brand_secondary"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/idbi_tv_check_transaction"
        android:background="@drawable/bg_outlined_brand_secondary_2_radius"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:text="@string/page_payment__check_transaction_resul_arrow"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/text_color_brand_secondary"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/idbi_tv_deposit_not_arrived"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="16dp"
        android:text="@string/common_payment_providers__gtbank_deposit_not_arrived__NG"
        android:fontFamily="sans-serif-medium"/>
    <View
        android:background="@color/line_type1_primary"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="1dp"/>
</LinearLayout>
