<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_general_primary"
    android:paddingLeft="30dp"
    android:paddingRight="39dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="@color/text_type1_primary"
        android:id="@+id/dbi_tv_title"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:lineSpacingExtra="3dp"
        android:lineSpacingMultiplier="1.2"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/H3_M"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/text_type1_primary"
        android:id="@+id/dbi_tv_info"
        android:paddingBottom="10dp"
        android:longClickable="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="40dp"
        android:lineSpacingExtra="3dp"
        android:lineSpacingMultiplier="1.2"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dbi_tv_title"
        style="@style/B1_R"/>
    <TextView
        android:gravity="center_horizontal"
        android:id="@+id/dbi_tv_conform"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="14dp"
        android:text="@string/common_functions__confirm"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dbi_tv_info"
        style="@style/AlertDialogButtonStyle.Text"/>
    <TextView
        android:textColor="@color/text_type1_secondary"
        android:gravity="center_horizontal"
        android:id="@+id/dbi_tv_cancel"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="14dp"
        android:text="@string/common_functions__cancel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/dbi_tv_conform"
        app:layout_constraintTop_toBottomOf="@+id/dbi_tv_info"
        style="@style/AlertDialogButtonStyle.Text.Secondary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
