<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="@dimen/_10sdp"
    android:layout_marginRight="@dimen/_10sdp"
    android:layout_marginHorizontal="@dimen/_10sdp"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="@dimen/_8sdp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/image2"
            android:layout_width="@dimen/_80sdp"
            android:layout_height="match_parent"
            android:src="@drawable/lobby_noti_bg"
            android:adjustViewBounds="true"
            android:rotationY="180"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/image1"
            android:layout_width="@dimen/_80sdp"
            android:layout_height="match_parent"
            android:src="@drawable/lobby_noti_bg"
            android:adjustViewBounds="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/layoutText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/layout_gift_amt"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed">
            <TextView
                android:textSize="@dimen/_12sdp"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/message"
                android:tag="@string/win_message_you_won_android"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextPrimaryBold"/>
            <TextView
                android:textSize="@dimen/_12sdp"
                android:textColor="@color/color_f1c944"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/currency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextPrimaryBold"/>
            <TextView
                android:textSize="@dimen/_12sdp"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/at"
                android:tag="@string/win_message_at_android"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextPrimaryBold"/>
            <TextView
                android:textSize="@dimen/_12sdp"
                android:textColor="@color/color_f1c944"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/coeff"
                android:paddingTop="@dimen/_2sdp"
                android:paddingBottom="@dimen/_2sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextPrimaryBold"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/layout_gift_amt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutText">
            <TextView
                android:textSize="@dimen/_10sdp"
                android:textColor="@color/color_f1c944"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="("
                style="@style/TextPrimaryRegular"/>
            <ImageView
                android:layout_gravity="center"
                android:layout_width="@dimen/_14sdp"
                android:layout_height="@dimen/_14sdp"
                app:srcCompat="@drawable/sporty_trophy"/>
            <TextView
                android:textSize="@dimen/_10sdp"
                android:textColor="@color/color_f1c944"
                android:id="@+id/actual_used_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_2sdp"
                style="@style/TextPrimaryRegular"/>
            <TextView
                android:textSize="@dimen/_10sdp"
                android:textColor="@color/color_f1c944"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" - "
                style="@style/TextPrimaryRegular"/>
            <ImageView
                android:layout_gravity="center"
                android:layout_width="@dimen/_14sdp"
                android:layout_height="@dimen/_14sdp"
                app:srcCompat="@drawable/gift_icon_bethistory"/>
            <TextView
                android:textSize="@dimen/_10sdp"
                android:textColor="@color/color_f1c944"
                android:id="@+id/gift_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_2sdp"
                style="@style/TextPrimaryRegular"/>
            <TextView
                android:textSize="@dimen/_10sdp"
                android:textColor="@color/color_f1c944"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=")"
                style="@style/TextPrimaryRegular"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
