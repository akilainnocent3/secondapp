<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/banner_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:id="@+id/info_layout"
                android:layout_width="match_parent"
                android:layout_height="176dp">
                <TextView
                    android:textSize="15dp"
                    android:textColor="#ffffff"
                    android:id="@+id/jackpot_banner_tips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="93dp"
                    android:text="@string/app_common__banner_winnings_tips"
                    android:layout_marginStart="20dp"/>
                <TextView
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#fafd00"
                    android:gravity="center_horizontal"
                    android:id="@+id/jackpot_banner_winnings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="22dp"
                    android:layout_below="@+id/jackpot_banner_tips"
                    android:fontFamily="sans-serif"
                    android:layout_marginStart="22dp"/>
                <TextView
                    android:textSize="11dp"
                    android:textStyle="bold"
                    android:textColor="#ff2f3e"
                    android:gravity="center_horizontal"
                    android:id="@+id/jackpot_banner_prize_tips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:text="@string/jackpot__prizes_for_10_and_9_correct_predictions_too"
                    android:layout_below="@+id/jackpot_banner_winnings"
                    android:fontFamily="sans-serif"
                    android:layout_marginStart="20dp"/>
            </RelativeLayout>
            <include
                android:id="@+id/timer_layout"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_below="@+id/info_layout"
                layout="@layout/spr_jackpot_banner_timer_unit"/>
            <TextView
                android:textSize="23sp"
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/jackpot_banner_close_vew"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginLeft="20dp"
                android:text="@string/jackpot__the_current_round_is_closed"
                android:layout_below="@+id/info_layout"
                android:layout_marginStart="20dp"/>
        </RelativeLayout>
        <com.sportybet.android.widget.LoadingView
            android:id="@+id/jackpot_banner_load_view"
            android:background="@color/licorice"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</merge>
