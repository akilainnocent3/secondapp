<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/background_general_primary"
    android:paddingLeft="10dp"
    android:paddingTop="6dp"
    android:paddingRight="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/title"
        android:background="@color/background_type1_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="7dp"
        android:minHeight="17dp">
        <TextView
            android:textSize="12dp"
            android:textColor="@color/text_type1_secondary"
            android:gravity="center_vertical"
            android:paddingLeft="6dp"
            android:layout_width="0dp"
            android:layout_height="17dp"
            android:text="@string/common_functions__time"
            android:layout_weight="1"/>
        <TextView
            android:textSize="12dp"
            android:textStyle="normal"
            android:textColor="@color/text_type1_secondary"
            android:gravity="end|center_vertical"
            android:layout_width="0dp"
            android:layout_height="17dp"
            android:text="@string/common_functions__stake_used"
            android:layout_weight="1"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="12dp"
            android:textStyle="normal"
            android:textColor="@color/text_type1_secondary"
            android:gravity="end|center_vertical"
            android:paddingRight="6dp"
            android:layout_width="0dp"
            android:layout_height="17dp"
            android:text="@string/common_functions__cashout"
            android:layout_weight="1"
            android:fontFamily="sans-serif"/>
    </LinearLayout>
    <View
        android:id="@+id/diver_line"
        android:background="@color/line_type1_primary"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/title"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/content"
        android:background="@color/background_general_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/diver_line">
        <TextView
            android:textSize="12dp"
            android:textStyle="normal"
            android:textColor="@color/text_type1_secondary"
            android:gravity="center_vertical"
            android:id="@+id/time"
            android:paddingLeft="6dp"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:lineSpacingExtra="4sp"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="12dp"
            android:textStyle="normal"
            android:textColor="@color/absolute_type2"
            android:gravity="end|center_vertical"
            android:id="@+id/stake_used"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="12dp"
            android:textStyle="normal"
            android:textColor="@color/absolute_type2"
            android:gravity="end|center_vertical"
            android:id="@+id/cashout"
            android:paddingRight="6dp"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif"/>
    </LinearLayout>
</RelativeLayout>
