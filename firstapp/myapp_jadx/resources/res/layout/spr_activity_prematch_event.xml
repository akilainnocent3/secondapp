<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/root"
        android:background="@color/bg_primary_d_base"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/action_bar_container"
            android:layout_width="match_parent"
            android:layout_height="@dimen/action_bar_height"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/simple_action_bar"/>
        <View
            android:id="@+id/overlay_top"
            android:background="#80000000"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/action_bar_height"/>
        <FrameLayout
            android:id="@+id/frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/action_bar_container">
            <com.sportybet.plugin.realsports.widget.banner.CustomSwipeRefreshLayout
                android:id="@+id/swipe"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.donkingliang.consecutivescroller.ConsecutiveScrollerLayout
                    android:id="@+id/nestedscrollview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    app:autoAdjustHeightAtBottomView="true"
                    app:isPermanent="true">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:clipChildren="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <androidx.compose.ui.platform.ComposeView
                            android:id="@+id/event_details_header"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.compose.ui.platform.ComposeView
                            android:id="@+id/fifa_world_cup_banner"
                            android:paddingBottom="10dp"
                            android:visibility="visible"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginRight="10dp"
                            android:layout_marginHorizontal="10dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/event_details_header"/>
                        <com.sportybet.android.widget.BubbleView
                            android:id="@+id/bet_builder_tab_tooltip"
                            android:visibility="gone"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginStart="30dp"
                            android:layout_marginEnd="18dp"
                            android:elevation="1dp"
                            app:closable="true"
                            app:descriptionText="@string/bet_builder__explore_top_bb"
                            app:layout_constraintBottom_toBottomOf="@+id/fifa_world_cup_banner"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:titleVisibility="false"
                            app:trianglePosition="bottom_left"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/tab_container"
                        android:background="@color/bg_primary_d_base"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        app:layout_isSticky="true">
                        <Space
                            android:id="@+id/tab_container_start_space"
                            android:layout_width="12dp"
                            android:layout_height="match_parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/tab_bet_builder"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <FrameLayout
                            android:id="@+id/tab_bet_builder"
                            android:background="@drawable/bg_prematch_event_tab_selector"
                            android:layout_width="36dp"
                            android:layout_height="match_parent"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp"
                            android:layout_marginEnd="1dp"
                            android:layout_marginVertical="8dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/tab_markets"
                            app:layout_constraintStart_toEndOf="@+id/tab_container_start_space"
                            app:layout_constraintTop_toTopOf="parent">
                            <ImageView
                                android:layout_gravity="center"
                                android:background="@drawable/bg_prematch_event_tab_selector"
                                android:duplicateParentState="true"
                                android:layout_width="28dp"
                                android:layout_height="wrap_content"
                                android:src="@drawable/ic_bet_builder_tab_logo_selector"/>
                        </FrameLayout>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textColor="@color/text_color_prematch_event_tab"
                            android:gravity="center"
                            android:id="@+id/tab_markets"
                            android:background="@drawable/bg_prematch_event_tab_selector"
                            android:padding="2dp"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp"
                            android:text="@string/common_functions__markets"
                            android:layout_marginEnd="1dp"
                            android:layout_marginVertical="8dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/tab_stats"
                            app:layout_constraintHorizontal_chainStyle="spread"
                            app:layout_constraintStart_toEndOf="@+id/tab_bet_builder"
                            app:layout_constraintTop_toTopOf="parent"
                            app:selected="true"
                            style="@style/B2_M"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textColor="@color/text_color_prematch_event_tab"
                            android:gravity="center"
                            android:id="@+id/tab_stats"
                            android:background="@drawable/bg_prematch_event_tab_selector"
                            android:padding="2dp"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp"
                            android:text="@string/common_functions__stats"
                            android:layout_marginEnd="1dp"
                            android:layout_marginVertical="8dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/tab_recommended_codes"
                            app:layout_constraintStart_toEndOf="@+id/tab_markets"
                            app:layout_constraintTop_toTopOf="parent"
                            style="@style/B2_M"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textColor="@color/text_color_prematch_event_tab"
                            android:gravity="center"
                            android:id="@+id/tab_recommended_codes"
                            android:background="@drawable/bg_prematch_event_tab_selector"
                            android:padding="2dp"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp"
                            android:text="@string/common_functions__codes"
                            android:layout_marginEnd="1dp"
                            android:layout_marginVertical="8dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/tab_comments"
                            app:layout_constraintStart_toEndOf="@+id/tab_stats"
                            app:layout_constraintTop_toTopOf="parent"
                            style="@style/B2_M"/>
                        <FrameLayout
                            android:id="@+id/tab_comments"
                            android:background="@drawable/bg_prematch_event_tab_selector"
                            android:layout_width="36dp"
                            android:layout_height="match_parent"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp"
                            android:layout_marginVertical="8dp"
                            app:layout_constraintEnd_toStartOf="@+id/tab_container_end_space"
                            app:layout_constraintStart_toEndOf="@+id/tab_recommended_codes"
                            app:layout_constraintTop_toTopOf="parent">
                            <ImageView
                                android:layout_gravity="center"
                                android:background="@drawable/bg_prematch_event_tab_selector"
                                android:duplicateParentState="true"
                                android:layout_width="16dp"
                                android:layout_height="wrap_content"
                                android:src="@drawable/ic_reply"
                                app:tint="@color/text_color_prematch_event_tab"/>
                        </FrameLayout>
                        <Space
                            android:id="@+id/tab_container_end_space"
                            android:layout_width="12dp"
                            android:layout_height="match_parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/tab_comments"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textAppearance="@style/C2_R"
                            android:textColor="@color/text_inverse_primary"
                            android:gravity="center"
                            android:id="@+id/bet_builder_tab_new_badge"
                            android:background="@drawable/bg_new_baggage"
                            android:paddingLeft="4dp"
                            android:paddingTop="1dp"
                            android:paddingRight="4dp"
                            android:paddingBottom="1dp"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/common_functions__new"
                            android:textAllCaps="false"
                            android:textAlignment="center"
                            android:layout_marginStart="-6dp"
                            android:elevation="1dp"
                            android:paddingHorizontal="4dp"
                            android:paddingVertical="1dp"
                            app:layout_constraintStart_toStartOf="@+id/tab_bet_builder"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textAppearance="@style/C2_R"
                            android:textColor="@color/text_inverse_primary"
                            android:gravity="center"
                            android:id="@+id/recommended_codes_tab_new_badge"
                            android:background="@drawable/bg_new_baggage"
                            android:paddingLeft="4dp"
                            android:paddingTop="1dp"
                            android:paddingRight="4dp"
                            android:paddingBottom="1dp"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/common_functions__new"
                            android:textAllCaps="false"
                            android:textAlignment="center"
                            android:layout_marginStart="8dp"
                            android:elevation="1dp"
                            android:paddingHorizontal="4dp"
                            android:paddingVertical="1dp"
                            app:layout_constraintStart_toStartOf="@+id/tab_recommended_codes"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/market_tab_container"
                        android:background="@color/bg_primary_d_base"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_isSticky="true">
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/market_search_image_view"
                            android:background="?android:attr/selectableItemBackground"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:scaleType="center"
                            app:srcCompat="@drawable/ic_market_search"/>
                        <View
                            android:layout_gravity="center_vertical"
                            android:background="@color/line_type1_secondary"
                            android:layout_width="1dp"
                            android:layout_height="20dp"/>
                        <com.google.android.material.tabs.TabLayout
                            android:id="@+id/market_tabs"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            app:layout_isSticky="true"
                            app:tabBackground="@color/bg_primary_d_base"
                            app:tabIconTint="@color/text_type1_tertiary"
                            app:tabIndicatorColor="@color/brand_secondary"
                            app:tabMode="scrollable"
                            app:tabPaddingEnd="10dp"
                            app:tabPaddingStart="10dp"
                            app:tabTextAppearance="@style/CustomTabAppearance"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:id="@+id/featured_bb_container"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/featured_bb_recycler"
                            android:paddingLeft="8dp"
                            android:paddingTop="8dp"
                            android:paddingRight="8dp"
                            android:paddingBottom="8dp"
                            android:clipToPadding="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:overScrollMode="never"
                            android:nestedScrollingEnabled="false"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="8dp"/>
                    </LinearLayout>
                    <RelativeLayout
                        android:id="@+id/bet_builder_tabs_container"
                        android:background="@color/bg_primary_d_base"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        app:layout_isSticky="true">
                        <com.google.android.material.tabs.TabLayout
                            android:id="@+id/bet_builder_tabs"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="4dp"
                            android:layout_toStartOf="@+id/bet_builder_filter_compose_view"
                            app:layout_isSticky="true"
                            app:tabBackground="@color/bg_primary_d_base"
                            app:tabGravity="start"
                            app:tabIconTint="@color/text_type1_tertiary"
                            app:tabIndicatorColor="@color/brand_secondary"
                            app:tabMode="scrollable"
                            app:tabPaddingEnd="2dp"
                            app:tabPaddingStart="2dp"
                            app:tabSelectedTextAppearance="@style/CustomTabAppearance.Bold"
                            app:tabTextAppearance="@style/CustomTabAppearance"/>
                        <androidx.compose.ui.platform.ComposeView
                            android:id="@+id/bet_builder_filter_compose_view"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="8dp"
                            android:layout_toStartOf="@+id/bet_builder_sort_compose_view"/>
                        <androidx.compose.ui.platform.ComposeView
                            android:id="@+id/bet_builder_sort_compose_view"
                            android:layout_width="28dp"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="12dp"
                            android:layout_alignParentEnd="true"/>
                    </RelativeLayout>
                    <androidx.compose.ui.platform.ComposeView
                        android:id="@+id/bet_builder_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_isSticky="true"/>
                    <androidx.compose.ui.platform.ComposeView
                        android:id="@+id/market_search_view"
                        android:background="@color/bg_primary_d_base"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_isSticky="true"/>
                    <androidx.compose.ui.platform.ComposeView
                        android:id="@+id/joker_toggle_view"
                        android:background="@color/bg_primary_d_base"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <com.sportybet.android.widget.NestedWebView
                        android:scrollbarStyle="insideOverlay"
                        android:id="@+id/web_view"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/event_recycler"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/comment_selection_container"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/bb_fragment_container"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:layout_scrollChild="@+id/pre_canned_recycler"/>
                    <com.sportybet.android.widget.LoadingView
                        android:id="@+id/content_loading_view"
                        android:background="@color/background_type1_secondary"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/spr_home_hei"/>
                </com.donkingliang.consecutivescroller.ConsecutiveScrollerLayout>
            </com.sportybet.plugin.realsports.widget.banner.CustomSwipeRefreshLayout>
            <View
                android:id="@+id/overlay_bottom"
                android:background="#80000000"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <RelativeLayout
                android:layout_gravity="bottom"
                android:id="@+id/refresh_container"
                android:background="@color/background_type1_quaternary"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:id="@+id/top_line"
                    android:background="@drawable/spr_shape_gradient_top_line"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/reply_at_name_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:layout_below="@+id/top_line">
                    <TextView
                        android:textSize="12dp"
                        android:paddingRight="6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/comment_details__replying_to"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintRight_toLeftOf="@+id/reply_at_name"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="12dp"
                        android:textStyle="bold"
                        android:textColor="@color/text_type1_primary"
                        android:id="@+id/reply_at_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="12dp"
                        android:textStyle="bold"
                        android:textColor="@color/text_type1_secondary"
                        android:id="@+id/cancel_reply_at_name"
                        android:paddingLeft="6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/comment_details__reply_cancel"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toRightOf="@+id/reply_at_name"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <include
                    android:id="@+id/spr_image_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="82dp"
                    android:layout_below="@+id/reply_at_name_container"
                    android:layout_marginStart="12dp"
                    layout="@layout/spr_prematch_comment_image_view"/>
                <View
                    android:background="@color/background_type1_primary"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_below="@+id/spr_image_container"/>
                <ImageView
                    android:gravity="center"
                    android:id="@+id/input_share_btn"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginTop="10dp"
                    android:layout_alignBottom="@+id/input_layout"
                    android:layout_marginStart="4dp"
                    android:paddingHorizontal="8dp"
                    app:srcCompat="@drawable/ic_code_share_prematch"
                    app:tint="@color/brand_secondary"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/input_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_toLeftOf="@+id/comment_send_btn"
                    android:layout_toRightOf="@+id/input_share_btn"
                    android:layout_below="@+id/spr_image_container">
                    <androidx.appcompat.widget.AppCompatEditText
                        android:textSize="14dp"
                        android:id="@+id/edtInput"
                        android:background="@drawable/spr_selector_bg_write_comment"
                        android:paddingLeft="10dp"
                        android:paddingTop="5dp"
                        android:paddingRight="5dp"
                        android:paddingBottom="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/live__write_a_comment"
                        android:maxLines="3"
                        android:singleLine="false"
                        android:maxLength="300"
                        android:drawablePadding="10dp"
                        android:isScrollContainer="true"
                        app:layout_constraintBottom_toTopOf="@+id/input_count"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="10sp"
                        android:textStyle="normal"
                        android:textColor="@color/text_type1_secondary"
                        android:gravity="center"
                        android:id="@+id/input_count"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="12dp"
                        android:fontFamily="sans-serif"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintRight_toRightOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <ImageView
                    android:id="@+id/comment_send_btn"
                    android:paddingLeft="8dp"
                    android:paddingTop="6dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBottom="@+id/input_layout"
                    android:layout_alignParentRight="true"
                    app:srcCompat="@drawable/ic_send"
                    app:tint="@color/brand_secondary"/>
            </RelativeLayout>
            <ImageView
                android:layout_gravity="end|bottom"
                android:id="@+id/refresh_btn"
                android:background="@drawable/spr_shape_bg_refresh"
                android:padding="6dp"
                android:visibility="gone"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="80dp"
                app:srcCompat="@drawable/spr_ic_refresh"/>
            <ImageView
                android:layout_gravity="end|bottom"
                android:id="@+id/comment_nav_up_button"
                android:background="@drawable/bg_oval_shape_black"
                android:padding="6dp"
                android:visibility="gone"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="80dp"
                app:srcCompat="@drawable/ic__arrow_tail_up"
                app:tint="@color/text_inverse_primary"/>
            <com.sportybet.plugin.realsports.widget.FloatLoadingView
                android:id="@+id/float_loading"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.sportybet.android.widget.LoadingView
                android:id="@+id/loading_view"
                android:background="@color/bg_primary_d_base"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:loadingLayout="@layout/spr_loading_prematch_event"/>
        </FrameLayout>
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/odds_filter_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/action_bar_container"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/touch_overlay"
        android:background="@android:color/transparent"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:layout_gravity="end"
        android:orientation="vertical"
        android:id="@+id/events_side_menu_container"
        android:background="@color/background_general_primary"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="match_parent">
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/events_side_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
