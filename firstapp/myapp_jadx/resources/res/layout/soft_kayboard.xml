<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="end"
    android:layout_gravity="bottom"
    android:orientation="horizontal"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:weightSum="10">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="8">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="center"
                android:id="@+id/one"
                android:background="@color/color_616161"
                android:layout_width="0dp"
                android:layout_height="@dimen/_32sdp"
                android:foreground="?android:attr/selectableItemBackground"
                android:text="1"
                android:layout_weight="1"
                style="@style/TextPrimaryBold"/>
            <View
                android:background="@color/color_9e9e9e"
                android:layout_width="0.5dp"
                android:layout_height="@dimen/_32sdp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="center"
                android:id="@+id/two"
                android:background="@color/color_616161"
                android:layout_width="0dp"
                android:layout_height="@dimen/_32sdp"
                android:foreground="?android:attr/selectableItemBackground"
                android:text="2"
                android:layout_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.1"
                style="@style/TextPrimaryBold"/>
            <View
                android:background="@color/color_9e9e9e"
                android:layout_width="0.5dp"
                android:layout_height="@dimen/_32sdp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="center"
                android:id="@+id/three"
                android:background="@color/color_616161"
                android:layout_width="0dp"
                android:layout_height="@dimen/_32sdp"
                android:foreground="?android:attr/selectableItemBackground"
                android:text="3"
                android:layout_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.1"
                style="@style/TextPrimaryBold"/>
            <View
                android:background="@color/color_9e9e9e"
                android:layout_width="0.5dp"
                android:layout_height="@dimen/_32sdp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="center"
                android:id="@+id/four"
                android:background="@color/color_616161"
                android:layout_width="0dp"
                android:layout_height="@dimen/_32sdp"
                android:foreground="?android:attr/selectableItemBackground"
                android:text="4"
                android:layout_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.1"
                style="@style/TextPrimaryBold"/>
            <View
                android:background="@color/color_9e9e9e"
                android:layout_width="0.5dp"
                android:layout_height="@dimen/_32sdp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="center"
                android:id="@+id/five"
                android:background="@color/color_616161"
                android:layout_width="0dp"
                android:layout_height="@dimen/_32sdp"
                android:foreground="?android:attr/selectableItemBackground"
                android:text="5"
                android:layout_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.1"
                style="@style/TextPrimaryBold"/>
            <View
                android:background="@color/color_9e9e9e"
                android:layout_width="0.5dp"
                android:layout_height="@dimen/_32sdp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="center"
                android:id="@+id/six"
                android:background="@color/color_616161"
                android:layout_width="0dp"
                android:layout_height="@dimen/_32sdp"
                android:foreground="?android:attr/selectableItemBackground"
                android:text="6"
                android:layout_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.1"
                style="@style/TextPrimaryBold"/>
            <View
                android:background="@color/color_9e9e9e"
                android:layout_width="0.5dp"
                android:layout_height="@dimen/_32sdp"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/cross"
                android:background="@color/color_616161"
                android:layout_width="0dp"
                android:layout_height="@dimen/_32sdp"
                android:foreground="?android:attr/selectableItemBackground"
                android:layout_weight="1.5">
                <ImageView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:src="@drawable/backspace"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </LinearLayout>
        <View
            android:background="@color/color_9e9e9e"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="center"
                android:id="@+id/seven"
                android:background="@color/color_616161"
                android:layout_width="0dp"
                android:layout_height="@dimen/_32sdp"
                android:foreground="?android:attr/selectableItemBackground"
                android:text="7"
                android:layout_weight="1"
                style="@style/TextPrimaryBold"/>
            <View
                android:background="@color/color_9e9e9e"
                android:layout_width="0.5dp"
                android:layout_height="@dimen/_32sdp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="center"
                android:id="@+id/eight"
                android:background="@color/color_616161"
                android:layout_width="0dp"
                android:layout_height="@dimen/_32sdp"
                android:foreground="?android:attr/selectableItemBackground"
                android:text="8"
                android:layout_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextPrimaryBold"/>
            <View
                android:background="@color/color_9e9e9e"
                android:layout_width="0.5dp"
                android:layout_height="@dimen/_32sdp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="center"
                android:id="@+id/nine"
                android:background="@color/color_616161"
                android:layout_width="0dp"
                android:layout_height="@dimen/_32sdp"
                android:foreground="?android:attr/selectableItemBackground"
                android:text="9"
                android:layout_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.1"
                style="@style/TextPrimaryBold"/>
            <View
                android:background="@color/color_9e9e9e"
                android:layout_width="0.5dp"
                android:layout_height="@dimen/_32sdp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="center"
                android:id="@+id/zero"
                android:background="@color/color_616161"
                android:layout_width="0dp"
                android:layout_height="@dimen/_32sdp"
                android:foreground="?android:attr/selectableItemBackground"
                android:text="0"
                android:layout_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.1"
                style="@style/TextPrimaryBold"/>
            <View
                android:background="@color/color_9e9e9e"
                android:layout_width="0.5dp"
                android:layout_height="@dimen/_32sdp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="center"
                android:id="@+id/point"
                android:background="@color/color_616161"
                android:layout_width="0dp"
                android:layout_height="@dimen/_32sdp"
                android:foreground="?android:attr/selectableItemBackground"
                android:text="."
                android:layout_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.1"
                style="@style/TextPrimaryBold"/>
            <View
                android:background="@color/color_9e9e9e"
                android:layout_width="0.5dp"
                android:layout_height="@dimen/_32sdp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="center"
                android:id="@+id/double_zero"
                android:background="@color/color_616161"
                android:layout_width="0dp"
                android:layout_height="@dimen/_32sdp"
                android:foreground="?android:attr/selectableItemBackground"
                android:text="00"
                android:layout_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.1"
                style="@style/TextPrimaryBold"/>
            <View
                android:background="@color/color_9e9e9e"
                android:layout_width="0.5dp"
                android:layout_height="@dimen/_32sdp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="center"
                android:id="@+id/clear"
                android:tag="@string/clear_text_cms"
                android:background="@color/color_616161"
                android:layout_width="0dp"
                android:layout_height="@dimen/_32sdp"
                android:foreground="?android:attr/selectableItemBackground"
                android:text="Clear"
                android:layout_weight="1.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.1"
                style="@style/TextPrimaryBold"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/_14ssp"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/done"
        android:tag="@string/done_text_cms"
        android:background="@color/sh_keyBoard_done_btn_color"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:foreground="?android:attr/selectableItemBackground"
        android:text="Done"
        android:maxLines="1"
        android:layout_weight="2"
        android:autoSizeTextType="uniform"
        android:autoSizeStepGranularity="@dimen/_1ssp"
        android:autoSizeMinTextSize="@dimen/_6ssp"
        android:autoSizeMaxTextSize="@dimen/_14ssp"
        style="@style/TextPrimaryBold"/>
</LinearLayout>
