<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/chat_cashout_layout"
    android:background="#050505"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/cashout_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_2sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="bottom"
            android:id="@+id/cashout1"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="@dimen/_70sdp"
            android:layout_margin="@dimen/_3sdp"
            android:layout_weight="1"
            app:cardCornerRadius="@dimen/_4sdp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/red_rocket_image"
                android:layout_width="0dp"
                android:layout_height="@dimen/_20sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                app:layout_constraintBottom_toTopOf="@+id/cashout_text1"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
            <TextView
                android:textSize="@dimen/_12ssp"
                android:gravity="center"
                android:id="@+id/cashout_text1"
                android:tag="@string/cashed_out_cms"
                android:background="@drawable/cashout_button_pr"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_40sdp"
                android:maxLines="2"
                android:autoSizeTextType="uniform"
                android:autoSizeStepGranularity="@dimen/_1ssp"
                android:autoSizeMinTextSize="@dimen/_8ssp"
                android:autoSizeMaxTextSize="@dimen/_12ssp"
                app:layout_constraintBottom_toBottomOf="parent"
                style="@style/TextPrimaryMedium"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="bottom"
            android:id="@+id/cashout2"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="@dimen/_70sdp"
            android:layout_margin="@dimen/_3sdp"
            android:layout_weight="1"
            app:cardCornerRadius="@dimen/_4sdp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/purple_rocket_image"
                android:layout_width="0dp"
                android:layout_height="@dimen/_20sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                app:layout_constraintBottom_toTopOf="@+id/cashout_text2"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
            <TextView
                android:textSize="@dimen/_12ssp"
                android:gravity="center"
                android:id="@+id/cashout_text2"
                android:tag="@string/cashed_out_cms"
                android:background="@drawable/cashout_button_pr"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_40sdp"
                android:maxLines="2"
                android:autoSizeTextType="uniform"
                android:autoSizeStepGranularity="@dimen/_1ssp"
                android:autoSizeMinTextSize="@dimen/_8ssp"
                android:autoSizeMaxTextSize="@dimen/_12ssp"
                app:layout_constraintBottom_toBottomOf="parent"
                style="@style/TextPrimaryMedium"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="bottom"
            android:id="@+id/cashout3"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="@dimen/_70sdp"
            android:layout_margin="@dimen/_3sdp"
            android:layout_weight="1"
            app:cardCornerRadius="@dimen/_4sdp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/blue_rocket_image"
                android:layout_width="0dp"
                android:layout_height="@dimen/_20sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                app:layout_constraintBottom_toTopOf="@+id/cashout_text3"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
            <TextView
                android:textSize="@dimen/_12ssp"
                android:gravity="center"
                android:id="@+id/cashout_text3"
                android:tag="@string/cashed_out_cms"
                android:background="@drawable/cashout_button_pr"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_40sdp"
                android:maxLines="2"
                android:autoSizeTextType="uniform"
                android:autoSizeStepGranularity="@dimen/_1ssp"
                android:autoSizeMinTextSize="@dimen/_8ssp"
                android:autoSizeMaxTextSize="@dimen/_12ssp"
                app:layout_constraintBottom_toBottomOf="parent"
                style="@style/TextPrimaryMedium"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/waiting_text_layout"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/_8sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/cashout_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.972">
        <TextView
            android:textSize="@dimen/_15ssp"
            android:gravity="center"
            android:id="@+id/powering"
            android:tag="@string/power_up_next_round_cms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_12sdp"
            android:maxLines="1"
            android:translationZ="1000dp"
            android:autoSizeTextType="uniform"
            android:autoSizeStepGranularity="@dimen/_1ssp"
            android:autoSizeMinTextSize="@dimen/_8ssp"
            android:autoSizeMaxTextSize="@dimen/_15ssp"
            app:layout_constraintBottom_toTopOf="@+id/seekbar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TextPrimaryMedium"/>
        <SeekBar
            android:layout_gravity="center_horizontal"
            android:id="@+id/seekbar"
            android:layout_width="@dimen/_180sdp"
            android:layout_height="6dp"
            android:progress="100"
            android:progressDrawable="@drawable/sh_seek_bar"
            android:thumb="@drawable/seek_bar_bg"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:seekbar_drawable="@drawable/sh_seek_bar"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/_28sdp"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/coefficient"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/cashout_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextPrimaryBold"/>
</androidx.constraintlayout.widget.ConstraintLayout>
