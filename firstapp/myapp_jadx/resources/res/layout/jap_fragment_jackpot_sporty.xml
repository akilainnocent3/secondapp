<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <android.widget.Space
        android:id="@+id/right_anchor"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="normal"
        android:textColor="@color/text_type2_tertiary"
        android:gravity="center"
        android:id="@+id/round_number"
        android:background="@color/background_type2_secondary"
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:lineSpacingExtra="2.8sp"
        android:fontFamily="sans-serif-medium"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="@color/text_type2_secondary"
        android:gravity="center_horizontal"
        android:id="@+id/date_match"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="10dp"
        android:text="@string/jackpot__correct_events"
        android:layout_below="@+id/round_number"
        android:fontFamily="sans-serif"
        android:layout_marginStart="32dp"/>
    <TextView
        android:textSize="10dp"
        android:textStyle="normal"
        android:textColor="@color/text_type2_secondary"
        android:gravity="center_horizontal"
        android:id="@+id/home"
        android:layout_width="@dimen/jackpot_btn_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginRight="@dimen/jackpot_home_margin_right"
        android:text="@string/jackpot__table_header_home"
        android:layout_toLeftOf="@+id/right_anchor"
        android:layout_below="@+id/round_number"
        android:fontFamily="sans-serif"
        android:layout_marginEnd="@dimen/jackpot_home_margin_right"
        android:layout_toStartOf="@+id/right_anchor"/>
    <TextView
        android:textSize="10dp"
        android:textStyle="normal"
        android:textColor="@color/text_type2_secondary"
        android:gravity="center_horizontal"
        android:layout_width="@dimen/jackpot_btn_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginRight="@dimen/jackpot_draw_margin_right"
        android:text="@string/jackpot__table_header_draw"
        android:layout_toLeftOf="@+id/right_anchor"
        android:layout_below="@+id/round_number"
        android:fontFamily="sans-serif"
        android:layout_marginEnd="@dimen/jackpot_draw_margin_right"
        android:layout_toStartOf="@+id/right_anchor"/>
    <TextView
        android:textSize="10dp"
        android:textStyle="normal"
        android:textColor="@color/text_type2_secondary"
        android:gravity="center_horizontal"
        android:layout_width="@dimen/jackpot_btn_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginRight="@dimen/jackpot_away_margin_right"
        android:text="@string/jackpot__table_header_away"
        android:layout_toLeftOf="@+id/right_anchor"
        android:layout_below="@+id/round_number"
        android:fontFamily="sans-serif"
        android:layout_marginEnd="@dimen/jackpot_away_margin_right"
        android:layout_toStartOf="@+id/right_anchor"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/jackpot_games_recycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="30dp"
        android:layout_below="@+id/round_number"/>
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/jackpot_games_recycler"
        layout="@layout/jap_jackpot_bottom_place_bet"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_secondary"
        android:gravity="center"
        android:id="@+id/games_no_data"
        android:background="@color/background_type2_primary"
        android:paddingLeft="40dp"
        android:paddingRight="40dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/common_feedback__no_data_available"
        android:fontFamily="sans-serif"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"/>
    <com.sportybet.plugin.jackpot.widget.LoadingView
        android:id="@+id/jackpot_games_loading"
        android:background="@color/background_type2_primary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/gift_value_edit_composeview"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/gift_selector_composeview"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
