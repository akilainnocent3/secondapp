<?xml version="1.0" encoding="utf-8"?>
<com.sporty.android.common_ui.widgets.SimpleActionBar xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/brand_primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageButton
        android:id="@+id/simple_action_bar_back"
        android:background="?android:attr/selectableItemBackground"
        android:layout_width="48dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_action_bar_back"
        app:tint="@android:color/white"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/simple_action_bar_back"
        app:layout_constraintRight_toLeftOf="@+id/primary_action_holder"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginRight="16dp">
        <com.sporty.android.common_ui.widgets.DoubleTextViewWithSeparator
            android:id="@+id/double_text_view_with_separator"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="20dp"
            android:textStyle="normal"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/common_functions__details"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/primary_action_holder"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/divider_line"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/primary_action"
            android:background="?android:attr/selectableItemBackground"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/common_functions__change"
            android:lineSpacingExtra="2sp"
            android:fontFamily="sans-serif-medium"/>
        <ImageButton
            android:layout_gravity="center"
            android:id="@+id/primary_action_icon"
            android:background="?android:attr/selectableItemBackground"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:srcCompat="@drawable/ic_icon_primary_action_change"/>
    </FrameLayout>
    <View
        android:id="@+id/divider_line"
        android:background="@color/brand_primary_variable"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginRight="10dp"
        android:alpha="0.5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/search"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageButton
        android:id="@+id/search"
        android:background="?android:attr/selectableItemBackground"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/home"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_action_bar_search"/>
    <ImageButton
        android:id="@+id/home"
        android:background="?android:attr/selectableItemBackground"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_home"/>
</com.sporty.android.common_ui.widgets.SimpleActionBar>
