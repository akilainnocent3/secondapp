<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/title_bar"
        android:background="#e41827"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/back"
            android:background="?android:attr/selectableItemBackground"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_action_bar_back"
            app:tint="?attr/colorTitleBarTint"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="normal"
            android:textColor="#ffffff"
            android:gravity="center_vertical"
            android:id="@+id/back_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/common_functions__deposit"
            android:singleLine="true"
            android:layout_toRightOf="@+id/back"
            android:lineSpacingExtra="8sp"
            android:fontFamily="sans-serif-medium"
            android:layout_toEndOf="@+id/back"/>
        <ImageButton
            android:id="@+id/deposit_help_center_btn"
            android:background="?android:attr/selectableItemBackground"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:layout_toLeftOf="@+id/home"
            android:layout_centerVertical="true"
            app:srcCompat="@drawable/ic_help_outline_black_24dp"
            app:tint="?attr/colorTitleBarTint"/>
        <ImageButton
            android:id="@+id/home"
            android:background="?android:attr/selectableItemBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            app:srcCompat="@drawable/ic_home"
            app:tint="@android:color/white"/>
    </RelativeLayout>
    <com.google.android.material.tabs.TabLayout
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="#353a45"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/deposit_tab"
        android:layout_width="250dp"
        android:layout_height="48dp"
        android:textAllCaps="false"
        android:fontFamily="sans-serif"
        app:tabIndicatorColor="#0d9737"
        app:tabIndicatorHeight="3dp"
        app:tabTextAppearance="@style/CustomTabAppearance"/>
    <View
        android:background="@color/line_type1_primary"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/deposit_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
