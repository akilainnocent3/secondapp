<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_secondary_d_base"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/option1Container"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/option1Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            app:srcCompat="@drawable/ic_calendar_16dp"
            app:tint="@color/text_type1_primary"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/text_primary"
            android:layout_gravity="center_vertical"
            android:id="@+id/option1Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:text="@string/bet_history__filter_by_date"
            android:layout_weight="1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/option1Checked"
            android:visibility="invisible"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="20dp"
            app:srcCompat="@drawable/ic_check"/>
    </LinearLayout>
    <View
        android:id="@+id/divider"
        android:background="@color/line_type1_primary"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/option1Container"/>
    <LinearLayout
        android:id="@+id/option2Container"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/option2Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider"
            app:srcCompat="@drawable/ic_delete_bucket"
            app:tint="@color/text_type1_primary"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/text_primary"
            android:layout_gravity="center_vertical"
            android:id="@+id/option2Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:text="@string/bet_history__delete_tickets"
            android:layout_weight="1"
            app:layout_constraintBottom_toBottomOf="@+id/option2Icon"
            app:layout_constraintLeft_toRightOf="@+id/option2Icon"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/option2Icon"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/option2Checked"
            android:visibility="invisible"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="20dp"
            app:srcCompat="@drawable/ic_check"/>
    </LinearLayout>
    <View
        android:id="@+id/divider2"
        android:background="@color/line_type1_primary"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/option2Container"/>
    <LinearLayout
        android:id="@+id/option3Container"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider2">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/option3Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider"
            app:srcCompat="@drawable/ic_delete_bucket"
            app:tint="@color/text_type1_primary"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/text_primary"
            android:layout_gravity="center_vertical"
            android:id="@+id/option3Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:text="@string/bet_history__delete_tickets"
            android:layout_weight="1"
            app:layout_constraintBottom_toBottomOf="@+id/option3Icon"
            app:layout_constraintLeft_toRightOf="@+id/option3Icon"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/option3Icon"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/option3Checked"
            android:visibility="invisible"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="20dp"
            app:srcCompat="@drawable/ic_check"/>
    </LinearLayout>
    <View
        android:id="@+id/divider3"
        android:background="@color/line_type1_primary"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/option3Container"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/text_disabled_action"
        android:gravity="center"
        android:id="@+id/clearButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="@string/common_functions__clear"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider3"/>
</androidx.constraintlayout.widget.ConstraintLayout>
