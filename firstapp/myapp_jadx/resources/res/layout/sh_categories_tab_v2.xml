<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parent"
    android:background="@drawable/sh_sidebet_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.flexbox.FlexboxLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:alignItems="center"
        app:flexDirection="row"
        app:justifyContent="space_around"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/classic_tab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_flexGrow="1">
            <TextView
                android:textSize="@dimen/_10ssp"
                android:textColor="@color/sh_bet_text_enable_color"
                android:gravity="center"
                android:id="@+id/clasic_button"
                android:tag="@string/classic_cms"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:text="Classic"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:autoSizeTextType="uniform"
                android:autoSizeStepGranularity="@dimen/_1ssp"
                android:autoSizeMinTextSize="@dimen/_6ssp"
                android:autoSizeMaxTextSize="@dimen/_10ssp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/classic_bet_count"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextPrimaryBold"/>
            <com.sportygames.commons.utils.LineAnimationView
                android:id="@+id/classic_line"
                android:layout_width="0dp"
                android:layout_height="4.5dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/clasic_button"
                app:layout_constraintStart_toStartOf="@+id/clasic_button"/>
            <ImageView
                android:id="@+id/classic_glow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="-5dp"
                android:src="@drawable/sb_glow"
                android:alpha="0.9"
                android:scaleX="1.5"
                android:scaleY="1.3"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/clasic_button"
                app:layout_constraintStart_toStartOf="@+id/clasic_button"/>
            <TextView
                android:textSize="@dimen/_10ssp"
                android:textColor="@drawable/sh_brt_count_color"
                android:id="@+id/classic_bet_count"
                android:background="@drawable/sh_bet_count_selector"
                android:paddingLeft="@dimen/_4sdp"
                android:paddingTop="0dp"
                android:paddingRight="@dimen/_4sdp"
                android:paddingBottom="0dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/_2sdp"
                android:layout_marginStart="@dimen/_5sdp"
                android:paddingHorizontal="@dimen/_4sdp"
                android:paddingVertical="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/clasic_button"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/divider_1"
            android:background="@color/color_CCCCCC"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:layout_marginVertical="6dp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ou_tab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_flexGrow="1">
            <TextView
                android:textSize="@dimen/_10ssp"
                android:textColor="@color/color_CCCCCC"
                android:gravity="center"
                android:id="@+id/ou_button"
                android:tag="@string/over_under_cms"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:text="O/U"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:autoSizeTextType="uniform"
                android:autoSizeStepGranularity="@dimen/_1ssp"
                android:autoSizeMinTextSize="@dimen/_6ssp"
                android:autoSizeMaxTextSize="@dimen/_10ssp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextPrimaryBold"/>
            <com.sportygames.commons.utils.LineAnimationView
                android:id="@+id/ou_line"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="4.5dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/ou_button"
                app:layout_constraintStart_toStartOf="@+id/ou_button"/>
            <ImageView
                android:id="@+id/ou_glow"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="-5dp"
                android:src="@drawable/sb_glow"
                android:alpha="0.9"
                android:scaleX="1.1"
                android:scaleY="1.3"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/ou_button"
                app:layout_constraintStart_toStartOf="@+id/ou_button"/>
            <TextView
                android:textSize="@dimen/_9ssp"
                android:textColor="@drawable/sh_brt_count_color"
                android:id="@+id/ou_bet_count"
                android:background="@drawable/sh_bet_count_selector"
                android:paddingLeft="@dimen/_3sdp"
                android:paddingRight="@dimen/_3sdp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2"
                android:layout_marginStart="@dimen/_1sdp"
                android:paddingHorizontal="@dimen/_3sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ou_button"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/divider_2"
            android:background="@color/color_CCCCCC"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:layout_marginVertical="6dp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/range_tab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_flexGrow="1">
            <TextView
                android:textSize="@dimen/_10ssp"
                android:textColor="@color/color_CCCCCC"
                android:gravity="center"
                android:id="@+id/range_button"
                android:tag="@string/range_cms"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:text="Range"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:autoSizeTextType="uniform"
                android:autoSizeStepGranularity="@dimen/_1ssp"
                android:autoSizeMinTextSize="@dimen/_6ssp"
                android:autoSizeMaxTextSize="@dimen/_10ssp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextPrimaryBold"/>
            <com.sportygames.commons.utils.LineAnimationView
                android:id="@+id/range_line"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="4.5dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/range_button"
                app:layout_constraintStart_toStartOf="@+id/range_button"/>
            <ImageView
                android:id="@+id/range_glow"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="-5dp"
                android:src="@drawable/sb_glow"
                android:alpha="0.9"
                android:scaleX="1.3"
                android:scaleY="1.3"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/range_button"
                app:layout_constraintStart_toStartOf="@+id/range_button"/>
            <TextView
                android:textSize="@dimen/_9ssp"
                android:textColor="@drawable/sh_brt_count_color"
                android:id="@+id/range_bet_count"
                android:background="@drawable/sh_bet_count_selector"
                android:paddingLeft="@dimen/_3sdp"
                android:paddingRight="@dimen/_3sdp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2"
                android:layout_marginStart="@dimen/_1sdp"
                android:paddingHorizontal="@dimen/_3sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/range_button"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.flexbox.FlexboxLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
