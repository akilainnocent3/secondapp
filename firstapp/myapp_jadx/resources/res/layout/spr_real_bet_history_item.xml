<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/warning_primary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/r_bet_item_top_divider_line_layout"
        android:background="@color/background_general_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:background="@color/line_type1_primary"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="64dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/text_type1_primary"
        android:gravity="center_horizontal"
        android:id="@+id/r_bet_year"
        android:background="@color/background_general_primary"
        android:paddingTop="24dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/r_bet_item_top_divider_line_layout"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/swipe_delete_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/r_bet_year"
        app:srcCompat="@drawable/ic_delete_bucket"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/swipe_content_view"
        android:background="@color/background_general_primary"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/r_bet_year">
        <View
            android:id="@+id/r_bet_top_divider_line"
            android:background="@color/line_type1_primary"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/r_bet_item_divider_line"
            android:background="@color/line_type1_primary"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="64dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline_vertical_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="12dp"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="64dp"/>
        <CheckBox
            android:id="@+id/r_bet_bulk_delete_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:button="@drawable/background_checkbox_circle_24dp"
            app:layout_constraintBottom_toTopOf="@+id/r_bet_day"
            app:layout_constraintStart_toStartOf="@+id/guideline_vertical_start"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="18dp"
            android:textStyle="bold"
            android:textColor="@color/text_type1_secondary"
            android:id="@+id/r_bet_day"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@+id/guideline_vertical_start"
            app:layout_constraintTop_toBottomOf="@+id/r_bet_bulk_delete_box"
            app:layout_goneMarginTop="10dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/text_type1_secondary"
            android:id="@+id/r_bet_date"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@+id/guideline_vertical_start"
            app:layout_constraintTop_toBottomOf="@+id/r_bet_day"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/r_bet_title_layout"
            android:background="@color/background_type1_tertiary"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/guideline_vertical"
            app:layout_constraintTop_toBottomOf="@+id/r_bet_top_divider_line">
            <TextView
                android:textColor="@color/text_type2_primary"
                android:gravity="center"
                android:id="@+id/r_bet_type"
                android:paddingLeft="9dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="9dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/B1_B"/>
            <TextView
                android:textAppearance="@style/B2_R"
                android:textColor="@color/text_type2_primary"
                android:id="@+id/r_bet_insure"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/r_bet_type"
                app:layout_constraintStart_toEndOf="@+id/r_bet_type"
                app:layout_constraintTop_toTopOf="@+id/r_bet_type"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/r_bet_pending_event_icon"
                android:padding="4dp"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="2dp"
                app:layout_constraintBottom_toBottomOf="@+id/r_bet_type"
                app:layout_constraintStart_toEndOf="@+id/r_bet_insure"
                app:layout_constraintTop_toTopOf="@+id/r_bet_type"
                app:srcCompat="@drawable/ic_info_error"
                app:tint="@color/icon_inverse_primary"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/text_type2_primary"
                android:gravity="center"
                android:id="@+id/r_bet_status"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:drawablePadding="5dp"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textColor="@color/text_type1_secondary"
            android:id="@+id/r_bet_total_stake"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            app:layout_constraintStart_toEndOf="@+id/guideline_vertical"
            app:layout_constraintTop_toBottomOf="@+id/r_bet_title_layout"
            style="@style/B2_M"/>
        <TextView
            android:textColor="@color/text_type1_primary"
            android:id="@+id/r_bet_total_stake_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/r_bet_total_stake"
            app:layout_constraintEnd_toEndOf="@+id/r_bet_title_layout"
            app:layout_constraintTop_toTopOf="@+id/r_bet_total_stake"
            style="@style/B2_M"/>
        <TextView
            android:textColor="@color/text_type1_secondary"
            android:id="@+id/r_bet_total_return"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/component_wap_share_bet__total_return"
            app:layout_constraintStart_toEndOf="@+id/guideline_vertical"
            app:layout_constraintTop_toBottomOf="@+id/r_bet_total_stake"
            style="@style/B2_M"/>
        <TextView
            android:textColor="@color/brand_quaternary"
            android:id="@+id/r_bet_total_return_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/r_bet_total_return"
            app:layout_constraintEnd_toEndOf="@+id/r_bet_title_layout"
            app:layout_constraintTop_toTopOf="@+id/r_bet_total_return"
            style="@style/H3_B"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/r_bet_odds_boost"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/guideline_vertical"
            app:layout_constraintTop_toBottomOf="@+id/r_bet_total_return">
            <ImageView
                android:id="@+id/r_bet_odds_boost_live_img"
                android:layout_width="16dp"
                android:layout_height="12dp"
                android:layout_margin="4dp"
                android:src="@drawable/ic_odds_boost"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/text_type1_primary"
                android:id="@+id/r_bet_odds_boost_live_text"
                android:paddingTop="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/component_betslip__live_odds_boost"
                android:layout_marginStart="5dp"
                app:layout_constraintBottom_toBottomOf="@+id/r_bet_odds_boost_live_img"
                app:layout_constraintStart_toEndOf="@+id/r_bet_odds_boost_live_img"
                app:layout_constraintTop_toTopOf="@+id/r_bet_odds_boost_live_img"/>
            <ImageView
                android:id="@+id/r_bet_odds_boost_flash_img"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/ic_flash_boost"
                android:layout_marginStart="6dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/r_bet_odds_boost_live_img"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/text_type1_primary"
                android:id="@+id/r_bet_odds_boost_flash_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/component_betslip__flash_odds_boost"
                android:layout_marginStart="6dp"
                app:layout_constraintBottom_toBottomOf="@+id/r_bet_odds_boost_flash_img"
                app:layout_constraintStart_toEndOf="@+id/r_bet_odds_boost_flash_img"
                app:layout_constraintTop_toTopOf="@+id/r_bet_odds_boost_flash_img"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/r_bet_odds_boost_live_group"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:constraint_referenced_ids="r_bet_odds_boost_live_img,r_bet_odds_boost_live_text"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/r_bet_odds_boost_flash_group"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:constraint_referenced_ids="r_bet_odds_boost_flash_img,r_bet_odds_boost_flash_text"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/r_bet_odds_boost_divider_line"
            android:background="@color/line_type1_primary"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:layout_marginStart="64dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/r_bet_odds_boost"
            app:layout_goneMarginTop="8dp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/r_bet_match_desc_container"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            app:layout_constraintEnd_toStartOf="@+id/barrier_end_buttons"
            app:layout_constraintStart_toEndOf="@+id/guideline_vertical"
            app:layout_constraintTop_toBottomOf="@+id/r_bet_odds_boost_divider_line"
            app:layout_goneMarginBottom="4dp"
            app:layout_goneMarginTop="12dp">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/text_type1_secondary"
                android:id="@+id/r_bet_match_desc1"
                android:paddingRight="8dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/text_type1_secondary"
                android:id="@+id/r_bet_match_desc2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/r_bet_match_desc1"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/text_type1_secondary"
                android:id="@+id/r_bet_match_desc3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/r_bet_match_desc2"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/text_type1_secondary"
                android:id="@+id/r_bet_match_desc4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/r_bet_match_desc3"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/note_container"
            android:background="@color/background_type1_primary"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:layout_constraintEnd_toEndOf="@+id/r_bet_title_layout"
            app:layout_constraintStart_toStartOf="@+id/r_bet_title_layout"
            app:layout_constraintTop_toBottomOf="@+id/r_bet_match_desc_container"/>
        <TextView
            android:textSize="10dp"
            android:textColor="@color/text_type1_secondary"
            android:id="@+id/r_bet_pending_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="@string/common_feedback__your_ticket_is_being_reviewed_tip"
            app:layout_constraintEnd_toStartOf="@+id/edit_bet"
            app:layout_constraintStart_toEndOf="@+id/guideline_vertical"
            app:layout_constraintTop_toBottomOf="@+id/note_container"/>
        <TextView
            android:textAppearance="@style/B1_B"
            android:textColor="@color/brand_secondary"
            android:id="@+id/edit_bet"
            android:paddingTop="4dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common_functions__edit_bet"
            android:paddingStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/r_bet_match_desc_container"
            app:layout_constraintEnd_toEndOf="@+id/r_bet_total_return_value"
            app:layout_constraintTop_toTopOf="@+id/r_bet_match_desc_container"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/remix_bet_button_container"
            android:paddingLeft="8dp"
            android:visibility="visible"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/r_bet_match_desc_container"
            app:layout_constraintEnd_toEndOf="@+id/r_bet_total_return_value"
            app:layout_constraintTop_toTopOf="@+id/r_bet_match_desc_container">
            <TextView
                android:textAppearance="@style/B2_M"
                android:textColor="@color/text_inverse_primary"
                android:gravity="center"
                android:id="@+id/remix_bet_button"
                android:background="@drawable/bg_filled_brand_secondary_2_radius_with_brand_secondary_disable"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="@string/bet_history__remix_bet"
                android:paddingHorizontal="8dp"/>
            <View
                android:id="@+id/remix_bet_red_dot"
                android:background="@drawable/bg_red_dot"
                android:visibility="visible"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginTop="-3dp"
                android:layout_marginEnd="-3dp"
                app:layout_constraintEnd_toEndOf="@+id/remix_bet_button"
                app:layout_constraintTop_toTopOf="@+id/remix_bet_button"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier_end_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="start"
            app:constraint_referenced_ids="edit_bet,remix_bet_button_container"/>
        <View
            android:id="@+id/space"
            android:layout_width="match_parent"
            android:layout_height="11dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/r_bet_pending_desc"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
