<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/bottom_layout"
    android:background="@color/trans_black_75"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/cashout_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="@dimen/_2sdp"
        app:layout_constraintBottom_toTopOf="@+id/list_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.1"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="bottom"
            android:id="@+id/cashout1"
            android:background="@drawable/cashout_button_sh"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="@dimen/_35sdp"
            android:layout_marginLeft="@dimen/_2sdp"
            android:layout_marginTop="@dimen/_2sdp"
            android:layout_marginBottom="@dimen/_2sdp"
            android:layout_weight="1"
            app:cardCornerRadius="@dimen/_4sdp">
            <TextView
                android:textSize="@dimen/_9ssp"
                android:gravity="center"
                android:id="@+id/cashout_text1"
                android:tag="@string/cashed_out_cms"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Cashout"
                android:autoSizeTextType="uniform"
                android:autoSizeStepGranularity="@dimen/_1ssp"
                android:autoSizeMinTextSize="@dimen/_6ssp"
                android:autoSizeMaxTextSize="@dimen/_12ssp"
                style="@style/TextPrimaryMedium"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="bottom"
            android:id="@+id/cashout2"
            android:background="@drawable/cashout_button_sh"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="@dimen/_35sdp"
            android:layout_marginLeft="@dimen/_2sdp"
            android:layout_marginTop="@dimen/_2sdp"
            android:layout_marginBottom="@dimen/_2sdp"
            android:layout_weight="1"
            app:cardCornerRadius="@dimen/_4sdp">
            <TextView
                android:textSize="@dimen/_9ssp"
                android:gravity="center"
                android:id="@+id/cashout_text2"
                android:tag="@string/cashed_out_cms"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Cashout"
                android:autoSizeTextType="uniform"
                android:autoSizeStepGranularity="@dimen/_1ssp"
                android:autoSizeMinTextSize="@dimen/_6ssp"
                android:autoSizeMaxTextSize="@dimen/_12ssp"
                style="@style/TextPrimaryMedium"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/waiting_text_layout"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/cashout_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.15"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.972">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/_10sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="1"
            app:layout_constraintStart_toStartOf="parent">
            <TextView
                android:textSize="@dimen/_15sdp"
                android:gravity="center"
                android:id="@+id/powering"
                android:tag="@string/power_up_next_round_cms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_8sdp"
                android:text="POWERING UP FOR NEXT ROUND"
                app:layout_constraintBottom_toTopOf="@+id/seekbar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/TextPrimaryMedium"/>
            <SeekBar
                android:layout_gravity="center_horizontal"
                android:id="@+id/seekbar"
                android:layout_width="@dimen/_180sdp"
                android:layout_height="6dp"
                android:progress="100"
                android:progressDrawable="@drawable/sh_seek_bar"
                android:thumb="@drawable/seek_bar_bg"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:seekbar_drawable="@drawable/sh_seek_bar"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ongoing"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/_10sdp"
        android:translationZ="10000dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/cashout_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.22"
        app:layout_constraintStart_toStartOf="parent">
        <View
            android:id="@+id/view_ongoing"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent="0.15"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/_28ssp"
            android:gravity="bottom|center_horizontal"
            android:id="@+id/coefficient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_1sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/TextPrimaryBold"/>
        <TextView
            android:textSize="@dimen/_16sdp"
            android:gravity="center"
            android:id="@+id/flew_text"
            android:tag="@string/flew_away_cms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Flew Away!"
            android:textAllCaps="true"
            app:layout_constraintBottom_toTopOf="@+id/coefficient"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/TextPrimaryBold"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.sportygames.commons.components.GiftToast
        android:id="@+id/gift_toast_bar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:translationZ="2dp"
        app:applyMotionScene="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/fl_content"
        android:background="@color/trans_black_75"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/list_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/list_layout"
        android:background="@color/sg_transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/message_layout">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/chat_title_bar"
            android:paddingBottom="1dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/_12ssp"
                android:textColor="@color/color_8d8d8d"
                android:id="@+id/online_text"
                android:tag="@string/online_txt_cms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/online"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="@dimen/_12sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/online_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/chat_online_circle"
                android:layout_marginStart="@dimen/_8sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/online_text"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/_12ssp"
                android:textColor="@color/white"
                android:id="@+id/online_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="1"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="@dimen/_8sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/online_iv"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextSecondaryRegular"/>
            <TextView
                android:textSize="@dimen/_16ssp"
                android:textColor="@color/white"
                android:id="@+id/chat"
                android:tag="@string/chat_text_cms"
                android:paddingTop="@dimen/_12sdp"
                android:paddingBottom="@dimen/_12sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/chat"
                android:paddingStart="@dimen/_4sdp"
                android:paddingEnd="@dimen/_4sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.35"
                app:layout_constraintStart_toEndOf="@+id/online_iv"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextPrimaryBold"/>
            <ImageView
                android:id="@+id/cross_chat"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:src="@drawable/close_icon"
                android:paddingStart="0x7f0702ae"
                android:paddingEnd="0x7f0702ae"
                android:layout_marginEnd="@dimen/_4sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextPrimaryRegular"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <RelativeLayout
            android:background="@color/chat_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/chat_list_layout"
                android:background="@color/yellow_clr"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_350sdp"
                android:minHeight="350dp"
                app:layout_constraintHeight_default="wrap"
                app:layout_constraintHeight_max="350dp">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/chat_list"
                    android:background="@color/chat_bg"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constrainedHeight="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.github.ybq.android.spinkit.SpinKitView
                android:id="@+id/spin_kit"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                app:SpinKit_Color="@android:color/darker_gray"
                style="@style/SpinKitStyle"/>
            <TextView
                android:id="@+id/no_list"
                android:tag="@string/say_hello_cms"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/say_hello"
                android:layout_centerInParent="true"
                style="@style/TextPrimaryBold"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/error_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <TextView
                    android:id="@+id/oops_error"
                    android:tag="@string/error_connection_cms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/oops_error_chat"
                    style="@style/TextPrimaryBold"/>
                <TextView
                    android:id="@+id/try_again"
                    android:tag="@string/try_again_chat_cms"
                    android:background="@drawable/card_round_border"
                    android:paddingLeft="@dimen/_8sdp"
                    android:paddingTop="@dimen/_4sdp"
                    android:paddingRight="8dp"
                    android:paddingBottom="@dimen/_4sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:text="@string/try_again"
                    android:backgroundTint="@color/try_again_color"
                    style="@style/TextPrimaryBold"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/new_message"
                android:background="@drawable/card_new_message"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_30sdp"
                android:layout_alignBottom="@+id/chat_list_layout"
                android:layout_centerHorizontal="true">
                <TextView
                    android:gravity="center_vertical"
                    android:id="@+id/new_message_text"
                    android:tag="@string/new_messages_cms"
                    android:paddingLeft="@dimen/_12sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_30sdp"
                    android:layout_marginBottom="@dimen/_16sdp"
                    android:text="@string/new_messages"
                    android:layout_centerHorizontal="true"
                    style="@style/TextPrimaryBold"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_30sdp">
                    <ImageView
                        android:gravity="center_vertical"
                        android:layout_width="@dimen/_10sdp"
                        android:layout_height="@dimen/_10sdp"
                        android:layout_marginLeft="6dp"
                        android:layout_marginRight="0x7f070024"
                        android:src="@drawable/down_arrow_chat"/>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/message_layout"
        android:background="@color/sb_black_100"
        android:paddingBottom="@dimen/_4sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/_8sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="@dimen/_10sdp"
            android:textColor="#535353"
            android:id="@+id/count"
            android:padding="0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:text="0/160"
            android:fontFamily="sans-serif-medium"
            android:paddingEnd="@dimen/_2sdp"
            app:layout_constraintEnd_toEndOf="@+id/chat_layout"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/chat_layout"
            android:background="@drawable/chat_edittext_idle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/_7sdp"
            android:paddingEnd="@dimen/_6sdp"
            app:layout_constraintEnd_toStartOf="@+id/send_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/count">
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="@dimen/_11ssp"
                android:textColor="@color/text_hint"
                android:textColorHint="@color/chat_hint_color_text"
                android:id="@+id/message"
                android:tag="@string/write_something_cms"
                android:background="@null"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/write_something"
                android:singleLine="true"
                android:maxLength="160"
                android:inputType="textCapSentences"
                android:imeOptions="actionSend"
                android:textCursorDrawable="@drawable/chat_cursor"
                android:fontFamily="sans-serif"
                android:paddingStart="@dimen/_5sdp"
                android:paddingEnd="@dimen/_5sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/gif"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textColor="@color/chat_hint_color_gif"
                android:gravity="center"
                android:id="@+id/gif"
                android:tag="@string/gif_text_cms"
                android:background="@drawable/chat_gif_box"
                android:paddingLeft="@dimen/_4sdp"
                android:paddingTop="@dimen/_1sdp"
                android:paddingRight="@dimen/_4sdp"
                android:paddingBottom="@dimen/_1sdp"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:layout_marginBottom="@dimen/_6sdp"
                android:text="@string/gif"
                android:fontFamily="sans-serif-condensed"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextPrimaryBold"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="@dimen/_15ssp"
            android:textColor="@color/swipe_color"
            android:gravity="center"
            android:id="@+id/send_text"
            android:tag="@string/send_btn_cms"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:text="@string/send"
            android:alpha="0.5"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="@dimen/_10sdp"
            android:paddingEnd="@dimen/_10sdp"
            app:layout_constraintBottom_toBottomOf="@+id/chat_layout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/chat_layout"
            style="@style/TextPrimaryBold"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:id="@+id/gif_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        layout="@layout/dialog_gif"/>
    <com.sportygames.sportyherov2.components.SHToastContainer
        android:id="@+id/toastChat"
        android:background="@android:color/transparent"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:translationZ="999dp"
        app:layout_constraintHeight_percent="0.07"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.425"/>
    <com.sportygames.sportyherov2.components.SHToastContainer
        android:id="@+id/rain_error_toast"
        android:background="@android:color/transparent"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:translationZ="999dp"
        app:layout_constraintHeight_percent="0.1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.425"/>
    <include
        android:id="@+id/rain_claimed_toast_bar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/_4sdp"
        android:layout_marginRight="@dimen/_4sdp"
        android:translationZ="999dp"
        android:elevation="@dimen/_8sdp"
        android:layout_marginHorizontal="@dimen/_4sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.07"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/sg_rain_claimed_notification"/>
    <include
        android:id="@+id/cashOutToastChat"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.09"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/layout_cashout_toast"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/whole_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/cashout_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
