<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@color/brand_primary"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/my_favorite_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageButton
        android:layout_gravity="center_vertical"
        android:id="@+id/goback"
        android:background="?android:attr/selectableItemBackground"
        android:paddingLeft="19dp"
        android:paddingTop="13dp"
        android:paddingRight="19dp"
        android:paddingBottom="13dp"
        android:layout_width="56dp"
        android:layout_height="44dp"
        android:paddingHorizontal="19dp"
        android:paddingVertical="13dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_action_bar_back"/>
    <TextView
        android:textSize="20dp"
        android:textStyle="normal"
        android:textColor="@color/text_type2_primary"
        android:ellipsize="end"
        android:id="@+id/my_favorite_title"
        android:paddingTop="10dp"
        android:paddingRight="16dp"
        android:paddingBottom="10dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:fontFamily="sans-serif-medium"
        android:paddingVertical="10dp"
        app:layout_constraintLeft_toRightOf="@+id/goback"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/item_sport"
        android:layout_width="match_parent"
        android:layout_height="@dimen/my_favorite_setting_item_height"
        app:layout_constraintTop_toBottomOf="@+id/my_favorite_title"
        layout="@layout/spr_my_favorite_summary_item"/>
    <include
        android:id="@+id/item_league"
        android:layout_width="match_parent"
        android:layout_height="@dimen/my_favorite_setting_item_height"
        app:layout_constraintTop_toBottomOf="@+id/item_sport"
        layout="@layout/spr_my_favorite_summary_item"/>
    <include
        android:id="@+id/item_team"
        android:layout_width="match_parent"
        android:layout_height="@dimen/my_favorite_setting_item_height"
        app:layout_constraintTop_toBottomOf="@+id/item_league"
        layout="@layout/spr_my_favorite_summary_item"/>
    <include
        android:id="@+id/item_market"
        android:layout_width="match_parent"
        android:layout_height="@dimen/my_favorite_setting_item_height"
        app:layout_constraintTop_toBottomOf="@+id/item_team"
        layout="@layout/spr_my_favorite_summary_item"/>
    <include
        android:id="@+id/item_odds"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/my_favorite_setting_item_height"
        app:layout_constraintTop_toBottomOf="@+id/item_market"
        layout="@layout/spr_my_favorite_summary_item"/>
    <include
        android:id="@+id/item_stake"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/my_favorite_setting_item_height"
        app:layout_constraintTop_toBottomOf="@+id/item_odds"
        layout="@layout/spr_my_favorite_summary_item"/>
    <View
        android:id="@+id/my_favorite_bg"
        android:layout_width="0dp"
        android:layout_height="68dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <TextView
        android:textSize="14dp"
        android:gravity="center"
        android:id="@+id/view_my_favorite"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="42dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="42dp"
        android:layout_marginBottom="16dp"
        android:text="@string/my_favourites_settings__view_my_favourites"
        android:layout_marginHorizontal="42dp"
        android:layout_marginVertical="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/my_favorite_bg"
        app:layout_constraintLeft_toLeftOf="@+id/my_favorite_bg"
        app:layout_constraintRight_toRightOf="@+id/my_favorite_bg"
        app:layout_constraintTop_toTopOf="@+id/my_favorite_bg"
        style="@style/Widget.App.CommonButton.Contained"/>
</androidx.constraintlayout.widget.ConstraintLayout>
