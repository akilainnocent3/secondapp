<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/background_general_primary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12dp"
        android:textColor="@color/text_type1_secondary"
        android:gravity="center"
        android:id="@+id/ticket_id"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp"
        android:text="@string/bet_history__total_return"/>
    <RelativeLayout
        android:id="@+id/bet_history_title"
        android:background="@color/background_type2_for_iv_primary"
        android:layout_width="match_parent"
        android:layout_height="28dp">
        <Space
            android:id="@+id/bet_history_title_start_space"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_alignParentStart="true"/>
        <ImageView
            android:id="@+id/sports_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="4dp"
            android:layout_toEndOf="@+id/bet_history_title_start_space"
            app:srcCompat="@drawable/ic_mm_football"
            app:tint="@color/text_type2_primary"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/text_type2_primary"
            android:id="@+id/bet_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/sports_icon"
            android:layout_centerVertical="true"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/text_type2_primary"
            android:gravity="center"
            android:id="@+id/bet_status"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="18dp"
            android:drawablePadding="2dp"
            android:layout_alignParentRight="true"/>
        <ImageView
            android:id="@+id/bet_status_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/iwqk_win_white"
            android:layout_toLeftOf="@+id/bet_status"
            android:layout_centerVertical="true"
            app:tint="@color/brand_tertiary"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true">
        <TextView
            android:textSize="12dp"
            android:textColor="@color/text_type1_secondary"
            android:gravity="center_vertical"
            android:id="@+id/flex_one_cut_info"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:layout_marginTop="8dp"
            android:drawablePadding="4dp"
            android:fontFamily="sans-serif-medium"
            app:drawableLeftCompat="@drawable/spr_flex_bet_icon"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginLeft="18dp"
            android:layout_marginRight="18dp">
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/text_type1_secondary"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/bet_history__total_return"/>
            <TextView
                android:textSize="18dp"
                android:textStyle="bold"
                android:textColor="@color/text_type1_tertiary"
                android:gravity="end|center_vertical"
                android:id="@+id/total_return_value"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
        </LinearLayout>
        <View
            android:background="@color/line_type1_primary"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="18dp"
            android:layout_marginRight="18dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:layout_marginTop="11dp"
            android:layout_marginRight="18dp">
            <TextView
                android:textSize="12dp"
                android:textStyle="normal"
                android:textColor="@color/text_type1_secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bet_history__total_stake"/>
            <TextView
                android:textSize="12dp"
                android:textStyle="normal"
                android:textColor="@color/text_type1_tertiary"
                android:gravity="end"
                android:id="@+id/total_stake_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/gift_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="18dp">
            <TextView
                android:textSize="12dp"
                android:textStyle="normal"
                android:textColor="@color/text_type1_secondary"
                android:id="@+id/gift_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="12dp"
                android:textStyle="normal"
                android:textColor="@color/text_type1_tertiary"
                android:gravity="end"
                android:id="@+id/gift_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/total_stake_odds_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="18dp">
            <TextView
                android:textSize="12dp"
                android:textStyle="normal"
                android:textColor="@color/text_type1_secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_functions__total_odds"/>
            <TextView
                android:textSize="12dp"
                android:textStyle="normal"
                android:textColor="@color/text_type1_tertiary"
                android:gravity="end"
                android:id="@+id/total_stake_odds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/total_bonus_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="18dp">
            <TextView
                android:textSize="12dp"
                android:textStyle="normal"
                android:textColor="@color/text_type1_secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bet_history__total_bonus"/>
            <TextView
                android:textSize="12dp"
                android:textStyle="normal"
                android:textColor="@color/text_type1_tertiary"
                android:gravity="end"
                android:id="@+id/total_bonus_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/tax_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="18dp">
            <TextView
                android:textSize="12dp"
                android:textStyle="normal"
                android:textColor="@color/text_type1_secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bet_history__wh_tax"/>
            <TextView
                android:textSize="12dp"
                android:textStyle="normal"
                android:textColor="@color/text_type1_tertiary"
                android:gravity="end"
                android:id="@+id/wh_tax_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
        <View
            android:background="@color/line_type1_primary"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="18dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="18dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="right"
            android:orientation="horizontal"
            android:id="@+id/layout_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="18dp"
            android:layout_marginBottom="8dp">
            <TextView
                android:textAppearance="@style/B2_R"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:id="@+id/toggle_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/page_instant_virtual__show_ticket_details"
                android:drawablePadding="4dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_bet_details"
            android:background="@color/background_type1_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</merge>
