<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/transparent_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/close_bet_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:layout_gravity="bottom"
            android:background="@drawable/bg_shadow"
            android:layout_width="match_parent"
            android:layout_height="4dp"/>
        <ImageView
            android:layout_gravity="end|bottom"
            android:id="@+id/close_quick_bet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="-5dp"
            android:src="@drawable/spr_quickbet_close"
            android:layout_marginEnd="20dp"/>
    </FrameLayout>
    <RelativeLayout
        android:id="@+id/single_bet_container"
        android:background="@color/custom_brand_tertiary_type2"
        android:paddingTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/delete"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_marginLeft="10dp"
            android:layout_marginStart="10dp">
            <TextView
                android:id="@+id/color_mutex"
                android:layout_width="4dp"
                android:layout_height="match_parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:tint="@color/absolute_type2"
                app:srcCompat="@drawable/spr_ic_close_black_24dp"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:id="@+id/bet_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:maxHeight="85dp"
            android:minHeight="70dp"
            android:layout_toRightOf="@+id/delete"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="16dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/match_outcome_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:layout_constraintEnd_toStartOf="@+id/odds_value"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/sports_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"/>
                <TextView
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/match_outcome_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <View
                    android:id="@+id/market_title_barrier"
                    android:background="@color/text_disable_type1_primary"
                    android:layout_width="1dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="6dp"/>
                <androidx.constraintlayout.helper.widget.Flow
                    android:id="@+id/market_title_flow"
                    android:padding="6dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="sports_icon,match_outcome_desc,market_title_barrier,market_title,bet_builder_combine_count"
                    app:flow_horizontalBias="0"
                    app:flow_horizontalGap="6dp"
                    app:flow_horizontalStyle="packed"
                    app:flow_verticalBias="0"
                    app:flow_wrapMode="chain"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/text_disable_type1_primary"
                    android:gravity="start|center_vertical"
                    android:id="@+id/market_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="6dp"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/absolute_type1"
                    android:gravity="center"
                    android:id="@+id/bet_builder_combine_count"
                    android:background="@drawable/bg_bet_builder_combine_count"
                    android:visibility="gone"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="6dp"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="16dp"
                android:textColor="@color/text_type1_primary"
                android:gravity="end"
                android:id="@+id/odds_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintBottom_toBottomOf="@+id/match_outcome_container"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/match_outcome_container"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@+id/match_outcome_container">
                <TextView
                    android:textSize="14dp"
                    android:textStyle="bold"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="center_horizontal"
                    android:id="@+id/home_team"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="14dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_secondary"
                    android:gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:text="@string/bet_history__vs"
                    android:fontFamily="sans-serif"
                    android:layout_marginHorizontal="5dp"/>
                <TextView
                    android:textSize="14dp"
                    android:textStyle="bold"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="center_horizontal"
                    android:id="@+id/away_team"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"/>
            </LinearLayout>
            <EditText
                android:textSize="14dp"
                android:gravity="end|center_vertical"
                android:id="@+id/amount_edit_text"
                android:background="@drawable/bg_outlined_text_type1_primary_2_radius"
                android:layout_width="110dp"
                android:layout_height="28dp"
                android:layout_marginTop="4dp"
                android:digits="0123456789."
                android:imeOptions="actionDone"
                android:textCursorDrawable="@drawable/spr_cursor"
                android:paddingEnd="6dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/match_outcome_container"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <FrameLayout
            android:id="@+id/keyboard_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/gifts_container">
            <com.sportybet.plugin.realsports.betslip.virtualkeyboard.KeyboardView
                android:id="@+id/custom_number_keyboard"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:upperSpaceVisible="false"/>
        </FrameLayout>
        <TextView
            android:textSize="12dp"
            android:textStyle="normal"
            android:textColor="@color/warning_primary"
            android:gravity="end"
            android:id="@+id/warning_msg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-10dp"
            android:layout_below="@+id/bet_content_container"
            android:layout_alignRight="@+id/bet_content_container"
            android:fontFamily="sans-serif"
            android:layout_alignEnd="@+id/bet_content_container"/>
        <View
            android:id="@+id/quickbet_divide_line"
            android:background="@color/line_type1_primary"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_below="@+id/warning_msg"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/gifts_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/quickbet_divide_line"
            android:layout_alignRight="@+id/bet_content_container"
            android:layout_alignEnd="@+id/bet_content_container">
            <LinearLayout
                android:gravity="end|center_vertical"
                android:orientation="horizontal"
                android:id="@+id/gifts_touch_area"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:visibility="visible"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginRight="13dp"
                    android:layout_marginEnd="13dp"
                    app:layout_constraintBottom_toBottomOf="@+id/gifts"
                    app:layout_constraintEnd_toStartOf="@+id/gifts"
                    app:layout_constraintTop_toTopOf="@+id/gifts"
                    app:srcCompat="@drawable/ic__gift"
                    app:tint="@color/icon_brand_sub_primary_d_lighter"/>
                <TextView
                    android:textSize="14dp"
                    android:textStyle="normal"
                    android:textColor="@color/custom_text_type1_primary_type1"
                    android:gravity="center_vertical"
                    android:id="@+id/gifts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="26dp"
                    android:text="@string/common_functions__none_with_brackets"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="horizontal"
            android:id="@+id/layout_buttons_container"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:baselineAligned="false"
            android:layout_below="@+id/keyboard_container">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/pot_win_btn"
                android:background="@color/background_type2_secondary"
                android:paddingLeft="16dp"
                android:paddingTop="8dp"
                android:paddingRight="16dp"
                android:paddingBottom="8dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/place_bet_btn"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/text_type2_primary"
                    android:gravity="center"
                    android:id="@+id/wh_tax_label"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/bet_history__wh_tax"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintBottom_toTopOf="@+id/pot_win_label"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/text_type2_primary"
                    android:gravity="center"
                    android:id="@+id/wh_tax_value"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintBottom_toTopOf="@+id/pot_win_amount"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:textColor="@color/text_type2_primary"
                    android:gravity="center"
                    android:id="@+id/pot_win_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/component_betslip__to_win"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/wh_tax_label"/>
                <TextView
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:textColor="@color/text_type2_primary"
                    android:gravity="center"
                    android:id="@+id/pot_win_amount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/wh_tax_value"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/place_bet_btn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/pot_win_btn"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Widget.App.CommonButton.NoRadius.Default">
                <TextView
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="@color/text_color_brand_tertiary"
                    android:gravity="center"
                    android:id="@+id/about_to_pay_amount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/component_betslip__place_bet"
                    android:singleLine="true"
                    android:fontFamily="sans-serif"
                    app:layout_constraintBottom_toTopOf="@+id/excise_tax_label"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/text_color_brand_tertiary"
                    android:gravity="center"
                    android:id="@+id/excise_tax_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/about_to_pay_amount"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_multiple_bet"
        android:background="@color/custom_brand_tertiary_type2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/container"
            android:paddingLeft="16dp"
            android:paddingTop="12dp"
            android:paddingRight="16dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@color/text_type2_primary"
                android:gravity="center"
                android:id="@+id/tv_multibet_count"
                android:background="@drawable/bg_filled_brand_secondary_circle_20dp"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:fontFamily="sans-serif"/>
            <TextView
                android:textSize="18dp"
                android:textStyle="bold"
                android:textColor="@color/text_type1_primary"
                android:id="@+id/tv_multiple_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/common_functions__betslip"
                android:fontFamily="sans-serif"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/text_type1_primary"
                android:ellipsize="end"
                android:gravity="end"
                android:id="@+id/tv_multibet_odds_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"
                android:fontFamily="sans-serif"/>
        </LinearLayout>
        <com.sportybet.android.instantwin.presentation.widget.InstantWinMultipleBetBonusHint
            android:id="@+id/multiplebet_bonus_hint"
            android:layout_width="0dp"
            android:layout_height="18dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/container"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
