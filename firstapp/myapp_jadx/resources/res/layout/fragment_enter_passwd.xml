<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_root"
    android:paddingTop="4dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageButton
        android:id="@+id/back"
        android:background="?android:attr/selectableItemBackground"
        android:padding="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        app:srcCompat="@drawable/ic_action_bar_back"
        app:tint="@color/text_type1_secondary"/>
    <ImageButton
        android:layout_gravity="right"
        android:id="@+id/close"
        android:background="?android:attr/selectableItemBackground"
        android:padding="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="4dp"
        android:layout_alignParentRight="true"
        app:srcCompat="@drawable/ic_close_black_24dp"
        app:tint="@color/text_type1_secondary"/>
    <TextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_type1_primary"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="@string/my_account__verify_your_identity"
        android:layout_below="@+id/close"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_primary"
        android:gravity="center_horizontal"
        android:id="@+id/password_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="29dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="29dp"
        android:text="@string/my_account__before__accessing_sensitive_info_you_need_to_verify_your_identity_by_entering_old_password"
        android:layout_below="@+id/title"
        android:layout_centerHorizontal="true"/>
    <com.sporty.android.common_ui.widgets.PasswordEditText
        android:textStyle="normal"
        android:id="@+id/password_edit_text"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="30dp"
        android:layout_below="@+id/password_hint"/>
    <TextView
        android:textAppearance="@style/ErrorTextView"
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="@color/warning_primary"
        android:gravity="center_horizontal"
        android:id="@+id/error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="2dp"
        android:layout_below="@+id/password_edit_text"
        android:lineSpacingExtra="8sp"
        android:fontFamily="sans-serif"/>
    <com.sportybet.android.widget.ProgressButton
        android:id="@+id/log_in"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="42dp"
        android:layout_marginRight="30dp"
        android:text="@string/common_functions__next"
        android:layout_below="@+id/password_edit_text"
        android:layout_centerHorizontal="true"/>
    <com.sportybet.android.widget.ProgressButton
        android:textAppearance="@style/H4_R"
        android:textColor="@color/brand_secondary"
        android:id="@+id/forgot_password"
        android:background="@color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="39dp"
        android:layout_marginTop="12dp"
        android:text="@string/my_account__forgot_password"
        android:layout_below="@+id/log_in"
        android:layout_centerHorizontal="true"
        android:textAllCaps="false"
        app:loadingText=""
        app:progressBarColor="@color/brand_secondary"
        style="@style/Widget.App.ProgressButton.NoBackground.Large"/>
</RelativeLayout>
