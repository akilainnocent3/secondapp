<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_type1_quaternary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/top_divider_line"
        android:background="@color/line_type1_primary"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_primary"
        android:gravity="end|center_vertical"
        android:id="@+id/sports_event_size"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:fontFamily="sans-serif"
        android:layout_marginEnd="17dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_tertiary"
        android:gravity="center_vertical"
        android:id="@+id/sports_event_title"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:singleLine="true"
        android:fontFamily="sans-serif-medium"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toStartOf="@+id/sports_event_size"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/bottom_divider_line"
        android:background="@color/line_type1_primary"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fifa_world_cup_banner"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/fifa_world_cup_banner"
        android:paddingBottom="8dp"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="10dp"
        android:layout_marginHorizontal="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sports_event_title"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center"
        android:id="@+id/delete_layout"
        android:background="@color/background_type1_secondary"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottom_divider_line">
        <TextView
            android:textColor="@color/text_type2_tertiary"
            android:gravity="center"
            android:id="@+id/no_info_tip_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common_feedback__no_odds_available"
            android:textAlignment="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/no_info_del_text"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/warning_primary"
            android:id="@+id/no_info_del_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common_feedback__delete"
            android:layout_marginStart="45dp"
            app:layout_constraintBottom_toBottomOf="@+id/no_info_tip_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/no_info_tip_text"
            app:layout_constraintTop_toTopOf="@+id/no_info_tip_text"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.sportybet.android.widget.LoadingView
        android:id="@+id/sports_event_load_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="120dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottom_divider_line"/>
</androidx.constraintlayout.widget.ConstraintLayout>
