<?xml version="1.0" encoding="utf-8"?>
<com.sportygames.sportysoccer.widget.StatusBarLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/sg_score_bg"
        android:paddingLeft="3dp"
        android:layout_width="120dp"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true">
        <ImageView
            android:layout_width="33dp"
            android:layout_height="33dp"
            android:layout_marginRight="10dp"
            android:src="@drawable/sg_ball_icon"
            android:scaleType="fitXY"
            android:layout_marginEnd="10dp"/>
        <TextView
            android:textSize="20dp"
            android:textColor="@android:color/white"
            android:id="@+id/streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_bold"
            android:letterSpacing="0.03"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/info_container"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true">
        <TextView
            android:textSize="15sp"
            android:id="@+id/info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="12dp"
            android:fontFamily="@font/roboto_italic"
            style="@style/StatusBarInfo"/>
        <ImageView
            android:id="@+id/leader_board_icon"
            android:layout_width="54dp"
            android:layout_height="44dp"
            android:src="@drawable/sg_btn_leader_board"/>
    </LinearLayout>
</com.sportygames.sportysoccer.widget.StatusBarLayout>
