<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/ll_toggle"
    android:background="@color/redblack_toggle_off_color"
    android:paddingLeft="@dimen/_2sdp"
    android:paddingRight="@dimen/_2sdp"
    android:layout_width="@dimen/_40sdp"
    android:layout_height="@dimen/_18sdp"
    android:weightSum="1"
    android:paddingHorizontal="@dimen/_2sdp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintLeft_toLeftOf="parent"
    app:layout_constraintRight_toRightOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <TextView
        android:textSize="@dimen/_8sdp"
        android:gravity="center"
        android:id="@+id/on_textview"
        android:paddingLeft="@dimen/_4sdp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/_4sdp"
        android:layout_weight="1"
        android:textAlignment="center"
        style="@style/TextPrimaryRegular"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/switch_circle"
        android:layout_width="@dimen/_12sdp"
        android:layout_height="@dimen/_12sdp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:backgroundTint="@color/pp_switch"
        app:shapeAppearance="@style/ShapeAppearanceOverlay.App.CornerSize50Percent"
        style="@style/Widget.MaterialComponents.Button"/>
    <TextView
        android:textSize="@dimen/_8sdp"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/off_textview"
        android:paddingRight="@dimen/_4sdp"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_4sdp"
        android:layout_weight="1"
        android:textAlignment="center"
        style="@style/TextPrimaryRegular"/>
</androidx.appcompat.widget.LinearLayoutCompat>
