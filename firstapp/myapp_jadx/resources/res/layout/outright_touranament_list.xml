<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/tournament_recycler"
        android:background="@color/background_type1_secondary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="@dimen/outright_tournament_height"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/tournament_recycler_bottom_gradient"
        android:background="@drawable/outright_list_fading"
        android:layout_width="0dp"
        android:layout_height="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/tournament_recycler"
        app:layout_constraintEnd_toEndOf="@+id/tournament_recycler"
        app:layout_constraintStart_toStartOf="@+id/tournament_recycler"/>
</androidx.constraintlayout.widget.ConstraintLayout>
