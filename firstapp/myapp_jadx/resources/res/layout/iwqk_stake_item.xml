<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.flexbox.FlexboxLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="3dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="3dp"
        app:alignItems="center"
        app:flexWrap="wrap">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14dp"
                android:textStyle="normal"
                android:textColor="@color/text_type1_tertiary"
                android:gravity="left"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:textSize="14dp"
                android:textStyle="normal"
                android:textColor="@color/text_type1_primary"
                android:gravity="center_horizontal"
                android:id="@+id/number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="end"
            android:id="@+id/stake_input_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_flexGrow="1">
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/text_type1_tertiary"
                android:gravity="end"
                android:id="@+id/currency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"
                android:fontFamily="sans-serif"/>
            <EditText
                android:textSize="14dp"
                android:textStyle="normal"
                android:textColor="@color/text_type1_tertiary"
                android:gravity="center"
                android:id="@+id/edit_text"
                android:background="@drawable/bg_outlined_text_type1_secondary"
                android:paddingRight="6dp"
                android:layout_width="110dp"
                android:layout_height="28dp"
                android:digits="0123456789."
                android:textCursorDrawable="@drawable/spr_cursor"/>
        </LinearLayout>
    </com.google.android.flexbox.FlexboxLayout>
    <TextView
        android:textSize="12dp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_secondary"
        android:gravity="end"
        android:id="@+id/msg"
        android:paddingRight="1dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="3dp"
        android:fontFamily="sans-serif"/>
    <com.sportybet.plugin.realsports.betslip.virtualkeyboard.KeyboardView
        android:id="@+id/custom_number_keyboard"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</merge>
