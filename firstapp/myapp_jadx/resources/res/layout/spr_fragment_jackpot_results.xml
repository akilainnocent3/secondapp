<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.sportybet.plugin.realsports.widget.SpinnerTextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center_vertical"
        android:id="@+id/result_spinner"
        android:background="@drawable/spr_shape_jungle_green_item_bg"
        android:paddingLeft="8dp"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="9dp"
        android:layout_marginRight="10dp"
        android:layout_alignParentTop="true"
        android:lineSpacingExtra="2.8dp"
        android:fontFamily="sans-serif"
        android:paddingStart="8dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center_vertical"
        android:id="@+id/winnings_title"
        android:background="@color/cmn_pale_grey_two_15"
        android:paddingLeft="14dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:text="@string/jackpot__winnings"
        android:layout_below="@+id/result_spinner"
        android:fontFamily="sans-serif"
        android:paddingStart="14dp"/>
    <RelativeLayout
        android:id="@+id/winning_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/winnings_title">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/winnings_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="11dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/void_result_hint"
            android:background="#fafd00"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="13dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_jackpot"/>
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="#1b1e25"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/jackpot__no_more_than_one_event_hint"/>
        </LinearLayout>
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/results_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="50dp"
        android:layout_below="@+id/winning_content"/>
    <com.sportybet.android.widget.LoadingView
        android:id="@+id/jackpot_results_loading"
        android:background="#1b1e25"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="40dp"
        android:layout_below="@+id/result_spinner"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="normal"
        android:textColor="#9ca0ab"
        android:gravity="center"
        android:id="@+id/previous_no_data"
        android:background="#1b1e25"
        android:paddingLeft="40dp"
        android:paddingRight="40dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/common_feedback__no_data_available"
        android:layout_below="@+id/result_spinner"
        android:fontFamily="sans-serif"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"/>
</RelativeLayout>
