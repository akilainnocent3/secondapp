<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_secondary"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/epl_desc"
        android:paddingLeft="60dp"
        android:paddingRight="60dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/live__epl_provided"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="60dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/epl_watch_text"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="normal"
        android:textColor="@color/brand_secondary_variable_type3"
        android:gravity="center"
        android:id="@+id/epl_watch_text"
        android:background="@drawable/sfm_bg_boarder_sporty_green"
        android:layout_width="170dp"
        android:layout_height="44dp"
        android:layout_marginTop="18dp"
        android:text="@string/live__watch_now"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/epl_desc"/>
</androidx.constraintlayout.widget.ConstraintLayout>
