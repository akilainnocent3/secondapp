<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/_7sdp">
    <TextView
        android:textSize="@dimen/_9ssp"
        android:textColor="@color/white"
        android:id="@+id/redblack_stats_dialog_footer"
        android:tag="@string/end_round_stats_dialog_footer_cms"
        android:paddingLeft="@dimen/_4sdp"
        android:paddingRight="@dimen/_4sdp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/redblack_stats_dialog_note"
        style="@style/TextPrimaryBold"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center"
        android:layout_gravity="center"
        android:background="@color/redblack_bg_dark"
        android:padding="@dimen/_6sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:gravity="center"
            android:id="@+id/redblack_stats_star"
            android:layout_width="@dimen/_14sdp"
            android:layout_height="@dimen/_14sdp"
            android:src="@drawable/redblack_star"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="@dimen/_10sdp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/redblack_stats_txt"
            android:tag="@string/list_game_name_cms"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/_7sdp"
            style="@style/TextPrimaryBold"/>
        <TextView
            android:textSize="@dimen/_10sdp"
            android:textStyle="bold"
            android:textColor="#fafd00"
            android:gravity="end|center_vertical"
            android:layout_gravity="end"
            android:id="@+id/redblack_stats_amt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="900"
            android:layout_weight="1"
            android:textAlignment="textEnd"
            style="@style/TextPrimaryBold"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
