<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_general_primary"
    android:paddingLeft="30dp"
    android:paddingRight="30dp"
    android:paddingBottom="32dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/sporty_bank_logo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="34dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="18dp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_tertiary"
        android:gravity="center_horizontal"
        android:id="@+id/instruction_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/component_sporty_bank__info_pop_title"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sporty_bank_logo"/>
    <ImageView
        android:id="@+id/dot_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/instruction_title"
        app:srcCompat="@drawable/ic_dot"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_primary"
        android:id="@+id/instruction_content_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="20dp"
        android:text="@string/component_sporty_bank__info_pop_desc1"
        android:lineSpacingExtra="4sp"
        android:fontFamily="sans-serif"
        android:layout_marginStart="8dp"
        app:layout_constraintLeft_toRightOf="@+id/dot_1"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/instruction_title"/>
    <ImageView
        android:id="@+id/dot_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/instruction_content_1"
        app:srcCompat="@drawable/ic_dot"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_primary"
        android:id="@+id/instruction_content_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:text="@string/component_sporty_bank__info_pop_desc2"
        android:lineSpacingExtra="4sp"
        android:fontFamily="sans-serif"
        android:layout_marginStart="8dp"
        app:layout_constraintLeft_toRightOf="@+id/dot_2"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/dot_2"/>
    <Button
        android:textSize="14dp"
        android:textColor="@color/text_color_brand_tertiary"
        android:gravity="center"
        android:id="@+id/btn_continue"
        android:background="@drawable/bg_filled_brand_secondary_2_radius_with_brand_secondary_disable"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="30dp"
        android:layout_marginBottom="30dp"
        android:text="@string/common_functions__ok"
        android:textAllCaps="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/instruction_content_2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
