<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/provider_verify_code_container"
    android:background="@color/background_type2_primary"
    android:layout_width="match_parent"
    android:layout_height="30dp">
    <ImageView
        android:background="#4d353a45"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"/>
    <TextView
        android:textColor="@color/text_type1_secondary"
        android:id="@+id/provider_code_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="4dp"
        android:text="@string/bet_history__verify_code"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/provider_verify_code"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/B2_R"/>
    <TextView
        android:textColor="@color/brand_secondary_variable_type3"
        android:id="@+id/provider_verify_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/provider_code_title"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/B2_R"/>
</androidx.constraintlayout.widget.ConstraintLayout>
