<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:background="#e6000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/swipe_bet_tools"
        android:paddingLeft="25dp"
        android:paddingRight="25dp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_alignParentTop="true"
        android:paddingHorizontal="25dp">
        <ImageView
            android:id="@+id/tool_btn_close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_close_white_24dp"/>
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/tool_btn_setting"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="12dp"
            android:src="@drawable/ic_swipe_bet_setting"/>
        <ImageView
            android:id="@+id/tool_btn_tutorial"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="12dp"
            android:src="@drawable/ic_swipe_bet_tool_tutorial"/>
    </LinearLayout>
    <View
        android:id="@+id/swipe_quick_bet_view_area"
        android:layout_width="match_parent"
        android:layout_height="77dp"
        android:layout_alignParentBottom="true"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/swipe_quick_bet_view_area"
        android:layout_below="@+id/swipe_bet_tools">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/loading_view_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerHorizontal="true"
                layout="@layout/spr_swipe_bet_loading_view"/>
            <com.yuyakaido.android.cardstackview.CardStackView
                android:id="@+id/card_stack_view"
                android:paddingLeft="26dp"
                android:paddingRight="26dp"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:paddingHorizontal="26dp"/>
            <include
                android:id="@+id/error_view_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/spr_swipe_bet_error_view"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/swipe_bet_actions"
            android:paddingLeft="44dp"
            android:paddingRight="44dp"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:paddingHorizontal="44dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/swipe_action_remove"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:srcCompat="@drawable/ic_swipe_action_remove"/>
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/swipe_action_next_odds"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:srcCompat="@drawable/ic_swipe_action_next"/>
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/swipe_action_accept"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:srcCompat="@drawable/ic_swipe_action_accept"/>
        </LinearLayout>
    </LinearLayout>
    <include
        android:id="@+id/swipe_action_tutorial_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/spr_swipe_bet_action_tutorial"/>
    <include
        android:id="@+id/max_selection_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/spr_swipe_bet_max_selection_view"/>
    <include
        android:id="@+id/no_more_bets_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/spr_swipe_bet_no_more_bets_view"/>
</RelativeLayout>
