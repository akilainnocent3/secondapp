<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/black"
    android:layout_width="match_parent"
    android:layout_height="@dimen/action_bar_height">
    <ImageView
        android:id="@+id/home_notification_close"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:paddingStart="12dp"
        android:paddingVertical="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_cancel_black_24dp"
        app:tint="@color/text_type1_secondary"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@android:color/white"
        android:gravity="center_vertical"
        android:id="@+id/home_notification_hint"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/home_notification_action"
        app:layout_constraintStart_toEndOf="@+id/home_notification_close"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/brand_secondary"
        android:gravity="center"
        android:id="@+id/home_notification_action"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="@string/common_functions__more"
        android:drawablePadding="4dp"
        android:paddingHorizontal="12dp"
        app:drawableEndCompat="@drawable/ic_kyc_green_arrow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
