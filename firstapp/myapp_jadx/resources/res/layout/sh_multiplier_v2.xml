<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/space"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/_9ssp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/payout_error"
            android:tag="@string/over_under_max_payout_exceed_message_cms"
            android:background="@drawable/sg_sh_bg_payout_error"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/_20sdp"
            android:text="@string/exceed_max_payout_error"
            android:translationZ="1100dp"
            android:elevation="@dimen/_100sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/TextPrimaryMedium"/>
        <View
            android:id="@+id/shooting_view1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.1"/>
        <View
            android:id="@+id/shooting_view2"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent="0.3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.motion.widget.MotionLayout
            android:id="@+id/shooting_star_layout"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="-40dp"
            app:layoutDescription="@xml/shooting_star2_v2"
            app:layout_constraintHeight_percent="0.7"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/shooting_view2"
            app:layout_constraintWidth_percent="0.85">
            <ImageView
                android:id="@+id/shooting_star1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/shooting_star"
                android:scaleType="fitXY"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.motion.widget.MotionLayout>
        <View
            android:id="@+id/shooting_view"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.1"/>
        <androidx.constraintlayout.motion.widget.MotionLayout
            android:id="@+id/motionLayout"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="30dp"
            android:layout_marginStart="-30dp"
            app:layoutDescription="@xml/shooting_star_v2"
            app:layout_constraintHeight_percent="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.6">
            <ImageView
                android:id="@+id/shooting_star"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/shooting_star"
                android:scaleType="fitXY"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.motion.widget.MotionLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/waiting"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:translationZ="999dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <View
                android:id="@+id/view_waiting"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintHeight_percent="0.25"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/view_waiting1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintHeight_percent="0.25"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/top_percent_waiting"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintHeight_percent="0.05"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/waiting_text_layout"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/top_percent_waiting"
                app:layout_constraintWidth_percent="0.972">
                <View
                    android:id="@+id/view_top_powering"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintHeight_percent="0.3"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:id="@+id/view_top_s_logo"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintHeight_percent="0.242"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/snow_logo"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="9dp"
                    android:src="@drawable/sh_logo_snow"
                    android:translationZ="100dp"
                    android:elevation="100dp"
                    app:layout_constraintEnd_toEndOf="@+id/logo"
                    app:layout_constraintHeight_percent="0.4"
                    app:layout_constraintStart_toStartOf="@+id/logo"
                    app:layout_constraintTop_toTopOf="@+id/logo"
                    app:layout_constraintWidth_percent="0.46"/>
                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/s_logo_sh"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/view_top_s_logo"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_percent="0.545"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/view_top_powering">
                    <TextView
                        android:textSize="@dimen/_12ssp"
                        android:gravity="center"
                        android:id="@+id/powering"
                        android:tag="@string/power_up_next_round_cms"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_10sdp"
                        android:layout_marginRight="@dimen/_10sdp"
                        android:layout_marginBottom="@dimen/_8sdp"
                        android:text="@string/powering_up_for_next_round"
                        android:maxLines="1"
                        android:layout_marginHorizontal="@dimen/_10sdp"
                        app:layout_constraintBottom_toTopOf="@+id/seekbar"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintWidth_percent="0.75"
                        style="@style/TextPrimaryBold"/>
                    <SeekBar
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/seekbar"
                        android:layout_width="@dimen/_220sdp"
                        android:layout_height="4dp"
                        android:progressDrawable="@drawable/sh_seek_bar"
                        android:thumb="@drawable/seek_bar_bg"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:seekbar_drawable="@drawable/sh_seek_bar"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/waiting_v1"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:translationZ="999dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <View
                android:id="@+id/view_waiting_v1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintHeight_percent="0.18"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/sh"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:src="@drawable/powering_up"
                android:layout_marginEnd="20dp"
                app:layout_constraintHeight_percent="0.52"
                app:layout_constraintTop_toBottomOf="@+id/view_waiting_v1"/>
            <ImageView
                android:id="@+id/progressBar1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:src="@drawable/powering_up_grey_christmas"
                android:scaleType="centerInside"
                android:adjustViewBounds="true"
                android:layout_marginEnd="20dp"
                app:layout_constraintHeight_percent="0.52"
                app:layout_constraintTop_toBottomOf="@+id/view_waiting_v1"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/waiting_text_layout_v1"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent="0.972">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_percent="0.6"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textSize="@dimen/_13ssp"
                        android:gravity="center"
                        android:id="@+id/powering_v1"
                        android:tag="@string/power_up_next_round_cms"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_10sdp"
                        android:layout_marginRight="@dimen/_10sdp"
                        android:layout_marginBottom="@dimen/_6sdp"
                        android:text="@string/powering_up_for_next_round"
                        android:maxLines="1"
                        android:layout_marginHorizontal="@dimen/_10sdp"
                        app:layout_constraintBottom_toTopOf="@+id/seekbar_v1"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintWidth_percent="0.75"
                        style="@style/TextPrimaryMedium"/>
                    <SeekBar
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/seekbar_v1"
                        android:layout_width="@dimen/_180sdp"
                        android:layout_height="5dp"
                        android:progressDrawable="@drawable/sh_seek_bar"
                        android:thumb="@drawable/seek_bar_bg"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:seekbar_drawable="@drawable/sh_seek_bar"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/mini_waiting_text_layout"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/view_bottom2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.972">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="@dimen/_10ssp"
                    android:gravity="center"
                    android:id="@+id/mini_powering"
                    android:tag="@string/power_up_next_round_cms"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_5sdp"
                    android:text="@string/powering_up_for_next_round"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeStepGranularity="@dimen/_1ssp"
                    android:autoSizeMinTextSize="@dimen/_10ssp"
                    android:autoSizeMaxTextSize="@dimen/_14ssp"
                    app:layout_constraintBottom_toTopOf="@+id/mini_seekbar"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintWidth_percent="0.75"
                    style="@style/TextPrimaryMedium"/>
                <SeekBar
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/mini_seekbar"
                    android:layout_width="@dimen/_180sdp"
                    android:layout_height="5dp"
                    android:progressDrawable="@drawable/sh_seek_bar"
                    android:thumb="@drawable/seek_bar_bg"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:seekbar_drawable="@drawable/sh_seek_bar"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ongoing"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:translationZ="999dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <View
                android:id="@+id/view_ongoing"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintHeight_percent="0.25"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/view_cashout"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintHeight_percent="0.05"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.motion.widget.MotionLayout
                android:id="@+id/container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layoutDescription="@xml/hero"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="1"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="1">
                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/hero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/sg_sh"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/valentine"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/sg_sh"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:id="@+id/hero_view_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintWidth_percent="0.17"/>
                <View
                    android:id="@+id/hero_view_2"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintHeight_percent="0.05"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.motion.widget.MotionLayout>
            <View
                android:id="@+id/view_bottom"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHeight_percent="0.03"
                app:layout_constraintStart_toStartOf="parent"/>
            <View
                android:id="@+id/view_bottom1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHeight_percent="0.08"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:textSize="@dimen/_50ssp"
                android:gravity="center"
                android:id="@+id/coefficient"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3.35x"
                android:lines="1"
                android:shadowColor="#4dffffff"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="20"
                app:layout_constraintBottom_toTopOf="@+id/view_bottom"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/TextPrimaryBlack"/>
            <TextView
                android:textSize="@dimen/_35ssp"
                android:gravity="center"
                android:id="@+id/mini_coefficient"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lines="1"
                android:shadowColor="#4dffffff"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="20"
                app:layout_constraintBottom_toTopOf="@+id/view_bottom1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/TextPrimaryBlack"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/flew_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="-10dp"
                app:layout_constraintBottom_toTopOf="@+id/coefficient"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <TextView
                    android:textSize="@dimen/_12ssp"
                    android:gravity="center"
                    android:id="@+id/flew_text"
                    android:tag="@string/flew_away_cms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Flew Away"
                    android:textAllCaps="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TextPrimaryBold"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.cardview.widget.CardView
            android:id="@+id/ic_rain_timer"
            android:visibility="gone"
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:layout_marginStart="@dimen/_6sdp"
            app:cardBackgroundColor="@color/rain_bg_timer"
            app:cardCornerRadius="4dp"
            app:cardElevation="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_gravity="center"
                android:padding="1dp"
                android:layout_width="30dp"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_gravity="top|center_horizontal"
                    android:id="@+id/ic_cloud_next"
                    android:layout_width="30dp"
                    android:layout_height="27dp"
                    android:src="@drawable/ic_rain_cloud_timer_next"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/ic_cloud_active"
                    android:visibility="gone"
                    android:layout_width="30dp"
                    android:layout_height="27dp"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/ic_rain_cloud_timer_active"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="9sp"
                    android:textColor="@color/rain_dark_yellow_text"
                    android:layout_gravity="bottom|center_horizontal"
                    android:id="@+id/rain_timer"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    style="@style/TextPrimaryMedium"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
        <View
            android:id="@+id/view_bottom2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHeight_percent="0.2"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
