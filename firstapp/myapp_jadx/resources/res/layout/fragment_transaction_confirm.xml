<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/background_general_primary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14dp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_primary"
        android:gravity="center"
        android:id="@+id/withdraw_amount_text"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="24dp"
        android:lineSpacingExtra="10dp"
        android:fontFamily="sans-serif"/>
    <TextView
        android:textSize="22dp"
        android:textStyle="bold"
        android:textColor="@color/text_type1_primary"
        android:gravity="center"
        android:id="@+id/withdraw_amount"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_below="@+id/withdraw_amount_text"
        android:lineSpacingExtra="2dp"
        android:fontFamily="sans-serif"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/tax_layout"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginLeft="29dp"
        android:layout_marginTop="32dp"
        android:layout_marginRight="26dp"
        android:layout_below="@+id/withdraw_amount">
        <TextView
            android:textSize="14dp"
            android:textStyle="normal"
            android:textColor="@color/text_type1_primary"
            android:gravity="center_vertical"
            android:id="@+id/tax"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="@string/page_withdraw__withdrawal_tax"
            android:lineSpacingExtra="10sp"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/text_type1_primary"
            android:gravity="end|center_vertical"
            android:id="@+id/tax_count"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:lineSpacingExtra="8dp"
            android:fontFamily="sans-serif"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/fee_layout"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginLeft="29dp"
        android:layout_marginRight="26dp"
        android:layout_below="@+id/tax_layout">
        <TextView
            android:textSize="14dp"
            android:textStyle="normal"
            android:textColor="@color/text_type1_primary"
            android:gravity="center_vertical"
            android:id="@+id/fees"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="@string/page_withdraw__withdrawal_fee"
            android:lineSpacingExtra="10sp"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/text_type1_primary"
            android:gravity="end|center_vertical"
            android:id="@+id/fees_count"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:lineSpacingExtra="8dp"
            android:fontFamily="sans-serif"/>
    </LinearLayout>
    <TextView
        android:textStyle="normal"
        android:textColor="@color/text_type1_primary"
        android:gravity="center_vertical"
        android:id="@+id/remain_amount_text"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginLeft="29dp"
        android:text="@string/page_withdraw__remaining_amount"
        android:layout_below="@+id/fee_layout"
        android:lineSpacingExtra="10dp"
        android:fontFamily="sans-serif"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/text_type1_primary"
        android:gravity="end|center_vertical"
        android:id="@+id/remain_amount"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginRight="26dp"
        android:layout_alignTop="@+id/remain_amount_text"
        android:layout_alignParentRight="true"
        android:lineSpacingExtra="8dp"
        android:fontFamily="sans-serif"/>
    <TextView
        android:gravity="center"
        android:id="@+id/cancel"
        android:layout_width="96dp"
        android:layout_height="48dp"
        android:layout_marginTop="23dp"
        android:text="@string/common_functions__cancel"
        android:layout_below="@+id/remain_amount_text"
        style="@style/Widget.App.CommonButton.NoRadius.DefaultSub"/>
    <com.sportybet.android.widget.ProgressButton
        android:id="@+id/confirm"
        android:background="@color/brand_quaternary"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/common_functions__confirm"
        android:layout_toRightOf="@+id/cancel"
        android:layout_alignTop="@+id/cancel"
        style="@style/Widget.App.CommonButton.NoRadius.Default"/>
</RelativeLayout>
