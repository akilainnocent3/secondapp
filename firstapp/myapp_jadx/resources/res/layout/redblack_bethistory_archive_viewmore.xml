<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/archive_viewmore"
    android:background="@color/sb_black"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/_4sdp"
    android:backgroundTint="@color/sb_black"
    app:cardBackgroundColor="@color/sb_black"
    app:cardCornerRadius="@dimen/_10sdp">
    <TextView
        android:textSize="@dimen/_10ssp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/archive_viewmore_btn"
        android:tag="@string/more_cms"
        android:background="@color/button_blue"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_28sdp"
        android:text="@string/more"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextPrimaryBold"/>
    <ImageView
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_4sdp"
        android:src="@drawable/archive_trash"
        app:layout_constraintBottom_toBottomOf="@+id/archive_viewmore_btn"
        app:layout_constraintLeft_toRightOf="@+id/archive_viewmore_btn"
        app:layout_constraintTop_toTopOf="@+id/archive_viewmore_btn"/>
</androidx.cardview.widget.CardView>
