<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/error_img"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="60dp"
        android:src="@drawable/spr_network_check"
        android:tint="#dcdee5"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="normal"
        android:textColor="#9ca0ab"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/wap_search__failed"
        android:fontFamily="sans-serif"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="#0d9737"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/retry"
        android:background="@drawable/spr_selector_reload_bg"
        android:layout_width="92dp"
        android:layout_height="36dp"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="22dp"
        android:layout_marginRight="30dp"
        android:text="@string/common_functions__retry"
        android:textAllCaps="false"
        android:fontFamily="sans-serif"/>
</merge>
