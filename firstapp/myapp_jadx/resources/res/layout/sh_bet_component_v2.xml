<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_layout"
    android:background="@android:color/transparent"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <androidx.cardview.widget.CardView
        android:id="@+id/wc_flag"
        android:background="@color/sg_transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="0dp"
        android:backgroundTint="@color/sg_transparent"
        app:cardBackgroundColor="@color/sg_transparent"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">
        <ImageView
            android:id="@+id/wc_flag_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
    </androidx.cardview.widget.CardView>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.47"/>
    <View
        android:id="@+id/left_space"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.01"/>
    <View
        android:id="@+id/top_space"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.074"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/bottom_space"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.1"/>
    <View
        android:id="@+id/right_space"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.022"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_auto_bet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="@dimen/_12sdp"
        app:layout_constraintEnd_toStartOf="@+id/guideline"
        app:layout_constraintTop_toBottomOf="@+id/top_space">
        <TextView
            android:textSize="@dimen/_7ssp"
            android:textColor="@color/color_CCCCCC"
            android:id="@+id/auto_bet_text"
            android:tag="@string/auto_bet_cms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginEnd="@dimen/_3sdp"
            app:layout_constraintBottom_toBottomOf="@+id/auto_bet_toggle"
            app:layout_constraintEnd_toStartOf="@+id/auto_bet_toggle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/auto_bet_toggle"
            style="@style/TextPrimaryBold"/>
        <com.sportygames.sportyherov2.components.SHBetToggle
            android:id="@+id/auto_bet_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/auto_bet_text"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_auto_cashout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-2dp"
        android:layout_marginStart="@dimen/_14sdp"
        app:layout_constraintStart_toEndOf="@+id/guideline"
        app:layout_constraintTop_toBottomOf="@+id/top_space">
        <TextView
            android:textSize="@dimen/_7ssp"
            android:textColor="@color/color_CCCCCC"
            android:id="@+id/auto_cashout_text"
            android:tag="@string/auto_cashout_cms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginEnd="@dimen/_3sdp"
            app:layout_constraintBottom_toBottomOf="@+id/auto_cashout_toggle"
            app:layout_constraintEnd_toStartOf="@+id/auto_cashout_toggle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/auto_cashout_toggle"
            style="@style/TextPrimaryBold"/>
        <com.sportygames.sportyherov2.components.SHBetToggle
            android:id="@+id/auto_cashout_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/auto_cashout_text"
            app:layout_constraintTop_toTopOf="parent"/>
        <RelativeLayout
            android:id="@+id/cashout_layout"
            android:visibility="invisible"
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_16sdp"
            android:layout_marginStart="5dp"
            app:layout_constraintBottom_toBottomOf="@+id/auto_cashout_toggle"
            app:layout_constraintStart_toEndOf="@+id/auto_cashout_toggle"
            app:layout_constraintTop_toTopOf="@+id/auto_cashout_toggle">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cashout_amount_layout"
                android:background="@drawable/sh_cashout_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="@dimen/_8ssp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/cashout_amount"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/cross"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TextPrimaryBold"/>
                <TextView
                    android:textSize="@dimen/_8ssp"
                    android:textColor="@color/white"
                    android:id="@+id/cross"
                    android:layout_width="4dp"
                    android:layout_height="10dp"
                    android:src="@drawable/close_icon"
                    android:text="x"
                    android:includeFontPadding="false"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/cashout_amount"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TextPrimaryBold"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </RelativeLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/spacer_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.09"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_auto_bet"/>
    <TextView
        android:textSize="@dimen/_7ssp"
        android:textColor="@color/color_CCCCCC"
        android:gravity="center"
        android:id="@+id/min_text"
        android:tag="@string/min_text_cms"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_1sdp"
        android:text="Min"
        android:layout_marginStart="1dp"
        app:layout_constraintStart_toEndOf="@+id/left_space"
        app:layout_constraintTop_toBottomOf="@+id/spacer_1"
        style="@style/TextPrimaryBold"/>
    <TextView
        android:textSize="@dimen/_7ssp"
        android:textColor="@color/color_CCCCCC"
        android:gravity="center"
        android:id="@+id/min"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_1sdp"
        app:layout_constraintStart_toEndOf="@+id/min_text"
        app:layout_constraintTop_toBottomOf="@+id/spacer_1"
        style="@style/TextPrimaryBold"/>
    <TextView
        android:textSize="@dimen/_7ssp"
        android:textColor="@color/color_CCCCCC"
        android:gravity="center"
        android:id="@+id/max"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_1sdp"
        app:layout_constraintEnd_toEndOf="@+id/bet_amountbox"
        app:layout_constraintTop_toBottomOf="@+id/spacer_1"
        style="@style/TextPrimaryBold"/>
    <TextView
        android:textSize="@dimen/_7ssp"
        android:textColor="@color/color_CCCCCC"
        android:gravity="center"
        android:id="@+id/max_text"
        android:tag="@string/max_text_cms"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_1sdp"
        android:text="Max"
        android:layout_marginEnd="1dp"
        app:layout_constraintEnd_toStartOf="@+id/max"
        app:layout_constraintTop_toBottomOf="@+id/spacer_1"
        style="@style/TextPrimaryBold"/>
    <View
        android:id="@+id/spacer_2"
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/min_text"/>
    <View
        android:id="@+id/blur_1"
        android:background="@drawable/card_bet_amount_blur"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="-1dp"
        app:layout_constraintHeight_percent="0.28"
        app:layout_constraintStart_toEndOf="@+id/left_space"
        app:layout_constraintTop_toBottomOf="@+id/spacer_2"
        app:layout_constraintWidth_percent="0.465"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bet_amountbox"
        android:background="@drawable/sh_card_bet_amount_background_v2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="-1dp"
        app:layout_constraintHeight_percent="0.28"
        app:layout_constraintStart_toEndOf="@+id/left_space"
        app:layout_constraintTop_toBottomOf="@+id/spacer_2"
        app:layout_constraintWidth_percent="0.465">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center"
            android:id="@+id/minus_layout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:layout_marginHorizontal="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHeight_percent="0.6"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.109">
            <ImageView
                android:gravity="center"
                android:id="@+id/minus"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/minus"/>
            <ImageView
                android:gravity="center"
                android:id="@+id/gift_box"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/gift_box"
                android:layout_centerVertical="true"
                android:scaleX="0.96"
                android:scaleY="0.96"
                app:layout_constraintWidth_default="percent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="@dimen/_12ssp"
            android:textColor="@color/auto_bet_cashout_color"
            android:gravity="center"
            android:id="@+id/amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/plus_layout"
            app:layout_constraintStart_toEndOf="@+id/minus_layout"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.5"
            style="@style/TextPrimaryBold"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center"
            android:id="@+id/plus_layout"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:src="@drawable/plus"
            android:layout_marginHorizontal="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.6"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.109">
            <ImageView
                android:gravity="center"
                android:id="@+id/plus"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/plus"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:gravity="center"
                android:id="@+id/cross_fbg"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/fbg_cross_ic"
                android:scaleX="1.2"
                android:scaleY="1.2"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/spacer_3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="@+id/guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bet_amountbox"/>
    <View
        android:gravity="center"
        android:id="@+id/blur_2"
        android:background="@drawable/card_bet_amount_blur"
        android:paddingLeft="8dp"
        android:paddingTop="3dp"
        android:paddingRight="8dp"
        android:paddingBottom="3dp"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_space"
        app:layout_constraintStart_toStartOf="@+id/bet_amountbox"
        app:layout_constraintTop_toBottomOf="@+id/spacer_3"
        app:layout_constraintWidth_percent="@dimen/amount_width_percent"/>
    <TextView
        android:textSize="@dimen/_10ssp"
        android:textColor="@color/color_b3b3b3"
        android:gravity="center"
        android:id="@+id/hint_amount1"
        android:background="@drawable/sh_hint_v2"
        android:paddingLeft="8dp"
        android:paddingTop="3dp"
        android:paddingRight="8dp"
        android:paddingBottom="3dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:includeFontPadding="false"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_space"
        app:layout_constraintStart_toStartOf="@+id/bet_amountbox"
        app:layout_constraintTop_toBottomOf="@+id/spacer_3"
        app:layout_constraintWidth_percent="@dimen/amount_width_percent"
        style="@style/TextPrimaryMedium"/>
    <ImageView
        android:gravity="center"
        android:id="@+id/fbg_icon"
        android:background="@drawable/sh_hint_v2"
        android:padding="4dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/fbg_icon"
        app:layout_constraintBottom_toBottomOf="@+id/hint_amount1"
        app:layout_constraintStart_toStartOf="@+id/bet_amountbox"
        app:layout_constraintTop_toBottomOf="@+id/spacer_3"
        app:layout_constraintWidth_percent="@dimen/amount_width_percent"
        style="@style/TextPrimaryMedium"/>
    <TextView
        android:textSize="@dimen/_10ssp"
        android:textColor="@color/color_b3b3b3"
        android:gravity="center"
        android:id="@+id/hint_fbg_selected"
        android:background="@drawable/sh_fbg_hint_selected"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="@+id/hint_amount1"
        app:layout_constraintStart_toStartOf="@+id/bet_amountbox"
        app:layout_constraintTop_toBottomOf="@+id/spacer_3"
        app:layout_constraintWidth_percent="@dimen/amount_width_percent"
        style="@style/TextPrimaryMedium"/>
    <TextView
        android:textSize="@dimen/_10ssp"
        android:textColor="@color/color_b3b3b3"
        android:gravity="center"
        android:id="@+id/hint_amount1_selected"
        android:background="@drawable/sh_hint_selected_v2"
        android:paddingLeft="8dp"
        android:paddingTop="3dp"
        android:paddingRight="8dp"
        android:paddingBottom="3dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:includeFontPadding="false"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        app:layout_constraintStart_toStartOf="@+id/bet_amountbox"
        app:layout_constraintTop_toBottomOf="@+id/spacer_3"
        app:layout_constraintWidth_percent="@dimen/amount_width_percent"
        style="@style/TextPrimaryMedium"/>
    <View
        android:gravity="center"
        android:id="@+id/blur_3"
        android:background="@drawable/card_bet_amount_blur"
        android:paddingLeft="8dp"
        android:paddingTop="3dp"
        android:paddingRight="8dp"
        android:paddingBottom="3dp"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        app:layout_constraintEnd_toStartOf="@+id/hint_amount3"
        app:layout_constraintStart_toEndOf="@+id/hint_amount1"
        app:layout_constraintTop_toBottomOf="@+id/spacer_3"
        app:layout_constraintWidth_percent="@dimen/amount_width_percent"/>
    <TextView
        android:textSize="@dimen/_10ssp"
        android:textColor="@color/color_b3b3b3"
        android:gravity="center"
        android:id="@+id/hint_amount2"
        android:background="@drawable/sh_hint_v2"
        android:paddingLeft="8dp"
        android:paddingTop="3dp"
        android:paddingRight="8dp"
        android:paddingBottom="3dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:includeFontPadding="false"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        app:layout_constraintEnd_toStartOf="@+id/hint_amount3"
        app:layout_constraintStart_toEndOf="@+id/hint_amount1"
        app:layout_constraintTop_toBottomOf="@+id/spacer_3"
        app:layout_constraintWidth_percent="@dimen/amount_width_percent"
        style="@style/TextPrimaryMedium"/>
    <TextView
        android:textSize="@dimen/_10ssp"
        android:textColor="@color/color_b3b3b3"
        android:gravity="center"
        android:id="@+id/hint_amount2_selected"
        android:background="@drawable/sh_hint_selected_v2"
        android:paddingLeft="8dp"
        android:paddingTop="3dp"
        android:paddingRight="8dp"
        android:paddingBottom="3dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:includeFontPadding="false"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        app:layout_constraintEnd_toStartOf="@+id/hint_amount3"
        app:layout_constraintStart_toEndOf="@+id/hint_amount1"
        app:layout_constraintTop_toBottomOf="@+id/spacer_3"
        app:layout_constraintWidth_percent="@dimen/amount_width_percent"
        style="@style/TextPrimaryMedium"/>
    <View
        android:gravity="center"
        android:id="@+id/blur_4"
        android:background="@drawable/card_bet_amount_blur"
        android:paddingLeft="8dp"
        android:paddingTop="3dp"
        android:paddingRight="8dp"
        android:paddingBottom="3dp"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        app:layout_constraintEnd_toEndOf="@+id/bet_amountbox"
        app:layout_constraintTop_toBottomOf="@+id/spacer_3"/>
    <TextView
        android:textSize="@dimen/_10ssp"
        android:textColor="@color/color_b3b3b3"
        android:gravity="center"
        android:id="@+id/hint_amount3"
        android:background="@drawable/sh_hint_v2"
        android:paddingLeft="8dp"
        android:paddingTop="3dp"
        android:paddingRight="8dp"
        android:paddingBottom="3dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:includeFontPadding="false"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        app:layout_constraintEnd_toEndOf="@+id/bet_amountbox"
        app:layout_constraintTop_toBottomOf="@+id/spacer_3"
        style="@style/TextPrimaryMedium"/>
    <TextView
        android:textSize="@dimen/_10ssp"
        android:textColor="@color/color_b3b3b3"
        android:gravity="center"
        android:id="@+id/hint_amount3_selected"
        android:background="@drawable/sh_hint_selected_v2"
        android:paddingLeft="8dp"
        android:paddingTop="3dp"
        android:paddingRight="8dp"
        android:paddingBottom="3dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:includeFontPadding="false"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        app:layout_constraintEnd_toEndOf="@+id/bet_amountbox"
        app:layout_constraintTop_toBottomOf="@+id/spacer_3"
        style="@style/TextPrimaryMedium"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bet_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_space"
        app:layout_constraintEnd_toStartOf="@+id/right_space"
        app:layout_constraintTop_toBottomOf="@+id/spacer_2"
        app:layout_constraintWidth_percent="0.465">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/guideline1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.52"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bet_button"
            android:background="@drawable/bet_button_sh_v2"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/gif"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:alpha="0.4"/>
            <ImageView
                android:id="@+id/bet_button_football_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="fitXY"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
            <TextView
                android:textSize="@dimen/_12ssp"
                android:gravity="center"
                android:id="@+id/bet_text"
                android:tag="@string/bet_upper_case_cms"
                android:visibility="visible"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BET"
                android:maxLines="2"
                android:shadowColor="#29000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="2"
                android:paddingStart="@dimen/_4sdp"
                android:paddingEnd="@dimen/_3sdp"
                android:autoSizeTextType="uniform"
                android:autoSizeStepGranularity="@dimen/_1ssp"
                android:autoSizeMinTextSize="@dimen/_10ssp"
                android:autoSizeMaxTextSize="@dimen/_12ssp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextPrimaryMedium"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="@dimen/_12ssp"
            android:gravity="center"
            android:id="@+id/cashout_button"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:shadowColor="#29000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="2"
            android:paddingStart="@dimen/_4sdp"
            android:paddingEnd="@dimen/_3sdp"
            style="@style/TextPrimaryMedium"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center"
            android:id="@+id/waiting_button"
            android:background="@drawable/waiting_btn_sh"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TextPrimaryMedium">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_8ssp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/waiting"
                android:tag="@string/waiting_for_next_round_cms"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:lineSpacingExtra="@dimen/_1sdp"
                android:breakStrategy="simple"
                android:autoSizeTextType="uniform"
                android:autoSizeStepGranularity="@dimen/_1ssp"
                android:autoSizeMinTextSize="@dimen/_6ssp"
                app:autoSizeMaxTextSize="@dimen/_8ssp"
                app:layout_constraintBottom_toTopOf="@+id/extra_space"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintWidth_percent="0.6"
                style="@style/TextPrimaryMedium"/>
            <View
                android:id="@+id/extra_space"
                android:layout_width="wrap_content"
                android:layout_height="3dp"
                app:layout_constraintBottom_toTopOf="@+id/progress"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/waiting"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/progress"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:indeterminate="true"
                android:indeterminateDrawable="@drawable/progress_sh"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/extra_space">
                <ProgressBar
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:indeterminate="true"
                    android:indeterminateDrawable="@drawable/progress_sh"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/ProgressColor"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/place_bet_text_layout"
            android:background="@drawable/bg_classic_placebet"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.543"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="@dimen/_8ssp"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/place_bet_text"
                    android:paddingLeft="@dimen/_2sdp"
                    android:paddingTop="@dimen/_2sdp"
                    android:paddingRight="@dimen/_2sdp"
                    android:paddingBottom="@dimen/_2sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lines="1"
                    android:includeFontPadding="false"
                    android:autoSizeTextType="uniform"
                    android:autoSizeStepGranularity="@dimen/_1ssp"
                    android:autoSizeMinTextSize="@dimen/_6ssp"
                    android:paddingHorizontal="@dimen/_2sdp"
                    android:paddingVertical="@dimen/_2sdp"
                    android:autoSizeMaxTextSize="@dimen/_8ssp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TextPrimaryMedium"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/spacer_4"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@+id/place_bet_text_layout"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center"
            android:id="@+id/cross_bet"
            android:background="@drawable/sh_close_bg_classic"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="2.5dp"
            android:layout_marginStart="@dimen/_2sdp"
            android:layout_marginEnd="@dimen/_3sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/place_bet"
            app:layout_constraintHeight_percent="0.35"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="@+id/place_bet_text_layout"
            app:layout_constraintTop_toBottomOf="@+id/spacer_4">
            <ImageView
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/sh_cross"
                android:paddingVertical="2dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextPrimaryMedium"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center"
            android:id="@+id/place_bet"
            android:background="@drawable/sh_place_bet_bg_classic"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="2.5dp"
            android:layout_marginStart="@dimen/_3sdp"
            android:layout_marginEnd="@dimen/_2sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/place_bet_text_layout"
            app:layout_constraintHeight_percent="0.35"
            app:layout_constraintStart_toEndOf="@+id/cross_bet"
            app:layout_constraintTop_toBottomOf="@+id/spacer_4">
            <ImageView
                android:gravity="center"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_width="14dp"
                android:layout_height="12dp"
                android:src="@drawable/sh_tick"
                android:paddingVertical="2dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextPrimaryMedium"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/_10ssp"
        android:textColor="@color/sh_bet_card_text_dark_theme"
        android:gravity="center"
        android:id="@+id/hint_amount4"
        android:background="@drawable/sh_hint_v2"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.2"
        style="@style/TextPrimaryMedium"/>
    <TextView
        android:textSize="@dimen/_10ssp"
        android:textColor="@color/sh_bet_card_text_dark_theme"
        android:gravity="center"
        android:id="@+id/hint_amount4_selected"
        android:background="@drawable/sh_hint_selected_v2"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.2"
        style="@style/TextPrimaryMedium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
