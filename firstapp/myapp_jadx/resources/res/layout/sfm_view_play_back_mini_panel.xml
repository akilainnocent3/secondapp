<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/sfm_bg_boarder_sporty_green"
    android:layout_width="wrap_content"
    android:layout_height="28dp">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/left_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="10dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/icon_fm_logo"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/left_guideline"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/sfm_ic_fm_logo"
        app:tint="@color/brand_secondary_variable_type3"/>
    <TextView
        android:textSize="10dp"
        android:textStyle="normal"
        android:textColor="@color/brand_secondary_variable_type3"
        android:id="@+id/label_sporty_fm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:text="@string/sfm_sporty_fm"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/icon_fm_logo"
        app:layout_constraintStart_toEndOf="@+id/icon_fm_logo"
        app:layout_constraintTop_toTopOf="@+id/icon_fm_logo"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/player_status"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginLeft="4dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/label_sporty_fm"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/sfm_ic_sound_wave_off"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/play_btn"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="10dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/player_status"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/sfm_ic_fm_playback_selector"/>
</merge>
