<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toggle_container"
    android:layout_width="@dimen/_32sdp"
    android:layout_height="@dimen/_12sdp">
    <View
        android:id="@+id/toggle_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_toggle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:weightSum="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center"
            android:id="@+id/on_textview"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/_6sdp">
            <TextView
                android:textSize="@dimen/_8ssp"
                android:gravity="center"
                android:id="@+id/count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAlignment="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextPrimaryMedium"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/switch_circle"
            android:layout_width="@dimen/_9sdp"
            android:layout_height="@dimen/_9sdp"
            android:layout_marginLeft="1.5dp"
            android:layout_marginRight="1.5dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:backgroundTint="@color/sh_valentine"
            android:layout_marginHorizontal="1.5dp"
            app:shapeAppearance="@style/ShapeAppearanceOverlay.App.CornerSize50Percent"
            style="@style/Widget.MaterialComponents.Button"/>
        <ImageButton
            android:id="@+id/switch_heart"
            android:background="@drawable/favorite"
            android:visibility="gone"
            android:layout_width="@dimen/_14sdp"
            android:layout_height="@dimen/_14sdp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:backgroundTint="@color/sh_valentine"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/off_textview"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/_3sdp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</FrameLayout>
