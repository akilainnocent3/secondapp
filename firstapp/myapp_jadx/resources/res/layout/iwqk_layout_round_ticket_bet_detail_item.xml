<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/background_general_primary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp">
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/brand_tertiary"
        android:gravity="center"
        android:id="@+id/bet_type"
        android:background="@color/brand_secondary"
        android:paddingLeft="8dp"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginLeft="50dp"
        android:layout_marginRight="20dp"/>
    <com.sportybet.android.instantwin.presentation.widget.RoundTicketBetDetailReturnInfoLayout
        android:id="@+id/return_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="55dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="20dp"/>
    <com.sportybet.android.instantwin.presentation.widget.RoundTicketBetInfoLayout
        android:id="@+id/bet_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="20dp"/>
</LinearLayout>
