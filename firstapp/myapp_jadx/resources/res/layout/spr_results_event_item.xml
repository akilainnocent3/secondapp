<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="60dp">
    <TextView
        android:textSize="10dp"
        android:textStyle="normal"
        android:textColor="@color/text_type2_tertiary"
        android:gravity="center_horizontal"
        android:id="@+id/results_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14dp"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="6.8sp"
        android:fontFamily="sans-serif"/>
    <TextView
        android:textSize="10dp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_primary"
        android:gravity="center_horizontal"
        android:id="@+id/results_game_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_alignLeft="@+id/results_date"
        android:layout_alignParentBottom="true"
        android:lineSpacingExtra="6.8sp"
        android:fontFamily="sans-serif"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_primary"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/results_home_team"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="80dp"
        android:maxLines="2"
        android:layout_centerVertical="true"
        android:lineSpacingExtra="2.8sp"
        android:fontFamily="sans-serif"/>
    <TextView
        android:textStyle="bold"
        android:textColor="@color/text_type2_primary"
        android:gravity="center"
        android:id="@+id/results_spinner"
        android:background="@color/background_type2_secondary"
        android:layout_width="80dp"
        android:layout_height="22dp"
        android:layout_marginLeft="14dp"
        android:layout_toRightOf="@+id/results_home_team"
        android:layout_centerVertical="true"
        android:lineSpacingExtra="2.8sp"
        android:dropDownWidth="156dp"/>
    <TextView
        android:textSize="10dp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/results_time"
        android:layout_width="80dp"
        android:layout_height="17dp"
        android:layout_above="@+id/results_spinner"
        android:layout_alignLeft="@+id/results_spinner"
        android:lineSpacingExtra="6.8sp"
        android:fontFamily="sans-serif-medium"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_primary"
        android:gravity="start"
        android:id="@+id/results_away_team"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14dp"
        android:maxLines="2"
        android:layout_toRightOf="@+id/results_spinner"
        android:layout_centerVertical="true"
        android:lineSpacingExtra="2.8sp"
        android:fontFamily="sans-serif"
        android:layout_toEndOf="@+id/results_spinner"/>
    <View
        android:id="@+id/bottom_line"
        android:background="@color/background_type1_primary"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
