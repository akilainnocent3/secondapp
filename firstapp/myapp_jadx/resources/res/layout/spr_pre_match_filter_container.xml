<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:id="@+id/sports_expand_tab_layout"
    android:layout_width="match_parent"
    android:layout_height="42dp">
    <com.sportybet.plugin.realsports.widget.PreMatchSpinnerTextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:gravity="center_vertical"
        android:id="@+id/time_btn"
        android:paddingLeft="8dp"
        android:paddingRight="4dp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:text="@string/common_functions__time"
        android:maxLines="1"
        android:drawablePadding="2dp"
        android:layout_weight="1"
        android:lineSpacingExtra="2.8dp"
        android:textAllCaps="false"
        android:paddingStart="8dp"
        android:paddingEnd="4dp"
        app:autoSizeMaxTextSize="14dp"
        app:autoSizeMinTextSize="10dp"
        app:autoSizeTextType="uniform"/>
    <View
        android:background="@color/line_type1_primary"
        android:layout_width="1dp"
        android:layout_height="match_parent"/>
    <com.sportybet.plugin.realsports.widget.PreMatchSpinnerTextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:gravity="center_vertical"
        android:id="@+id/league_btn"
        android:paddingLeft="8dp"
        android:paddingRight="4dp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:text="@string/common_functions__league"
        android:maxLines="2"
        android:drawablePadding="2dp"
        android:layout_weight="1"
        android:lineSpacingExtra="2.8dp"
        android:textAllCaps="false"
        android:paddingStart="8dp"
        android:paddingEnd="4dp"
        app:autoSizeMaxTextSize="14dp"
        app:autoSizeMinTextSize="10dp"
        app:autoSizeTextType="uniform"/>
    <View
        android:background="@color/line_type1_primary"
        android:layout_width="1dp"
        android:layout_height="match_parent"/>
    <com.sportybet.plugin.realsports.widget.PreMatchSpinnerTextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:gravity="center_vertical"
        android:id="@+id/odds_btn"
        android:paddingLeft="8dp"
        android:paddingRight="4dp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:text="@string/common_functions__odds_txt"
        android:singleLine="true"
        android:drawablePadding="2dp"
        android:layout_weight="1"
        android:lineSpacingExtra="2.8dp"
        android:textAllCaps="false"
        android:paddingStart="8dp"
        android:paddingEnd="4dp"/>
    <View
        android:background="@color/line_type1_primary"
        android:layout_width="1dp"
        android:layout_height="match_parent"/>
    <com.sportybet.plugin.realsports.widget.PreMatchSpinnerTextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:gravity="center_vertical"
        android:id="@+id/sort_btn"
        android:paddingLeft="8dp"
        android:paddingRight="4dp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:text="@string/common_functions__sort"
        android:singleLine="true"
        android:drawablePadding="2dp"
        android:layout_weight="1"
        android:lineSpacingExtra="2.8dp"
        android:textAllCaps="false"
        android:paddingStart="8dp"
        android:paddingEnd="4dp"/>
</merge>
