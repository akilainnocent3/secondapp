<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parent_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/wheel_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:id="@+id/container_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.cardview.widget.CardView
                android:layout_gravity="center"
                android:id="@+id/wheel_layout_shadow"
                android:background="@color/sg_color_cfba8d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/sg_color_cfba8d"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/game_header">
                <ImageView
                    android:layout_gravity="start"
                    android:id="@+id/white_line_1"
                    android:background="@drawable/sg_spin2win_white_grad1"
                    android:layout_width="@dimen/_50sdp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="-50dp"/>
                <ImageView
                    android:layout_gravity="start"
                    android:id="@+id/white_line_2"
                    android:background="@drawable/sg_spin2win_white_grad1"
                    android:layout_width="@dimen/_50sdp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="-50dp"/>
                <ImageView
                    android:layout_gravity="start"
                    android:id="@+id/white_line_3"
                    android:background="@drawable/sg_spin2win_white_grad1"
                    android:layout_width="@dimen/_50sdp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="-50dp"/>
            </androidx.cardview.widget.CardView>
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/circle_2"
                android:background="@color/sg_color_6a0d00"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/_7sdp"
                android:translationZ="10dp"
                app:shapeAppearanceOverlay="@style/roundedImageViewRounded"/>
            <ImageView
                android:id="@+id/wheel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/_7sdp"
                android:rotation="10"
                android:translationZ="12dp"
                app:shapeAppearanceOverlay="@style/roundedImageViewRounded"/>
            <TextView
                android:textSize="@dimen/_14sdp"
                android:textColor="@color/sg_color_cfba8d"
                android:layout_gravity="top|center_horizontal"
                android:id="@+id/pin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼"
                android:translationZ="13dp"/>
        </FrameLayout>
        <androidx.cardview.widget.CardView
            android:layout_gravity="center"
            android:id="@+id/wheel_layout_shadow_2"
            android:background="@color/sg_color_cfba8d"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:translationZ="0dp"
            android:elevation="0dp"
            android:backgroundTint="@color/sg_color_cfba8d"
            app:cardCornerRadius="200dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.3">
            <ImageView
                android:layout_gravity="start"
                android:id="@+id/white_line_4"
                android:background="@drawable/sg_spin2win_white_grad1"
                android:visibility="gone"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="match_parent"
                android:layout_marginStart="-60dp"/>
            <ImageView
                android:layout_gravity="start"
                android:id="@+id/white_line_5"
                android:background="@drawable/sg_spin2win_white_grad1"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="match_parent"
                android:layout_marginStart="-30dp"/>
            <ImageView
                android:layout_gravity="start"
                android:id="@+id/white_line_6"
                android:background="@drawable/sg_spin2win_white_grad1"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="match_parent"/>
        </androidx.cardview.widget.CardView>
        <com.google.android.material.imageview.ShapeableImageView
            android:layout_gravity="center"
            android:id="@+id/white_circle"
            android:background="@drawable/sg_spin2win_wheel_bg_white"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:translationZ="@dimen/_10sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.25"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.25"
            app:shapeAppearanceOverlay="@style/roundedImageViewRounded"/>
        <com.google.android.material.imageview.ShapeableImageView
            android:layout_gravity="center"
            android:id="@+id/bg_house_draw"
            android:background="@color/sb_black_100"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleX="0"
            android:scaleY="0"
            android:translationZ="@dimen/_11sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.18"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.18"
            app:shapeAppearanceOverlay="@style/roundedImageViewRounded"/>
        <TextView
            android:textSize="@dimen/_15sdp"
            android:textColor="@color/white"
            android:layout_gravity="center"
            android:id="@+id/tv_house_draw"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleX="0"
            android:scaleY="0"
            android:translationZ="@dimen/_12sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/roundedImageViewRounded"
            style="@style/TextPrimaryBold"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/you_win_layout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/_20sdp"
            android:scaleX="0"
            android:scaleY="0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="1">
            <ImageView
                android:id="@+id/ic_you_win"
                android:tag="you_win_img:sg_game_name"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/_13sdp"
                android:adjustViewBounds="true"
                android:scaleX="0.8"
                android:scaleY="0.8"
                app:layout_constraintBottom_toTopOf="@+id/win_amount_normal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.7"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.9"/>
            <ImageView
                android:id="@+id/win_amount_normal"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ic_you_win"
                app:layout_constraintWidth_percent="0.7"/>
            <TextView
                android:textSize="@dimen/_15sdp"
                android:textColor="@color/white"
                android:id="@+id/tv_win_amount_normal"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_5sdp"
                app:layout_constraintBottom_toBottomOf="@+id/win_amount_normal"
                app:layout_constraintEnd_toEndOf="@+id/win_amount_normal"
                app:layout_constraintStart_toStartOf="@+id/win_amount_normal"
                app:layout_constraintTop_toTopOf="@+id/win_amount_normal"
                style="@style/TextPrimaryBold"/>
            <ImageView
                android:id="@+id/win_amount_fbg"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ic_you_win"
                app:layout_constraintWidth_percent="0.8"/>
            <TextView
                android:textSize="@dimen/_15sdp"
                android:textColor="@color/white"
                android:id="@+id/tv_win_amount_fbg"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/layout_gift_amt"
                app:layout_constraintEnd_toEndOf="@+id/win_amount_fbg"
                app:layout_constraintStart_toStartOf="@+id/win_amount_fbg"
                app:layout_constraintTop_toTopOf="@+id/win_amount_fbg"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/TextPrimaryBold"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/layout_gift_amt"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_8sdp"
                android:alpha="0.6"
                app:layout_constraintBottom_toBottomOf="@+id/win_amount_fbg"
                app:layout_constraintEnd_toEndOf="@+id/win_amount_fbg"
                app:layout_constraintStart_toStartOf="@+id/win_amount_fbg"
                app:layout_constraintTop_toBottomOf="@+id/tv_win_amount_fbg">
                <TextView
                    android:textSize="@dimen/_8sdp"
                    android:textColor="@color/white"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="("
                    style="@style/TextPrimaryRegular"/>
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="@dimen/_14sdp"
                    android:layout_height="@dimen/_14sdp"
                    app:srcCompat="@drawable/sporty_trophy"/>
                <TextView
                    android:textSize="@dimen/_8sdp"
                    android:textColor="@color/white"
                    android:id="@+id/left_amt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_2sdp"
                    style="@style/TextPrimaryRegular"/>
                <TextView
                    android:textSize="@dimen/_8sdp"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" - "
                    style="@style/TextPrimaryRegular"/>
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="@dimen/_13sdp"
                    android:layout_height="@dimen/_13sdp"
                    app:srcCompat="@drawable/gift_icon_bethistory"/>
                <TextView
                    android:textSize="@dimen/_8sdp"
                    android:textColor="@color/white"
                    android:id="@+id/right_amt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_2sdp"
                    style="@style/TextPrimaryRegular"/>
                <TextView
                    android:textSize="@dimen/_8sdp"
                    android:textColor="@color/white"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=")"
                    style="@style/TextPrimaryRegular"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/you_lose_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleX="0"
            android:scaleY="0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/_34sdp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/lose_text_1"
                android:tag="@string/key_loose_message_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sg_sorry_better"
                android:includeFontPadding="false"
                app:layout_constraintBottom_toTopOf="@+id/lose_text_2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextPrimaryBold"/>
            <TextView
                android:textSize="@dimen/_34sdp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/lose_text_2"
                android:tag="@string/key_loose_message_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sg_luck_next_time"
                android:includeFontPadding="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/lose_text_1"
                style="@style/TextPrimaryBold"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
