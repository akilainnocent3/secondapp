<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/custom_background_type2_secondary_type1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/text_type2_primary"
        android:gravity="center"
        android:id="@+id/betslip_num"
        android:background="@drawable/spr_shape_bg_green_circle_24dp"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:fontFamily="sans-serif"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="17dp"
        android:textColor="@color/text_type2_primary"
        android:gravity="center_vertical"
        android:id="@+id/betslip_label"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/common_functions__betslip"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/betslip_num"
        app:layout_constraintStart_toEndOf="@+id/betslip_num"
        app:layout_constraintTop_toTopOf="@+id/betslip_num"
        style="@style/Title1Bold"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/collapse_icon_container"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageButton
            android:id="@+id/collapse_icon"
            android:background="?android:attr/selectableItemBackground"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:srcCompat="@drawable/spr_arrow_down_white_32_32dp"
            app:tint="@color/text_type2_primary"/>
        <android.widget.Space
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </LinearLayout>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/text_type2_primary"
        android:gravity="end|center_vertical"
        android:id="@+id/login"
        android:background="?android:attr/selectableItemBackground"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:text="@string/common_functions__log_in"
        android:layout_toLeftOf="@+id/divide_line"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/divide_line"
        android:background="@color/text_type2_primary"
        android:layout_width="1dp"
        android:layout_height="20dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_toLeftOf="@+id/login"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/login"
        app:layout_constraintEnd_toStartOf="@+id/login"
        app:layout_constraintTop_toTopOf="@+id/login"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/text_type2_primary"
        android:gravity="end|center_vertical"
        android:id="@+id/register"
        android:background="?android:attr/selectableItemBackground"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:text="@string/common_functions__register"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/login"
        app:layout_constraintEnd_toStartOf="@+id/divide_line"
        app:layout_constraintTop_toTopOf="@+id/login"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/highlight"
        android:gravity="center_vertical"
        android:id="@+id/cash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:fontFamily="sans-serif"
        app:layout_constraintBottom_toBottomOf="@+id/betslip_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/betslip_label"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/text_type2_primary"
        android:gravity="center_vertical"
        android:id="@+id/cancel_edit"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:text="@string/common_functions__cancel_edit"
        android:fontFamily="sans-serif"
        app:layout_constraintBottom_toBottomOf="@+id/betslip_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/betslip_label"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sim_desc_and_games_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="58dp"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toTopOf="@+id/type_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/sim_desc_container"
            android:layout_width="68dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/how_to_play_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_icon_sim_how_to_play"/>
            <TextView
                android:textColor="@color/text_type2_primary"
                android:gravity="center"
                android:id="@+id/how_to_play_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/common_helps__how_to_play"
                style="@style/CaptionMedium"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/sim_bet_history_container"
            android:layout_width="68dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:minWidth="58dp"
            app:layout_constraintStart_toEndOf="@+id/sim_desc_container"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/sim_bet_history_img"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_icon_sim_bet_history_white"/>
                <ImageView
                    android:id="@+id/sim_bet_history_hint"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/red_point_hint"
                    app:layout_constraintStart_toStartOf="@+id/sim_bet_history_img"
                    app:layout_constraintTop_toTopOf="@+id/sim_bet_history_img"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textColor="@color/text_type2_primary"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/sim_bet_history_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/common_functions__bet_history"
                style="@style/CaptionMedium"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:id="@+id/real2sim_switch"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_centerVertical="true"
        app:layout_constraintBottom_toBottomOf="@+id/betslip_num"
        app:layout_constraintStart_toEndOf="@+id/betslip_num"
        app:layout_constraintTop_toTopOf="@+id/betslip_num"
        layout="@layout/layout_real_sim_switch"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/sim_notify_badge"
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="12dp"
        app:layout_constraintStart_toEndOf="@+id/real2sim_switch"
        app:layout_constraintTop_toTopOf="@+id/real2sim_switch"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/remove_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/type_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/real2sim_switch">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/auto_bet_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic__feature__auto__bet"
                app:tint="@color/white"/>
            <TextView
                android:textColor="@color/text_type2_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/component_betslip__auto_bet"
                android:layout_marginStart="2dp"
                style="@style/B2_R"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/sim_remove_all"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/sim_remove_all_img"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic__delete"
                app:tint="@color/white"/>
            <TextView
                android:textColor="@color/text_type2_primary"
                android:id="@+id/sim_remove_all_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/component_betslip__remove_all"
                android:layout_marginStart="2dp"
                style="@style/B2_R"/>
        </LinearLayout>
        <View
            android:id="@+id/settings_divide_line"
            android:background="@color/text_type2_primary"
            android:visibility="gone"
            android:layout_width="1dp"
            android:layout_height="15dp"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:layout_marginHorizontal="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/remove_all"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/remove_all"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic__delete"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/bet_settings"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white"/>
        <ImageView
            android:id="@+id/bet_settings"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic__settings"
            android:layout_marginEnd="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/bet_settings_flag"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white"/>
        <ImageView
            android:id="@+id/bet_settings_flag"
            android:visibility="gone"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:src="@drawable/shape_red_circle_item_18_bg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.65"
            app:layout_constraintTop_toTopOf="@+id/bet_settings"
            app:layout_constraintVertical_bias="0.3"
            app:tint="@color/brand_primary"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/betslip_type_dropdown"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/remove_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/remove_container"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/type_container"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:layout_below="@+id/remove_container"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/remove_container">
        <Button
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/text_color_text_type2_secondary_with_text_type1_primary"
            android:id="@+id/singles"
            android:background="@drawable/spr_betslip_type_selector"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="@string/component_betslip__singles"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:fontFamily="sans-serif"
            android:paddingHorizontal="14dp"/>
        <Button
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/text_color_text_type2_secondary_with_text_type1_primary"
            android:gravity="center"
            android:id="@+id/multiple"
            android:background="@drawable/spr_betslip_type_selector"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="@string/component_betslip__multiple"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:fontFamily="sans-serif"
            android:paddingHorizontal="14dp"/>
        <Button
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/text_color_text_type2_secondary_with_text_type1_primary"
            android:id="@+id/system"
            android:background="@drawable/spr_betslip_type_selector"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="6dp"
            android:text="@string/component_betslip__system"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:fontFamily="sans-serif"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
