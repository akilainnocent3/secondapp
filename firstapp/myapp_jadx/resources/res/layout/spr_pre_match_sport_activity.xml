<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/action_bar_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/simple_action_bar"/>
    <com.sportybet.plugin.realsports.prematch.widget.LiveTogglesContainer
        android:orientation="horizontal"
        android:id="@+id/live_toggles_container"
        android:background="@color/background_type2_primary"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="36dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"/>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/refresh_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/stub"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/live_toggles_container">
        <com.sportybet.plugin.realsports.prematch.widget.InterceptConsecutiveScrollerLayout
            android:id="@+id/scroll_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            app:autoAdjustHeightAtBottomView="true">
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/background_type2_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_isSticky="true">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.sportybet.plugin.realsports.prematch.widget.MarketsTabs
                        android:id="@+id/live_market_tabs"
                        android:background="@color/background_type2_primary"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        app:tabIndicatorColor="@color/brand_secondary"
                        app:tabIndicatorHeight="2dp"
                        app:tabMinWidth="0dp"
                        app:tabMode="scrollable"
                        app:tabPaddingEnd="10dp"
                        app:tabPaddingStart="10dp"
                        app:tabSelectedTextColor="@android:color/white"
                        app:tabTextAppearance="@style/CustomTabAppearance"
                        app:tabTextColor="@android:color/white"/>
                    <View
                        android:id="@+id/live_market_option_divider"
                        android:background="@color/line_type1_secondary"
                        android:visibility="gone"
                        android:layout_width="1dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"/>
                    <com.sportybet.android.widget.OneUpTwoUpSwitch
                        android:layout_gravity="center_vertical"
                        android:id="@+id/live_one_two_up_switch"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="8dp"
                        android:layout_marginRight="8dp"
                        android:layout_marginHorizontal="8dp"/>
                    <com.sportybet.android.widget.OUEarlyGoalsSwitch
                        android:layout_gravity="center_vertical"
                        android:id="@+id/live_ou_early_goals_switch"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="8dp"
                        android:layout_marginRight="8dp"
                        android:layout_marginHorizontal="8dp"/>
                </LinearLayout>
                <com.sportybet.android.widget.BubbleView
                    android:layout_gravity="end"
                    android:id="@+id/live_market_option_feature_alert"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-10dp"
                    android:layout_marginBottom="4dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    app:closable="true"
                    app:descriptionText="@string/component_betslip__early_goal_tip_desc"
                    app:title="@string/component_betslip__early_goal_tip_title"
                    app:trianglePosition="top_right"/>
                <include
                    android:id="@+id/live_market_title"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    layout="@layout/spr_live_market_title"/>
            </LinearLayout>
            <com.sportybet.plugin.realsports.prematch.widget.LiveEventsRecyclerView
                android:id="@+id/live_recycler"
                android:background="@color/background_type2_primary"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            <com.sportybet.android.widget.LoadingView
                android:id="@+id/live_loading"
                android:background="@color/background_type2_primary"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/spr_home_hei"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_isSticky="true">
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/event_type_tabs"
                    android:background="@color/background_type1_secondary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/event_tabs_layout_height"
                    app:tabBackground="@color/custom_background_type1_quaternary_type3"
                    style="@style/Widget.App.TabLayout.Default.Primary"/>
                <View
                    android:background="@color/line_type1_primary"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>
                <com.sportybet.plugin.realsports.prematch.widget.PreMatchFiltersContainer
                    android:orientation="horizontal"
                    android:id="@+id/filter_container"
                    android:background="@color/custom_background_type1_quaternary_type3"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    app:layout_isSticky="true"/>
                <View
                    android:id="@+id/filter_divider"
                    android:background="@color/line_type1_primary"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.sportybet.plugin.realsports.prematch.widget.MarketsTabs
                            android:textSize="14dp"
                            android:textStyle="bold"
                            android:textColor="@color/background_type2_primary"
                            android:id="@+id/pre_match_market_tabs"
                            android:background="@color/custom_background_type1_quaternary_type3"
                            android:visibility="gone"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:textAllCaps="false"
                            app:layout_isSticky="true"
                            app:tabBackground="@color/custom_background_type1_quaternary_type3"
                            app:tabIndicatorColor="@color/brand_secondary"
                            app:tabIndicatorHeight="4dp"
                            app:tabMode="scrollable"
                            app:tabTextAppearance="@style/CustomTabAppearance"
                            style="@style/Widget.App.TabLayout.Default.Primary"/>
                        <View
                            android:id="@+id/pre_match_market_option_divider"
                            android:background="@color/line_type1_secondary"
                            android:visibility="gone"
                            android:layout_width="1dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="8dp"/>
                        <com.sportybet.android.widget.OneUpTwoUpSwitch
                            android:layout_gravity="center_vertical"
                            android:id="@+id/pre_match_one_two_up_switch"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="8dp"
                            android:layout_marginRight="8dp"
                            android:layout_marginHorizontal="8dp"/>
                        <com.sportybet.android.widget.OUEarlyGoalsSwitch
                            android:layout_gravity="center_vertical"
                            android:id="@+id/pre_match_ou_early_goals_switch"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="8dp"
                            android:layout_marginRight="8dp"
                            android:layout_marginHorizontal="8dp"/>
                    </LinearLayout>
                    <com.sportybet.android.widget.BubbleView
                        android:layout_gravity="end"
                        android:id="@+id/pre_match_market_option_feature_alert"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-10dp"
                        android:layout_marginBottom="4dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        app:closable="true"
                        app:descriptionText="@string/component_betslip__early_goal_tip_desc"
                        app:title="@string/component_betslip__early_goal_tip_title"
                        app:trianglePosition="top_right"/>
                </LinearLayout>
                <View
                    android:id="@+id/pre_match_market_divider"
                    android:background="@color/line_type1_primary"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>
            </LinearLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_scrollChild="@+id/upcoming_recycler">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/upcoming_recycler"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.sportybet.android.widget.LoadingView
                    android:id="@+id/upcoming_loading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/spr_home_hei"/>
            </FrameLayout>
        </com.sportybet.plugin.realsports.prematch.widget.InterceptConsecutiveScrollerLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <View
        android:id="@+id/stub"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
