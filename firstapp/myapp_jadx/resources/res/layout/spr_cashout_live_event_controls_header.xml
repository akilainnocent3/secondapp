<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/stats"
        android:background="@drawable/spr_bg_tracker_btn_type1"
        android:paddingLeft="7dp"
        android:paddingTop="3dp"
        android:paddingRight="7dp"
        android:paddingBottom="3dp"
        android:layout_width="36dp"
        android:layout_height="28dp"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:layout_alignParentEnd="true"
        android:paddingHorizontal="7dp"
        android:paddingVertical="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/spr_stats"
        app:tint="@color/openbet_state_color"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/live_match_tracker"
        android:background="@drawable/spr_bg_tracker_btn_type1"
        android:layout_width="36dp"
        android:layout_height="28dp"
        android:scaleType="center"
        android:layout_toStartOf="@+id/stats"
        app:layout_constraintEnd_toStartOf="@+id/stats"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/spr_ic_match_tracker"
        app:tint="@color/openbet_lmt_color"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/games"
        android:background="@drawable/spr_bg_tracker_btn_type1"
        android:paddingLeft="7dp"
        android:paddingRight="7dp"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="28dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/common_functions__games"
        android:paddingHorizontal="7dp"
        app:layout_constraintEnd_toStartOf="@+id/streaming"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/tab_games_selector"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/streaming"
        android:background="@drawable/spr_bg_tracker_btn_type1"
        android:layout_width="36dp"
        android:layout_height="28dp"
        android:scaleType="center"
        android:layout_toStartOf="@+id/live_match_tracker"
        app:layout_constraintEnd_toStartOf="@+id/live_match_tracker"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/spr_ic_stv"
        app:tint="@color/openbet_stv_color"/>
    <ImageView
        android:id="@+id/live_event_indicator"
        android:visibility="invisible"
        android:layout_width="12dp"
        android:layout_height="8dp"
        android:layout_marginTop="28dp"
        android:src="@drawable/ic_cashout_live_event_indicator"
        app:layout_constraintEnd_toEndOf="@+id/streaming"
        app:layout_constraintStart_toStartOf="@+id/streaming"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/live_event_widgets_red_dot"
        android:background="@drawable/bg_red_dot"
        android:visibility="gone"
        android:layout_width="6dp"
        android:layout_height="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
