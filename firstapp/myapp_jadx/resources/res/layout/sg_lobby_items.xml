<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_2sdp"
        android:layout_marginStart="@dimen/_3sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.cardview.widget.CardView
            android:id="@+id/card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:layout_marginBottom="@dimen/_8sdp"
            android:layout_marginEnd="@dimen/_6sdp"
            app:cardCornerRadius="@dimen/_10sdp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center"
                    android:id="@+id/game_iv"
                    android:tag="@string/list_sg_lobby_image"
                    android:background="#2b2a2a"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"/>
                <LinearLayout
                    android:id="@+id/toast_layout"
                    android:background="@drawable/lobby_noti_item_bg"
                    android:paddingLeft="@dimen/_8sdp"
                    android:paddingTop="@dimen/_4sdp"
                    android:paddingRight="@dimen/_8sdp"
                    android:paddingBottom="@dimen/_4sdp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:layout_above="@+id/layout"
                    android:layout_centerHorizontal="true">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/toast_icon"
                        android:paddingTop="@dimen/_3sdp"
                        android:visibility="gone"
                        android:layout_width="@dimen/_12sdp"
                        android:layout_height="@dimen/_12sdp"
                        android:paddingEnd="@dimen/_4sdp"/>
                    <TextView
                        android:textSize="@dimen/_9sdp"
                        android:gravity="center_horizontal"
                        android:id="@+id/toast_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Removed from favourites"
                        style="@style/TextPrimaryBold"/>
                </LinearLayout>
                <RelativeLayout
                    android:id="@+id/layout"
                    android:background="#2a2a2a"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true">
                    <ImageView
                        android:id="@+id/dots"
                        android:layout_width="@dimen/_12sdp"
                        android:layout_height="@dimen/_12sdp"
                        android:layout_marginLeft="@dimen/_8ssp"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:textSize="@dimen/_12ssp"
                        android:ellipsize="marquee"
                        android:gravity="center"
                        android:id="@+id/game_name"
                        android:tag="@string/list_common_cms"
                        android:padding="@dimen/_5sdp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_16sdp"
                        android:layout_marginRight="@dimen/_20sdp"
                        android:text="@string/test"
                        android:scrollHorizontally="true"
                        android:singleLine="true"
                        android:layout_centerInParent="true"
                        android:marqueeRepeatLimit="marquee_forever"
                        style="@style/TextPrimaryBold"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/favourite"
                        android:paddingLeft="@dimen/_3sdp"
                        android:paddingTop="@dimen/_3sdp"
                        android:paddingRight="@dimen/_3sdp"
                        android:paddingBottom="@dimen/_3sdp"
                        android:layout_width="@dimen/_21sdp"
                        android:layout_height="@dimen/_21sdp"
                        android:layout_marginRight="@dimen/_4sdp"
                        android:src="@drawable/ic_heart_outline"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/linearLayoutCompat3"
                    android:background="@drawable/rect"
                    android:padding="@dimen/_5sdp"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_alignTop="@+id/game_iv"
                    android:layout_alignRight="@+id/game_iv"
                    android:layout_alignEnd="@+id/game_iv">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:layout_marginRight="@dimen/_2sdp">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/_6sdp"
                            android:layout_height="@dimen/_6sdp"
                            android:src="@drawable/online_vector"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <TextView
                        android:textSize="@dimen/_8sdp"
                        android:textColor="@color/white"
                        android:id="@+id/online_tv"
                        android:tag="@string/game_player_count_cms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/test"
                        style="@style/TextPrimaryRegular"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/_8sdp"
        android:textStyle="italic"
        android:textColor="@color/tag_color"
        android:gravity="center"
        android:id="@+id/tag_tv"
        android:background="@drawable/tag_bg"
        android:paddingLeft="@dimen/_12sdp"
        android:paddingTop="@dimen/_3sdp"
        android:paddingRight="@dimen/_12sdp"
        android:paddingBottom="@dimen/_3sdp"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/test"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingVertical="@dimen/_3sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextPrimaryBold"/>
</androidx.constraintlayout.widget.ConstraintLayout>
