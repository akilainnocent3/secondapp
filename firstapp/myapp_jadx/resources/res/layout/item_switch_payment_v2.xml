<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_begin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="16dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="16dp"/>
    <View
        android:id="@+id/editing_select_icon_space"
        android:visibility="gone"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        app:layout_constraintStart_toEndOf="@+id/guideline_begin"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/select_icon_image_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/editing_select_icon_space"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_check"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/icon_image_view"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/select_icon_image_view"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/B2_R"
        android:textColor="@color/text_color_text_type1_primary"
        android:id="@+id/title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/icon_image_view"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.sportybet.feature.payment.impl.common.presentation.widget.AssetLabelTextView
        android:textAppearance="@style/C1_R"
        android:id="@+id/label"
        android:paddingLeft="3dp"
        android:paddingTop="1.5dp"
        android:paddingRight="3dp"
        android:paddingBottom="1.5dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:paddingHorizontal="3dp"
        android:paddingVertical="1.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/title_text"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/label_tooltip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_pay_tooltip"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/label"
        app:layout_constraintStart_toEndOf="@+id/label"
        app:layout_constraintTop_toTopOf="@+id/label"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/delete_btn"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="0dp"
        android:tint="@color/text_type1_secondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_cancel_black_24dp"/>
    <View
        android:id="@+id/diver_line"
        android:background="@color/line_type1_primary"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
