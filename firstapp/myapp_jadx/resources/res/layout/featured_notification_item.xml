<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="@color/notification_green"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_constraintHorizontal_chainStyle="packed">
    <TextView
        android:textSize="@dimen/_8ssp"
        android:textColor="@color/notification_text_color"
        android:gravity="center"
        android:id="@+id/notication_name"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="hgbfvdcs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/notication_number"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextPrimaryRegular"/>
    <TextView
        android:textSize="@dimen/_8ssp"
        android:textColor="@color/notification_money_color"
        android:gravity="center_vertical"
        android:id="@+id/notication_number"
        android:tag="@string/notification_message_cms"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="hgbfvdcs hgfdsadcfvgb ghj"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/notication_name"
        style="@style/TextPrimaryBold"/>
</androidx.constraintlayout.widget.ConstraintLayout>
