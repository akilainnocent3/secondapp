<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/spr_gift_pop"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginRight="20dp"
    android:minWidth="122dp"
    android:minHeight="65dp"
    android:backgroundTint="@color/background_type1_quaternary">
    <ImageView
        android:id="@+id/get_gifts_img"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginLeft="15dp"
        android:src="@drawable/spr_cake"
        android:scaleType="fitXY"
        android:layout_centerVertical="true"
        android:layout_marginStart="15dp"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/brand_secondary"
        android:gravity="center_vertical"
        android:id="@+id/get_gifts_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="7dp"
        android:text="@string/wap_home__get_gifts"
        android:layout_toRightOf="@+id/get_gifts_img"
        android:layout_centerVertical="true"
        android:fontFamily="sans-serif"
        android:layout_marginStart="7dp"/>
    <ImageView
        android:id="@+id/get_gifts_close"
        android:padding="12dp"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_toRightOf="@+id/get_gifts_view"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/get_gifts_view"/>
</RelativeLayout>
