<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/sg_rain_bg_v2"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/rain_drops_notification"
        android:scaleType="fitXY"/>
    <TextView
        android:textSize="@dimen/_13sdp"
        android:textColor="@color/white"
        android:id="@+id/rain_claim_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeStepGranularity="@dimen/_1ssp"
        android:autoSizeMinTextSize="@dimen/_8ssp"
        android:autoSizeMaxTextSize="@dimen/_13sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextPrimaryBold"/>
    <ImageView
        android:id="@+id/rain_icon_half_cloud"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/ic_half_cloud_rain"
        android:scaleType="fitXY"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.26"/>
</androidx.constraintlayout.widget.ConstraintLayout>
