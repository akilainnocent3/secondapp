<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_general_primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerview_match_event_info"
        android:layout_width="151dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/space_match_event_bottom_button_gap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tablayout_match_event_market"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewpager_match_event_outcome"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/space_match_event_bottom_button_gap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/recyclerview_match_event_info"
        app:layout_constraintTop_toBottomOf="@+id/tablayout_match_event_market"/>
    <FrameLayout
        android:id="@+id/framelayout_match_event_betbuilder_fragment_container"
        android:background="@color/background_general_primary"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/space_match_event_bottom_button_gap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tablayout_match_event_market"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeview_match_event_league_tab"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/composeview_match_event_league_stats_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/actionbar_match_event"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeview_match_event_league_stats_button"
        android:background="@color/background_type2_secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/composeview_match_event_league_tab"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/composeview_match_event_league_tab"/>
    <View
        android:id="@+id/view_match_event_market_tab_background"
        android:background="@color/background_general_primary"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/tablayout_match_event_market"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tablayout_match_event_market"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeview_bet_builder_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/tablayout_match_event_market"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tablayout_match_event_market"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeview_match_event_odds_filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/tablayout_match_event_market"
        app:layout_constraintEnd_toStartOf="@+id/tablayout_match_event_market"
        app:layout_constraintStart_toEndOf="@+id/composeview_bet_builder_container"
        app:layout_constraintTop_toTopOf="@+id/tablayout_match_event_market"/>
    <com.google.android.material.tabs.TabLayout
        android:textSize="14dp"
        android:textStyle="normal"
        android:id="@+id/tablayout_match_event_market"
        android:layout_width="0dp"
        android:layout_height="48dp"
        app:layout_constraintEnd_toEndOf="@+id/viewpager_match_event_outcome"
        app:layout_constraintStart_toEndOf="@+id/composeview_match_event_odds_filter"
        app:layout_constraintTop_toBottomOf="@+id/composeview_match_event_league_tab"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/brand_secondary"
        app:tabIndicatorFullWidth="true"
        app:tabIndicatorHeight="4dp"
        app:tabMaxWidth="0dp"
        app:tabMode="scrollable"
        app:tabPaddingEnd="10dp"
        app:tabPaddingStart="10dp"
        app:tabTextAppearance="@style/InstantWin.TabLayout.Market"
        app:tabTextColor="@color/text_type1_primary"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeview_match_event_gift_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/actionbar_match_event"/>
    <com.sportybet.android.instantwin.presentation.widget.ActionBar
        android:id="@+id/actionbar_match_event"
        android:layout_width="0dp"
        android:layout_height="@dimen/action_bar_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeview_floating_kickoff_button"
        android:layout_width="85dp"
        android:layout_height="36dp"
        app:layout_constraintBottom_toTopOf="@+id/placebetbuttonlayout_match_event"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.sportybet.android.instantwin.presentation.widget.PlaceBetButtonLayout
        android:id="@+id/placebetbuttonlayout_match_event"
        android:layout_width="0dp"
        android:layout_height="63dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.sportybet.android.virtual.presentation.widget.InstantWinQuickBetView
        android:id="@+id/quickbetview_match_event"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_match_event_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-15dp"
        app:barrierDirection="top"
        app:constraint_referenced_ids="quickbetview_match_event,placebetbuttonlayout_match_event"/>
    <android.widget.Space
        android:id="@+id/space_match_event_bottom_button_gap"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/barrier_match_event_bottom"/>
    <com.sportybet.android.widget.LoadingView
        android:id="@+id/loadingview_match_event_loading"
        android:background="@color/background_type1_secondary"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/composeview_match_event_league_tab"
        app:loadingLayout="@layout/iwqk_match_event_preview"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeview_match_event_head_to_head_stats_bottom_sheet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeview_match_event_explore_more_bottom_sheet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeview_match_event_bet_builder_tutorial_bottom_sheet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeview_match_event_market_guide_bottom_sheet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeview_match_event_skip_to_result_dialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
