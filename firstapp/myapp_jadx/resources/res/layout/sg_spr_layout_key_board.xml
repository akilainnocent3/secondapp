<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/sg_text_type1_primary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/layout_upper_space"
        android:background="@color/sg_absolute_type1"
        android:layout_width="match_parent"
        android:layout_height="16dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/quick_tool_bar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/sg_absolute_type1"
            android:gravity="center"
            android:id="@+id/quick_btn_1"
            android:background="@drawable/sg_bg_rect_round_board"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/sg_keyboard_stake_space_left_right"
            android:layout_marginTop="@dimen/sg_keyboard_stake_space"
            android:layout_marginBottom="@dimen/sg_keyboard_stake_space"
            android:maxLines="1"
            android:layout_weight="1"
            app:autoSizeMaxTextSize="14dp"
            app:autoSizeMinTextSize="11dp"
            app:autoSizeStepGranularity="1dp"
            app:autoSizeTextType="uniform"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/sg_absolute_type1"
            android:gravity="center"
            android:id="@+id/quick_btn_2"
            android:background="@drawable/sg_bg_rect_round_board"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/sg_keyboard_stake_space_left_right"
            android:layout_marginTop="@dimen/sg_keyboard_stake_space"
            android:layout_marginBottom="@dimen/sg_keyboard_stake_space"
            android:maxLines="1"
            android:layout_weight="1"
            app:autoSizeMaxTextSize="14dp"
            app:autoSizeMinTextSize="11dp"
            app:autoSizeStepGranularity="1dp"
            app:autoSizeTextType="uniform"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/sg_absolute_type1"
            android:gravity="center"
            android:id="@+id/quick_btn_3"
            android:background="@drawable/sg_bg_rect_round_board"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/sg_keyboard_stake_space_left_right"
            android:layout_marginTop="@dimen/sg_keyboard_stake_space"
            android:layout_marginBottom="@dimen/sg_keyboard_stake_space"
            android:maxLines="1"
            android:layout_weight="1"
            app:autoSizeMaxTextSize="14dp"
            app:autoSizeMinTextSize="11dp"
            app:autoSizeStepGranularity="1dp"
            app:autoSizeTextType="uniform"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/default_stake_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/sg_keyboard_stake_space_left_right"
            android:paddingEnd="@dimen/sg_keyboard_stake_space_left_right">
            <ImageView
                android:id="@+id/default_stake_checkbox"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:src="@drawable/sg_ic_check_box_unselected"
                android:layout_marginHorizontal="4dp"/>
            <TextView
                android:textSize="@dimen/sg_keyboard_update_default_stake_text_size"
                android:textColor="@color/sg_absolute_type1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sg_component_betslip_update_default_stake"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/quick_tool_bar_divider"
        android:background="#9ca0ab"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="8"
            android:overScrollMode="never"/>
        <TextView
            android:textSize="16dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/done"
            android:background="@drawable/sg_spr_selector_item_done"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/sg_common_functions_done"
            android:layout_weight="2"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
    <View
        android:background="#9ca0ab"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
</merge>
