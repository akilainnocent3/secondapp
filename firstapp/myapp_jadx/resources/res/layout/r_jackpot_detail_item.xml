<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_type1_secondary"
    android:paddingLeft="16dp"
    android:paddingTop="12dp"
    android:paddingRight="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/custom_brand_tertiary_type4"
        android:id="@+id/r_jackpot_live"
        android:background="@color/custom_focus_type1"
        android:paddingLeft="3dp"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/component_betslip__live"
        android:fontFamily="sans-serif"
        android:paddingStart="3dp"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_tertiary"
        android:id="@+id/r_jackpot_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/r_jackpot_live"
        android:fontFamily="sans-serif"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_secondary"
        android:id="@+id/r_jackpot_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_toRightOf="@+id/r_jackpot_number"
        android:fontFamily="sans-serif"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/r_jackpot_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/r_jackpot_time">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3">
            <com.sportybet.plugin.jackpot.widget.EllipsizingTextView
                android:textSize="12sp"
                android:textStyle="normal"
                android:textColor="@color/text_type1_primary"
                android:id="@+id/r_jackpot_home"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:fontFamily="sans-serif"/>
            <com.sportybet.plugin.jackpot.widget.EllipsizingTextView
                android:textSize="12sp"
                android:textStyle="normal"
                android:textColor="@color/text_type1_primary"
                android:id="@+id/r_jackpot_away"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:fontFamily="sans-serif"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textStyle="normal"
            android:textColor="@color/text_type1_primary"
            android:gravity="center"
            android:id="@+id/r_jackpot_score"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="normal"
            android:textColor="@color/text_type1_secondary"
            android:gravity="center"
            android:id="@+id/r_jackpot_pick"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="sans-serif"/>
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/r_jackpot_result_layout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="12sp"
                android:textStyle="normal"
                android:textColor="@color/text_type1_secondary"
                android:gravity="center"
                android:id="@+id/r_jackpot_result"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:fontFamily="sans-serif"/>
            <ImageView
                android:textSize="12sp"
                android:textStyle="normal"
                android:id="@+id/r_jackpot_result_img"
                android:background="@drawable/spr_event_win"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_centerInParent="true"
                android:fontFamily="sans-serif"
                app:tint="@color/brand_secondary_variable_type3"/>
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/r_jackpot_statistics_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_below="@+id/r_jackpot_content">
        <TextView
            android:textSize="12sp"
            android:textStyle="normal"
            android:textColor="@color/brand_quaternary"
            android:id="@+id/r_jackpot_check_statistics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:text="@string/common_functions__statistics"
            android:drawablePadding="7dp"
            android:fontFamily="sans-serif"/>
        <View
            android:background="@color/line_type1_primary"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/r_jackpot_betting_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_below="@+id/r_jackpot_content">
        <TextView
            android:textSize="12sp"
            android:textStyle="normal"
            android:textColor="@color/brand_quaternary"
            android:gravity="center"
            android:id="@+id/r_jackpot_live_betting"
            android:background="@drawable/jap_selector_reload_bg"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="18dp"
            android:text="@string/bet_history__go_to_live_betting"
            android:fontFamily="sans-serif"/>
        <View
            android:background="@color/line_type1_primary"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
    </LinearLayout>
    <View
        android:id="@+id/r_jackpot_bottom_line"
        android:background="@color/line_type1_primary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_below="@+id/r_jackpot_content"/>
</RelativeLayout>
