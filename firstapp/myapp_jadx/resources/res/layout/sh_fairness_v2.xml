<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:orientation="vertical"
        android:id="@+id/container"
        android:paddingBottom="@dimen/_8sdp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="@color/sg_transparent"
        app:cardCornerRadius="@dimen/_6sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.7"
        app:layout_constraintHorizontal_bias="0.487"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.202"
        app:layout_constraintWidth_percent="0.923">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:id="@+id/parentConstraint"
            android:background="@drawable/sh_dialog_bg_v2"
            android:paddingBottom="@dimen/_8sdp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHeight_percent="0.78"
            app:layout_constraintHorizontal_bias="0.487"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.202"
            app:layout_constraintWidth_percent="0.973">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/round_layout"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintHeight_percent="0.1"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_10ssp"
                    android:id="@+id/round_id"
                    android:tag="@string/round_n_cms"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_11sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/coefficient"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="0.33"
                    style="@style/TextPrimaryBold"/>
                <TextView
                    android:textSize="@dimen/_8sdp"
                    android:gravity="center"
                    android:id="@+id/coefficient"
                    android:background="@drawable/sh_previous_chip_bg"
                    android:paddingLeft="@dimen/_10sdp"
                    android:paddingTop="@dimen/_2sdp"
                    android:paddingRight="@dimen/_10sdp"
                    android:paddingBottom="@dimen/_2sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="70dp"
                    app:layout_constraintBottom_toBottomOf="@+id/round_id"
                    app:layout_constraintEnd_toStartOf="@+id/time"
                    app:layout_constraintStart_toEndOf="@+id/round_id"
                    app:layout_constraintTop_toTopOf="@+id/round_id"
                    style="@style/TextPrimaryBold"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_10ssp"
                    android:gravity="center"
                    android:id="@+id/time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_6sdp"
                    android:lines="2"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/coefficient"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="0.33"
                    style="@style/TextPrimaryBold"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:nestedScrollingEnabled="false"
                app:layout_constraintHeight_percent="0.9"
                app:layout_constraintTop_toBottomOf="@+id/round_layout">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:focusableInTouchMode="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_40sdp"
                    app:layout_constraintTop_toBottomOf="@+id/round_layout">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_10ssp"
                        android:id="@+id/provably_fair_text"
                        android:tag="@string/what_is_provably_fair_cms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="0x7f0702ae"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:text="@string/provably_fair"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TextPrimaryBold"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/server_seed_image"
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_32sdp"
                        android:layout_marginLeft="0x7f0702ae"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:src="@drawable/server_seed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/provably_fair_text"
                        style="@style/TextPrimaryBold"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_10ssp"
                        android:id="@+id/server_seed_text"
                        android:tag="@string/server_seed_round_cms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:src="@drawable/server_seed"
                        android:text="@string/fairness_dialog_server_seed_text"
                        android:layout_marginStart="10dp"
                        app:layout_constraintStart_toEndOf="@+id/server_seed_image"
                        app:layout_constraintTop_toBottomOf="@+id/provably_fair_text"
                        style="@style/TextPrimaryBold"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:tag="@string/seed_cms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:text=" :"
                        app:layout_constraintStart_toEndOf="@+id/server_seed_text"
                        app:layout_constraintTop_toBottomOf="@+id/provably_fair_text"
                        app:layout_constraintWidth_percent="0.4"
                        style="@style/TextPrimaryBold"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_10ssp"
                        android:textColor="#6a6a6a"
                        android:id="@+id/server_seed_generate_text"
                        android:tag="@string/round_generated_on_our_side_cms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/server_seed"
                        android:text="@string/fairness_dialog_generate_text"
                        android:layout_marginStart="8dp"
                        app:layout_constraintStart_toEndOf="@+id/server_seed_image"
                        app:layout_constraintTop_toBottomOf="@+id/server_seed_text"
                        style="@style/TextPrimaryBold"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:gravity="center"
                        android:id="@+id/server_seed"
                        android:background="@drawable/card_fairness"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_8sdp"
                        android:minHeight="@dimen/_40sdp"
                        app:layout_constraintTop_toBottomOf="@+id/server_seed_image"
                        style="@style/TextPrimaryBold"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/client_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/server_seed">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/client_seed_image"
                            android:layout_width="@dimen/_30sdp"
                            android:layout_height="@dimen/_32sdp"
                            android:layout_marginLeft="0x7f0702ae"
                            android:layout_marginTop="@dimen/_12sdp"
                            android:src="@drawable/client_seed"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            style="@style/TextPrimaryBold"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/_10ssp"
                            android:id="@+id/client_seed_text"
                            android:tag="@string/client_seeds_cms"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_12sdp"
                            android:src="@drawable/server_seed"
                            android:text="@string/fairness_dialog_client_seed_text"
                            android:layout_marginStart="10dp"
                            app:layout_constraintStart_toEndOf="@+id/client_seed_image"
                            app:layout_constraintTop_toTopOf="parent"
                            style="@style/TextPrimaryBold"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_12sdp"
                            android:text=" :"
                            app:layout_constraintStart_toEndOf="@+id/client_seed_text"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintWidth_percent="0.4"
                            style="@style/TextPrimaryBold"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/_10ssp"
                            android:textColor="#6a6a6a"
                            android:id="@+id/client_seed_generate_text"
                            android:tag="@string/round_generated_on_player_side_cms"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:src="@drawable/server_seed"
                            android:text="@string/fairness_dialog_generate_player_text"
                            android:layout_marginStart="8dp"
                            app:layout_constraintStart_toEndOf="@+id/client_seed_image"
                            app:layout_constraintTop_toBottomOf="@+id/client_seed_text"
                            app:layout_constraintWidth_percent="0.7"
                            style="@style/TextPrimaryBold"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.recyclerview.widget.RecyclerView
                        android:gravity="center"
                        android:id="@+id/client_seed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_8sdp"
                        android:minHeight="@dimen/_100sdp"
                        app:layout_constraintTop_toBottomOf="@+id/client_layout"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/combined_seed_image"
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_32sdp"
                        android:layout_marginLeft="0x7f0702ae"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:src="@drawable/combined"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/client_seed"
                        style="@style/TextPrimaryBold"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_10ssp"
                        android:id="@+id/combined_seed_text"
                        android:tag="@string/combined_hash_cms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:text="@string/fairness_dialog_sha2_text"
                        android:layout_marginStart="10dp"
                        app:layout_constraintStart_toEndOf="@+id/server_seed_image"
                        app:layout_constraintTop_toBottomOf="@+id/client_seed"
                        style="@style/TextPrimaryBold"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:text=" :"
                        app:layout_constraintStart_toEndOf="@+id/combined_seed_text"
                        app:layout_constraintTop_toBottomOf="@+id/client_seed"
                        app:layout_constraintWidth_percent="0.4"
                        style="@style/TextPrimaryBold"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_10ssp"
                        android:textColor="#6a6a6a"
                        android:id="@+id/combined_text"
                        android:tag="@string/combined_hash_info_cms"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/_8sdp"
                        android:src="@drawable/server_seed"
                        android:text="@string/fairness_dialog_sha2_note"
                        android:singleLine="false"
                        android:layout_marginStart="8dp"
                        app:layout_constraintStart_toEndOf="@+id/server_seed_image"
                        app:layout_constraintTop_toBottomOf="@+id/combined_seed_text"
                        app:layout_constraintWidth_percent="0.7"
                        style="@style/TextPrimaryBold"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/combined_seed"
                        android:background="@drawable/card_fairness"
                        android:padding="@dimen/_8sdp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_8sdp"
                        android:minHeight="@dimen/_40sdp"
                        android:singleLine="true"
                        app:layout_constraintTop_toBottomOf="@+id/combined_text"
                        style="@style/TextPrimaryBold"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textColor="@color/color_6a6a6a"
                        android:id="@+id/hex_text"
                        android:tag="@string/hex_cms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="0x7f0702ae"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:text="@string/fairness_dialog_hex_text"
                        android:singleLine="false"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/combined_seed"
                        style="@style/TextPrimaryBold"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textColor="@color/color_6a6a6a"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:text=" :"
                        app:layout_constraintStart_toEndOf="@+id/hex_text"
                        app:layout_constraintTop_toBottomOf="@+id/combined_seed"
                        app:layout_constraintWidth_percent="0.4"
                        style="@style/TextPrimaryBold"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:gravity="center"
                        android:id="@+id/hex"
                        android:background="@drawable/card_fairness"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_8sdp"
                        android:minHeight="@dimen/_40sdp"
                        app:layout_constraintTop_toBottomOf="@+id/hex_text"
                        style="@style/TextPrimaryBold"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textColor="@color/color_6a6a6a"
                        android:id="@+id/decimal_text"
                        android:tag="@string/decimal_cms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="0x7f0702ae"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:layout_marginRight="@dimen/_8sdp"
                        android:text="@string/fairness_dialog_decimal_text"
                        android:singleLine="false"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/hex"
                        style="@style/TextPrimaryBold"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textColor="@color/color_6a6a6a"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:text=" :"
                        app:layout_constraintStart_toEndOf="@+id/decimal_text"
                        app:layout_constraintTop_toBottomOf="@+id/hex"
                        app:layout_constraintWidth_percent="0.4"
                        style="@style/TextPrimaryBold"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:gravity="center"
                        android:id="@+id/decimal"
                        android:background="@drawable/card_fairness"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_8sdp"
                        android:minHeight="@dimen/_40sdp"
                        app:layout_constraintTop_toBottomOf="@+id/decimal_text"
                        style="@style/TextPrimaryBold"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textColor="@color/color_6a6a6a"
                        android:id="@+id/result_text"
                        android:tag="@string/result_text_bet_cms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="0x7f0702ae"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:layout_marginRight="@dimen/_8sdp"
                        android:text="@string/fairness_dialog_result_text"
                        android:singleLine="false"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/decimal"
                        style="@style/TextPrimaryBold"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textColor="@color/color_6a6a6a"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:text=" :"
                        app:layout_constraintStart_toEndOf="@+id/result_text"
                        app:layout_constraintTop_toBottomOf="@+id/decimal"
                        app:layout_constraintWidth_percent="0.4"
                        style="@style/TextPrimaryBold"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:gravity="center"
                        android:id="@+id/result"
                        android:background="@drawable/card_fairness"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_8sdp"
                        android:minHeight="@dimen/_40sdp"
                        app:layout_constraintTop_toBottomOf="@+id/result_text"
                        style="@style/TextPrimaryBold"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </ScrollView>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.github.ybq.android.spinkit.SpinKitView
            android:layout_gravity="center"
            android:id="@+id/loader"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            app:SpinKit_Color="@color/button_blue"
            style="@style/SpinKitStyle"/>
    </androidx.cardview.widget.CardView>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_40sdp"
        android:tint="@color/sb_black"
        android:backgroundTint="@color/white"
        app:fabSize="normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/close_icon_white"/>
</androidx.constraintlayout.widget.ConstraintLayout>
