<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_container"
    android:background="@color/background_general_primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.sportybet.android.instantwin.presentation.widget.ActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/action_bar_height"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/cancel_btn"
        android:background="?android:attr/selectableItemBackground"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar"
        app:srcCompat="@drawable/cmn_ic_close_gray"
        app:tint="@color/text_type1_primary"/>
    <TextView
        android:textSize="18dp"
        android:textStyle="bold"
        android:textColor="@color/text_type1_primary"
        android:gravity="center"
        android:id="@+id/tv_range_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bet_history__choose_date_range"
        android:fontFamily="sans-serif"
        app:layout_constraintTop_toBottomOf="@+id/cancel_btn"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_range_desc">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/absolute_type2"
                android:id="@+id/tv_range_start_date_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="16dp"
                android:text="@string/common_dates__from"
                android:fontFamily="sans-serif"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintEnd_toStartOf="@+id/background_guideline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/absolute_type2"
                android:id="@+id/tv_range_end_date_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="16dp"
                android:text="@string/common_dates__to"
                android:fontFamily="sans-serif"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/background_guideline"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                app:layout_constraintTop_toBottomOf="@+id/tv_range_start_date_label">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="center"
                    android:id="@+id/tv_range_start_date"
                    android:background="@drawable/btn_border_rounded_bg"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="@color/background_type1_tertiary"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="center"
                    android:id="@+id/tv_range_end_date"
                    android:background="@drawable/btn_border_rounded_bg"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="16dp"
                    android:backgroundTint="@color/background_type1_tertiary"/>
            </LinearLayout>
            <com.sportybet.plugin.realsports.betorder.calendar.view.CalendarView
                android:id="@+id/calendar_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="70dp"
                app:layout_constraintTop_toBottomOf="@+id/tv_range_end_date_label"
                app:selectionType="range"
                style="@style/CustomCalendarView"/>
            <TextView
                android:textSize="16dp"
                android:textStyle="normal"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/update_btn"
                android:background="@color/brand_secondary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/calendar_button_height"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="32dp"
                android:layout_marginRight="16dp"
                android:text="@string/common_functions__update"
                android:fontFamily="sans-serif"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/calendar_view"/>
            <TextView
                android:textSize="16dp"
                android:textStyle="normal"
                android:textColor="@color/brand_secondary"
                android:gravity="center"
                android:id="@+id/back_to_all_dates"
                android:background="@drawable/btn_border_rounded_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/calendar_button_height"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="13dp"
                android:layout_marginRight="16dp"
                android:text="@string/bet_history__back_to_all_dates"
                android:fontFamily="sans-serif"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/update_btn"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/background_guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.5"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
