<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/sports_event_tournament_layout"
    android:background="?android:attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="36dp">
    <TextView
        android:textSize="14dp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_primary"
        android:gravity="start|center_vertical"
        android:id="@+id/sports_event_tournament_name_text"
        android:layout_width="270dp"
        android:layout_height="35dp"
        android:layout_marginLeft="26dp"
        android:singleLine="true"
        android:lineSpacingExtra="2.8sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="26dp"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_primary"
        android:gravity="end|center_vertical"
        android:id="@+id/sports_event_tournament_count_text"
        android:layout_width="wrap_content"
        android:layout_height="35dp"
        android:layout_marginRight="17dp"
        android:layout_alignParentRight="true"
        android:lineSpacingExtra="2.8sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginEnd="17dp"
        android:layout_alignParentEnd="true"/>
    <View
        android:id="@+id/sports_event_tournament_divider_line"
        android:background="@color/line_type1_primary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="16dp"
        android:layout_below="@+id/sports_event_tournament_count_text"
        android:layout_marginStart="16dp"/>
    <View
        android:id="@+id/bottom_long_divider_line"
        android:background="@color/line_type1_primary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/sports_event_tournament_count_text"/>
</RelativeLayout>
