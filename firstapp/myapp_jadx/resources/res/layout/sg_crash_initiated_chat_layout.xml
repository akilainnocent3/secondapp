<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/toast_container"
        android:background="@drawable/sg_rush_toast"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_8sdp"
        android:layout_marginRight="@dimen/_8sdp"
        android:maxHeight="@dimen/_40sdp"
        android:minHeight="@dimen/_40sdp"
        android:layout_marginHorizontal="@dimen/_8sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="spread">
        <ImageView
            android:id="@+id/image2"
            android:layout_width="@dimen/_80sdp"
            android:layout_height="match_parent"
            android:src="@drawable/lobby_noti_bg"
            android:adjustViewBounds="true"
            android:rotationY="180"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/image1"
            android:layout_width="@dimen/_80sdp"
            android:layout_height="match_parent"
            android:src="@drawable/lobby_noti_bg"
            android:adjustViewBounds="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/sg_layout_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed">
            <TextView
                android:textSize="@dimen/_12sdp"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/sg_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextPrimaryBold"/>
            <TextView
                android:textSize="@dimen/_12sdp"
                android:textColor="@color/color_f1c944"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/sg_currency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextPrimaryBold"/>
            <TextView
                android:textSize="@dimen/_12sdp"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/sg_at"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" at "
                style="@style/TextPrimaryBold"/>
            <TextView
                android:textSize="@dimen/_12sdp"
                android:textColor="@color/color_f1c944"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/sg_coeff"
                android:paddingTop="@dimen/_2sdp"
                android:paddingBottom="@dimen/_2sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextPrimaryBold"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/_26sdp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_house_coefficient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1.00X"
        android:shadowColor="@color/sg_rush_shadow_house_coeff"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="5"
        app:layout_constraintBottom_toTopOf="@+id/auto_bet_red_btn_chat"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toast_container"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/auto_bet_red_btn_chat"
        android:background="@drawable/auto_bet_button_bg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxHeight="@dimen/_40sdp"
        android:minHeight="@dimen/_40sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_house_coefficient"
        app:layout_constraintWidth_percent="0.5">
        <TextView
            android:textSize="@dimen/_15sdp"
            android:textStyle="italic|bold"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_stop_bet"
            android:tag="@string/stop_auto_bet_text_cms"
            android:paddingTop="4dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/sg_rush_stop_auto_bet"
            android:maxLines="2"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="8"
            app:layout_constraintBottom_toTopOf="@+id/tv_rounds_played"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/TextPrimaryBold"/>
        <TextView
            android:textSize="@dimen/_9sdp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/tv_rounds_played"
            android:tag="@string/round_played_text_cms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sg_rush_rounds_played"
            android:alpha="0.6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/rounds_played_count"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_stop_bet"
            style="@style/TextPrimaryRegular"/>
        <TextView
            android:textSize="@dimen/_9sdp"
            android:textColor="@color/white"
            android:id="@+id/rounds_played_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_rounds_played"
            app:layout_constraintTop_toBottomOf="@+id/tv_stop_bet"
            style="@style/TextPrimaryRegular"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
