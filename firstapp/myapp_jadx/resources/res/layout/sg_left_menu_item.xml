<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/_4sdp">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center"
        android:id="@+id/icon_menu_layout"
        android:layout_width="@dimen/_18sdp"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/icon_menu"
            android:layout_width="@dimen/_15sdp"
            android:layout_height="@dimen/_10sdp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_12sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/icon_menu_layout"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/_13ssp"
            android:gravity="center_vertical"
            android:id="@+id/menu_txt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            app:layout_constraintBottom_toTopOf="@+id/menu_sub_title"
            app:layout_constraintEnd_toStartOf="@+id/chkState"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TextPrimaryMedium"/>
        <TextView
            android:textSize="@dimen/_9ssp"
            android:gravity="center_vertical"
            android:id="@+id/menu_sub_title"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/chkState"
            app:layout_constraintStart_toStartOf="@+id/menu_txt"
            app:layout_constraintTop_toBottomOf="@+id/menu_txt"
            style="@style/TextPrimaryMedium"/>
        <com.github.ybq.android.spinkit.SpinKitView
            android:id="@+id/spin_kit"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:SpinKit_Color="@android:color/white"
            app:layout_constraintBottom_toBottomOf="@+id/chkState"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toStartOf="@+id/chkState"
            app:layout_constraintHorizontal_bias="0.9"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/chkState"
            style="@style/SpinKitView.Small.DoubleBounce"/>
        <com.sportygames.commons.components.SGToggle
            android:gravity="end"
            android:id="@+id/chkState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:background="#ffffff"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:alpha="0.1"
        android:layout_marginStart="@dimen/_6sdp"
        android:layout_marginEnd="@dimen/_3sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
