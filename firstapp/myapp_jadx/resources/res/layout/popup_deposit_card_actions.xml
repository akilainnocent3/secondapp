<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/background_general_primary"
    android:padding="4dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:translationZ="4dp">
    <TextView
        android:textColor="@color/text_type1_primary"
        android:id="@+id/action_set_default"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/page_payment__set_as_default"
        android:drawablePadding="8dp"
        app:drawableStartCompat="@drawable/ic_edit"
        app:drawableTint="@color/text_type1_primary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/text_type1_primary"
        android:id="@+id/action_delete"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="120dp"
        android:text="@string/common_functions__delete"
        android:drawablePadding="8dp"
        app:drawableStartCompat="@drawable/spr_trash"
        app:drawableTint="@color/text_type1_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_set_default"/>
    <FrameLayout
        android:id="@+id/loading_mask"
        android:background="#99ffffff"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ProgressBar
            android:layout_gravity="center"
            android:layout_width="24dp"
            android:layout_height="24dp"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
