<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_month_header"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <View
            android:layout_gravity="center_vertical"
            android:id="@+id/view_left_line"
            android:background="@color/spr_default_border_color"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginLeft="@dimen/spr_space_1x"
            android:layout_marginRight="@dimen/spr_space_1x"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/spr_text_big"
            android:layout_gravity="center"
            android:id="@+id/tv_month_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="true"
            android:letterSpacing="0.1"/>
        <View
            android:layout_gravity="center_vertical"
            android:id="@+id/view_right_line"
            android:background="@color/spr_default_border_color"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginLeft="@dimen/spr_space_1x"
            android:layout_marginRight="@dimen/spr_space_1x"
            android:layout_weight="1"/>
    </LinearLayout>
    <com.sportybet.plugin.realsports.betorder.calendar.view.MonthView
        android:id="@+id/month_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
