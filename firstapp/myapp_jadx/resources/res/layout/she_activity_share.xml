<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="#80000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/preview_container"
        android:background="@drawable/bg_preview_container_rounded_top"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1">
        <ScrollView
            android:id="@+id/preview_scroll"
            android:scrollbars="none"
            android:layout_width="120dp"
            android:layout_height="90dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="24dp"
            android:minWidth="120dp"
            android:minHeight="90dp"
            android:fillViewport="true"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/book_code_container"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/img_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true"/>
            </LinearLayout>
        </ScrollView>
        <TextView
            android:textSize="12dp"
            android:textStyle="normal"
            android:textColor="@color/text_type2_tertiary"
            android:gravity="center"
            android:id="@+id/time"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="22dp"
            android:layout_centerHorizontal="true"
            android:fontFamily="sans-serif"
            app:layout_constraintLeft_toLeftOf="@+id/preview_scroll"
            app:layout_constraintRight_toRightOf="@+id/preview_scroll"
            app:layout_constraintTop_toBottomOf="@+id/preview_scroll"/>
        <ImageView
            android:id="@+id/btn_zoom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/she_share_zoom"
            android:layout_centerHorizontal="true"
            app:layout_constraintBottom_toBottomOf="@+id/preview_scroll"
            app:layout_constraintLeft_toLeftOf="@+id/preview_scroll"
            app:layout_constraintRight_toRightOf="@+id/preview_scroll"
            app:layout_constraintTop_toTopOf="@+id/preview_scroll"/>
        <TextView
            android:textColor="@color/text_type1_primary"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/common_functions__share"
            android:layout_centerHorizontal="true"
            android:textAllCaps="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/B2_B"/>
        <TextView
            android:textColor="@color/text_type1_primary"
            android:id="@+id/betslip_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/common_functions__booking_code"
            app:layout_constraintLeft_toLeftOf="@+id/book_code_container"
            app:layout_constraintTop_toTopOf="@+id/preview_scroll"
            style="@style/B2_B"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/book_code_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintLeft_toRightOf="@+id/preview_scroll"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/betslip_title">
            <TextView
                android:textSize="28dp"
                android:textStyle="normal"
                android:textColor="@color/text_type1_primary"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/book_code"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:fontFamily="sans-serif-medium"
                app:autoSizeMaxTextSize="28dp"
                app:autoSizeMinTextSize="14dp"
                app:autoSizeStepGranularity="2dp"
                app:autoSizeTextType="uniform"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/copy_code"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_booking_code_copy"
                android:layout_marginStart="6dp"
                app:tint="@color/absolute_type2"/>
        </LinearLayout>
        <TextView
            android:textColor="@color/brand_quaternary"
            android:ellipsize="end"
            android:id="@+id/load_code"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxWidth="140dp"
            android:text="@string/app_widget__shortcut_load_code"
            android:maxLines="1"
            android:layout_centerHorizontal="true"
            app:layout_constraintLeft_toLeftOf="@+id/book_code_container"
            app:layout_constraintTop_toBottomOf="@+id/book_code_container"
            style="@style/B1_M"/>
        <ImageView
            android:id="@+id/ic_load_code"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="6dp"
            android:src="@drawable/ic_share_code"
            app:layout_constraintBottom_toBottomOf="@+id/load_code"
            app:layout_constraintLeft_toRightOf="@+id/load_code"
            app:layout_constraintTop_toTopOf="@+id/load_code"
            app:tint="@color/brand_secondary"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/custom_code_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/time">
            <TextView
                android:textColor="@color/colorPrimary"
                android:ellipsize="end"
                android:id="@+id/load_code_betslip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_functions__load_code_to_betslip"
                android:maxLines="1"
                style="@style/B1_M"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/text_type1_secondary"
                android:ellipsize="end"
                android:id="@+id/separator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:text="|"
                android:maxLines="1"
                android:layout_marginHorizontal="16dp"
                style="@style/B1_M"/>
            <TextView
                android:textColor="@color/colorPrimary"
                android:ellipsize="end"
                android:id="@+id/assign_custom_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_functions__assign_custom_code"
                android:maxLines="1"
                style="@style/B1_M"/>
        </LinearLayout>
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/share_preview_compose"
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/custom_code_container"/>
        <View
            android:id="@+id/betSlip_divider"
            android:background="@color/line_type1_primary"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="32dp"
            android:layout_marginHorizontal="32dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/share_preview_compose"/>
        <LinearLayout
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/display_user_name"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:paddingHorizontal="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/betSlip_divider">
            <TextView
                android:textColor="@color/text_type1_primary"
                android:ellipsize="end"
                android:id="@+id/tv_display_user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="280dp"
                android:text="@string/personal_page__display_username_in_bookbet_image"
                android:maxLines="1"
                style="@style/B2_B"/>
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:minWidth="4dp"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.SwitchCompat
                android:theme="@style/Widget.App.CommonSwitch.Quaternary"
                android:id="@+id/display_user_name_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/publish_with_note"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingHorizontal="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/display_user_name">
            <TextView
                android:textColor="@color/text_type1_primary"
                android:ellipsize="end"
                android:id="@+id/publish_with_note_switch_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxWidth="280dp"
                android:text="@string/common_functions__share_with_note"
                android:maxLines="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/B2_B"/>
            <androidx.appcompat.widget.SwitchCompat
                android:theme="@style/Widget.App.CommonSwitch.Quaternary"
                android:id="@+id/publish_with_note_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/publish_with_note_switch_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/publish_with_note_switch_label"/>
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/note_on_bet_view"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/publish_with_note_switch"
                app:layout_goneMarginTop="0dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textColor="@color/text_type1_primary"
            android:id="@+id/tv_social_share_title"
            android:paddingLeft="24dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/personal_page__published_on_sportysocial"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/publish_with_note"
            style="@style/B1_B"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/loyalty_reward_share_container"
            android:background="@color/background_general_primary"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintBottom_toTopOf="@+id/share_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1">
            <TextView
                android:textColor="@color/text_type1_primary"
                android:gravity="center"
                android:id="@+id/loyalty_reward_share_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/page_loyalty__social_media_options_share_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/H3_B"/>
            <TextView
                android:textSize="@dimen/she_share_text_size"
                android:textColor="@color/text_type1_primary"
                android:gravity="center_horizontal"
                android:id="@+id/loyalty_reward_share_copylink"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="16dp"
                android:text="@string/common_functions__copy_link"
                android:drawablePadding="8dp"
                app:drawableTopCompat="@drawable/ic_share_copylink"
                app:layout_constraintBottom_toTopOf="@+id/loyalty_reward_share_divider"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/loyalty_reward_share_title"
                app:layout_constraintVertical_bias="1"/>
            <View
                android:id="@+id/loyalty_reward_share_divider"
                android:background="@color/line_type1_primary"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/share_barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="tv_title,time,tv_social_share_title,loyalty_reward_share_container"/>
        <HorizontalScrollView
            android:id="@+id/share_container"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/share_barrier">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:background="@color/background_general_primary"
                android:paddingTop="24dp"
                android:paddingRight="28dp"
                android:paddingBottom="24dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:layout_gravity="clip_vertical"
                    android:id="@+id/avatar_bar"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="28dp">
                    <com.sporty.android.common_ui.widgets.CircleImageView
                        android:id="@+id/avatar"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/avatar"
                        android:layout_centerHorizontal="true"
                        app:circle_border_color="@color/brand_secondary"
                        app:circle_border_width="2dp"/>
                    <TextView
                        android:textSize="@dimen/she_share_text_size"
                        android:textStyle="normal"
                        android:textColor="@color/text_type1_primary"
                        android:id="@+id/tv_social_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/common_functions__view"
                        android:layout_below="@+id/avatar"
                        android:layout_centerHorizontal="true"/>
                </RelativeLayout>
                <View
                    android:layout_gravity="center_vertical"
                    android:id="@+id/social_divider_line"
                    android:background="@color/line_type1_primary"
                    android:visibility="gone"
                    android:layout_width="1dp"
                    android:layout_height="44dp"
                    android:layout_marginLeft="12dp"
                    android:layout_marginRight="12dp"
                    android:layout_marginHorizontal="12dp"/>
                <TextView
                    android:textSize="@dimen/she_share_text_size"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="center_horizontal"
                    android:id="@+id/tv_save"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="@string/common_functions__save_image"
                    android:drawablePadding="8dp"
                    android:layout_marginStart="24dp"
                    app:drawableTopCompat="@drawable/she_share_save"/>
                <TextView
                    android:textSize="@dimen/she_share_text_size"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="center_horizontal"
                    android:id="@+id/tv_copylink"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="@string/common_functions__copy_link"
                    android:drawablePadding="8dp"
                    android:layout_marginStart="24dp"
                    app:drawableTopCompat="@drawable/ic_share_copylink"/>
                <TextView
                    android:textSize="@dimen/she_share_text_size"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="center_horizontal"
                    android:id="@+id/tv_twitter"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="@string/common_functions__x"
                    android:drawablePadding="8dp"
                    android:layout_marginStart="24dp"
                    app:drawableTopCompat="@drawable/ic_x"/>
                <TextView
                    android:textSize="@dimen/she_share_text_size"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="center_horizontal"
                    android:id="@+id/tv_telegram"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="@string/common_functions__telegram"
                    android:drawablePadding="8dp"
                    android:layout_marginStart="16dp"
                    app:drawableTopCompat="@drawable/ic_telegram"/>
                <TextView
                    android:textSize="@dimen/she_share_text_size"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="center_horizontal"
                    android:id="@+id/tv_whatsapp"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="@string/common_functions__whatsapp"
                    android:drawablePadding="8dp"
                    android:layout_marginStart="24dp"
                    app:drawableTopCompat="@drawable/ic_whatsapp"/>
                <TextView
                    android:textSize="@dimen/she_share_text_size"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="center_horizontal"
                    android:id="@+id/tv_facebook"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="@string/common_functions__facebook"
                    android:drawablePadding="8dp"
                    android:layout_marginStart="24dp"
                    app:drawableTopCompat="@drawable/ic_facebook"/>
                <TextView
                    android:textSize="@dimen/she_share_text_size"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="center_horizontal"
                    android:id="@+id/tv_more"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="@string/component_sporty_banner__icon_text_more"
                    android:drawablePadding="8dp"
                    android:layout_marginStart="24dp"
                    app:drawableTopCompat="@drawable/ic_social_more"/>
            </LinearLayout>
        </HorizontalScrollView>
        <com.sportybet.android.widget.ProgressButton
            android:id="@+id/btn_social_share"
            android:background="@drawable/bg_filled_brand_quaternary_2_radius_with_brand_secondary_disable"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:text="@string/personal_page__create_my_sportysocial"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintTop_toBottomOf="@+id/share_container"
            style="@style/Widget.App.CommonButton.Contained.Large"/>
        <TextView
            android:textSize="10dp"
            android:textColor="@color/text_type1_secondary"
            android:gravity="center"
            android:id="@+id/txt_social_hint"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="24dp"
            android:layout_marginBottom="16dp"
            android:text="@string/personal_page__click_to_create_and_share_to_your_sportysocial"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_social_share"/>
        <com.sportybet.android.widget.BubbleView
            android:id="@+id/newFeatureAlertView"
            android:visibility="gone"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="-14dp"
            app:closable="true"
            app:descriptionVisibility="false"
            app:layout_constraintEnd_toEndOf="@+id/ic_load_code"
            app:layout_constraintTop_toBottomOf="@+id/ic_load_code"
            app:title="@string/page_load_code__click_the_load_code_icon_to_add_this_code_to_your_betslip"
            app:trianglePosition="top_right"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.sporty.android.common_ui.widgets.LoadingViewNew
        android:id="@+id/load_code_loading"
        android:background="#80000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"/>
    <com.sportybet.android.bookingcode.presentation.activity.CustomCodeComposeUtil
        android:id="@+id/compose_custom_code_sheet"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
