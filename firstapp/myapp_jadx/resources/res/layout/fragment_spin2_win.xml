<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/sg_color_272727"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/cordLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.drawerlayout.widget.DrawerLayout
            android:id="@+id/drawer_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/table_layout"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_percent="0.9"
                    app:layout_constraintHorizontal_bias="1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <com.sportygames.spin2win.components.Spin2WinHeader
                        android:id="@+id/game_header"
                        android:background="@android:color/transparent"
                        android:paddingLeft="@dimen/_3sdp"
                        android:paddingRight="@dimen/_3sdp"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:paddingHorizontal="@dimen/_3sdp"
                        app:game_title="@string/sg_spin2win"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHeight_percent="0.082"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.9"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/board_header_layout"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:scaleY="1.1"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHeight_percent="0.055"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/game_header"
                        app:layout_constraintWidth_percent="0.815">
                        <TextView
                            android:textSize="@dimen/_11sdp"
                            android:textColor="@color/sg_color_ffd660"
                            android:gravity="center"
                            android:id="@+id/tv_payouts"
                            android:tag="@string/key_payout"
                            android:background="@color/sg_color_115439"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:text="@string/sg_payouts"
                            android:textAllCaps="true"
                            android:layout_marginEnd="1dp"
                            app:layout_constraintEnd_toStartOf="@+id/tv_stats"
                            app:layout_constraintHorizontal_chainStyle="packed"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintWidth_percent="0.5"
                            style="@style/TextPrimaryBold"/>
                        <TextView
                            android:textSize="@dimen/_11sdp"
                            android:textColor="@color/sg_color_ffd660"
                            android:gravity="center"
                            android:id="@+id/tv_stats"
                            android:tag="@string/key_stats"
                            android:background="@color/sg_color_115439"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:text="@string/sg_stats"
                            android:textAllCaps="true"
                            android:layout_marginStart="1dp"
                            app:layout_constraintEnd_toStartOf="@+id/games_campaign_progress_container"
                            app:layout_constraintStart_toEndOf="@+id/tv_payouts"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintWidth_percent="0.5"
                            style="@style/TextPrimaryBold"/>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/games_campaign_progress_container"
                            android:background="@color/sg_color_115439"
                            android:visibility="gone"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_marginStart="1dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/tv_stats"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintWidth_percent="0.3">
                            <androidx.compose.ui.platform.ComposeView
                                android:id="@+id/games_campaign_progress"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_2sdp"
                                android:layout_marginBottom="@dimen/_minus1sdp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <com.sportygames.spin2win.components.Spin2WinNumberBoard
                        android:id="@+id/number_board_layout"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="2dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHeight_percent="0.69"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/board_header_layout"
                        app:layout_constraintWidth_percent="0.896"/>
                    <com.sportygames.spin2win.components.Spin2WinButtonBoard
                        android:id="@+id/button_board_layout"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHeight_percent="0.69"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/board_header_layout"
                        app:layout_constraintWidth_percent="0.896"/>
                    <View
                        android:id="@+id/invisible_board"
                        android:background="@color/sg_transparent"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHeight_percent="0.69"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/board_header_layout"
                        app:layout_constraintWidth_percent="0.896"/>
                    <com.sportygames.commons.components.BetChipContainerSpin2Win
                        android:id="@+id/bet_chips"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginBottom="@dimen/_10sdp"
                        android:layout_marginEnd="@dimen/_5sdp"
                        app:bg_color="@color/sg_color_0d3525"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHeight_percent="0.1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/button_board_layout"
                        app:layout_constraintWidth_percent="0.896"/>
                    <com.sportygames.spin2win.components.Spin2WinWheel
                        android:id="@+id/wheel_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:translationZ="@dimen/_11sdp"
                        android:elevation="@dimen/_11sdp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/game_header"/>
                    <androidx.cardview.widget.CardView
                        android:id="@+id/wheel_layout_shadow"
                        android:background="@color/redblack_bg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:translationZ="@dimen/_10sdp"
                        android:elevation="@dimen/_10sdp"
                        android:backgroundTint="@color/redblack_bg"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/game_header"/>
                    <androidx.constraintlayout.widget.Group
                        android:id="@+id/wheel_group"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:constraint_referenced_ids="wheel_layout, wheel_layout_shadow"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:textSize="@dimen/_14sdp"
                    android:textColor="@color/white"
                    android:id="@+id/tv_my_bets"
                    android:tag="@string/key_my_bets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_30sdp"
                    android:text="@string/sg_spin2win_my_bets"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TextPrimaryBold"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/bet_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_8sdp"
                    android:layout_marginTop="@dimen/_1sdp"
                    android:layout_marginRight="@dimen/_8sdp"
                    android:layout_marginHorizontal="@dimen/_8sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_my_bets"/>
                <androidx.constraintlayout.widget.Group
                    android:id="@+id/bet_list_group"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="bet_list, tv_my_bets"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/bet_button_layout"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_percent="0.08"
                    app:layout_constraintStart_toStartOf="parent">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/undo_layout"
                        android:background="@color/sg_color_08461a"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="@dimen/_1sdp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/clear_all_layout"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.17">
                        <ImageView
                            android:id="@+id/ic_undo"
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:layout_marginTop="@dimen/_10sdp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@drawable/sg_undo"/>
                        <TextView
                            android:textSize="@dimen/_8sdp"
                            android:textColor="@color/white"
                            android:id="@+id/tv_undo"
                            android:tag="@string/key_undo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/_3sdp"
                            android:text="@string/sg_undo"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            style="@style/TextPrimaryMedium"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/clear_all_layout"
                        android:background="@color/sg_color_08461a"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/_1sdp"
                        android:layout_marginEnd="@dimen/_1sdp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/spin_layout"
                        app:layout_constraintStart_toEndOf="@+id/undo_layout"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.17">
                        <ImageView
                            android:id="@+id/ic_clear"
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:layout_marginTop="@dimen/_10sdp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@drawable/sg_trash"/>
                        <TextView
                            android:textSize="@dimen/_8sdp"
                            android:textColor="@color/white"
                            android:id="@+id/tv_clear"
                            android:tag="@string/key_clear_all"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/_3sdp"
                            android:text="@string/sg_clear_all"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            style="@style/TextPrimaryMedium"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/spin_layout"
                        android:background="@color/sg_bg_spin_layout"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/_1sdp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/clear_all_layout"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:textSize="@dimen/_15sdp"
                            android:textColor="@color/white"
                            android:id="@+id/tv_spin"
                            android:tag="@string/key_spin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sg_spin"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            style="@style/TextPrimaryBold"/>
                        <androidx.constraintlayout.widget.Guideline
                            android:orientation="horizontal"
                            android:id="@+id/guideline1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_constraintGuide_percent="0.5"/>
                        <androidx.constraintlayout.widget.Guideline
                            android:orientation="vertical"
                            android:id="@+id/guideline2"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            app:layout_constraintGuide_percent="0.5"/>
                        <androidx.constraintlayout.widget.Group
                            android:id="@+id/stake_group"
                            android:visibility="visible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:constraint_referenced_ids="tv_total_stake, total_stake_value, tv_potential_win, potential_win_value"/>
                        <TextView
                            android:textSize="@dimen/_9sdp"
                            android:id="@+id/tv_total_stake"
                            android:tag="@string/totat_stake_cms"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="-4dp"
                            android:text="@string/sg_total_stake"
                            android:layout_marginEnd="@dimen/_8sdp"
                            app:layout_constraintEnd_toEndOf="@+id/guideline2"
                            app:layout_constraintTop_toTopOf="@+id/guideline1"
                            style="@style/TextPrimaryBold"/>
                        <TextView
                            android:textSize="@dimen/_9sdp"
                            android:id="@+id/total_stake_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="-2dp"
                            android:layout_marginEnd="@dimen/_18sdp"
                            app:layout_constraintEnd_toEndOf="@+id/guideline2"
                            app:layout_constraintTop_toBottomOf="@+id/tv_total_stake"
                            style="@style/TextPrimaryBold"/>
                        <ImageView
                            android:id="@+id/ic_fbg"
                            android:visibility="gone"
                            android:layout_width="@dimen/_8sdp"
                            android:layout_height="@dimen/_8sdp"
                            android:src="@drawable/gift_box"
                            android:layout_marginStart="@dimen/_2sdp"
                            android:layout_marginEnd="@dimen/_8sdp"
                            app:layout_constraintEnd_toEndOf="@+id/guideline2"
                            app:layout_constraintTop_toBottomOf="@+id/tv_total_stake"/>
                        <TextView
                            android:textSize="@dimen/_9sdp"
                            android:id="@+id/tv_potential_win"
                            android:tag="@string/key_potential_win"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="-4dp"
                            android:text="@string/sg_potential_win"
                            android:layout_marginStart="@dimen/_8sdp"
                            app:layout_constraintStart_toStartOf="@+id/guideline2"
                            app:layout_constraintTop_toTopOf="@+id/guideline1"
                            style="@style/TextPrimaryBold"/>
                        <TextView
                            android:textSize="@dimen/_9sdp"
                            android:id="@+id/potential_win_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="-2dp"
                            android:layout_marginStart="@dimen/_8sdp"
                            app:layout_constraintStart_toStartOf="@+id/guideline2"
                            app:layout_constraintTop_toBottomOf="@+id/tv_potential_win"
                            style="@style/TextPrimaryBold"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/new_bet_layout"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_percent="0.08"
                    app:layout_constraintStart_toStartOf="parent">
                    <TextView
                        android:textSize="@dimen/_16ssp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/re_bet"
                        android:tag="@string/rebet_btn_cms"
                        android:background="@color/sg_color_08461a"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:text="@string/rebet"
                        android:textAllCaps="false"
                        android:autoSizeTextType="uniform"
                        android:autoSizeStepGranularity="@dimen/_1ssp"
                        android:autoSizeMinTextSize="@dimen/_12ssp"
                        android:autoSizeMaxTextSize="@dimen/_16ssp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/new_round"
                        app:layout_constraintHeight_default="percent"
                        app:layout_constraintStart_toStartOf="parent"
                        style="@style/TextPrimaryMedium"/>
                    <TextView
                        android:textSize="@dimen/_16ssp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/new_round"
                        android:tag="@string/new_round_btn_cms"
                        android:background="@color/sg_bg_spin_layout"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:text="@string/sg_new_bet"
                        android:textAllCaps="false"
                        android:autoSizeTextType="uniform"
                        android:autoSizeStepGranularity="@dimen/_1ssp"
                        android:autoSizeMinTextSize="@dimen/_12ssp"
                        android:autoSizeMaxTextSize="@dimen/_16ssp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHeight_default="percent"
                        app:layout_constraintStart_toEndOf="@+id/re_bet"
                        style="@style/TextPrimaryMedium"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.google.android.material.navigation.NavigationView
                android:layout_gravity="end"
                android:id="@+id/navigationView"
                android:layout_width="@dimen/_230sdp"
                android:layout_height="match_parent">
                <com.sportygames.commons.components.SGHamburgerMenu
                    android:id="@+id/hamburger_menu"
                    android:background="@color/sg_color_1e6847"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:header_color="@color/sg_color_075431"/>
            </com.google.android.material.navigation.NavigationView>
        </androidx.drawerlayout.widget.DrawerLayout>
        <FrameLayout
            android:layout_gravity="bottom"
            android:id="@+id/flContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.sportygames.commons.components.GiftToast
            android:id="@+id/gift_toast_bar"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:translationZ="2dp"
            app:applyMotionScene="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.sportygames.commons.components.SgErrorToastContainer
            android:id="@+id/error_toast"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:translationZ="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <com.sportygames.commons.components.ProgressMeterComponent
        android:id="@+id/progress_meter_component"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/onboarding_images"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
</androidx.constraintlayout.widget.ConstraintLayout>
