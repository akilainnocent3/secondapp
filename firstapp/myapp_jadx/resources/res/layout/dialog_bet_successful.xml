<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/loyalty_progress_hint_compose_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        app:layout_constraintBottom_toTopOf="@+id/guideline_10"
        app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.1"/>
    <ScrollView
        android:id="@+id/scrollView"
        android:background="@color/background_general_primary"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="false"
        app:layout_constraintBottom_toTopOf="@+id/pairButton"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintHeight_min="0dp"
        app:layout_constraintTop_toBottomOf="@+id/guideline_10"
        app:layout_constraintVertical_bias="1">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true">
            <androidx.constraintlayout.widget.Guideline
                android:orientation="horizontal"
                android:id="@+id/guide_line_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_begin="24dp"/>
            <ImageView
                android:id="@+id/succ_icon_image_view"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/spr_event_win"
                android:layout_marginEnd="8dp"
                app:layout_constraintEnd_toStartOf="@+id/succ_title_text_view"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/guide_line_top"
                app:tint="@color/brand_secondary"/>
            <TextView
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="@color/text_type1_primary"
                android:id="@+id/succ_title_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/component_betslip__bet_successfule"
                app:layout_constraintBottom_toBottomOf="@+id/succ_icon_image_view"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/succ_icon_image_view"
                app:layout_constraintTop_toTopOf="@+id/succ_icon_image_view"/>
            <RelativeLayout
                android:id="@+id/info_container"
                android:paddingLeft="32dp"
                android:paddingTop="24dp"
                android:paddingRight="32dp"
                android:paddingBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="32dp"
                app:layout_constraintTop_toBottomOf="@+id/succ_icon_image_view">
                <TextView
                    android:textAppearance="@style/B1_M"
                    android:textColor="@color/text_type1_secondary"
                    android:id="@+id/textView11"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bet_history__total_stake"/>
                <TextView
                    android:textAppearance="@style/B1_B"
                    android:textColor="@color/text_type1_tertiary"
                    android:gravity="end"
                    android:id="@+id/total_stake_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/textView11"
                    android:layout_alignParentEnd="true"/>
                <TextView
                    android:textAppearance="@style/B1_M"
                    android:textColor="@color/text_type1_secondary"
                    android:id="@+id/excise_tax"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/common_functions__excise_tax"
                    android:layout_below="@+id/textView11"/>
                <TextView
                    android:textAppearance="@style/B1_B"
                    android:textColor="@color/text_type1_tertiary"
                    android:gravity="end"
                    android:id="@+id/excise_tax_value"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/excise_tax"
                    android:layout_alignParentEnd="true"/>
                <TextView
                    android:textAppearance="@style/B1_M"
                    android:textColor="@color/text_type1_secondary"
                    android:id="@+id/gift_type"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/common_functions__cash_gift"
                    android:layout_below="@+id/excise_tax"/>
                <TextView
                    android:textAppearance="@style/B1_B"
                    android:textColor="@color/text_type1_tertiary"
                    android:gravity="end"
                    android:id="@+id/gift_value"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/gift_type"
                    android:layout_alignParentEnd="true"/>
                <TextView
                    android:textAppearance="@style/B1_M"
                    android:textColor="@color/text_type1_secondary"
                    android:id="@+id/full_winning_title"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/component_betslip__potential_return"
                    android:layout_below="@+id/gift_type"/>
                <TextView
                    android:textAppearance="@style/B1_B"
                    android:textColor="@color/text_type1_tertiary"
                    android:gravity="end"
                    android:id="@+id/full_winning_value"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/full_winning_title"
                    android:layout_alignParentEnd="true"/>
                <TextView
                    android:textAppearance="@style/B1_M"
                    android:textColor="@color/text_type1_secondary"
                    android:id="@+id/wh_tax"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/bet_history__wh_tax"
                    android:layout_below="@+id/full_winning_title"/>
                <TextView
                    android:textAppearance="@style/B1_B"
                    android:textColor="@color/text_type1_tertiary"
                    android:gravity="end"
                    android:id="@+id/wh_tax_value"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/wh_tax"
                    android:layout_alignParentEnd="true"/>
                <TextView
                    android:textAppearance="@style/B1_M"
                    android:textColor="@color/text_type1_secondary"
                    android:id="@+id/net_win"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/component_betslip__to_win"
                    android:layout_below="@+id/wh_tax"/>
                <TextView
                    android:textAppearance="@style/B1_B"
                    android:textColor="@color/text_type1_tertiary"
                    android:gravity="end"
                    android:id="@+id/net_win_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/net_win"
                    android:layout_alignBottom="@+id/net_win"
                    android:layout_alignParentEnd="true"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textAppearance="@style/B1_M"
                    android:textColor="@color/text_type1_secondary"
                    android:id="@+id/one_cut"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/common_functions__one_cut_win"
                    android:layout_below="@+id/net_win"
                    app:drawableLeftCompat="@drawable/ic_one_cut_active"/>
                <TextView
                    android:textAppearance="@style/B1_B"
                    android:textColor="@color/text_type1_tertiary"
                    android:gravity="end"
                    android:id="@+id/one_cut_win_value"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/one_cut"
                    android:layout_alignBottom="@+id/one_cut"
                    android:layout_alignParentEnd="true"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/booking_code_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_below="@+id/one_cut">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/booking_code_left_container"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textAppearance="@style/B1_B"
                            android:textColor="@color/text_type1_tertiary"
                            android:ellipsize="end"
                            android:id="@+id/booking_code_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"/>
                        <ImageView
                            android:id="@+id/booking_code_info"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:focusable="true"
                            android:clickable="true"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/spr_info"
                            android:layout_marginStart="6dp"
                            app:tint="@color/text_type1_secondary"/>
                    </LinearLayout>
                    <FrameLayout
                        android:id="@+id/share_state_container"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="12dp">
                        <ImageView
                            android:id="@+id/share_btn"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_booking_code_share"
                            app:tint="@color/text_type1_tertiary"/>
                        <ProgressBar
                            android:id="@+id/share_btn_loading"
                            android:visibility="gone"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:indeterminate="true"
                            android:indeterminateDrawable="@drawable/share_code_loading_circle_black"/>
                    </FrameLayout>
                    <ImageView
                        android:id="@+id/copy_btn"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_booking_code_copy"
                        android:layout_marginStart="12dp"
                        app:tint="@color/text_type1_tertiary"/>
                    <FrameLayout
                        android:id="@+id/publish_state_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp">
                        <TextView
                            android:textAppearance="@style/B1_B"
                            android:textColor="@color/brand_secondary"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/publish_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/common_functions__publish"/>
                        <TextView
                            android:textAppearance="@style/B1_B"
                            android:textColor="@color/brand_secondary"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/view_publish_btn"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/common_functions__view"/>
                        <ProgressBar
                            android:layout_gravity="center_vertical"
                            android:id="@+id/publish_btn_loading"
                            android:visibility="gone"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:indeterminate="true"
                            android:indeterminateDrawable="@drawable/share_code_loading_circle_black"/>
                    </FrameLayout>
                </LinearLayout>
                <TextView
                    android:textAppearance="@style/B1_M"
                    android:textColor="@color/text_type1_secondary"
                    android:id="@+id/custom_code_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="20dp"
                    android:text="@string/common_functions__assign_custom_code"
                    android:layout_below="@+id/booking_code_row"/>
                <TextView
                    android:textAppearance="@style/B1_B"
                    android:textColor="@color/colorPrimary"
                    android:gravity="end|center_vertical"
                    android:id="@+id/custom_code_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/common_functions__assign_code"
                    android:layout_alignTop="@+id/custom_code_label"
                    android:layout_alignBottom="@+id/custom_code_label"
                    android:layout_alignParentEnd="true"/>
                <TextView
                    android:textAppearance="@style/B1_M"
                    android:textColor="@color/text_type1_secondary"
                    android:id="@+id/reward_progress_label"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/component_betslip__reward_progress"
                    android:layout_below="@+id/custom_code_label"/>
                <TextView
                    android:textAppearance="@style/B1_B"
                    android:textColor="@color/brand_secondary"
                    android:id="@+id/view_reward_progress_button"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/common_functions__view"
                    android:layout_alignTop="@+id/reward_progress_label"
                    android:layout_alignBottom="@+id/reward_progress_label"
                    android:layout_alignParentEnd="true"/>
                <TextView
                    android:textAppearance="@style/B1_M"
                    android:textColor="@color/text_type1_secondary"
                    android:id="@+id/open_bets_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/common_functions__open_bets"
                    android:layout_below="@+id/reward_progress_label"/>
                <TextView
                    android:textAppearance="@style/B1_B"
                    android:textColor="@color/brand_secondary"
                    android:id="@+id/view_open_bets_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/common_functions__view"
                    android:layout_alignTop="@+id/open_bets_label"
                    android:layout_alignBottom="@+id/open_bets_label"
                    android:layout_alignParentEnd="true"/>
                <View
                    android:id="@+id/social_share_divider"
                    android:background="@color/line_type1_primary"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_below="@+id/open_bets_label"/>
                <include
                    android:id="@+id/social_share_section"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_below="@+id/booking_code_row"
                    layout="@layout/layout_social_share_section"/>
                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/joker_selections_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_below="@+id/open_bets_label"/>
                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/note_on_bet_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/joker_selections_view"/>
            </RelativeLayout>
            <TextView
                android:textSize="10dp"
                android:textStyle="normal"
                android:textColor="#9ca0ab"
                android:id="@+id/cashout_gift_info"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/component_betslip__note_cashout_unavailabel_as_gifts_have_been_used"
                android:fontFamily="sans-serif"
                android:layout_marginStart="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/info_container"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/post_bet_upsell_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                app:layout_constraintTop_toBottomOf="@+id/cashout_gift_info">
                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/post_bet_upsell_header_compose_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/post_bet_upsell_banner_compose_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/mission_bet_success_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/post_bet_upsell_section"/>
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/recommended_code_header_compose_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/mission_bet_success_view"/>
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/recommended_code_view_pager"
                android:background="@color/background_general_primary"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                app:layout_constraintTop_toBottomOf="@+id/recommended_code_header_compose_view"/>
            <View
                android:id="@+id/recommended_code_pager_bottom_space"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                app:layout_constraintTop_toBottomOf="@+id/recommended_code_view_pager"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/recommended_code_pager_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="recommended_code_view_pager,recommended_code_pager_bottom_space"/>
            <include
                android:id="@+id/recommended_code_spin_card"
                android:background="@color/background_general_primary"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginHorizontal="20dp"
                app:layout_constraintTop_toBottomOf="@+id/recommended_code_pager_bottom_space"
                layout="@layout/item_booking_code_info_pager"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/recommended_code_spin_button"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="16dp"
                app:layout_constraintTop_toBottomOf="@+id/recommended_code_spin_card">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/recommended_code_spin_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/recommended_code_spin_text"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic__general__spin"/>
                <TextView
                    android:textAppearance="@style/B2_B"
                    android:textColor="@color/brand_secondary"
                    android:id="@+id/recommended_code_spin_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/component_betslip__try_another_codes"
                    android:layout_marginStart="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/recommended_code_spin_icon"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/recommended_code_spin_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="recommended_code_spin_card,recommended_code_spin_button"/>
            <com.sporty.android.common_ui.widgets.AspectRatioImageView
                android:id="@+id/banner_ad"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                app:layout_constraintTop_toBottomOf="@+id/recommended_code_spin_button"/>
            <com.sporty.android.common_ui.widgets.LoadingViewNew
                android:id="@+id/loading_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <com.sporty.android.common_ui.widgets.GenericPairButton
        android:id="@+id/pairButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:gpbLeftButtonLabel="@string/common_functions__rebet"
        app:gpbRightButtonLabel="@string/common_functions__ok"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <com.sportybet.android.bookingcode.presentation.activity.CustomCodeComposeUtil
        android:id="@+id/compose_custom_code_sheet"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
