<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/text_type1_primary"
        android:gravity="center"
        android:id="@+id/open_bet_no_login_text"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/bet_history__please_log_in_to_see_your_open_and_cashout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="14dp"
        android:textColor="@color/brand_secondary"
        android:id="@+id/open_bet_login_btn"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="30dp"
        android:text="@string/common_functions__log_in"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/open_bet_no_login_text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
