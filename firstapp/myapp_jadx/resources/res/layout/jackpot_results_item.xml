<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="70dp">
    <android.widget.Space
        android:id="@+id/left_anchor"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/text_type2_primary"
        android:gravity="end|center_vertical"
        android:id="@+id/result_index"
        android:paddingRight="10dp"
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:fontFamily="sans-serif"
        android:paddingEnd="10dp"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/text_type2_secondary"
        android:gravity="start|center_vertical"
        android:id="@+id/home_team_name"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="33dp"
        android:singleLine="true"
        android:layout_toRightOf="@+id/left_anchor"
        android:layout_centerVertical="true"
        android:lineSpacingExtra="4.8sp"
        android:fontFamily="sans-serif"
        android:layout_marginStart="33dp"
        android:layout_toEndOf="@+id/left_anchor"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/text_type2_secondary"
        android:gravity="start|center_vertical"
        android:id="@+id/result_time"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:singleLine="true"
        android:layout_above="@+id/home_team_name"
        android:layout_alignLeft="@+id/home_team_name"
        android:lineSpacingExtra="4.8sp"
        android:fontFamily="sans-serif"
        android:layout_alignStart="@+id/home_team_name"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/text_type2_secondary"
        android:gravity="start|center_vertical"
        android:id="@+id/away_team_name"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:singleLine="true"
        android:layout_below="@+id/home_team_name"
        android:layout_alignLeft="@+id/home_team_name"
        android:lineSpacingExtra="4.8sp"
        android:fontFamily="sans-serif"
        android:layout_alignStart="@+id/home_team_name"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_type2_primary"
        android:gravity="center"
        android:id="@+id/result_result"
        android:layout_width="50dp"
        android:layout_height="match_parent"
        android:layout_marginRight="24dp"
        android:layout_alignParentRight="true"
        android:lineSpacingExtra="2.8sp"
        android:fontFamily="sans-serif"
        android:layout_marginEnd="24dp"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/brand_secondary_variable_type3"
        android:gravity="center"
        android:id="@+id/result_score"
        android:layout_width="50dp"
        android:layout_height="match_parent"
        android:layout_marginRight="108dp"
        android:drawablePadding="2dp"
        android:layout_alignParentRight="true"
        android:lineSpacingExtra="2.8sp"
        android:fontFamily="sans-serif"
        android:layout_marginEnd="108dp"
        android:layout_alignParentEnd="true"/>
    <View
        android:background="@color/background_type2_tertiary"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"/>
</RelativeLayout>
