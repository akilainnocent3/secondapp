<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_general_primary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_type1_primary"
        android:id="@+id/amount_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="15dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_type1_primary"
        android:id="@+id/amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/amount_label"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_type1_secondary"
        android:id="@+id/remain_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="20dp"
        android:text="@string/page_withdraw__remaining_amount"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/amount"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_type1_primary"
        android:id="@+id/remain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/remain_label"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_type1_secondary"
        android:id="@+id/draw_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/page_withdraw__withdraw_to"
        app:layout_constraintLeft_toLeftOf="@+id/remain_label"
        app:layout_constraintTop_toBottomOf="@+id/remain_label"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/drop_alert_icon"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_info_filled"
        android:tint="@color/other003"
        android:scaleY="-1"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/draw"
        app:layout_constraintEnd_toStartOf="@+id/draw"
        app:layout_constraintTop_toTopOf="@+id/draw"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_type1_primary"
        android:id="@+id/draw"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/remain"
        app:layout_constraintTop_toTopOf="@+id/draw_label"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_type1_secondary"
        android:id="@+id/mobile_number_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/my_account__mobile_number"
        app:layout_constraintLeft_toLeftOf="@+id/draw_label"
        app:layout_constraintTop_toBottomOf="@+id/draw_label"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_type1_primary"
        android:id="@+id/number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintRight_toRightOf="@+id/draw"
        app:layout_constraintTop_toBottomOf="@+id/mobile_number_label"
        app:layout_constraintTop_toTopOf="@+id/mobile_number_label"/>
    <TextView
        android:textSize="16sp"
        android:gravity="center"
        android:id="@+id/cancel"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:text="@string/common_functions__cancel"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/confirm"
        app:layout_constraintTop_toBottomOf="@+id/mobile_number_label"
        style="@style/Widget.App.CommonButton.NoRadius.DefaultSub"/>
    <com.sportybet.android.widget.ProgressButton
        android:gravity="center"
        android:id="@+id/confirm"
        android:background="@color/brand_quaternary"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:textAllCaps="false"
        app:layout_constraintHorizontal_weight="3"
        app:layout_constraintLeft_toRightOf="@+id/cancel"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cancel"/>
</androidx.constraintlayout.widget.ConstraintLayout>
