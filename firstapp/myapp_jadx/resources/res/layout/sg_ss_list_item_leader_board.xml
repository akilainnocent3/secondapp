<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/leader_board_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/leader_board_content"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/rank"
            android:background="@drawable/sg_coin_gold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:text="1"
            android:shadowColor="#3affffff"
            android:shadowDy="2"
            android:layout_centerVertical="true"
            android:fontFamily="@font/roboto_medium"/>
        <ImageView
            android:id="@+id/country"
            android:layout_width="28dp"
            android:layout_height="20dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="12dp"
            android:layout_toRightOf="@+id/rank"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="normal"
            android:textColor="#de000000"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:maxLines="2"
            android:layout_toLeftOf="@+id/score"
            android:layout_toRightOf="@+id/country"
            android:layout_centerVertical="true"
            android:fontFamily="@font/roboto"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="normal"
            android:textColor="#de000000"
            android:gravity="right"
            android:id="@+id/score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:maxWidth="200dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:fontFamily="@font/roboto"/>
    </RelativeLayout>
    <View
        android:background="@color/sg_leader_background"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/leader_board_content"/>
</RelativeLayout>
