<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/title_container"
        android:background="@color/brand_primary"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/goback"
            android:background="?android:attr/selectableItemBackground"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_action_bar_back"/>
        <TextView
            android:textSize="20dp"
            android:textStyle="normal"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/page_transaction__transactions"
            android:maxLines="1"
            android:layout_toRightOf="@+id/goback"
            android:layout_centerInParent="true"
            android:lineSpacingExtra="8dp"
            android:fontFamily="sans-serif-medium"
            android:layout_toEndOf="@+id/goback"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/help"
            android:background="?android:attr/selectableItemBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dp"
            android:layout_toLeftOf="@+id/search"
            android:layout_centerInParent="true"
            app:srcCompat="@drawable/spr_ic_help_outline_black_24dp"
            app:tint="@android:color/white"/>
        <ImageView
            android:id="@+id/search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dp"
            android:layout_toLeftOf="@+id/home"
            android:layout_centerInParent="true"
            app:srcCompat="@drawable/ic_action_bar_search"/>
        <ImageButton
            android:id="@+id/home"
            android:background="?android:attr/selectableItemBackground"
            android:paddingBottom="1dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:layout_alignParentRight="true"
            android:layout_centerInParent="true"
            app:srcCompat="@drawable/ic_home"
            app:tint="@android:color/white"/>
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/quick_btns"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="19dp"
        android:layout_marginTop="32dp"
        android:layout_marginRight="19dp"
        android:layout_below="@+id/title_container"
        android:layout_marginHorizontal="19dp">
        <com.sporty.android.common_ui.widgets.CommonButton
            android:id="@+id/quick_btn_1"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintEnd_toStartOf="@+id/quick_btn_2"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Widget.Transaction.CommonButton"/>
        <com.sporty.android.common_ui.widgets.CommonButton
            android:id="@+id/quick_btn_2"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:minHeight="32dp"
            android:layout_marginHorizontal="4dp"
            app:layout_constraintEnd_toStartOf="@+id/quick_btn_3"
            app:layout_constraintStart_toEndOf="@+id/quick_btn_1"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Widget.Transaction.CommonButton"/>
        <com.sporty.android.common_ui.widgets.CommonButton
            android:id="@+id/quick_btn_3"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_marginStart="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/quick_btn_2"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Widget.Transaction.CommonButton"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/dates"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="13dp"
        android:layout_below="@+id/quick_btns">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_type1_primary"
            android:gravity="start"
            android:id="@+id/tv_range_start_date"
            android:padding="8dp"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="36dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_type1_primary"
            android:gravity="end"
            android:id="@+id/tv_range_end_date"
            android:padding="8dp"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="36dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif"/>
    </LinearLayout>
    <com.sportybet.plugin.realsports.betorder.calendar.view.CalendarView
        android:id="@+id/calendar_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/dates"
        app:selectionType="range"
        style="@style/CustomCalendarView"/>
    <TextView
        android:textAppearance="@style/B2_R"
        android:textColor="@color/brand_quaternary"
        android:gravity="center"
        android:id="@+id/apply_btn"
        android:background="?android:attr/selectableItemBackground"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/calendar_button_height"
        android:layout_marginBottom="@dimen/calendar_button_bottom_margin"
        android:text="@string/common_functions__apply"
        android:layout_above="@+id/divide_line"
        android:layout_marginEnd="20dp"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textAppearance="@style/B2_R"
        android:textStyle="normal"
        android:textColor="@color/text_type1_primary"
        android:gravity="center"
        android:id="@+id/cancel_btn"
        android:background="?android:attr/selectableItemBackground"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/calendar_button_height"
        android:layout_marginBottom="@dimen/calendar_button_bottom_margin"
        android:text="@string/common_functions__cancel"
        android:layout_above="@+id/divide_line"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/divide_line"
        android:background="@color/line_type1_primary"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_above="@+id/bottom_description"/>
    <RelativeLayout
        android:id="@+id/bottom_description"
        android:padding="@dimen/calendar_go_to_older_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <TextView
            android:textAppearance="@style/B2_R"
            android:textColor="@color/text_type1_secondary"
            android:gravity="center_horizontal"
            android:id="@+id/description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/page_transaction__description_only_record_six_months_transaction_data"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <com.sportybet.android.widget.BubbleView
        android:id="@+id/newFeatureAlertView"
        android:visibility="gone"
        android:layout_width="279dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/quick_btns"
        android:layout_alignStart="@+id/quick_btns"
        app:closable="true"
        app:title="@string/page_transaction__new_feature_alert"
        app:trianglePosition="top_left"/>
</RelativeLayout>
