<?xml version="1.0" encoding="utf-8"?>
<com.sportybet.android.cashoutphase3.InstantCashoutView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="282dp">
    <TextView
        android:textColor="@color/text_type1_primary"
        android:id="@+id/stake_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/common_functions__stake"
        style="@style/B2_R"/>
    <TextView
        android:textColor="@color/text_type1_primary"
        android:id="@+id/stake"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/stake_label"
        android:layout_alignBottom="@+id/stake_label"
        android:layout_alignParentRight="true"
        style="@style/B1_B"/>
    <TextView
        android:textColor="@color/text_type1_primary"
        android:id="@+id/pot_win_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/component_cashout__pot_win"
        android:layout_below="@+id/stake_label"
        style="@style/B2_R"/>
    <TextView
        android:textColor="@color/text_type1_primary"
        android:id="@+id/pot_win"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/pot_win_label"
        android:layout_alignBottom="@+id/pot_win_label"
        android:layout_alignParentRight="true"
        style="@style/B1_B"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center"
        android:id="@+id/spr_cash_out_instant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:minHeight="76dp"
        android:layout_below="@+id/pot_win">
        <com.sportybet.plugin.realsports.widget.DancingNumber2
            android:textSize="20dp"
            android:textColor="@color/text_type1_primary"
            android:gravity="center"
            android:id="@+id/spr_cash_out_instant_middle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.sportybet.plugin.realsports.widget.DancingNumber2
            android:textSize="12dp"
            android:textColor="@color/text_type1_secondary"
            android:gravity="center"
            android:id="@+id/middle2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="12dp"
            android:layout_marginHorizontal="12dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/spr_cash_out_instant_middle"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12dp"
            android:textColor="@color/text_type1_secondary"
            android:gravity="bottom|center_horizontal"
            android:id="@+id/tax_msg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            app:autoSizeMaxTextSize="12dp"
            app:autoSizeMinTextSize="8dp"
            app:autoSizeStepGranularity="1dp"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/middle2"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/spr_cash_out_instant_seek_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/button_container"
        android:layout_below="@+id/spr_cash_out_instant">
        <SeekBar
            android:id="@+id/spr_cash_out_instant_seek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:progressDrawable="@drawable/spr_seekbar_style"
            android:thumb="@drawable/spr_custom_thumb"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/text_type1_primary"
            android:id="@+id/spr_cash_out_instant_min"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            app:layout_constraintStart_toStartOf="@+id/spr_cash_out_instant_seek"
            app:layout_constraintTop_toBottomOf="@+id/spr_cash_out_instant_seek"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/text_type1_primary"
            android:id="@+id/spr_cash_out_instant_max"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:layout_alignParentRight="true"
            app:layout_constraintEnd_toEndOf="@+id/spr_cash_out_instant_seek"
            app:layout_constraintTop_toBottomOf="@+id/spr_cash_out_instant_seek"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/spr_cash_out_instant_fallback_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_below="@+id/spr_cash_out_instant">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="10dp"
            android:textColor="@color/text_danger"
            android:gravity="center_horizontal"
            android:id="@+id/fallback_text"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cashout__fallback_cashout_confirm_popup_hint"
            android:maxLines="3"
            android:paddingHorizontal="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/fallback_tip_mark"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/C2_R"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/fallback_tip_mark"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginTop="2dp"
            android:tint="@color/icon_brand_main"
            app:layout_constraintBottom_toBottomOf="@+id/fallback_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/fallback_text"
            app:srcCompat="@drawable/ic_icon_tip_mark"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/update_button_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/update_button_inner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Widget.App.CommonButton.Outline">
            <androidx.appcompat.widget.AppCompatTextView
                android:textAppearance="@style/H4_M"
                android:textColor="@color/text_brand_sub_primary_d_lighter"
                android:gravity="center"
                android:id="@+id/update_text_btn"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/cashout__update_required_to_continue"
                android:textAllCaps="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/update_icon"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/update_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:tint="@color/text_color_brand_secondary"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/update_text_btn"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/icon_arrow1_right"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/brand_secondary"
            android:id="@+id/update_no_p_why"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/cashout__why_is_partial_cashout_unavailable"
            android:drawablePadding="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/update_button_inner"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/button_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/spr_cash_out_instant_cash_out"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:textAllCaps="false"
            app:layout_constraintEnd_toStartOf="@+id/refresh_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Widget.App.CommonButton.Contained"/>
        <com.sportybet.android.widget.ProgressButton
            android:id="@+id/confirm_cashout_progress"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:minHeight="48dp"
            app:layout_constraintBottom_toBottomOf="@+id/spr_cash_out_instant_cash_out"
            app:layout_constraintEnd_toEndOf="@+id/spr_cash_out_instant_cash_out"
            app:layout_constraintStart_toStartOf="@+id/spr_cash_out_instant_cash_out"
            app:layout_constraintTop_toTopOf="@+id/spr_cash_out_instant_cash_out"
            app:loadingText="@string/common_functions__confirm"/>
        <ImageButton
            android:id="@+id/refresh_button"
            android:background="@drawable/spr_refresh_bg"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/spr_cash_out_instant_cash_out"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/spr_cash_out_instant_cash_out"
            app:layout_constraintTop_toTopOf="@+id/spr_cash_out_instant_cash_out"
            app:srcCompat="@drawable/spr_ic_refresh_black_24dp"
            app:tint="@color/brand_secondary"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/brand_secondary"
            android:id="@+id/spr_cash_out_instant_no_p_why"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/cashout__why_is_partial_cashout_unavailable"
            android:drawablePadding="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/spr_cash_out_instant_cash_out"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.sportybet.android.cashoutphase3.InstantCashoutView>
