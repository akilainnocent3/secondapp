<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/line"
        android:background="@color/background_type1_primary"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_primary"
        android:id="@+id/withdraw_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:minHeight="19dp"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/line"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_secondary"
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        app:layout_constraintLeft_toLeftOf="@+id/withdraw_amount"
        app:layout_constraintTop_toBottomOf="@+id/withdraw_amount"
        app:layout_constraintTop_toTopOf="@+id/partner_code"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_type1_primary"
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="40dp"
        android:minHeight="24dp"
        android:fontFamily="sans-serif"
        app:layout_constraintRight_toRightOf="@+id/line"
        app:layout_constraintTop_toTopOf="@+id/withdraw_amount"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_secondary"
        android:id="@+id/partner_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        app:layout_constraintRight_toRightOf="@+id/status"
        app:layout_constraintTop_toBottomOf="@+id/status"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_primary"
        android:id="@+id/pin_code"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        app:layout_constraintRight_toRightOf="@+id/partner_code"
        app:layout_constraintTop_toBottomOf="@+id/partner_code"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_primary"
        android:id="@+id/cancel_fee"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        app:layout_constraintRight_toRightOf="@+id/partner_code"
        app:layout_constraintTop_toBottomOf="@+id/partner_code"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/text_type1_secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="4dp"
        android:text="&gt;"
        android:fontFamily="sans-serif"
        app:layout_constraintBottom_toBottomOf="@+id/time"
        app:layout_constraintLeft_toRightOf="@+id/status"
        app:layout_constraintRight_toRightOf="parent"/>
    <Button
        android:gravity="center"
        android:id="@+id/cancel_btn"
        android:visibility="gone"
        android:layout_width="328dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:minHeight="37dp"
        android:text="@string/page_withdraw__cancel_withdraw"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pin_code"
        style="@style/Widget.App.CommonButton.Outline"/>
</androidx.constraintlayout.widget.ConstraintLayout>
