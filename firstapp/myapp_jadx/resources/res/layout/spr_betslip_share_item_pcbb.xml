<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/ivGame"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_bet_builder_list_logo"
        android:layout_marginStart="15dp"
        app:layout_constraintBottom_toBottomOf="@+id/game"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/game"/>
    <TextView
        android:textAppearance="@style/B1_B"
        android:textSize="14dp"
        android:textStyle="italic|bold"
        android:textColor="@color/text_inverse_brand_sub"
        android:ellipsize="end"
        android:id="@+id/game"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/bet_builder__bet_builder"
        android:maxLines="1"
        android:layout_marginStart="2dp"
        android:paddingVertical="7dp"
        app:layout_constraintStart_toEndOf="@+id/ivGame"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/text_type1_primary"
        android:gravity="center"
        android:id="@+id/odds"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="15dp"
        android:layout_marginHorizontal="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/H4_B"/>
    <TextView
        android:textColor="@color/text_type1_primary"
        android:ellipsize="end"
        android:id="@+id/teamname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="2dp"
        android:maxLines="1"
        android:layout_marginHorizontal="15dp"
        android:layout_marginVertical="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/game"
        style="@style/B1_R"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/text_type1_secondary"
        android:id="@+id/bb_selections"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="15dp"
        android:lineSpacingExtra="4dp"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="20dp"
        android:layout_marginHorizontal="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/teamname"/>
    <ImageView
        android:id="@+id/bb_selections_line"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:src="@drawable/spr_ic_selections_line"
        android:scaleType="fitXY"
        android:layout_marginStart="6dp"
        android:paddingVertical="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/bb_selections"
        app:layout_constraintStart_toStartOf="@+id/bb_selections"
        app:layout_constraintTop_toTopOf="@+id/bb_selections"/>
    <View
        android:id="@+id/bottom_padding"
        android:background="@color/line_type1_primary"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/bb_selections"/>
</androidx.constraintlayout.widget.ConstraintLayout>
