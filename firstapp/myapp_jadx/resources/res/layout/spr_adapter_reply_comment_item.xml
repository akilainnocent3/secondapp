<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/reply_comment_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="0dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="16dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/member_icon_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/reply_comment_guideline"
        app:layout_constraintTop_toTopOf="parent">
        <com.sporty.android.common_ui.widgets.CircleImageView
            android:id="@+id/icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/default_avatar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.sporty.android.common_ui.widgets.CircleImageView
            android:id="@+id/country_icon"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:src="@drawable/default_avatar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintCircle="@+id/icon"
            app:layout_constraintCircleAngle="120"
            app:layout_constraintCircleRadius="10dp"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/comment_container"
        android:background="@drawable/prematch_comment_rect_bg"
        android:paddingLeft="8dp"
        android:paddingTop="4dp"
        android:paddingRight="8dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="8dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/guideline_end"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/member_icon_container"
        app:layout_constraintTop_toTopOf="@+id/member_icon_container">
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_type1_primary"
            android:id="@+id/nick_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="normal"
            android:textColor="@color/text_type1_primary"
            android:id="@+id/comment"
            android:longClickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="200dp"
            android:maxLines="3"
            android:fontFamily="sans-serif"
            app:layout_constraintStart_toStartOf="@+id/nick_name"
            app:layout_constraintTop_toBottomOf="@+id/nick_name"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_type1_secondary"
            android:id="@+id/txtSeeMore"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="@string/common_functions__see_more"
            app:layout_constraintStart_toStartOf="@+id/comment"
            app:layout_constraintTop_toBottomOf="@+id/comment"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:id="@+id/comment_content_layout"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="@+id/guideline_end"
        app:layout_constraintStart_toStartOf="@+id/comment_container"
        app:layout_constraintTop_toBottomOf="@+id/comment_container"
        layout="@layout/spr_adapter_comment_image_view"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/information_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/comment_container"
        app:layout_constraintTop_toBottomOf="@+id/comment_content_layout">
        <TextView
            android:textSize="12sp"
            android:layout_gravity="center_vertical"
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.sportybet.plugin.realsports.event.comment.prematch.view.PostSocialPanel
            android:id="@+id/view_social_panel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <com.sportybet.plugin.realsports.event.comment.ReplyPanel
        android:id="@+id/reply_container"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/guideline_end"
        app:layout_constraintStart_toStartOf="@+id/comment_container"
        app:layout_constraintTop_toBottomOf="@+id/information_panel"/>
</androidx.constraintlayout.widget.ConstraintLayout>
