<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="40dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ivStakeArrow"
        android:paddingTop="@dimen/_4sdp"
        android:paddingBottom="@dimen/_1sdp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/clBetSlider"
        app:layout_constraintEnd_toEndOf="@+id/clBetSlider"
        app:layout_constraintStart_toStartOf="@+id/clBetSlider"
        app:layout_constraintWidth_percent="0.1">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivStakeArrowImage"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="0x7f080372"
            android:adjustViewBounds="true"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.3"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBetSlider"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.9"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivStakeArrow"
        app:layout_constraintWidth_percent="0.1556"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/clBetSlider"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="#4d000000"
        app:cardCornerRadius="30dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.9"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivStakeArrow"
        app:layout_constraintWidth_percent="0.1556">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBetChips"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:stackFromEnd="true"/>
        <View
            android:id="@+id/scrollBlocker"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.cardview.widget.CardView>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/_10ssp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tvSelectStakes"
        android:tag="@string/fh_select_stake_cms"
        android:paddingTop="6dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/fh_select_stake"
        android:lines="2"
        app:layout_constraintEnd_toEndOf="@+id/clBetSlider"
        app:layout_constraintStart_toStartOf="@+id/clBetSlider"
        app:layout_constraintTop_toBottomOf="@+id/clBetSlider"
        app:layout_constraintWidth_percent="0.22"
        style="@style/TextPrimaryBold"/>
</androidx.constraintlayout.widget.ConstraintLayout>
