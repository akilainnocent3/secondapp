<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/fragment_root"
            android:paddingTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.sporty.android.common_ui.widgets.AspectRatioImageView
                android:id="@+id/top_ad"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:scaleType="fitXY"
                android:layout_below="@+id/flag"/>
            <ImageButton
                android:id="@+id/close"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:layout_marginRight="16dp"
                android:layout_alignParentRight="true"
                app:srcCompat="@drawable/ic_close_black_24dp"
                app:tint="@color/text_type1_secondary"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/text_type1_tertiary"
                android:gravity="center_vertical"
                android:id="@+id/flag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="8dp"
                android:drawablePadding="6dp"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/brand_secondary"
                android:gravity="center_vertical"
                android:id="@+id/change_region"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:text="@string/common_functions__change"
                android:drawablePadding="6dp"
                android:layout_toRightOf="@+id/flag"
                android:layout_alignTop="@+id/flag"
                android:layout_alignBottom="@+id/flag"
                android:layout_marginStart="14dp"
                android:layout_toEndOf="@+id/flag"/>
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_type1_primary"
                android:gravity="center"
                android:id="@+id/title"
                android:paddingLeft="30dp"
                android:paddingRight="30dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/page_login__join_sportybet_with_your_mobile_number"
                android:layout_below="@+id/top_ad"
                android:layout_centerHorizontal="true"
                android:paddingHorizontal="30dp"/>
            <FrameLayout
                android:id="@+id/mobile_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="24dp"
                android:layout_marginRight="30dp"
                android:layout_below="@+id/title">
                <com.sporty.android.common_ui.widgets.ClearEditText
                    android:textSize="14sp"
                    android:id="@+id/mobile"
                    android:background="@drawable/bg_outlined_line_type1_secondary_2_radius"
                    android:paddingLeft="60dp"
                    android:paddingRight="11dp"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:hint="@string/my_account__mobile_number"
                    android:maxLines="1"
                    android:maxLength="@integer/mobile_max_length"
                    android:digits="0123456789"
                    android:inputType="phone"
                    android:imeOptions="actionDone"/>
                <TextView
                    android:textColor="@color/text_type1_secondary"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/prefix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="18dp"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/info_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp"
                android:layout_marginRight="30dp"
                android:minHeight="42dp"
                android:layout_below="@+id/mobile_container">
                <TextView
                    android:textAppearance="@style/ErrorTextView"
                    android:id="@+id/error"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/hint"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/gp_policy_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp">
                    <CheckBox
                        android:textSize="14dp"
                        android:textColor="@color/text_type1_primary"
                        android:gravity="top"
                        android:id="@+id/check_box_gp_privacy_policy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp"
                        android:checked="false"
                        android:paddingStart="8dp"/>
                    <CheckBox
                        android:textSize="14dp"
                        android:textColor="@color/text_type1_primary"
                        android:gravity="top"
                        android:id="@+id/check_box_gp_terms_conditions_and_age"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp"
                        android:checked="false"
                        android:paddingStart="8dp"/>
                </LinearLayout>
            </LinearLayout>
            <com.sportybet.android.widget.ProgressButton
                android:id="@+id/next"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginLeft="30dp"
                android:layout_marginRight="30dp"
                android:text="@string/common_functions__next"
                android:layout_below="@+id/info_container"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/brand_secondary"
                android:id="@+id/login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="@string/page_login__already_have_an_account_log_in"
                android:layout_below="@+id/next"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
    </LinearLayout>
</ScrollView>
