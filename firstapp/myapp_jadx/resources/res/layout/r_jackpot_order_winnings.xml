<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_type2_primary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:background="@color/custom_brand_secondary_opacity_type3"
        android:padding="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="10dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="14sp"
            android:textStyle="normal"
            android:textColor="@color/text_type2_primary"
            android:id="@+id/win_order_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:lineSpacingExtra="8sp"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="normal"
            android:textColor="@color/focus"
            android:gravity="end"
            android:id="@+id/win_order_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_alignParentRight="true"
            android:lineSpacingExtra="8sp"
            android:fontFamily="sans-serif"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
