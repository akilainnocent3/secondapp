<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/trans_black_70"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="32dp"
        app:cardCornerRadius="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/background_image"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/sg_rut_purple_gd"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="@+id/linear_layout"
                app:layout_constraintEnd_toEndOf="@+id/linear_layout"
                app:layout_constraintStart_toStartOf="@+id/linear_layout"
                app:layout_constraintTop_toTopOf="@+id/linear_layout"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/sg_rut_sporty_top_left"
                app:layout_constraintStart_toStartOf="@+id/linear_layout"
                app:layout_constraintTop_toTopOf="@+id/linear_layout"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/sg_rut_sporty_bottom_right"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="@+id/linear_layout"
                app:layout_constraintEnd_toEndOf="@+id/linear_layout"/>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/linear_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:layout_gravity="right"
                    android:id="@+id/round_close"
                    android:background="@null"
                    android:layout_width="@dimen/_28sdp"
                    android:layout_height="@dimen/_28sdp"
                    android:layout_margin="8dp"
                    app:srcCompat="@drawable/sg_rut_ic_highlight_off_black_24dp"/>
                <TextView
                    android:textSize="22sp"
                    android:textColor="#fff"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-24dp"
                    android:text="@string/sg_game_roulette__rounds_to_play"
                    style="@style/TextPrimaryBold"/>
                <View
                    android:background="#33ffffff"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="13dp"
                    android:layout_marginRight="8dp"/>
                <GridLayout
                    android:id="@+id/grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <View
                    android:background="#33ffffff"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#fff"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:text="@string/sg_game_roulette__note_if_you_drop_out_these_rewards_will_not_apply"
                    style="@style/TextRegularPrimary"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
