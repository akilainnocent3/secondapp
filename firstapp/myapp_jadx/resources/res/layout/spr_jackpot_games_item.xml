<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="70dp">
    <android.widget.Space
        android:id="@+id/left_anchor"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
    <android.widget.Space
        android:id="@+id/right_anchor"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="end|center_vertical"
        android:id="@+id/jackpot_index"
        android:paddingRight="10dp"
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:fontFamily="sans-serif"
        android:paddingEnd="10dp"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/jackpot_home_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="33dp"
        android:maxWidth="105dp"
        android:singleLine="true"
        android:layout_toRightOf="@+id/left_anchor"
        android:layout_centerVertical="true"
        android:lineSpacingExtra="4.8sp"
        android:fontFamily="sans-serif"
        android:layout_marginStart="33dp"
        android:layout_toEndOf="@+id/left_anchor"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/jackpot_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:maxWidth="105dp"
        android:singleLine="true"
        android:layout_above="@+id/jackpot_home_name"
        android:layout_alignLeft="@+id/jackpot_home_name"
        android:lineSpacingExtra="4.8sp"
        android:fontFamily="sans-serif"
        android:layout_alignStart="@+id/jackpot_home_name"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="start|center_vertical"
        android:id="@+id/jackpot_away_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxWidth="105dp"
        android:singleLine="true"
        android:layout_below="@+id/jackpot_home_name"
        android:layout_alignLeft="@+id/jackpot_home_name"
        android:layout_centerVertical="true"
        android:lineSpacingExtra="4.8sp"
        android:fontFamily="sans-serif"
        android:layout_alignStart="@+id/jackpot_home_name"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/jackpot_away"
        android:background="@drawable/spr_toggle_bg_dark"
        android:layout_width="@dimen/jackpot_btn_width"
        android:layout_height="@dimen/jackpot_btn_height"
        android:layout_marginRight="@dimen/jackpot_away_margin_right"
        android:layout_toLeftOf="@+id/right_anchor"
        android:layout_centerVertical="true"
        android:fontFamily="sans-serif"
        android:layout_marginEnd="@dimen/jackpot_away_margin_right"
        android:layout_toStartOf="@+id/right_anchor"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/jackpot_draw"
        android:background="@drawable/spr_toggle_bg_dark"
        android:layout_width="@dimen/jackpot_btn_width"
        android:layout_height="@dimen/jackpot_btn_height"
        android:layout_marginRight="@dimen/jackpot_draw_margin_right"
        android:layout_toLeftOf="@+id/right_anchor"
        android:layout_alignTop="@+id/jackpot_away"
        android:fontFamily="sans-serif"
        android:layout_marginEnd="@dimen/jackpot_draw_margin_right"
        android:layout_toStartOf="@+id/right_anchor"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/jackpot_home"
        android:background="@drawable/spr_toggle_bg_dark"
        android:layout_width="@dimen/jackpot_btn_width"
        android:layout_height="@dimen/jackpot_btn_height"
        android:layout_marginRight="@dimen/jackpot_home_margin_right"
        android:layout_toLeftOf="@+id/right_anchor"
        android:layout_alignTop="@+id/jackpot_away"
        android:fontFamily="sans-serif"
        android:layout_marginEnd="@dimen/jackpot_home_margin_right"
        android:layout_toStartOf="@+id/right_anchor"/>
    <View
        android:background="#26eaecef"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="@dimen/jackpot_away_margin_right"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="@dimen/jackpot_away_margin_right"/>
</RelativeLayout>
