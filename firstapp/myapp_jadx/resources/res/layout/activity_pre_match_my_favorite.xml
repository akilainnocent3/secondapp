<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/action_bar"
        android:background="?attr/colorTitleBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/action_bar_height"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/go_back"
            android:background="?android:attr/selectableItemBackground"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_action_bar_back"/>
        <ImageButton
            android:id="@+id/add_my_favorite"
            android:background="?android:attr/selectableItemBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            app:srcCompat="@drawable/ic_my_favorite_add"/>
        <TextView
            android:textSize="12dp"
            android:textStyle="normal"
            android:textColor="?attr/colorTitleBarText"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/sport_title"
            android:layout_width="0x7f0707bb"
            android:layout_height="match_parent"
            android:maxLines="2"
            android:layout_toLeftOf="@+id/add_my_favorite"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="0x7f0707bc"
            android:textStyle="normal"
            android:textColor="?attr/colorTitleBarText"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/common_functions__my_favourites"
            android:maxLines="1"
            android:layout_toLeftOf="@+id/sport_title"
            android:layout_toRightOf="@+id/go_back"
            android:layout_centerVertical="true"
            android:lineSpacingExtra="8dp"
            android:fontFamily="sans-serif-medium"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/sports_top_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/action_bar_height">
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/live_container"
            android:background="@color/background_type2_primary"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="36dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/live_betting"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="12dp"
                android:layout_alignParentLeft="true">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/live_betting_arrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="4dp"
                    android:src="@drawable/iwqk_more"
                    android:tint="@color/brand_secondary"/>
                <TextView
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="@color/text_type2_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:text="@string/live__live_betting"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_secondary"
                    android:id="@+id/live_betting_count"
                    android:background="@drawable/spr_shape_index_bg"
                    android:padding="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/live_events"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true">
                <TextView
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:textColor="@color/text_type2_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:text="@string/live__all_live"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_quaternary"
                    android:id="@+id/live_count"
                    android:background="@drawable/spr_shape_index_bg"
                    android:padding="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/right_arrow_normal"
                    android:tint="@color/text_type2_primary"/>
            </LinearLayout>
        </RelativeLayout>
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/layout_swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.donkingliang.consecutivescroller.ConsecutiveScrollerLayout
                android:id="@+id/scroll_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                app:autoAdjustHeightAtBottomView="true">
                <LinearLayout
                    android:theme="@style/AppTheme.Live"
                    android:orientation="vertical"
                    android:id="@+id/live_tabs_container"
                    android:background="?attr/appColorSurface"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_isSticky="true">
                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/live_sport_tab"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        app:tabPaddingEnd="10dp"
                        app:tabPaddingStart="10dp"
                        app:tabTextAppearance="@style/CustomTabAppearance"
                        style="@style/Widget.App.TabLayout.Live.Primary"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.google.android.material.tabs.TabLayout
                            android:id="@+id/live_market_tab"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            app:tabMinWidth="0dp"
                            app:tabPaddingEnd="10dp"
                            app:tabPaddingStart="10dp"
                            app:tabTextAppearance="@style/CustomTabAppearance"
                            style="@style/Widget.App.TabLayout.Live.Secondary"/>
                        <View
                            android:id="@+id/live_market_option_divider"
                            android:background="@color/line_type1_secondary"
                            android:visibility="gone"
                            android:layout_width="1dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="8dp"/>
                        <com.sportybet.android.widget.OneUpTwoUpSwitch
                            android:layout_gravity="center_vertical"
                            android:id="@+id/live_one_up_two_up_switch"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="8dp"
                            android:layout_marginRight="8dp"
                            android:layout_marginHorizontal="8dp"/>
                        <com.sportybet.android.widget.OUEarlyGoalsSwitch
                            android:layout_gravity="center_vertical"
                            android:id="@+id/live_ou_early_goals_switch"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="8dp"
                            android:layout_marginRight="8dp"
                            android:layout_marginHorizontal="8dp"/>
                    </LinearLayout>
                    <com.sportybet.android.widget.BubbleView
                        android:layout_gravity="end"
                        android:id="@+id/live_market_option_feature_alert"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-8dp"
                        android:layout_marginBottom="4dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        app:closable="true"
                        app:descriptionText="@string/component_betslip__early_goal_tip_desc"
                        app:title="@string/component_betslip__early_goal_tip_title"
                        app:trianglePosition="top_right"/>
                    <include
                        android:id="@+id/live_market_title"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        layout="@layout/spr_live_market_title"/>
                </LinearLayout>
                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.sportybet.plugin.myfavorite.widget.MyFavoriteLivePanel
                        android:orientation="vertical"
                        android:id="@+id/live_panel"
                        android:background="@color/background_type2_primary"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.sportybet.android.widget.LoadingView
                            android:id="@+id/loading"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/spr_home_hei"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/event_view_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/brand_secondary_variable_type3"
                            android:gravity="center"
                            android:id="@+id/bottom_all"
                            android:paddingRight="30dp"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:drawablePadding="4dp"/>
                    </com.sportybet.plugin.myfavorite.widget.MyFavoriteLivePanel>
                </androidx.core.widget.NestedScrollView>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_isSticky="true">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/sports_expand_tab_layout"
                        android:background="@color/background_type1_secondary"
                        android:paddingRight="8dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="42dp">
                        <com.sportybet.plugin.realsports.widget.PreMatchSpinnerTextView
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:gravity="center_vertical"
                            android:id="@+id/time_btn"
                            android:paddingLeft="8dp"
                            android:paddingRight="4dp"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:text="@string/common_functions__time"
                            android:singleLine="true"
                            android:drawablePadding="2dp"
                            android:layout_weight="1"
                            android:lineSpacingExtra="2.8dp"
                            android:textAllCaps="false"
                            android:paddingStart="8dp"
                            android:paddingEnd="4dp"/>
                        <View
                            android:background="@color/line_type1_primary"
                            android:layout_width="1dp"
                            android:layout_height="match_parent"/>
                        <com.sportybet.plugin.realsports.widget.PreMatchSpinnerTextView
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:gravity="center_vertical"
                            android:id="@+id/regions_btn"
                            android:paddingLeft="8dp"
                            android:paddingRight="4dp"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:text="@string/common_functions__league"
                            android:singleLine="true"
                            android:drawablePadding="2dp"
                            android:layout_weight="3"
                            android:lineSpacingExtra="2.8dp"
                            android:textAllCaps="false"
                            android:paddingStart="8dp"
                            android:paddingEnd="4dp"/>
                    </LinearLayout>
                    <View
                        android:background="@color/line_type1_primary"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <com.google.android.material.tabs.TabLayout
                                android:textSize="14sp"
                                android:gravity="center"
                                android:id="@+id/tab_layout"
                                android:visibility="gone"
                                android:layout_width="0dp"
                                android:layout_height="52dp"
                                android:layout_weight="1"
                                android:textAllCaps="false"
                                app:tabTextAppearance="@style/CustomTabAppearance"
                                style="@style/Widget.App.TabLayout.Default.Secondary"/>
                            <View
                                android:id="@+id/pre_match_market_option_divider"
                                android:background="@color/line_type1_secondary"
                                android:visibility="gone"
                                android:layout_width="1dp"
                                android:layout_height="20dp"
                                android:layout_marginStart="8dp"/>
                            <com.sportybet.android.widget.OneUpTwoUpSwitch
                                android:layout_gravity="center_vertical"
                                android:id="@+id/pre_match_one_up_two_up_switch"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginLeft="8dp"
                                android:layout_marginRight="8dp"
                                android:layout_marginHorizontal="8dp"/>
                            <com.sportybet.android.widget.OUEarlyGoalsSwitch
                                android:layout_gravity="center_vertical"
                                android:id="@+id/pre_match_ou_early_goals_switch"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginLeft="8dp"
                                android:layout_marginRight="8dp"
                                android:layout_marginHorizontal="8dp"/>
                        </LinearLayout>
                        <com.sportybet.android.widget.BubbleView
                            android:layout_gravity="end"
                            android:id="@+id/pre_match_market_option_feature_alert"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="-8dp"
                            android:layout_marginBottom="4dp"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            app:closable="true"
                            app:descriptionText="@string/component_betslip__early_goal_tip_desc"
                            app:title="@string/component_betslip__early_goal_tip_title"
                            app:trianglePosition="top_right"/>
                    </LinearLayout>
                    <View
                        android:background="@color/line_type1_primary"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"/>
                </LinearLayout>
                <FrameLayout
                    android:id="@+id/sports_frame"
                    android:background="@color/background_general_primary"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layout_scrollChild="@+id/sports_recycler_view">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/sports_no_match_container"
                        android:padding="40dp"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/sports_no_match_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            app:srcCompat="@drawable/spr_ic_info2"
                            app:tint="@color/text_type1_secondary"/>
                        <TextView
                            android:textSize="16sp"
                            android:textStyle="normal"
                            android:textColor="@color/text_type1_secondary"
                            android:gravity="center"
                            android:id="@+id/sports_no_match"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/my_favourites__no_events_found"
                            android:fontFamily="sans-serif"/>
                    </LinearLayout>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/sports_recycler_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                </FrameLayout>
            </com.donkingliang.consecutivescroller.ConsecutiveScrollerLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>
    <include
        android:id="@+id/my_favorite_empty_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/action_bar_height"
        layout="@layout/my_favorite_empty_layout"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="@color/text_type1_primary"
        android:gravity="center"
        android:layout_gravity="right"
        android:id="@+id/add_more_settings"
        android:background="@drawable/spr_gift_pop"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginRight="30dp"
        android:text="@string/my_favourites__customise_tip"
        android:fontFamily="sans-serif"
        android:backgroundTint="@color/background_type1_secondary"/>
</FrameLayout>
