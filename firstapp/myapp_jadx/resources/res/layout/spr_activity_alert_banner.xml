<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#99000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.sporty.android.common_ui.widgets.AspectRatioImageView
        android:id="@+id/banner_img"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:scaleType="fitXY"
        android:layout_marginHorizontal="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageButton
        android:id="@+id/banner_close"
        android:background="@null"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toTopOf="@+id/banner_img"
        app:layout_constraintEnd_toEndOf="@+id/banner_img"
        app:srcCompat="@drawable/spr_ic_close_black_24dp"
        app:tint="@color/text_type2_primary"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="normal"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/banner_opt_out"
        android:padding="10dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="40dp"
        android:layout_marginRight="30dp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="30dp"
        app:layout_constraintTop_toBottomOf="@+id/banner_img"/>
</androidx.constraintlayout.widget.ConstraintLayout>
