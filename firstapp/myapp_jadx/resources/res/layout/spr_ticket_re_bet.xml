<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/td_ticket_rebet_container"
    android:background="@color/background_type2_primary"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">
    <View
        android:id="@+id/td_bottom_divider_line"
        android:background="@color/line_type2_secondary"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="10dp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_secondary"
        android:gravity="center_vertical"
        android:id="@+id/td_ticket_booking_code_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/page_load_code__booking_code"
        android:fontFamily="sans-serif"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/td_bottom_divider_line"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="normal"
        android:textColor="@color/text_type2_secondary"
        android:gravity="center_vertical"
        android:id="@+id/td_ticket_booking_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/td_ticket_booking_code_title"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="right"
        app:constraint_referenced_ids="td_ticket_booking_code_title,td_ticket_booking_code"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginLeft="12dp"
        android:layout_toRightOf="@+id/td_ticket_booking_code"
        app:layout_constraintBottom_toBottomOf="@+id/td_ticket_booking_code"
        app:layout_constraintLeft_toRightOf="@+id/barrier_right"
        app:layout_constraintTop_toTopOf="@+id/td_ticket_booking_code_title">
        <ImageView
            android:gravity="center"
            android:id="@+id/td_ticket_copy_btn"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginLeft="8dp"
            android:src="@drawable/ic_booking_code_copy"
            app:tint="@color/text_type2_secondary"/>
        <ImageView
            android:gravity="center"
            android:id="@+id/td_ticket_share_btn"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginLeft="8dp"
            android:src="@drawable/ic_booking_code_share"
            app:tint="@color/text_type2_secondary"/>
        <ProgressBar
            android:id="@+id/btn_share_loading"
            android:visibility="gone"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginLeft="8dp"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/share_code_loading_circle"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/rebet_info"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginRight="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/td_ticket_rebet_btn"
        app:layout_constraintRight_toLeftOf="@+id/td_ticket_rebet_btn"
        app:layout_constraintTop_toTopOf="@+id/td_ticket_rebet_btn"
        app:srcCompat="@drawable/ic_info_filled"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:gravity="center"
        android:id="@+id/td_ticket_rebet_btn"
        android:background="@drawable/bg_fiilled_brand_secondary_3_radius"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:text="@string/common_functions__rebet"
        android:fontFamily="sans-serif"
        app:layout_constraintBottom_toBottomOf="@+id/td_ticket_booking_code"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/td_ticket_booking_code_title"
        style="@style/Widget.App.CommonButton.Contained"/>
</androidx.constraintlayout.widget.ConstraintLayout>
