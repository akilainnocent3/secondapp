<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="200dp"
        app:controller_layout_id="@layout/exo_playback_control_view"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/video_error_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/player_view"
        app:layout_constraintEnd_toEndOf="@+id/player_view"
        app:layout_constraintStart_toStartOf="@+id/player_view"
        app:layout_constraintTop_toTopOf="@+id/player_view"
        layout="@layout/spm_video_unavailable"/>
    <com.sporty.android.common_ui.widgets.AspectRatioFrameLayout
        android:id="@+id/video_in_web_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <WebView
            android:id="@+id/video_in_web"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.sporty.android.common_ui.widgets.AspectRatioFrameLayout>
    <com.sporty.android.common_ui.widgets.AspectRatioFrameLayout
        android:id="@+id/epl_video_container"
        android:background="@color/text_type1_primary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.sportybet.plugin.realsports.widget.EPLStreamingMentionView
            android:id="@+id/epl_watch_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"/>
    </com.sporty.android.common_ui.widgets.AspectRatioFrameLayout>
    <com.sporty.android.common_ui.widgets.AspectRatioFrameLayout
        android:id="@+id/player_loading_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.sportybet.android.widget.LoadingView
            android:id="@+id/player_loading"
            android:background="@color/transparent_white"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.sporty.android.common_ui.widgets.AspectRatioFrameLayout>
    <ImageView
        android:id="@+id/channel_switch"
        android:visibility="invisible"
        android:layout_width="38dp"
        android:layout_height="36dp"
        android:layout_marginTop="15dp"
        android:src="@drawable/ig_switch"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#e6ffffff"
        android:id="@+id/channel_switch_hint"
        android:background="@color/background_type2_primary"
        android:paddingLeft="6dp"
        android:paddingTop="4dp"
        android:paddingRight="6dp"
        android:paddingBottom="4dp"
        android:visibility="invisible"
        android:layout_width="210dp"
        android:layout_height="36dp"
        android:layout_marginTop="15dp"
        android:text="if the live stream isn&apos;t for this match,\10 click here to try other channels!"
        android:paddingHorizontal="6dp"
        android:paddingVertical="4dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/channels_container"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="15dp"
        android:layout_alignParentRight="true"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/text_type1_secondary"
        android:gravity="center"
        android:id="@+id/streaming_ended_message"
        android:background="@color/text_type1_primary"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/live__live_stream_ended"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/live_stream_playback_cover"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/player_view"
        app:layout_constraintEnd_toEndOf="@+id/player_view"
        app:layout_constraintStart_toStartOf="@+id/player_view"
        app:layout_constraintTop_toTopOf="@+id/player_view"/>
</merge>
