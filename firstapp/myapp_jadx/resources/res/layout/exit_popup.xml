<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/trans_black_75"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/grey_view"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout"
        android:background="@color/white"
        android:paddingTop="@dimen/_8sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/error_header"
            android:background="@drawable/exit_popup_error_background"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="0x7f0702ae"
            android:layout_marginRight="0x7f0702ae"
            android:layout_marginBottom="@dimen/_10sdp"
            app:layout_constraintBottom_toTopOf="@+id/you_may_text">
            <ImageView
                android:id="@+id/error_image"
                android:layout_width="@dimen/_17sdp"
                android:layout_height="@dimen/_17sdp"
                android:layout_marginLeft="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_7sdp"
                android:src="@drawable/ic_exit_popup_error"
                android:scaleType="centerCrop"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/_14sdp"
                android:textColor="@color/sb_black"
                android:id="@+id/error_message"
                android:tag="@string/you_may_like_cms"
                android:paddingLeft="@dimen/_5sdp"
                android:paddingTop="@dimen/_6sdp"
                android:paddingRight="@dimen/_5sdp"
                android:paddingBottom="@dimen/_6sdp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Game temporarily unavailable. Contact support for assistance!"
                android:fontFamily="@font/roboto_black"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/error_image"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="@dimen/_12sdp"
            android:textColor="@color/sb_black"
            android:id="@+id/you_may_text"
            android:tag="@string/you_may_like_cms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_11sdp"
            android:layout_marginBottom="@dimen/_4sdp"
            android:text="@string/may_like_games"
            app:layout_constraintBottom_toTopOf="@+id/game_list"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/TextPrimaryMedium"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/game_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_5sdp"
            android:layout_marginRight="@dimen/_5sdp"
            android:layout_marginBottom="@dimen/_4sdp"
            android:overScrollMode="never"
            app:layout_constraintBottom_toTopOf="@+id/button_layout"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:id="@+id/button_layout"
            android:background="@color/redblack_confirm_dialog_left_button"
            android:layout_width="0dp"
            android:layout_height="@dimen/_42sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/confirm_layout"
            app:layout_constraintHeight_percent="0.084"
            app:layout_constraintStart_toStartOf="parent">
            <TextView
                android:textSize="@dimen/_10sdp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/cancel_button"
                android:tag="@string/exit_btn_cms"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:text="@string/label_dialog_exit"
                android:textAlignment="center"
                android:autoSizeTextType="uniform"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.43"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextPrimaryBold"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:id="@+id/confirm_layout"
            android:background="@color/use_gift_color"
            android:layout_width="0dp"
            android:layout_height="@dimen/_42sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHeight_percent="0.084"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintWidth_percent="0.67">
            <TextView
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/confirm_button"
                android:tag="@string/stay_btn_cms"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:text="@string/stay"
                android:textAlignment="center"
                android:autoSizeTextType="uniform"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.43"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextPrimaryBold"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
