<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/win_root"
    android:background="#0000"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.sporty.android.common_ui.widgets.AspectRatioRelativeLayout
        android:layout_gravity="center"
        android:id="@+id/bingo_winning"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageButton
            android:id="@+id/bingo_close"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginRight="20dp"
            android:layout_alignParentRight="true"
            android:layout_marginEnd="20dp"
            app:srcCompat="@drawable/spr_ic_close_black_24dp"
            app:tint="@color/brand_tertiary"/>
        <ImageView
            android:id="@+id/bingo_img"
            android:layout_width="600dp"
            android:layout_height="470dp"
            android:scaleType="centerCrop"
            android:layout_below="@+id/bingo_close"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="35dp"
            android:textStyle="bold"
            android:textColor="@color/brand_tertiary"
            android:gravity="center"
            android:id="@+id/bingo_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="283dp"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#dcdee5"
            android:gravity="center"
            android:id="@+id/bingo_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="80dp"
            android:layout_marginTop="90dp"
            android:layout_below="@+id/bingo_amount"/>
        <Button
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/brand_secondary_variable_type3"
            android:id="@+id/bingo_detail"
            android:background="@drawable/spr_bg_green_rect"
            android:layout_width="150dp"
            android:layout_height="42dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="14dp"
            android:text="@string/common_functions__details"
            android:layout_below="@+id/bingo_type"
            android:textAllCaps="false"
            android:layout_marginStart="20dp"/>
        <Button
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="#353a45"
            android:id="@+id/bingo_share"
            android:background="@drawable/spr_bg_green_rect_solid"
            android:layout_width="150dp"
            android:layout_height="42dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="14dp"
            android:layout_marginRight="20dp"
            android:text="@string/common_functions__share"
            android:layout_below="@+id/bingo_type"
            android:layout_alignParentRight="true"
            android:textAllCaps="false"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
    </com.sporty.android.common_ui.widgets.AspectRatioRelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/winning_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/soundIconComposeView"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="32dp"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageButton
            android:id="@+id/close"
            android:background="@null"
            android:padding="18dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/spr_ic_close_black_24dp"
            app:tint="@color/brand_tertiary"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="44dp"
                android:textStyle="bold"
                android:textColor="@color/text_type2_primary"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_functions__you_won"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="28dp"
                android:textStyle="bold"
                android:textColor="@color/text_inverse_brand_sub"
                android:gravity="center"
                android:id="@+id/amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/title"/>
            <TextView
                android:textAppearance="@style/B1_R"
                android:textColor="@color/text_inverse_primary"
                android:id="@+id/percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/component_pop_dialog__android_you_got_more_winnings_than_vnum_of_all_users_new"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/amount"/>
            <TextView
                android:textAppearance="@style/B1_R"
                android:textColor="@color/text_inverse_primary"
                android:id="@+id/detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-2dp"
                android:text="@string/component_pop_dialog__check_ticket_details"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/percent"/>
            <ImageView
                android:id="@+id/img"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/image_height"
                android:layout_marginTop="-60dp"
                android:translationZ="-2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/detail"/>
            <android.widget.Space
                android:id="@+id/space2"
                android:layout_width="20dp"
                android:layout_height="42dp"
                app:layout_constraintBottom_toBottomOf="@+id/img"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:textAppearance="@style/B2_R"
                android:textColor="@color/text_inverse_secondary"
                android:id="@+id/type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/space2"/>
            <TextView
                android:textColor="@color/text_inverse_secondary"
                android:id="@+id/verify_code_title"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/bet_history__verify_code"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/verify_code_content"
                app:layout_constraintTop_toTopOf="@+id/space2"
                style="@style/B2_R"/>
            <TextView
                android:textColor="@color/text_inverse_secondary"
                android:id="@+id/verify_code_content"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toRightOf="@+id/verify_code_title"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/verify_code_title"
                style="@style/B2_R"/>
            <Button
                android:textAppearance="@style/H4_M"
                android:textColor="@color/brand_secondary_variable_type3"
                android:id="@+id/share"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:text="@string/component_pop_dialog__show_off"
                android:textAllCaps="false"
                android:layout_marginStart="16dp"
                app:layout_constraintEnd_toStartOf="@+id/remix_bet"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/space2"
                style="@style/Widget.App.CommonButton.Outline"/>
            <FrameLayout
                android:id="@+id/remix_bet"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/share"
                app:layout_constraintTop_toTopOf="@+id/share"
                style="@style/Widget.App.CommonButton.Contained">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textAppearance="@style/H4_M"
                    android:textColor="@color/text_color_brand_tertiary"
                    android:layout_gravity="center"
                    android:id="@+id/remix_bet_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bet_history__remix_bet"
                    android:drawablePadding="4dp"
                    android:drawableStart="@drawable/ic__ai"/>
            </FrameLayout>
            <View
                android:id="@+id/remix_bet_new_feature_dot"
                android:background="@drawable/bg_red_dot"
                android:visibility="gone"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginTop="-2dp"
                android:layout_marginEnd="-2dp"
                app:layout_constraintEnd_toEndOf="@+id/remix_bet"
                app:layout_constraintTop_toTopOf="@+id/remix_bet"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/share"
                app:srcCompat="@drawable/spr_logo"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <RelativeLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:id="@+id/gift"
        android:paddingBottom="36dp"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="36dp">
        <RelativeLayout
            android:gravity="center_horizontal"
            android:id="@+id/card_container"
            android:layout_width="match_parent"
            android:layout_height="183dp">
            <ImageView
                android:id="@+id/gift_cup"
                android:background="@drawable/spr_bg_green_circle"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginTop="-48dp"
                android:src="@drawable/spr_cup"
                android:scaleType="center"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/brand_tertiary"
                android:gravity="center"
                android:id="@+id/received_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_centerHorizontal="true"/>
            <RelativeLayout
                android:id="@+id/gift_amount"
                android:layout_width="match_parent"
                android:layout_height="121dp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="18dp"
                android:layout_marginRight="10dp"
                android:layout_below="@+id/received_title">
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/absolute_type1"
                    android:gravity="end"
                    android:id="@+id/gift_amount_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginRight="45dp"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentRight="true"/>
                <TextView
                    android:textSize="28dp"
                    android:textStyle="bold"
                    android:textColor="@color/absolute_type1"
                    android:id="@+id/g_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:layout_marginRight="45dp"
                    android:layout_below="@+id/gift_amount_hint"
                    android:layout_alignParentRight="true"/>
                <TextView
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:textColor="@color/absolute_type1"
                    android:id="@+id/prefix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:layout_marginRight="6dp"
                    android:layout_toLeftOf="@+id/g_amount"
                    android:layout_alignTop="@+id/g_amount"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/absolute_type1"
                    android:id="@+id/gift_end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="45dp"
                    android:text="@string/component_cash_gift_popup__use_it_in_your_betslip"
                    android:layout_below="@+id/g_amount"
                    android:layout_alignParentRight="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/gift_amount2"
                android:layout_width="match_parent"
                android:layout_height="152dp"
                android:layout_marginTop="0dp"
                android:layout_below="@+id/gift_amount">
                <TextView
                    android:textSize="28dp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_tertiary"
                    android:id="@+id/g_amount2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="58dp"
                    android:layout_marginRight="45dp"
                    android:layout_alignParentRight="true"/>
                <TextView
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_tertiary"
                    android:id="@+id/prefix2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:layout_marginRight="6dp"
                    android:layout_toLeftOf="@+id/g_amount2"
                    android:layout_alignTop="@+id/g_amount2"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/brand_tertiary"
                    android:id="@+id/gift_end2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="45dp"
                    android:text="@string/component_cash_gift_popup__use_it_in_your_betslip"
                    android:layout_toLeftOf="@+id/g_amount2"
                    android:layout_below="@+id/g_amount2"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/gift_source_container"
            android:background="@drawable/background_received_gift"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="-36dp"
            android:minHeight="190dp"
            android:layout_below="@+id/card_container">
            <TextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@color/absolute_type2"
                android:gravity="center"
                android:id="@+id/gift_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="36dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="36dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/brand_secondary_variable_type2"
                android:gravity="center"
                android:id="@+id/gift_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="45dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="45dp"
                android:layout_below="@+id/gift_source"/>
            <Button
                android:textSize="16dp"
                android:textColor="@color/brand_secondary"
                android:gravity="center"
                android:id="@+id/view_gift"
                android:background="@drawable/spr_bg_black_rect"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="28dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="14dp"
                android:layout_marginBottom="16dp"
                android:minHeight="42dp"
                android:text="@string/component_pop_dialog__view"
                android:layout_below="@+id/gift_hint"
                android:layout_alignParentLeft="true"
                android:textAllCaps="false"/>
            <Button
                android:textSize="16dp"
                android:textColor="@color/brand_tertiary"
                android:gravity="center"
                android:id="@+id/cash_gift_bet"
                android:background="@drawable/spr_bet_solid_green_rect"
                android:layout_width="105dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginRight="28dp"
                android:minHeight="42dp"
                android:text="@string/gift__bet_now"
                android:layout_toRightOf="@+id/view_gift"
                android:layout_below="@+id/gift_hint"
                android:layout_alignParentRight="true"
                android:textAllCaps="false"/>
        </RelativeLayout>
        <ImageButton
            android:id="@+id/close_gift"
            android:background="@drawable/spr_bg_black_circle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="62dp"
            android:layout_marginRight="16dp"
            android:layout_below="@+id/gift_source_container"
            android:layout_centerHorizontal="true"
            app:srcCompat="@drawable/spr_ic_cancel_white"/>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/cash_gift_pop_root"
        android:background="@android:color/transparent"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="360dp">
        <com.sporty.android.common_ui.widgets.AspectRatioRelativeLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/cash_gift_bottom_layout"
            android:background="@drawable/spr_shape_gift_pop_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="40dp"
            android:minHeight="360dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/cash_gift_pop_close"
                android:padding="8dp"
                android:paddingRight="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginRight="5dp"
                android:layout_alignParentRight="true"
                android:layout_alignParentEnd="true"
                app:srcCompat="@drawable/spr_ic_close_black_24dp"
                app:tint="#0d9737"/>
            <TextView
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="#f2f3f5"
                android:gravity="center_horizontal"
                android:id="@+id/cash_gift_pop_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/gift__lucky_extra"
                android:layout_centerHorizontal="true"
                android:lineSpacingExtra="-2sp"/>
            <TextView
                android:textSize="16dp"
                android:textColor="#f2f3f5"
                android:gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="@string/gift__new_cash_gift"
                android:layout_below="@+id/cash_gift_pop_title"
                android:lineSpacingExtra="2sp"/>
            <TextView
                android:textSize="16dp"
                android:textColor="#32ce62"
                android:gravity="center"
                android:id="@+id/cash_gift_pop_view"
                android:background="@drawable/spr_bg_green_rect"
                android:layout_width="80dp"
                android:layout_height="42dp"
                android:layout_marginLeft="28dp"
                android:layout_marginRight="14dp"
                android:layout_marginBottom="12dp"
                android:text="@string/component_cash_gift_popup__view"
                android:layout_above="@+id/pop_pushtext"
                android:layout_alignParentLeft="true"/>
            <TextView
                android:textSize="16dp"
                android:textColor="#1b1e25"
                android:gravity="center"
                android:id="@+id/cash_gift_pop_bet"
                android:background="@drawable/spr_bg_green_rect_solid"
                android:layout_width="105dp"
                android:layout_height="42dp"
                android:layout_marginRight="28dp"
                android:layout_marginBottom="12dp"
                android:text="@string/gift__bet_now"
                android:layout_toRightOf="@+id/cash_gift_pop_view"
                android:layout_above="@+id/pop_pushtext"
                android:layout_alignParentRight="true"/>
            <TextView
                android:textSize="12dp"
                android:textStyle="normal"
                android:textColor="#dcdee5"
                android:id="@+id/pop_pushtext"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="36dp"
                android:layout_marginRight="36dp"
                android:layout_marginBottom="13dp"
                android:layout_alignParentBottom="true"
                android:fontFamily="sans-serif"/>
        </com.sporty.android.common_ui.widgets.AspectRatioRelativeLayout>
        <com.sporty.android.common_ui.widgets.AspectRatioRelativeLayout
            android:gravity="center_horizontal"
            android:id="@+id/cash_gift_value_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="23dp"
            android:layout_marginRight="23dp">
            <android.widget.Space
                android:id="@+id/anchor"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#1b1e25"
                android:gravity="end"
                android:id="@+id/prefix3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_below="@+id/anchor"/>
            <TextView
                android:textSize="36dp"
                android:textStyle="bold"
                android:textColor="#1b1e25"
                android:gravity="end"
                android:id="@+id/cash_gift_pop_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="9dp"
                android:layout_marginTop="8dp"
                android:minWidth="45dp"
                android:layout_toRightOf="@+id/prefix3"
                android:layout_below="@+id/anchor"
                android:layout_toEndOf="@+id/prefix3"/>
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="#1b1e25"
                android:gravity="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_functions__cash_gift"
                android:layout_below="@+id/cash_gift_pop_amount"
                android:layout_alignRight="@+id/cash_gift_pop_amount"/>
        </com.sporty.android.common_ui.widgets.AspectRatioRelativeLayout>
    </RelativeLayout>
    <com.sporty.android.common_ui.widgets.LoadingViewNew
        android:id="@+id/winning_loading_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
