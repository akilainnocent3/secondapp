<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.sportybet.android.widget.ListenableSpinner
        android:textSize="14dp"
        android:textStyle="bold"
        android:gravity="center"
        android:id="@+id/outcome_spinner"
        android:background="@drawable/iwqk_spinner_bg"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginRight="2dp"
        android:layout_weight="1"
        android:dropDownVerticalOffset="34dp"
        android:spinnerMode="dropdown"/>
    <com.sportybet.android.instantwin.presentation.widget.OutcomeButton
        android:id="@+id/outcome1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <com.sportybet.android.instantwin.presentation.widget.OutcomeButton
        android:id="@+id/outcome2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="2dp"
        android:layout_weight="1"/>
    <com.sportybet.android.instantwin.presentation.widget.OutcomeButton
        android:id="@+id/outcome3"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="2dp"
        android:layout_weight="1"/>
    <com.sportybet.android.instantwin.presentation.widget.OutcomeButton
        android:id="@+id/outcome4"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="2dp"
        android:layout_weight="1"/>
</merge>
