<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/title_bar"
        android:background="?attr/colorTitleBar"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/cancel"
            android:background="?android:attr/selectableItemBackground"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_action_bar_back"
            app:tint="?attr/colorTitleBarTint"/>
        <com.sporty.android.common_ui.widgets.ClearEditText
            android:textAppearance="@style/B1_R"
            android:textColor="@color/custom_text_type1_secondary_type1"
            android:textColorHint="@color/text_type1_secondary"
            android:id="@+id/search_text"
            android:background="@drawable/bg_filled_background_general_primary_5_radius"
            android:paddingLeft="11dp"
            android:paddingRight="7dp"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:hint="@string/page_transaction__ticket_id_trade_no"
            android:maxLines="1"
            android:drawablePadding="7dp"
            android:layout_toLeftOf="@+id/search_icon"
            android:layout_toRightOf="@+id/cancel"
            android:layout_centerInParent="true"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:paddingStart="11dp"
            android:paddingEnd="7dp"/>
        <TextView
            android:textAppearance="@style/B1_M"
            android:textColor="?attr/colorTitleBarText"
            android:gravity="center_vertical"
            android:id="@+id/search_icon"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:text="@string/common_functions__search"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/title_bar">
        <TextView
            android:textSize="10sp"
            android:textStyle="normal"
            android:textColor="@color/warning_primary"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/target_hint"
            android:background="#fee9ed"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:lineSpacingExtra="0sp"
            android:fontFamily="sans-serif"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/search_result_list"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="normal"
            android:textColor="@color/text_type1_primary"
            android:gravity="center"
            android:id="@+id/search_hint_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="88dp"
            android:layout_marginRight="40dp"
            android:text="@string/page_transaction__enter_ticket_id_to_search_history_tip"
            android:drawablePadding="30dp"
            android:lineSpacingExtra="0sp"
            android:fontFamily="sans-serif"
            app:drawableBottomCompat="@drawable/spr_transaction_search_no_result"/>
        <com.sportybet.android.widget.LoadingView
            android:id="@+id/loading"
            android:background="@color/background_type1_secondary"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</RelativeLayout>
