<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <ImageView
        android:id="@+id/back_button"
        android:background="@drawable/sg_ss_backbutton_background"
        android:paddingLeft="@dimen/_7sdp"
        android:paddingTop="@dimen/_7sdp"
        android:paddingRight="@dimen/_7sdp"
        android:paddingBottom="@dimen/_7sdp"
        android:visibility="gone"
        android:layout_width="@dimen/_43sdp"
        android:layout_height="@dimen/_26sdp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:src="@drawable/sg_ss_back_icon"
        android:paddingHorizontal="@dimen/_7sdp"
        android:paddingVertical="@dimen/_7sdp"/>
    <ImageView
        android:layout_width="140dp"
        android:layout_height="72dp"
        android:layout_marginTop="70dp"
        android:layout_marginRight="13dp"
        android:layout_marginBottom="171.2dp"
        android:src="@drawable/sg_sporty_soccer_logo"
        android:layout_alignParentRight="true"/>
    <LinearLayout
        android:gravity="bottom|right"
        android:orientation="vertical"
        android:id="@+id/main_menus"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginRight="13dp"
        android:layout_marginBottom="@dimen/_100sdp"
        android:splitMotionEvents="false">
        <include
            android:id="@+id/btn_play"
            android:layout_width="152dp"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            layout="@layout/sg_ss_layout_button"/>
        <include
            android:id="@+id/btn_practice"
            android:layout_width="152dp"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            layout="@layout/sg_ss_layout_button"/>
        <include
            android:id="@+id/btn_settings"
            android:layout_width="152dp"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            layout="@layout/sg_ss_layout_button"/>
        <include
            android:id="@+id/btn_rules"
            android:layout_width="152dp"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            layout="@layout/sg_ss_layout_button"/>
        <include
            android:id="@+id/btn_no_win"
            android:visibility="gone"
            android:layout_width="152dp"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            layout="@layout/sg_ss_layout_button"/>
        <include
            android:id="@+id/btn_tutorial_reset"
            android:visibility="gone"
            android:layout_width="152dp"
            android:layout_height="48dp"
            layout="@layout/sg_ss_layout_button"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/main_game_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/sg_main_game_bg"
        android:scaleType="centerCrop"/>
</RelativeLayout>
