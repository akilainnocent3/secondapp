<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@color/background_hint_type1"
    android:paddingTop="11dp"
    android:paddingBottom="11dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingVertical="11dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:rotation="180"
        android:layout_marginStart="11dp"
        app:srcCompat="@drawable/ic_info_filled"
        app:tint="@color/other003"/>
    <TextView
        android:textAppearance="@style/B2_R"
        android:textColor="@color/text_type1_primary"
        android:layout_gravity="center_vertical"
        android:id="@+id/textView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:lineSpacingExtra="2dp"
        android:layout_marginStart="11dp"
        android:layout_marginEnd="16dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/icon_close"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:tint="@color/text_type1_secondary"
        android:layout_marginEnd="16dp"
        app:srcCompat="@drawable/ic_cancel_black_24dp"/>
</merge>
