<?xml version="1.0" encoding="utf-8"?>
<com.sportybet.android.cashoutphase3.AutoCashoutResultView xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="288dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/spr_cash_out_auto_result_info_container"
        android:layout_width="match_parent"
        android:layout_height="224dp">
        <TextView
            android:textSize="18dp"
            android:textColor="@color/text_type1_primary"
            android:gravity="center"
            android:id="@+id/spr_cash_out_auto_result_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <View
            android:id="@+id/spr_cash_out_auto_result_divider_line"
            android:background="@color/line_type1_primary"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/text_type1_primary"
                android:gravity="center"
                android:id="@+id/description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/B1_M"/>
            <TextView
                android:textColor="@color/text_type1_primary"
                android:id="@+id/description_msg"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/H3_B"/>
        </LinearLayout>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/text_type1_primary"
            android:gravity="center"
            android:id="@+id/description2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <TextView
        android:textSize="16sp"
        android:gravity="center"
        android:id="@+id/action_btn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_above="@+id/no_action_message"
        android:layout_alignWithParentIfMissing="true"
        android:textAllCaps="false"
        style="@style/Widget.App.CommonButton.Outline"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/warning_primary"
        android:gravity="center"
        android:id="@+id/no_action_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/cashout__auto_cashout_is_unavailable_now"
        android:layout_alignParentBottom="true"
        android:textAllCaps="false"/>
</com.sportybet.android.cashoutphase3.AutoCashoutResultView>
