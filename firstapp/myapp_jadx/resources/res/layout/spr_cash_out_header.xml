<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/spr_top_rounded_rect"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="10dp"
    android:layout_marginTop="10dp"
    android:layout_marginRight="10dp"
    android:elevation="4dp"
    android:layout_marginHorizontal="10dp"
    android:paddingHorizontal="12dp">
    <com.google.android.flexbox.FlexboxLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_marginVertical="10dp"
        app:alignItems="center"
        app:flexWrap="wrap"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/rebet_btn_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textAppearance="@style/B1_B"
            android:textColor="@color/text_type1_primary"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="3dp"
            android:layout_marginEnd="4dp"
            android:layout_marginVertical="3dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/outcome_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp">
            <TextView
                android:textSize="12dp"
                android:textColor="@color/brand_quinary"
                android:gravity="center"
                android:id="@+id/live"
                android:background="@color/custom_brand_secondary_variable_type1_type3"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_functions__live"
                android:paddingHorizontal="2dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textAppearance="@style/B2_R"
                android:textColor="@color/text_type1_secondary"
                android:id="@+id/desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="4dp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ic_pending_event"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:tint="@color/icon_primary"
            app:layout_alignSelf="center"
            app:srcCompat="@drawable/ic_info_error"/>
    </com.google.android.flexbox.FlexboxLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/rebet_btn_container"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/import_sim_container"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/rebet_ic_img_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tint="@color/brand_quaternary"
            app:srcCompat="@drawable/spr_ic_multi_maker_spin"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/B2_R"
            android:textColor="@color/brand_quaternary"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common_functions__rebet"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="4dp"
            app:srcCompat="@drawable/ic_booking_code_share"
            app:tint="@color/text_type1_secondary"/>
        <View
            android:background="@color/border_primary"
            android:layout_width="1dp"
            android:layout_height="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/share"
            app:layout_constraintTop_toTopOf="parent"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/import_sim_container"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/share"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tint="@color/brand_quaternary"
            app:srcCompat="@drawable/ic_sim_import"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/B2_R"
            android:textColor="@color/brand_quaternary"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/component_betslip__switch_sim"
            app:srcCompat="@drawable/ic_booking_code_share"
            app:tint="@color/text_type1_secondary"/>
    </LinearLayout>
    <View
        android:id="@+id/divide_line"
        android:background="@color/border_primary"
        android:layout_width="1dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/share"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/share"
        android:padding="4dp"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/divide_line_2"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_booking_code_share"
        app:tint="@color/auto_cashout_action_btn_text_color"/>
    <View
        android:id="@+id/divide_line_2"
        android:background="@color/border_primary"
        android:layout_width="1dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/edit_bet"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/B2_R"
        android:textColor="@color/brand_quaternary"
        android:gravity="center"
        android:id="@+id/edit_bet"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="@string/common_functions__edit_bet"
        android:paddingStart="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_edit_bet"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="divide_line_2, edit_bet"/>
    <View
        android:background="@color/line_type1_primary"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
