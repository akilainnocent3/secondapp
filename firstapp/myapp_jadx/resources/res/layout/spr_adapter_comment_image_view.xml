<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/comment_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/booking_code_bonus_container"
        android:background="@color/background_type1_primary"
        android:paddingLeft="8dp"
        android:paddingTop="4dp"
        android:paddingRight="8dp"
        android:paddingBottom="4dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/share_img_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textColor="@color/text_type1_primary"
            android:id="@+id/share_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/odds_bonus_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/B2_M"/>
        <TextView
            android:textColor="@color/brand_secondary"
            android:id="@+id/result_booking_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toEndOf="@+id/share_result"
            app:layout_constraintTop_toTopOf="@+id/share_result"
            style="@style/B2_B"/>
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/odds_bonus_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:alignContent="stretch"
            app:alignItems="stretch"
            app:flexWrap="wrap"
            app:layout_constraintBottom_toTopOf="@+id/market_match"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/share_result">
            <TextView
                android:textColor="@color/text_type1_primary"
                android:id="@+id/odds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/B2_M"/>
            <TextView
                android:textColor="@color/text_type1_primary"
                android:id="@+id/bonus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                style="@style/B2_M"/>
        </com.google.android.flexbox.FlexboxLayout>
        <TextView
            android:textColor="@color/text_brand_sub_primary_d_base"
            android:id="@+id/market_match"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/odds_bonus_container"
            style="@style/C1_R"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/share_img_container"
        android:layout_width="50dp"
        android:layout_height="0dp"
        android:minHeight="52dp"
        app:layout_constraintBottom_toBottomOf="@+id/booking_code_bonus_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/booking_code_bonus_container">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/share_img"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/vague_order"
            android:scaleType="fitXY"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/zoom_bet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/she_share_zoom"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
