<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_begin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="16dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="16dp"/>
    <com.sportybet.android.widget.HintView
        android:id="@+id/alert_hint_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="@+id/guideline_end"
        app:layout_constraintStart_toStartOf="@+id/guideline_begin"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/blu_voucher_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="@+id/guideline_begin"
        app:layout_constraintTop_toBottomOf="@+id/alert_hint_view"
        app:srcCompat="@drawable/blu_voucher_logo"/>
    <TextView
        android:textColor="@color/text_type1_primary"
        android:id="@+id/blu_voucher_pin_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/page_payment__blu_voucher_pin_number"
        app:layout_constraintStart_toStartOf="@+id/guideline_begin"
        app:layout_constraintTop_toBottomOf="@+id/blu_voucher_logo"
        style="@style/B1_M"/>
    <TextView
        android:textColor="@color/text_type1_primary"
        android:id="@+id/blu_voucher_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/guideline_end"
        app:layout_constraintTop_toTopOf="@+id/blu_voucher_pin_label"
        style="@style/B2_M"/>
    <TextView
        android:textColor="@color/text_type1_primary"
        android:id="@+id/blu_voucher_balance_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toStartOf="@+id/blu_voucher_balance"
        app:layout_constraintTop_toTopOf="@+id/blu_voucher_pin_label"
        style="@style/B2_M"/>
    <com.sporty.android.common_ui.widgets.ClearEditText
        android:textSize="14sp"
        android:textStyle="normal"
        android:textColor="@color/absolute_type2"
        android:textColorHint="@color/text_type1_secondary"
        android:id="@+id/blu_voucher_pin_edit"
        android:background="@drawable/comb_edit_text_bg"
        android:paddingLeft="16dp"
        android:paddingRight="12dp"
        android:saveEnabled="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minHeight="48dp"
        android:hint="@string/page_payment__enter_the_blu_voucher_pin_number"
        android:maxLines="1"
        android:drawablePadding="8dp"
        android:lineSpacingExtra="0sp"
        android:inputType="number"
        android:imeOptions="actionDone"
        android:fontFamily="sans-serif-medium"
        app:cancalDrawableSize="16dp"
        app:layout_constraintEnd_toEndOf="@+id/guideline_end"
        app:layout_constraintStart_toStartOf="@+id/guideline_begin"
        app:layout_constraintTop_toBottomOf="@+id/blu_voucher_pin_label"/>
    <TextView
        android:textSize="10dp"
        android:textStyle="normal"
        android:textColor="@color/warning_primary"
        android:id="@+id/blu_voucher_pin_warning"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:minHeight="11dp"
        app:layout_constraintEnd_toEndOf="@+id/guideline_end"
        app:layout_constraintStart_toStartOf="@+id/guideline_begin"
        app:layout_constraintTop_toBottomOf="@+id/blu_voucher_pin_edit"/>
    <TextView
        android:textColor="@color/text_type1_primary"
        android:gravity="right"
        android:id="@+id/blu_voucher_kyc_hint"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="21dp"
        android:layout_marginRight="16dp"
        android:minHeight="20dp"
        android:text="@string/page_payment__you_will_need_kyc_verification_for_this_deposit_to_credit"
        android:maxLines="2"
        app:layout_constraintEnd_toEndOf="@+id/guideline_end"
        app:layout_constraintStart_toStartOf="@+id/guideline_begin"
        app:layout_constraintTop_toBottomOf="@+id/blu_voucher_pin_warning"/>
    <com.sportybet.android.widget.ProgressButton
        android:id="@+id/blu_voucher_deposit_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:minHeight="48dp"
        android:text="@string/page_payment__redeem_voucher"
        app:layout_constraintEnd_toEndOf="@+id/guideline_end"
        app:layout_constraintStart_toStartOf="@+id/guideline_begin"
        app:layout_constraintTop_toBottomOf="@+id/blu_voucher_kyc_hint"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/blu_voucher_description_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        app:layout_constraintEnd_toEndOf="@+id/guideline_end"
        app:layout_constraintStart_toStartOf="@+id/guideline_begin"
        app:layout_constraintTop_toBottomOf="@+id/blu_voucher_deposit_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
