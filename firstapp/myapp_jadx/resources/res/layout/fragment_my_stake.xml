<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?android:attr/windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/bottom_layout"
        layout="@layout/my_favorite_bottom_layout"/>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/stake_tab"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="50dp"
        android:layout_marginRight="50dp"
        android:layout_marginBottom="28dp"
        app:tabMode="fixed"
        app:tabPaddingEnd="@dimen/my_fav_stake_tab_padding"
        app:tabPaddingStart="@dimen/my_fav_stake_tab_padding"
        app:tabTextColor="@color/text_type1_tertiary"
        style="@style/Widget.App.TabLayout.Default.Primary"/>
    <include
        android:id="@+id/default_stake_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/stake_tab"
        layout="@layout/my_favorite_default_stake_layout"/>
    <com.sportybet.plugin.myfavorite.widget.QuickAddStakeLayout
        android:id="@+id/quick_add_stake_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_layout"
        android:layout_below="@+id/stake_tab"/>
    <com.sporty.android.common_ui.widgets.LoadingViewNew
        android:id="@+id/loading"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:layout_centerInParent="true"/>
</RelativeLayout>
