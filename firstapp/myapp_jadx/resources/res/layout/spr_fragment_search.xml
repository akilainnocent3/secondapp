<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/title_bar_bg"
        android:background="@color/brand_primary"
        android:layout_width="0dp"
        android:layout_height="44dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageButton
        android:id="@+id/go_back"
        android:background="?android:attr/selectableItemBackground"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/title_bar_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_action_bar_back"/>
    <com.sportybet.plugin.realsports.widget.ClearEditText
        android:textSize="12sp"
        android:textColor="@color/text_type1_tertiary"
        android:textColorHint="@color/custom_text_type1_secondary_type1"
        android:id="@+id/search_keyword"
        android:background="@drawable/bg_filled_background_general_primary_5_radius"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginRight="20dp"
        android:hint="@string/wap_search__search_tips"
        android:singleLine="true"
        android:maxLength="27"
        android:imeOptions="actionSearch"
        android:textCursorDrawable="@null"
        android:layout_marginEnd="20dp"
        android:paddingHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/title_bar_bg"
        app:layout_constraintEnd_toEndOf="@+id/title_bar_bg"
        app:layout_constraintStart_toEndOf="@+id/go_back"
        app:layout_constraintTop_toTopOf="@+id/title_bar_bg"/>
    <FrameLayout
        android:id="@+id/search_container"
        android:background="@color/background_general_primary"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:isPermanent="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar_bg">
        <com.donkingliang.consecutivescroller.ConsecutiveScrollerLayout
            android:id="@+id/search_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            app:autoAdjustHeightAtBottomView="true">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_type1_primary"
                android:id="@+id/hot_searches_label"
                android:paddingLeft="16dp"
                android:paddingTop="12dp"
                android:paddingRight="16dp"
                android:paddingBottom="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/wap_search__hot_search_title"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"/>
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/hot_searches_tags"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                app:chipSpacingVertical="8dp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/search_history_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/search_history_label"
                    android:paddingLeft="16dp"
                    android:paddingTop="12dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="12dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/wap_search__search_history_title"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/clear"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textColor="@color/absolute_type2"
                    android:gravity="center"
                    android:id="@+id/clear"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:text="@string/common_functions__clear"
                    android:paddingHorizontal="16dp"
                    app:layout_constraintBottom_toBottomOf="@+id/search_history_label"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/search_history_label"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_search_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/search_live_tab_container"
                android:background="@color/background_type2_primary"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_isSticky="true">
                <TextView
                    android:textSize="18dp"
                    android:textStyle="bold"
                    android:textColor="#f3f3f6"
                    android:gravity="center"
                    android:id="@+id/search_live_title"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:text="@string/common_functions__live"
                    android:paddingHorizontal="12dp"
                    app:layout_constraintBottom_toBottomOf="@+id/search_live_sport_tab"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/search_live_sport_tab"/>
                <View
                    android:id="@+id/search_live_view"
                    android:background="@color/text_type1_secondary"
                    android:layout_width="1dp"
                    android:layout_height="16dp"
                    app:layout_constraintBottom_toBottomOf="@+id/search_live_title"
                    app:layout_constraintStart_toEndOf="@+id/search_live_title"
                    app:layout_constraintTop_toTopOf="@+id/search_live_title"/>
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/search_live_sport_tab"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/search_sport_tabs_height"
                    android:layout_marginStart="12dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/search_live_view"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tabIndicatorHeight="0dp"
                    app:tabMinWidth="10dp"
                    app:tabMode="scrollable"
                    app:tabPaddingEnd="12dp"
                    app:tabPaddingStart="0dp"
                    app:tabSelectedTextColor="@color/brand_secondary"
                    app:tabTextAppearance="@style/CustomTabAppearance"
                    style="@style/Widget.App.TabLayout.Live.NoIndicator"/>
                <androidx.constraintlayout.widget.Guideline
                    android:orientation="vertical"
                    android:id="@+id/live_guideline_end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintGuide_percent="1"/>
                <androidx.constraintlayout.widget.Barrier
                    android:id="@+id/live_barrier_switch_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:barrierAllowsGoneWidgets="false"
                    app:barrierDirection="start"
                    app:constraint_referenced_ids="live_guideline_end,live_one_two_up_switch,live_ou_early_goals_switch"/>
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/search_live_market_tab"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/search_market_tabs_height"
                    app:layout_constraintEnd_toStartOf="@+id/live_market_option_divider"
                    app:layout_constraintHorizontal_chainStyle="spread_inside"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/search_live_sport_tab"
                    app:tabMode="scrollable"
                    app:tabPaddingEnd="10dp"
                    app:tabPaddingStart="10dp"
                    style="@style/Widget.App.TabLayout.Live.Secondary"/>
                <View
                    android:id="@+id/live_market_option_divider"
                    android:background="@color/line_type1_secondary"
                    android:visibility="gone"
                    android:layout_width="1dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintBottom_toBottomOf="@+id/search_live_market_tab"
                    app:layout_constraintEnd_toStartOf="@+id/live_barrier_switch_start"
                    app:layout_constraintStart_toEndOf="@+id/search_live_market_tab"
                    app:layout_constraintTop_toTopOf="@+id/search_live_market_tab"/>
                <com.sportybet.android.widget.OneUpTwoUpSwitch
                    android:layout_gravity="center_vertical"
                    android:id="@+id/live_one_two_up_switch"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginHorizontal="8dp"
                    app:layout_constraintBottom_toBottomOf="@+id/search_live_market_tab"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/search_live_market_tab"/>
                <com.sportybet.android.widget.OUEarlyGoalsSwitch
                    android:layout_gravity="center_vertical"
                    android:id="@+id/live_ou_early_goals_switch"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginHorizontal="8dp"
                    app:layout_constraintBottom_toBottomOf="@+id/search_live_market_tab"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/search_live_market_tab"/>
                <include
                    android:id="@+id/search_live_market_title"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    app:layout_constraintTop_toBottomOf="@+id/search_live_market_tab"
                    layout="@layout/spr_live_market_title"/>
                <com.sportybet.android.widget.BubbleView
                    android:id="@+id/live_market_option_feature_alert"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    app:closable="true"
                    app:descriptionText="@string/component_betslip__early_goal_tip_desc"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/live_market_option_divider"
                    app:title="@string/component_betslip__early_goal_tip_title"
                    app:trianglePosition="top_right"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.sportybet.plugin.realsports.search.widget.searchlivepanel.SearchLivePanel
                    android:id="@+id/search_live_panel"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </androidx.core.widget.NestedScrollView>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/search_prematch_tab_container"
                android:paddingBottom="4dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_isSticky="true">
                <TextView
                    android:textSize="18dp"
                    android:textStyle="bold"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="center"
                    android:id="@+id/search_prematch_title"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="@string/wap_home__sports"
                    android:paddingHorizontal="12dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:id="@+id/search_pre_match_view"
                    android:background="@color/text_type1_secondary"
                    android:layout_width="1dp"
                    android:layout_height="16dp"
                    app:layout_constraintBottom_toBottomOf="@+id/search_prematch_title"
                    app:layout_constraintStart_toEndOf="@+id/search_prematch_title"
                    app:layout_constraintTop_toTopOf="@+id/search_prematch_title"/>
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/search_prematch_sport_tab"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:overScrollMode="never"
                    android:layout_marginStart="12dp"
                    app:layout_constraintBottom_toBottomOf="@+id/search_prematch_title"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/search_pre_match_view"
                    app:layout_constraintTop_toTopOf="@+id/search_prematch_title"
                    app:tabIndicatorHeight="0dp"
                    app:tabMinWidth="10dp"
                    app:tabMode="scrollable"
                    app:tabPaddingEnd="12dp"
                    app:tabTextAppearance="@style/CustomTabAppearance"
                    style="@style/Widget.App.TabLayout.Default.NoIndicator"/>
                <androidx.constraintlayout.widget.Guideline
                    android:orientation="vertical"
                    android:id="@+id/pre_match_guideline_end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintGuide_percent="1"/>
                <androidx.constraintlayout.widget.Barrier
                    android:id="@+id/pre_match_barrier_switch_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:barrierAllowsGoneWidgets="false"
                    app:barrierDirection="start"
                    app:constraint_referenced_ids="pre_match_guideline_end,pre_match_one_two_up_switch,pre_match_ou_early_goals_switch"/>
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/search_prematch_market_tab"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:overScrollMode="never"
                    app:layout_constraintEnd_toStartOf="@+id/pre_match_market_option_divider"
                    app:layout_constraintHorizontal_chainStyle="spread_inside"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/search_prematch_sport_tab"
                    app:tabMode="scrollable"
                    app:tabPaddingEnd="10dp"
                    app:tabPaddingStart="10dp"
                    app:tabTextAppearance="@style/CustomTabAppearance"
                    style="@style/Widget.App.TabLayout.Default.Secondary"/>
                <View
                    android:id="@+id/pre_match_market_option_divider"
                    android:background="@color/line_type1_secondary"
                    android:visibility="gone"
                    android:layout_width="1dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintBottom_toBottomOf="@+id/search_prematch_market_tab"
                    app:layout_constraintEnd_toStartOf="@+id/pre_match_barrier_switch_start"
                    app:layout_constraintStart_toEndOf="@+id/search_prematch_market_tab"
                    app:layout_constraintTop_toTopOf="@+id/search_prematch_market_tab"/>
                <com.sportybet.android.widget.OneUpTwoUpSwitch
                    android:layout_gravity="center_vertical"
                    android:id="@+id/pre_match_one_two_up_switch"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginHorizontal="8dp"
                    app:layout_constraintBottom_toBottomOf="@+id/search_prematch_market_tab"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/search_prematch_market_tab"/>
                <com.sportybet.android.widget.OUEarlyGoalsSwitch
                    android:layout_gravity="center_vertical"
                    android:id="@+id/pre_match_ou_early_goals_switch"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginHorizontal="8dp"
                    app:layout_constraintBottom_toBottomOf="@+id/search_prematch_market_tab"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/search_prematch_market_tab"/>
                <com.sportybet.android.widget.BubbleView
                    android:id="@+id/pre_match_market_option_feature_alert"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    app:closable="true"
                    app:descriptionText="@string/component_betslip__early_goal_tip_desc"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/pre_match_market_option_divider"
                    app:title="@string/component_betslip__early_goal_tip_title"
                    app:trianglePosition="top_right"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.sportybet.plugin.realsports.search.widget.searchprematchpanel.SearchPreMatchPanel
                android:id="@+id/search_prematch_panel"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_scrollChild="@+id/event_list"/>
        </com.donkingliang.consecutivescroller.ConsecutiveScrollerLayout>
    </FrameLayout>
    <com.sportybet.plugin.realsports.search.SearchResultLoadingView
        android:id="@+id/search_loading_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar_bg"/>
</androidx.constraintlayout.widget.ConstraintLayout>
