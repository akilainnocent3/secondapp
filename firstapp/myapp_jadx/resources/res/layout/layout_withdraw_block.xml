<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/warning_secondary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="75dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/draw_warn"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="12dp"
        app:srcCompat="@drawable/ic_error_black_24dp"
        app:tint="@color/text_type2_primary"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_type2_primary"
        android:id="@+id/draw_grey_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="12dp"
        android:layout_toRightOf="@+id/draw_warn"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_type2_primary"
        android:id="@+id/draw_grey_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginRight="75dp"
        android:layout_marginBottom="12dp"
        android:layout_below="@+id/draw_grey_title"
        android:layout_alignLeft="@+id/draw_grey_title"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/withdraw_grey_txt_color"
        android:gravity="center"
        android:id="@+id/draw_verify_btn"
        android:background="@drawable/withdraw_grey_btn_bg"
        android:padding="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:minWidth="52dp"
        android:minHeight="22dp"
        android:layout_alignTop="@+id/draw_grey_details"
        android:layout_alignParentRight="true"/>
</RelativeLayout>
