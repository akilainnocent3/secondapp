<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:background="@color/custom_background_type1_primary_type2"
    android:paddingLeft="4dp"
    android:paddingTop="2dp"
    android:paddingRight="4dp"
    android:paddingBottom="2dp"
    android:layout_width="205dp"
    android:layout_height="38dp"
    android:paddingHorizontal="4dp"
    android:paddingVertical="2dp">
    <TextView
        android:textSize="14dp"
        android:textColor="@color/text_type1_secondary"
        android:gravity="center"
        android:id="@+id/spinner_text"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fontFamily="sans-serif"/>
    <com.sportybet.plugin.realsports.widget.OutcomeButton
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/spr_prematch_toggle_txt"
        android:gravity="center"
        android:id="@+id/spinner_outcome1"
        android:background="@drawable/spr_prematch_toggle_bg"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fontFamily="sans-serif"
        android:layout_marginStart="1dp"
        style="?android:attr/borderlessButtonStyle"/>
    <com.sportybet.plugin.realsports.widget.OutcomeButton
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/spr_prematch_toggle_txt"
        android:gravity="center"
        android:id="@+id/spinner_outcome2"
        android:background="@drawable/spr_prematch_toggle_bg"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fontFamily="sans-serif"
        android:layout_marginStart="1dp"
        style="?android:attr/borderlessButtonStyle"/>
    <com.sportybet.plugin.realsports.widget.OutcomeButton
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/spr_prematch_toggle_txt"
        android:gravity="center"
        android:id="@+id/spinner_outcome3"
        android:background="@drawable/spr_prematch_toggle_bg"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fontFamily="sans-serif"
        android:layout_marginStart="1dp"
        style="?android:attr/borderlessButtonStyle"/>
</LinearLayout>
