<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/viewSplash"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.3055"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivWheel"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.7"
        app:layout_constraintWidth_percent="0.85"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layFireFlies"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivWheel"
        app:layout_constraintEnd_toEndOf="@+id/ivWheel"
        app:layout_constraintStart_toStartOf="@+id/ivWheel"
        app:layout_constraintTop_toTopOf="@+id/ivWheel"
        app:layout_constraintWidth_percent="0.95"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutMultiplier"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:translationZ="0dp"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/multiplierSvgContainer"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.3055">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivSplash"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintDimensionRatio="1:1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tvMultiplier"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:lines="1"
                android:autoSizeTextType="uniform"
                app:fontFamily="@font/motley_forces"
                app:layout_constraintBottom_toBottomOf="@+id/ivSplash"
                app:layout_constraintEnd_toEndOf="@+id/ivSplash"
                app:layout_constraintHeight_percent="0.45"
                app:layout_constraintStart_toStartOf="@+id/ivSplash"
                app:layout_constraintTop_toTopOf="@+id/ivSplash"
                app:layout_constraintWidth_percent="0.5"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivCutLeft"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivCutRight"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lySuccessTexts"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.152"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.6">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_24ssp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tvYouWon"
            android:tag="@string/fh_you_won_cms"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:text="@string/fh_you_won"
            android:alpha="0.75"
            app:fontFamily="@font/motley_forces"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.3158"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_28ssp"
            android:textColor="@color/fh_you_won_amount"
            android:gravity="center"
            android:id="@+id/tvWonAmount"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:autoSizeTextType="uniform"
            app:fontFamily="@font/motley_forces"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.3684"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvYouWon"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_24ssp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tvAtMultiplier"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:alpha="0.75"
            android:autoSizeTextType="uniform"
            app:fontFamily="@font/motley_forces"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.3158"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvWonAmount"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/gift_round_detail"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_2sdp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lySuccessTexts">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_16ssp"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="("
            android:alpha="0.7"
            android:paddingEnd="@dimen/_2sdp"
            app:fontFamily="@font/motley_forces"
            app:layout_constraintBottom_toBottomOf="@+id/total_win_icon"
            app:layout_constraintRight_toLeftOf="@+id/total_win_icon"
            app:layout_constraintTop_toTopOf="@+id/total_win_icon"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/total_win_icon"
            android:layout_width="@dimen/_15sdp"
            android:layout_height="@dimen/_15sdp"
            android:layout_marginRight="@dimen/_4sdp"
            android:src="@drawable/sporty_trophy"
            android:alpha="0.5"
            app:layout_constraintBottom_toBottomOf="@+id/total_win_amount"
            app:layout_constraintRight_toLeftOf="@+id/total_win_amount"
            app:layout_constraintTop_toTopOf="@+id/total_win_amount"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_16ssp"
            android:textColor="@color/white"
            android:id="@+id/total_win_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            app:fontFamily="@font/motley_forces"
            app:layout_constraintBottom_toBottomOf="@+id/gift_minus_saperator_tv"
            app:layout_constraintRight_toLeftOf="@+id/gift_minus_saperator_tv"
            app:layout_constraintTop_toTopOf="@+id/gift_minus_saperator_tv"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_16ssp"
            android:textColor="@color/white"
            android:id="@+id/gift_minus_saperator_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" - "
            android:alpha="0.7"
            app:fontFamily="@font/motley_forces"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/gift_icon"
            android:layout_width="@dimen/_15sdp"
            android:layout_height="@dimen/_15sdp"
            android:src="@drawable/gift_icon_bethistory"
            android:scaleType="fitXY"
            android:alpha="0.5"
            app:layout_constraintBottom_toBottomOf="@+id/gift_minus_saperator_tv"
            app:layout_constraintLeft_toRightOf="@+id/gift_minus_saperator_tv"
            app:layout_constraintTop_toTopOf="@+id/gift_minus_saperator_tv"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_16ssp"
            android:textColor="@color/white"
            android:id="@+id/gift_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:paddingStart="@dimen/_4sdp"
            android:paddingEnd="@dimen/_2sdp"
            app:fontFamily="@font/motley_forces"
            app:layout_constraintBottom_toBottomOf="@+id/gift_icon"
            app:layout_constraintLeft_toRightOf="@+id/gift_icon"
            app:layout_constraintTop_toTopOf="@+id/gift_icon"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_16ssp"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=")"
            android:alpha="0.7"
            app:fontFamily="@font/motley_forces"
            app:layout_constraintBottom_toBottomOf="@+id/gift_amount"
            app:layout_constraintLeft_toRightOf="@+id/gift_amount"
            app:layout_constraintTop_toTopOf="@+id/gift_amount"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/_20ssp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tvConnecting"
        android:tag="@string/fh_connecting_cms"
        android:paddingLeft="16dp"
        android:paddingTop="2dp"
        android:paddingRight="16dp"
        android:paddingBottom="2dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/fh_connecting"
        android:alpha="0.9"
        android:paddingHorizontal="16dp"
        android:paddingVertical="2dp"
        app:fontFamily="@font/motley_forces"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.047"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/_30ssp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tvErrorMissed"
        android:tag="@string/fh_missed_cms"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/fh_missed"
        android:alpha="0.75"
        app:fontFamily="@font/motley_forces"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.06"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.6"
        app:layout_constraintWidth_percent="0.6"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/_24ssp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tvErrorBetterLuck"
        android:tag="@string/fh_better_luck_cms"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/fh_better_luck"
        android:lineSpacingExtra="4sp"
        android:alpha="0.75"
        app:fontFamily="@font/motley_forces"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.1"
        app:layout_constraintHorizontal_bias="0.52"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.6"
        app:layout_constraintWidth_percent="0.55"/>
</androidx.constraintlayout.widget.ConstraintLayout>
