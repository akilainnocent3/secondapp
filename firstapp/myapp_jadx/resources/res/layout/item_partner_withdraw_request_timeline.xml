<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="80dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/indicator_image_view"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_check_circle_green_24dp"/>
    <View
        android:id="@+id/timeline"
        android:background="@drawable/line"
        android:layout_width="3dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/indicator_image_view"
        app:layout_constraintStart_toStartOf="@+id/indicator_image_view"
        app:layout_constraintTop_toBottomOf="@+id/indicator_image_view"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_type1_primary"
        android:id="@+id/title_text_view"
        android:paddingBottom="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="3dp"
        android:layout_marginRight="10dp"
        android:fontFamily="sans-serif"
        android:layout_marginHorizontal="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/indicator_image_view"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/hint_container"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/title_text_view"
        app:layout_constraintTop_toBottomOf="@+id/title_text_view">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/warning"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="2dp"
            android:tint="@color/text_type1_secondary"
            app:srcCompat="@drawable/ic_error_black_24dp"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="normal"
            android:textColor="@color/text_type1_secondary"
            android:id="@+id/hint"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:singleLine="false"
            android:lineSpacingExtra="2sp"
            android:fontFamily="sans-serif"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_type1_secondary"
        android:id="@+id/time_text_view"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/title_text_view"
        app:layout_constraintTop_toBottomOf="@+id/hint_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
