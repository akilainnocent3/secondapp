<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_3sdp"
    android:backgroundTint="@color/sh_top_win_item_bg_dark_theme"
    app:cardCornerRadius="20dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:padding="0x7f0702ae"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/user_image_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.4">
            <ImageView
                android:id="@+id/user_image"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:scrollbarSize="@dimen/_8ssp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/user_name"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:layout_marginStart="@dimen/_8sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/user_image"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.55"
                style="@style/TextPrimaryMedium"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cashout_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/user_image_layout"
            app:layout_constraintStart_toEndOf="@+id/user_image_layout"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.5">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_8ssp"
                android:id="@+id/cashout_text"
                android:tag="@string/cashout_text_cms"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="Cashout  "
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/cashout_amount"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextSecondaryRegular"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_8ssp"
                android:gravity="center"
                android:id="@+id/cashout_amount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/_44sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/cashout_text"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextPrimaryMedium"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/fairness_layout"
            android:layout_width="0dp"
            android:layout_height="@dimen/_30sdp"
            app:layout_constraintStart_toEndOf="@+id/cashout_layout"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.1">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/fairness"
                android:layout_width="13dp"
                android:layout_height="14dp"
                android:src="@drawable/fairness"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/stake_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/user_image_layout"
            app:layout_constraintWidth_percent="0.4">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_8ssp"
                android:id="@+id/stake_text"
                android:tag="@string/stake_game_cms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stake"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/_50sdp"
                app:layout_constraintWidth_min="@dimen/_30sdp"
                app:layout_constraintWidth_percent="0.5"
                style="@style/TextSecondaryRegular"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_9sdp"
                android:id="@+id/stake_space"
                android:tag="@string/stake_game_cms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  "
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/stake_text"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextSecondaryRegular"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="center_vertical"
                android:id="@+id/stake_amount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/stake_space"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.6"
                style="@style/TextPrimaryRegular"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/coefficient_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/user_image_layout"
            app:layout_constraintTop_toBottomOf="@+id/user_image_layout"
            app:layout_constraintWidth_percent="0.5">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_8ssp"
                android:id="@+id/coefficient_text"
                android:tag="@string/coefficient_cms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Coefficient  "
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextSecondaryRegular"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_8ssp"
                android:gravity="center"
                android:id="@+id/coefficient_amount"
                android:background="@drawable/sh_previous_chip_bg"
                android:paddingLeft="@dimen/_6sdp"
                android:paddingTop="@dimen/_2sdp"
                android:paddingRight="@dimen/_6sdp"
                android:paddingBottom="@dimen/_3sdp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/_40sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/coefficient_text"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.5"
                style="@style/TextPrimaryBold"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/chat_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/coefficient_layout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/cashout_layout"
            app:layout_constraintTop_toTopOf="@+id/coefficient_layout"
            app:layout_constraintWidth_percent="0.1">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/_16sdp"
                android:layout_height="@dimen/_16sdp"
                android:src="@drawable/chat_sh"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
