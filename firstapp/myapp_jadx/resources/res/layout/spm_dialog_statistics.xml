<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/dialog_layout"
    android:paddingTop="80dp"
    android:paddingBottom="80dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="14dp"
    android:layout_marginRight="14dp"
    android:layout_marginHorizontal="14dp"
    android:paddingVertical="80dp">
    <View
        android:id="@+id/view_top"
        android:background="@color/background_dialog_title"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btn_close"
        android:padding="8dp"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/view_top"
        app:layout_constraintEnd_toEndOf="@+id/view_top"
        app:layout_constraintTop_toTopOf="@+id/view_top"
        app:srcCompat="@drawable/spr_ic_close_white_16dp"
        app:tint="@color/brand_tertiary"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/brand_tertiary"
        android:id="@+id/tv_title"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/common_functions__statistics"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/view_top"
        app:layout_constraintStart_toStartOf="@+id/view_top"
        app:layout_constraintTop_toTopOf="@+id/view_top"/>
    <com.sportybet.android.widget.NestedWebView
        android:scrollbarStyle="insideOverlay"
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_top"/>
</androidx.constraintlayout.widget.ConstraintLayout>
