<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/sports_event_tournament_layout"
    android:background="@color/background_type2_primary"
    android:layout_width="match_parent"
    android:layout_height="36dp">
    <ImageView
        android:gravity="start|center_vertical"
        android:id="@+id/sports_event_tournament_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="20dp"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="normal"
        android:textColor="@color/text_type2_primary"
        android:gravity="start|center_vertical"
        android:id="@+id/sports_event_tournament_name_text"
        android:layout_width="270dp"
        android:layout_height="35dp"
        android:layout_marginLeft="50dp"
        android:singleLine="true"
        android:lineSpacingExtra="2.8sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="50dp"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="normal"
        android:textColor="@color/text_type2_primary"
        android:gravity="end|center_vertical"
        android:id="@+id/sports_event_tournament_count_text"
        android:layout_width="wrap_content"
        android:layout_height="35dp"
        android:layout_marginRight="10dp"
        android:layout_alignParentRight="true"
        android:lineSpacingExtra="2.8sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginEnd="10dp"
        android:layout_alignParentEnd="true"/>
    <View
        android:id="@+id/sports_event_tournament_divider_line"
        android:background="@color/line_type1_secondary"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="50dp"
        android:layout_below="@+id/sports_event_tournament_count_text"
        android:layout_marginStart="50dp"/>
</RelativeLayout>
