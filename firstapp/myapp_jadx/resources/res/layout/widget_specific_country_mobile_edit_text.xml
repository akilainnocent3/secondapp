<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/edit_text_container"
        android:background="@drawable/bg_icon_text_selector_button_enabled"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:paddingStart="16dp"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/icon_start_image_view"
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_mobile_money"
            app:tint="@color/text_disable_type1_primary"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/B1_M"
            android:textColor="@color/text_type1_primary"
            android:id="@+id/calling_code_text_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/icon_start_image_view"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:textAppearance="@style/B1_M"
            android:textColor="@color/text_type1_primary"
            android:textColorHint="@color/text_type1_secondary"
            android:gravity="center_vertical"
            android:id="@+id/edit_text"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginTop="1dp"
            android:inputType="number"
            android:imeOptions="actionDone"
            android:layout_marginStart="12dp"
            app:layout_constraintEnd_toStartOf="@+id/clear_btn"
            app:layout_constraintStart_toEndOf="@+id/calling_code_text_view"/>
        <FrameLayout
            android:id="@+id/clear_btn"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingHorizontal="12dp"
            app:layout_constraintEnd_toEndOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_cancel_black_24dp"
                app:tint="@color/text_disable_type1_primary"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/B2_R"
        android:textColor="@color/warning_primary"
        android:id="@+id/error_text_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="@+id/edit_text_container"
        app:layout_constraintTop_toBottomOf="@+id/edit_text_container"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/B2_R"
        android:textColor="@color/text_type1_secondary"
        android:id="@+id/hint_text_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="@+id/edit_text_container"
        app:layout_constraintTop_toBottomOf="@+id/edit_text_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
