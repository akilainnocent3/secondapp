<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.Guideline
                    android:orientation="vertical"
                    android:id="@+id/guideline_begin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintGuide_begin="20dp"/>
                <androidx.constraintlayout.widget.Guideline
                    android:orientation="vertical"
                    android:id="@+id/guideline_end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintGuide_end="20dp"/>
                <com.sportybet.android.widget.HintView
                    android:id="@+id/hint_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.sportybet.android.widget.HintView
                    android:id="@+id/secondary_hint_view"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:layout_constraintEnd_toStartOf="@+id/guideline_end"
                    app:layout_constraintStart_toEndOf="@+id/guideline_begin"
                    app:layout_constraintTop_toBottomOf="@+id/hint_view"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/deposit_with_exist_group"
                    android:visibility="visible"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toStartOf="@+id/guideline_end"
                    app:layout_constraintStart_toEndOf="@+id/guideline_begin"
                    app:layout_constraintTop_toBottomOf="@+id/secondary_hint_view">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/saved_card_recycler_view"
                        android:scrollbars="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="13dp"
                        android:textStyle="normal"
                        android:textColor="@color/brand_secondary"
                        android:gravity="center"
                        android:id="@+id/use_new_card_btn"
                        android:paddingLeft="20dp"
                        android:paddingTop="20dp"
                        android:paddingRight="20dp"
                        android:paddingBottom="20dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="20dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/saved_card_recycler_view"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/help_cvv_icon"
                        android:background="?android:attr/selectableItemBackground"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:tint="@color/text_type1_secondary"
                        android:paddingEnd="6dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/use_new_card_btn"
                        app:srcCompat="@drawable/ic_help_outline_black_24dp"/>
                    <TextView
                        android:textSize="12dp"
                        android:textStyle="normal"
                        android:textColor="@color/text_type1_primary"
                        android:gravity="center"
                        android:id="@+id/balance_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="19dp"
                        android:fontFamily="sans-serif"
                        android:layout_marginEnd="10dp"
                        app:layout_constraintBottom_toBottomOf="@+id/help_cvv_icon"
                        app:layout_constraintEnd_toStartOf="@+id/balance"
                        app:layout_constraintTop_toBottomOf="@+id/use_new_card_btn"
                        app:layout_constraintTop_toTopOf="@+id/help_cvv_icon"/>
                    <TextView
                        android:textSize="12dp"
                        android:textStyle="normal"
                        android:textColor="@color/text_type1_primary"
                        android:gravity="center"
                        android:id="@+id/balance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="19dp"
                        android:fontFamily="sans-serif"
                        app:layout_constraintBottom_toBottomOf="@+id/balance_label"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/balance_label"/>
                    <com.sporty.android.common_ui.widgets.CombEditText
                        android:id="@+id/cvv_edit_text"
                        android:background="@drawable/comb_edit_text_bg"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginEnd="10dp"
                        app:layout_constraintEnd_toStartOf="@+id/amount_container"
                        app:layout_constraintHorizontal_weight="9"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/help_cvv_icon"/>
                    <TextView
                        android:textSize="10dp"
                        android:textStyle="normal"
                        android:textColor="@color/warning_primary"
                        android:id="@+id/cvv_warning"
                        android:visibility="invisible"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:minHeight="11dp"
                        android:fontFamily="sans-serif"
                        app:layout_constraintStart_toStartOf="@+id/cvv_edit_text"
                        app:layout_constraintTop_toBottomOf="@+id/cvv_edit_text"/>
                    <FrameLayout
                        android:id="@+id/amount_container"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_weight="16"
                        app:layout_constraintStart_toEndOf="@+id/cvv_edit_text"
                        app:layout_constraintTop_toBottomOf="@+id/help_cvv_icon">
                        <com.sporty.android.common_ui.widgets.ClearEditText
                            android:textAppearance="@style/B1_R"
                            android:gravity="center"
                            android:id="@+id/amount"
                            android:background="@drawable/bg_outlined_line_type1_secondary_2_radius"
                            android:paddingLeft="110dp"
                            android:paddingRight="12dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:maxLines="1"
                            android:drawablePadding="8dp"
                            android:lineSpacingExtra="0dp"
                            android:inputType="numberDecimal"
                            android:imeOptions="actionDone"
                            app:cancalDrawableSize="16dp"/>
                        <TextView
                            android:textSize="14dp"
                            android:textStyle="normal"
                            android:textColor="@color/text_type1_primary"
                            android:gravity="center_vertical"
                            android:id="@+id/amount_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="12dp"
                            android:minHeight="48dp"
                            android:lineSpacingExtra="0sp"
                            android:fontFamily="sans-serif-medium"/>
                    </FrameLayout>
                    <TextView
                        android:textSize="10dp"
                        android:textStyle="normal"
                        android:textColor="@color/warning_primary"
                        android:id="@+id/amount_warning"
                        android:visibility="invisible"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:minHeight="11dp"
                        android:layout_weight="16"
                        android:fontFamily="sans-serif"
                        app:layout_constraintEnd_toEndOf="@+id/amount_container"
                        app:layout_constraintStart_toStartOf="@+id/amount_container"
                        app:layout_constraintTop_toBottomOf="@+id/amount_container"/>
                    <com.sportybet.android.widget.BubbleView
                        android:id="@+id/newFeatureAlertView"
                        android:visibility="gone"
                        android:layout_width="256dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="57dp"
                        app:closable="true"
                        app:descriptionText="@string/page_payment__set_default_card_feature_hint_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:title="@string/page_payment__default_function_available_now"
                        app:trianglePosition="top_right"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <include
                    android:id="@+id/deposit_with_new_card_layout"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    app:layout_constraintEnd_toStartOf="@+id/guideline_end"
                    app:layout_constraintStart_toEndOf="@+id/guideline_begin"
                    app:layout_constraintTop_toBottomOf="@+id/deposit_with_exist_group"
                    layout="@layout/layout_deposit_with_new_card"/>
                <com.sportybet.feature.payment.impl.deposit.presentation.widget.AmountQuickAddingButtonGroup
                    android:id="@+id/deposit_amount_quick_adding_buttons"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:layout_constraintEnd_toStartOf="@+id/guideline_end"
                    app:layout_constraintStart_toEndOf="@+id/guideline_begin"
                    app:layout_constraintTop_toBottomOf="@+id/deposit_with_new_card_layout"/>
                <TextView
                    android:textSize="13dp"
                    android:textStyle="normal"
                    android:textColor="#0d9737"
                    android:id="@+id/ad_text_view"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:drawablePadding="5dp"
                    android:lineSpacingExtra="-1dp"
                    android:fontFamily="sans-serif"
                    app:layout_constraintEnd_toStartOf="@+id/guideline_end"
                    app:layout_constraintStart_toEndOf="@+id/guideline_begin"
                    app:layout_constraintTop_toBottomOf="@+id/deposit_amount_quick_adding_buttons"/>
                <com.sportybet.android.widget.ProgressButton
                    android:textAppearance="@style/B1_M"
                    android:id="@+id/next"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:text="@string/common_functions__top_up_now"
                    app:layout_constraintEnd_toStartOf="@+id/guideline_end"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toEndOf="@+id/guideline_begin"
                    app:layout_constraintTop_toBottomOf="@+id/ad_text_view"/>
                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/deposit_banner_compose_view"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:layout_constraintEnd_toEndOf="@+id/next"
                    app:layout_constraintStart_toStartOf="@+id/next"
                    app:layout_constraintTop_toBottomOf="@+id/next"/>
                <com.google.android.flexbox.FlexboxLayout
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/card_image_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:flexWrap="wrap"
                    app:layout_constraintEnd_toStartOf="@+id/guideline_end"
                    app:layout_constraintStart_toEndOf="@+id/guideline_begin"
                    app:layout_constraintTop_toBottomOf="@+id/deposit_banner_compose_view"/>
                <com.sportybet.android.widget.SimpleDescriptionListView
                    android:id="@+id/description_list_view"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:paddingVertical="16dp"
                    app:layout_constraintEnd_toStartOf="@+id/guideline_end"
                    app:layout_constraintStart_toEndOf="@+id/guideline_begin"
                    app:layout_constraintTop_toBottomOf="@+id/card_image_container"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <FrameLayout
        android:id="@+id/anti_interaction_mask"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <WebView
        android:id="@+id/verify_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1000dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.sporty.android.common_ui.widgets.LoadingViewNew
        android:id="@+id/loading_mask"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/init_mask"
        android:background="@color/background_general_primary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/compose_custom_container"
        android:background="@color/background_general_primary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.sporty.android.common_ui.widgets.LoadingViewNew
        android:id="@+id/init_failed_mask"
        android:background="@color/background_general_primary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
