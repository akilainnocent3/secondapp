<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        android:background="@color/background_general_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/cv_date_picker_popup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/item_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/selector_text_type1_primary"
            android:id="@+id/tv_custom_time"
            android:paddingLeft="16dp"
            android:paddingTop="14dp"
            android:paddingRight="16dp"
            android:paddingBottom="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/common_dates__custom_time"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            app:layout_constraintTop_toBottomOf="@+id/item_container"/>
        <TextView
            android:textSize="12dp"
            android:gravity="center"
            android:id="@+id/btn_custom_time_apply"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="@string/component_odds_filters__apply"
            android:textAllCaps="false"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="16dp"
            android:paddingHorizontal="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_custom_time"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_custom_time"
            style="@style/Widget.App.CommonButton.Contained"/>
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/cv_custom_time_range_picker"
            android:paddingTop="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/tv_custom_time"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/text_type1_primary"
            android:gravity="center"
            android:id="@+id/btn_clear"
            android:background="@color/background_type1_primary"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:text="@string/component_odds_filters__clear_all"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintTop_toBottomOf="@+id/cv_custom_time_range_picker"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
