<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_type1_secondary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="18sp"
        android:textColor="@color/text_type1_primary"
        android:id="@+id/title"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/live__upcoming_live"
        android:paddingStart="16dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/odds_filter_expand_btn"
        android:background="@drawable/ret_charcoal_grey_stroke"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title"
        app:srcCompat="@drawable/ic_odds_filter"
        app:tint="@color/text_type1_primary"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/odds_filter_info_container"
        android:background="@color/brand_secondary_variable_type1"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginRight="10dp"
        android:paddingHorizontal="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title">
        <ImageView
            android:id="@+id/odds_filter_clear_btn"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:scaleType="center"
            android:layout_marginEnd="4dp"
            app:srcCompat="@drawable/ic_close_odds_filter"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/brand_secondary_variable_type2"
            android:id="@+id/odds_filter_value_tv"
            android:layout_width="wrap_content"
            android:layout_height="20dp"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/market_option_guideline_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="1"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_switch_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="false"
        app:barrierDirection="start"
        app:constraint_referenced_ids="market_option_guideline_end,one_up_two_up_switch,ou_early_goals_switch"/>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/market_tab"
        android:background="@color/background_type1_secondary"
        android:layout_width="0dp"
        android:layout_height="48dp"
        app:layout_constraintEnd_toStartOf="@+id/market_option_divider"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:tabBackground="@color/background_type1_secondary"
        app:tabIndicatorHeight="2dp"
        app:tabMinWidth="0dp"
        app:tabMode="scrollable"
        app:tabPaddingEnd="10dp"
        app:tabPaddingStart="10dp"
        app:tabTextAppearance="@style/CustomTabAppearance"
        style="@style/Widget.App.TabLayout.Default"/>
    <View
        android:id="@+id/market_option_divider"
        android:background="@color/line_type1_secondary"
        android:visibility="gone"
        android:layout_width="1dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/market_tab"
        app:layout_constraintEnd_toStartOf="@+id/barrier_switch_start"
        app:layout_constraintStart_toEndOf="@+id/market_tab"
        app:layout_constraintTop_toTopOf="@+id/market_tab"/>
    <com.sportybet.android.widget.OneUpTwoUpSwitch
        android:layout_gravity="center_vertical"
        android:id="@+id/one_up_two_up_switch"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/market_tab"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <com.sportybet.android.widget.OUEarlyGoalsSwitch
        android:layout_gravity="center_vertical"
        android:id="@+id/ou_early_goals_switch"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/market_tab"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <com.sportybet.android.widget.BubbleView
        android:id="@+id/market_option_feature_alert"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-10dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:closable="true"
        app:descriptionText="@string/component_betslip__early_goal_tip_desc"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/market_tab"
        app:title="@string/component_betslip__early_goal_tip_title"
        app:trianglePosition="top_right"/>
    <include
        android:id="@+id/market_title"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@+id/market_option_feature_alert"
        layout="@layout/spr_sport_event_market_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
