<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_bar"
        android:background="@color/brand_primary"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageButton
            android:id="@+id/back"
            android:background="?android:attr/selectableItemBackground"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/title"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_action_bar_back"
            app:tint="@color/brand_tertiary"/>
        <TextView
            android:textSize="20dp"
            android:textStyle="normal"
            android:textColor="@color/text_type2_primary"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/gift__l_gifts"
            android:maxLines="1"
            android:lineSpacingExtra="8dp"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/back"
            app:layout_constraintRight_toLeftOf="@+id/verify_bvn_help"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_type2_primary"
            android:gravity="center"
            android:id="@+id/verify_bvn_help"
            android:background="?android:attr/selectableItemBackground"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginRight="8dp"
            android:text="@string/gift__how_to_use"
            android:layout_alignParentRight="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/home"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageButton
            android:id="@+id/home"
            android:background="?android:attr/selectableItemBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_home"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:isScrollContainer="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/guideline_begin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_begin="30dp"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/guideline_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.9062"/>
            <TextView
                android:textSize="@dimen/text_size_22dp"
                android:textStyle="bold"
                android:textColor="@color/text_type1_primary"
                android:gravity="center"
                android:id="@+id/verify_bvn_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="@string/component_bvn__claim_gifts"
                app:layout_constraintLeft_toLeftOf="@+id/guideline_begin"
                app:layout_constraintRight_toRightOf="@+id/guideline_end"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_bvn_gift_icon"
                android:visibility="gone"
                android:layout_width="118dp"
                android:layout_height="136dp"
                android:layout_marginTop="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/verify_bvn_title"/>
            <TextView
                android:textSize="@dimen/text_size_14dp"
                android:textColor="@color/text_type1_primary"
                android:gravity="left"
                android:id="@+id/verify_bvn_content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="8dp"
                app:layout_constraintLeft_toLeftOf="@+id/guideline_begin"
                app:layout_constraintRight_toRightOf="@+id/guideline_end"
                app:layout_constraintTop_toBottomOf="@+id/iv_bvn_gift_icon"/>
            <include
                android:id="@+id/verify_bvn_date_layout"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                app:layout_constraintLeft_toLeftOf="@+id/guideline_begin"
                app:layout_constraintRight_toRightOf="@+id/guideline_end"
                app:layout_constraintTop_toBottomOf="@+id/verify_bvn_content"
                layout="@layout/date_picker_layout"/>
            <include
                android:id="@+id/verify_bvn_info_layout"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                app:layout_constraintLeft_toLeftOf="@+id/guideline_begin"
                app:layout_constraintRight_toRightOf="@+id/guideline_end"
                app:layout_constraintTop_toBottomOf="@+id/verify_bvn_date_layout"
                layout="@layout/input_info_layout"/>
            <Button
                android:enabled="false"
                android:textSize="@dimen/text_size_16dp"
                android:id="@+id/verify_bvn_btn"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="@string/common_functions__verify"
                android:textAllCaps="false"
                app:layout_constraintLeft_toLeftOf="@+id/guideline_begin"
                app:layout_constraintRight_toRightOf="@+id/guideline_end"
                app:layout_constraintTop_toBottomOf="@+id/verify_bvn_info_layout"
                style="@style/Widget.App.CommonButton.Contained"/>
            <TextView
                android:textSize="@dimen/text_size_16dp"
                android:gravity="center"
                android:id="@+id/verify_bvn_skip"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="20dp"
                android:text="@string/common_functions__skip"
                app:layout_constraintLeft_toLeftOf="@+id/guideline_begin"
                app:layout_constraintRight_toRightOf="@+id/guideline_end"
                app:layout_constraintTop_toBottomOf="@+id/verify_bvn_btn"
                style="@style/Widget.App.CommonButton.Outline"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
