<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/text_type1_primary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/quick_tool_bar"
        android:background="@color/background_type2_secondary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/text_type2_primary"
            android:gravity="center"
            android:id="@+id/quick_btn_1"
            android:background="@drawable/bg_rect_round_board"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/keyboard_stake_space_left_right"
            android:layout_marginTop="@dimen/keyboard_stake_space"
            android:layout_marginBottom="@dimen/keyboard_stake_space"
            android:maxLines="1"
            android:layout_weight="1"
            app:autoSizeMaxTextSize="14dp"
            app:autoSizeMinTextSize="11dp"
            app:autoSizeStepGranularity="1dp"
            app:autoSizeTextType="uniform"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/text_type2_primary"
            android:gravity="center"
            android:id="@+id/quick_btn_2"
            android:background="@drawable/bg_rect_round_board"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/keyboard_stake_space_left_right"
            android:layout_marginTop="@dimen/keyboard_stake_space"
            android:layout_marginBottom="@dimen/keyboard_stake_space"
            android:maxLines="1"
            android:layout_weight="1"
            app:autoSizeMaxTextSize="14dp"
            app:autoSizeMinTextSize="11dp"
            app:autoSizeStepGranularity="1dp"
            app:autoSizeTextType="uniform"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/text_type2_primary"
            android:gravity="center"
            android:id="@+id/quick_btn_3"
            android:background="@drawable/bg_rect_round_board"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/keyboard_stake_space_left_right"
            android:layout_marginTop="@dimen/keyboard_stake_space"
            android:layout_marginBottom="@dimen/keyboard_stake_space"
            android:maxLines="1"
            android:layout_weight="1"
            app:autoSizeMaxTextSize="14dp"
            app:autoSizeMinTextSize="11dp"
            app:autoSizeStepGranularity="1dp"
            app:autoSizeTextType="uniform"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/default_stake_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/keyboard_stake_space_left_right"
            android:paddingEnd="@dimen/keyboard_stake_space_left_right">
            <CheckBox
                android:id="@+id/default_stake_checkbox"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:button="@drawable/ic_check_box_brand_secondary_disable_selector"
                android:layout_marginHorizontal="4dp"/>
            <TextView
                android:textSize="@dimen/keyboard_update_default_stake_text_size"
                android:textColor="@color/text_type2_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/component_betslip__update_default_stake"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/quick_tool_bar_divider"
        android:background="@color/line_type1_secondary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/quick_tool_bar"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        app:layout_constraintEnd_toStartOf="@+id/done"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintHorizontal_weight="0.8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/quick_tool_bar_divider"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/text_color_text_type2_primary"
        android:gravity="center"
        android:id="@+id/done"
        android:background="@drawable/bg_filled_brand_secondary_2_radius_with_brand_secondary_disable"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/common_functions__done"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toBottomOf="@+id/recycler_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="0.2"
        app:layout_constraintStart_toEndOf="@+id/recycler_view"
        app:layout_constraintTop_toTopOf="@+id/recycler_view"/>
</merge>
