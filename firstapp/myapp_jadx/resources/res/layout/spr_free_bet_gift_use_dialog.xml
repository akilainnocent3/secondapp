<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="18dp"
        android:textStyle="bold"
        android:textColor="@color/text_type1_primary"
        android:gravity="center"
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="23dp"
        android:layout_marginRight="20dp"
        android:text="@string/component_coupon__free_bet_amount"/>
    <RelativeLayout
        android:id="@+id/select_free_bet"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="28dp"
        android:layout_marginRight="20dp"
        android:layout_below="@+id/dialog_title">
        <RadioGroup
            android:id="@+id/rg_free_bet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton
                android:textSize="14dp"
                android:textColor="@color/text_type1_primary"
                android:id="@+id/rb_all_free_bet"
                android:background="@color/transparent_white"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:layout_marginBottom="4dp"
                android:checked="true"
                android:button="@null"
                android:text="@string/common_functions__all"
                android:drawableLeft="@drawable/gift_radio_button"
                android:drawablePadding="10dp"
                android:drawableStart="@drawable/gift_radio_button"
                android:letterSpacing="0.01"/>
            <RadioButton
                android:textSize="14dp"
                android:textColor="@color/text_type1_primary"
                android:id="@+id/rb_partial_free_bet"
                android:background="@color/transparent_white"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:button="@null"
                android:text="@string/common_functions__partial"
                android:drawableLeft="@drawable/gift_radio_button"
                android:drawablePadding="10dp"
                android:drawableStart="@drawable/gift_radio_button"
                android:letterSpacing="0.01"/>
        </RadioGroup>
        <TextView
            android:textSize="14dp"
            android:textStyle="normal"
            android:textColor="@color/text_type1_primary"
            android:gravity="center"
            android:id="@+id/tv_value"
            android:paddingRight="6dp"
            android:layout_width="90dp"
            android:layout_height="28dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            android:paddingEnd="6dp"
            android:layout_alignParentEnd="true"/>
        <EditText
            android:textSize="14dp"
            android:textStyle="normal"
            android:textColor="@color/text_type1_primary"
            android:gravity="center"
            android:id="@+id/input_value"
            android:background="@drawable/bg_outlined_text_type1_secondary"
            android:paddingRight="6dp"
            android:layout_width="130dp"
            android:layout_height="28dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:inputType="numberDecimal"
            android:imeOptions="actionDone"
            android:textCursorDrawable="@drawable/spr_cursor"
            android:paddingEnd="6dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/warning_primary"
        android:gravity="end"
        android:id="@+id/tv_error_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_below="@+id/select_free_bet"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/brand_secondary"
        android:gravity="center"
        android:id="@+id/tv_cancel"
        android:background="@drawable/spr_bg_green_rect"
        android:layout_width="114dp"
        android:layout_height="44dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="23dp"
        android:text="@string/common_functions__cancel"
        android:layout_below="@+id/tv_error_msg"
        android:layout_alignParentLeft="true"
        android:layout_marginStart="20dp"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/brand_tertiary"
        android:gravity="center"
        android:id="@+id/tv_confirm"
        android:background="@drawable/bg_filled_brand_secondary_2_radius_with_brand_secondary_disable"
        android:layout_width="114dp"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="23dp"
        android:text="@string/gift__use"
        android:layout_below="@+id/tv_error_msg"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="20dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
