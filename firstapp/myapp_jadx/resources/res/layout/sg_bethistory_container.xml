<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bethistory_main_ll"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/bethistory_container_list_layer"
        android:background="@drawable/redblack_bet_history_bg"
        android:padding="@dimen/_8sdp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.7"
        app:layout_constraintHorizontal_bias="0.487"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.201"
        app:layout_constraintWidth_percent="0.9">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/information_layout"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="10dp">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="0x7f0806e6"
                android:layout_marginStart="4dp"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/white"
                android:id="@+id/information_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:lineHeight="14dp"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bet_history_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_3sdp"
            android:layout_marginBottom="@dimen/_6sdp"
            android:layout_below="@+id/information_layout"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">
            <TextView
                android:textSize="@dimen/_11ssp"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:id="@+id/time_header"
                android:tag="@string/time_cms"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/bet_history_head_time"
                android:textAlignment="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.18"
                style="@style/BetHistoryHeaderTextFontStyle"/>
            <TextView
                android:textSize="@dimen/_11ssp"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:id="@+id/stake_header"
                android:tag="@string/stake_cms"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/bet_history_head_stake"
                android:textAlignment="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/time_header"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.25"
                style="@style/BetHistoryHeaderTextFontStyle"/>
            <TextView
                android:textSize="@dimen/_11ssp"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:id="@+id/status_header"
                android:tag="@string/status_cms"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/bet_history_head_status"
                android:textAlignment="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/stake_header"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.32"
                style="@style/BetHistoryHeaderTextFontStyle"/>
            <TextView
                android:textSize="@dimen/_11ssp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/status_header"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.25"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/_12sdp"
            android:layout_below="@+id/bet_history_header">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center"
                android:id="@+id/no_record_found"
                android:background="@color/dim_black_text_color"
                android:paddingTop="@dimen/_5sdp"
                android:paddingBottom="@dimen/_5sdp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:paddingVertical="@dimen/_5sdp">
                <TextView
                    android:textSize="@dimen/_9ssp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/no_record_text"
                    android:tag="@string/no_history_text_cms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/bet_history_no_record"
                    style="@style/TextPrimaryBold"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/bethistory_container_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <RelativeLayout
            android:id="@+id/loading_data"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true">
            <com.github.ybq.android.spinkit.SpinKitView
                android:id="@+id/spin_kit"
                android:visibility="visible"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_marginLeft="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_35sdp"
                app:SpinKit_Color="@android:color/white"
                style="@style/SpinKitView.Small.DoubleBounce"/>
        </RelativeLayout>
    </RelativeLayout>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/bet_history_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/close"
        app:backgroundTint="@color/white"
        app:fabSize="normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bethistory_container_list_layer"
        app:srcCompat="@drawable/close_icon_white"/>
</androidx.constraintlayout.widget.ConstraintLayout>
