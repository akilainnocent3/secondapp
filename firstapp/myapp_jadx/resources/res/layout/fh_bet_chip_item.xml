<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/percentPadding1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.05"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/chip"
        android:background="@drawable/fh_circle_chips_enable"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/percentPadding1"
        app:layout_constraintWidth_percent="0.8">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivChip"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_7ssp"
            android:textColor="@color/sg_button_text_color"
            android:gravity="center"
            android:id="@+id/tvChip"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:maxLines="1"
            app:fontFamily="@font/motley_forces"
            app:layout_constraintBottom_toBottomOf="@+id/ivChip"
            app:layout_constraintEnd_toEndOf="@+id/ivChip"
            app:layout_constraintStart_toStartOf="@+id/ivChip"
            app:layout_constraintTop_toTopOf="@+id/ivChip"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/percentPadding2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chip"
        app:layout_constraintWidth_percent="0.05"/>
</androidx.constraintlayout.widget.ConstraintLayout>
