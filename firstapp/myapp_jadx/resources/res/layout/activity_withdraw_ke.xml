<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/withdraw_activity_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/title_bar"
        android:background="?attr/colorTitleBar"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/back"
            android:background="?android:attr/selectableItemBackground"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_action_bar_back"
            app:tint="?attr/colorTitleBarTint"/>
        <TextView
            android:textSize="20dp"
            android:textStyle="normal"
            android:textColor="?attr/colorTitleBarText"
            android:gravity="center_vertical"
            android:id="@+id/back_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/page_withdraw__withdrawal"
            android:singleLine="true"
            android:layout_toRightOf="@+id/back"
            android:lineSpacingExtra="8dp"
            android:fontFamily="sans-serif-medium"
            android:layout_toEndOf="@+id/back"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/withdraw_help_center_btn"
            android:background="?android:attr/selectableItemBackground"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="12dp"
            android:layout_toLeftOf="@+id/home"
            android:layout_centerVertical="true"
            app:srcCompat="@drawable/ic_help_outline_black_24dp"
            app:tint="?attr/colorTitleBarTint"/>
        <ImageButton
            android:id="@+id/home"
            android:background="?android:attr/selectableItemBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            app:srcCompat="@drawable/ic_home"
            app:tint="?attr/colorTitleBarTint"/>
    </RelativeLayout>
    <include
        android:id="@+id/draw_grey_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/title_bar"
        layout="@layout/layout_withdraw_block"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/top_container"
        android:background="@drawable/withdraw_pin_hint_text_bg"
        android:paddingTop="11dp"
        android:paddingBottom="11dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/draw_grey_container">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="11dp"
            android:tint="@color/other003"
            android:rotation="180"
            android:layout_marginStart="11dp"
            app:srcCompat="@drawable/ic_info_black_14dp"/>
        <TextView
            android:textSize="12dp"
            android:textStyle="normal"
            android:textColor="@color/text_type1_primary"
            android:layout_gravity="center_vertical"
            android:id="@+id/top_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="11dp"
            android:lineSpacingExtra="2dp"
            android:fontFamily="sans-serif"
            android:layout_marginStart="11dp"/>
    </LinearLayout>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/compose_withdraw_alert_hint"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/top_container"/>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/withdraw_swipe"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/compose_withdraw_alert_hint">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/content_root"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <android.widget.Space
                    android:id="@+id/anchor"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_alignParentTop="true"/>
                <TextView
                    android:textSize="14dp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:id="@+id/payment_to"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="30dp"
                    android:text="@string/page_withdraw__withdraw_to"
                    android:drawablePadding="12dp"
                    android:lineSpacingExtra="6dp"
                    android:fontFamily="sans-serif"/>
                <TextView
                    android:textSize="14dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_primary"
                    android:id="@+id/number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="16dp"
                    android:text="@string/page_withdraw__withdraw_to"
                    android:drawablePadding="12dp"
                    android:layout_alignTop="@+id/payment_to"
                    android:layout_alignParentRight="true"
                    android:lineSpacingExtra="6dp"
                    android:fontFamily="sans-serif"/>
                <ImageView
                    android:id="@+id/momo_telecom_icon"
                    android:layout_width="45dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="4dp"
                    android:layout_toLeftOf="@+id/number"
                    android:layout_alignTop="@+id/number"
                    android:layout_alignBottom="@+id/number"/>
                <TextView
                    android:textSize="12dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_secondary"
                    android:id="@+id/balance_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="48dp"
                    android:layout_marginRight="10dp"
                    android:drawablePadding="6dp"
                    android:layout_toLeftOf="@+id/balance_account"
                    android:layout_below="@+id/number"
                    android:lineSpacingExtra="6dp"
                    android:fontFamily="sans-serif"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/text_secondary"
                    android:gravity="start|center_vertical"
                    android:id="@+id/balance_account"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="16dp"
                    android:text="--"
                    android:layout_below="@+id/anchor"
                    android:layout_alignTop="@+id/balance_info"
                    android:layout_alignParentRight="true"
                    android:lineSpacingExtra="4dp"
                    android:fontFamily="sans-serif"/>
                <RelativeLayout
                    android:gravity="right"
                    android:id="@+id/withdrawable_balance_layout"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="16dp"
                    android:layout_below="@+id/balance_info">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/withdrawable_balance_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="8dp"
                        android:tint="@color/text_primary"
                        android:minHeight="19dp"
                        android:layout_centerVertical="true"
                        app:srcCompat="@drawable/ic_help_outline_black_19dp"/>
                    <TextView
                        android:textSize="12dp"
                        android:textStyle="normal"
                        android:textColor="@color/text_primary"
                        android:gravity="center"
                        android:id="@+id/withdrawable_balance_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:minHeight="19dp"
                        android:layout_toRightOf="@+id/withdrawable_balance_hint"
                        android:layout_centerVertical="true"
                        android:fontFamily="sans-serif"/>
                    <TextView
                        android:textSize="12dp"
                        android:textStyle="normal"
                        android:textColor="@color/text_primary"
                        android:gravity="center"
                        android:id="@+id/withdrawable_balance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="19dp"
                        android:text="--"
                        android:layout_toRightOf="@+id/withdrawable_balance_label"
                        android:layout_centerVertical="true"
                        android:fontFamily="sans-serif"/>
                </RelativeLayout>
                <FrameLayout
                    android:id="@+id/edit_container"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="16dp"
                    android:layout_below="@+id/withdrawable_balance_layout">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="33dp"
                        android:layout_marginLeft="116dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginRight="6dp"
                        android:layout_marginBottom="5dp"/>
                    <com.sporty.android.common_ui.widgets.ClearEditText
                        android:textAppearance="@style/B1_R"
                        android:gravity="center"
                        android:id="@+id/amount_edit_text"
                        android:background="@drawable/bg_outlined_line_type1_secondary_2_radius"
                        android:paddingLeft="110dp"
                        android:paddingRight="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:maxLines="1"
                        android:maxLength="18"
                        android:inputType="numberDecimal"
                        android:imeOptions="actionDone"
                        app:cancalDrawableSize="16dp"/>
                    <TextView
                        android:textStyle="normal"
                        android:textColor="@color/text_primary"
                        android:gravity="center_vertical"
                        android:id="@+id/withdraw_amount_text"
                        android:paddingLeft="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/common_functions__amount"
                        android:lineSpacingExtra="4dp"/>
                </FrameLayout>
                <TextView
                    android:textAppearance="@style/ErrorTextView"
                    android:textSize="12dp"
                    android:textStyle="normal"
                    android:textColor="#e63442"
                    android:id="@+id/error"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_below="@+id/edit_container"
                    android:layout_alignLeft="@+id/edit_container"
                    android:layout_alignRight="@+id/edit_container"
                    android:lineSpacingExtra="4dp"
                    android:fontFamily="sans-serif"/>
                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/compose_order_container"
                    android:background="@color/transparent"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="30dp"
                    android:layout_below="@+id/error"
                    android:layout_alignLeft="@+id/edit_container"/>
                <TextView
                    android:textSize="16dp"
                    android:textColor="@color/withdraw_button_text_color"
                    android:gravity="center"
                    android:id="@+id/withdraw_btn"
                    android:background="@drawable/bg_filled_brand_secondary_2_radius_with_brand_secondary_disable"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginRight="16dp"
                    android:text="@string/common_functions__withdraw"
                    android:layout_below="@+id/compose_order_container"
                    android:textAllCaps="false"
                    android:fontFamily="sans-serif"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/description_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="30dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginRight="30dp"
                    android:layout_below="@+id/withdraw_btn"/>
                <com.sporty.android.common_ui.widgets.AspectRatioImageView
                    android:id="@+id/withdraw_banner"
                    android:background="@android:color/white"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="40dp"
                    android:layout_marginBottom="20dp"
                    android:scaleType="fitXY"
                    android:layout_below="@+id/description_container"/>
            </RelativeLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <com.sporty.android.common_ui.widgets.LoadingViewNew
        android:id="@+id/loading"
        android:background="@color/background_type1_secondary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/compose_withdraw_alert_hint"/>
</RelativeLayout>
