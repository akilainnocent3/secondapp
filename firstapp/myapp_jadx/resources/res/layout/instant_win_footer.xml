<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/top_line"
        android:background="@color/line_type1_primary"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="16dp"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/text_type2_primary"
        android:id="@+id/over_max_stake_msg"
        android:background="@color/background_notice"
        android:paddingLeft="16dp"
        android:paddingTop="5dp"
        android:paddingRight="16dp"
        android:paddingBottom="5dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/top_line"/>
    <com.sportybet.android.instantwin.presentation.widget.InstantWinMultipleBetBonusHint
        android:id="@+id/multiplebet_bonus_hint"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:layout_below="@+id/over_max_stake_msg"/>
    <com.sportybet.android.virtual.presentation.widget.StakeItemLayout
        android:orientation="horizontal"
        android:id="@+id/stake_per_bet_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:layout_below="@+id/multiplebet_bonus_hint"/>
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/sporty_insure"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_below="@+id/stake_per_bet_layout"
        app:alignItems="center"
        app:flexWrap="wrap">
        <TextView
            android:textSize="@dimen/insure_text_size"
            android:textStyle="bold"
            android:textColor="@color/brand_tertiary"
            android:id="@+id/sporty_insure_title"
            android:paddingLeft="16dp"
            android:paddingTop="2dp"
            android:paddingRight="16dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/component_betslip__sporty_insure"
            android:paddingHorizontal="16dp"
            android:paddingVertical="2dp"/>
        <ImageView
            android:id="@+id/flexibet_help"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="centerInside"
            android:minWidth="30dp"
            android:minHeight="30dp"
            app:srcCompat="@drawable/ic_icon_information"
            app:tint="@color/brand_secondary_disable"/>
        <LinearLayout
            android:gravity="end"
            android:id="@+id/check_box_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:layout_flexGrow="1">
            <CheckBox
                android:textSize="@dimen/insure_text_size"
                android:textColor="@color/text_color_custom_text_type1_primary_type4_with_brand_secondary_disable"
                android:id="@+id/flexible_check_box"
                android:paddingLeft="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@drawable/ic_check_box_custom_brand_secondary_type1_24dp"
                android:minHeight="16dp"
                android:text="@string/component_betslip__flexible"
                android:drawableLeft="@drawable/flexiable_bet_flag"
                android:drawablePadding="2dp"
                android:layout_marginEnd="8dp"/>
            <CheckBox
                android:textSize="@dimen/insure_text_size"
                android:textColor="@color/text_color_custom_text_type1_primary_type4_with_brand_secondary_disable"
                android:id="@+id/one_cut_check_box"
                android:paddingLeft="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/insure_one_bet_margin_right"
                android:button="@drawable/ic_check_box_custom_brand_secondary_type1_24dp"
                android:minHeight="16dp"
                android:text="@string/component_betslip__one_cut"
                android:drawableLeft="@drawable/ic_one_cut"
                android:drawablePadding="2dp"/>
        </LinearLayout>
        <com.sportybet.plugin.realsports.betslip.widget.IndicatorLayout
            android:id="@+id/indicator_layout"
            android:paddingTop="16dp"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.google.android.flexbox.FlexboxLayout>
    <RelativeLayout
        android:id="@+id/flex_control_panel"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_below="@+id/sporty_insure">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_type1_primary"
            android:id="@+id/flex_bet_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="3dp"
            android:text="@string/component_betslip__options_to_be_correct"
            android:layout_alignParentLeft="true"
            android:fontFamily="sans-serif-medium"/>
        <com.sportybet.android.widget.ArrowButton
            android:id="@+id/arrow_up"
            android:background="@drawable/spr_arrow_background"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginRight="16dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            app:upArrow="true"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/absolute_type2"
            android:gravity="center"
            android:id="@+id/flexibet_num"
            android:background="@color/background_general_primary"
            android:layout_width="60dp"
            android:layout_height="32dp"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:singleLine="false"
            android:layout_toLeftOf="@+id/arrow_up"
            android:layout_alignParentTop="true"/>
        <com.sportybet.android.widget.ArrowButton
            android:id="@+id/arrow_down"
            android:background="@drawable/spr_arrow_background"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_toLeftOf="@+id/flexibet_num"
            android:layout_alignParentTop="true"
            app:upArrow="false"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="italic"
            android:textColor="@color/text_type1_secondary"
            android:gravity="left"
            android:id="@+id/flex_bet_hint"
            android:paddingTop="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="@string/component_betslip__flexibet_change"
            android:maxLines="2"
            android:layout_below="@+id/flex_bet_text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
    </RelativeLayout>
    <TextView
        android:textSize="14dp"
        android:textStyle="italic"
        android:textColor="@color/text_type1_secondary"
        android:id="@+id/one_cut_hint"
        android:paddingLeft="16dp"
        android:paddingTop="8dp"
        android:paddingRight="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_below="@+id/flex_control_panel"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_secondary"
        android:id="@+id/flex_error_msg"
        android:paddingLeft="16dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/component_betslip__feature_is_invalid_for_less_valid_selections"
        android:layout_below="@+id/one_cut_hint"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/system_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/flex_error_msg"/>
    <View
        android:id="@+id/line"
        android:background="@color/line_type1_secondary"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="13dp"
        android:layout_below="@+id/system_layout"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/text_type2_primary"
        android:id="@+id/over_max_stake_msg_for_system"
        android:background="@color/background_notice"
        android:paddingLeft="16dp"
        android:paddingTop="5dp"
        android:paddingRight="16dp"
        android:paddingBottom="5dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/line"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/total_stake_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="6dp"
        android:layout_below="@+id/over_max_stake_msg_for_system">
        <TextView
            android:textSize="14dp"
            android:textStyle="normal"
            android:textColor="@color/text_type1_tertiary"
            android:gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common_functions__total_stake"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="normal"
            android:textColor="@color/text_type1_tertiary"
            android:gravity="end"
            android:id="@+id/total_stake_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/total_odds_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="6dp"
        android:layout_below="@+id/total_stake_layout">
        <TextView
            android:textSize="14dp"
            android:textStyle="normal"
            android:textColor="@color/text_type1_tertiary"
            android:gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common_functions__total_odds"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="normal"
            android:textColor="@color/text_type1_tertiary"
            android:gravity="end"
            android:id="@+id/total_odds_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/wh_tax_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="6dp"
        android:layout_below="@+id/total_odds_layout">
        <TextView
            android:textSize="14dp"
            android:textStyle="normal"
            android:textColor="@color/text_type1_primary"
            android:gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bet_history__wh_tax"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="normal"
            android:textColor="@color/text_type1_primary"
            android:gravity="end"
            android:id="@+id/wh_tax_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/excise_tax_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="6dp"
        android:layout_below="@+id/wh_tax_layout">
        <TextView
            android:textSize="14dp"
            android:textStyle="normal"
            android:textColor="@color/text_type1_primary"
            android:gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common_functions__excise_tax"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="normal"
            android:textColor="@color/text_type1_primary"
            android:gravity="end"
            android:id="@+id/excise_tax_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bonus_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="6dp"
        android:layout_below="@+id/excise_tax_layout">
        <TextView
            android:textSize="14dp"
            android:textStyle="normal"
            android:textColor="@color/text_type1_tertiary"
            android:gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bet_history__max_bonus"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="normal"
            android:textColor="@color/text_type1_tertiary"
            android:gravity="end"
            android:id="@+id/bonus_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/potentail_win_layout"
        android:background="@color/custom_brand_secondary_variable_type1_opacity_type2"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="8dp"
        android:layout_below="@+id/bonus_layout">
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/text_type1_tertiary"
            android:gravity="center_horizontal"
            android:id="@+id/potential_win_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/component_betslip__to_win"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/text_type1_tertiary"
            android:gravity="end"
            android:id="@+id/potentail_win_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/one_cut_still_win_container"
        android:background="@color/custom_brand_secondary_variable_type1_opacity_type2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="8dp"
        android:layout_below="@+id/potentail_win_layout">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/text_type1_tertiary"
            android:id="@+id/one_cut_still_win_label"
            android:paddingLeft="8dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common_functions__one_cut_win"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:fontFamily="sans-serif-medium"
            app:drawableLeftCompat="@drawable/ic_one_cut_active"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/text_type1_tertiary"
            android:id="@+id/one_cut_still_win"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:text="@string/app_common__zero_point_zero"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/gifts_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:minHeight="20dp"
        android:layout_below="@+id/one_cut_still_win_container">
        <TextView
            android:textSize="14dp"
            android:textStyle="normal"
            android:textColor="@color/text_type1_primary"
            android:gravity="center_vertical"
            android:id="@+id/gifts_label"
            android:paddingLeft="16dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="26dp"
            android:text="@string/component_coupon__choose_gifts_2"
            android:layout_alignParentLeft="true"
            android:fontFamily="sans-serif-medium"/>
        <ImageView
            android:visibility="visible"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginRight="13dp"
            android:layout_toLeftOf="@+id/gifts"
            android:layout_centerVertical="true"
            app:srcCompat="@drawable/ic__gift"
            app:tint="@color/icon_brand_sub_primary_d_lighter"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="normal"
            android:textColor="#0d9737"
            android:gravity="center_vertical"
            android:id="@+id/gifts"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:minHeight="26dp"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <com.sportybet.android.widget.BubbleView
        android:id="@+id/flexipop"
        android:visibility="gone"
        android:layout_width="279dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/sporty_insure"
        android:layout_marginStart="24dp"
        app:closable="true"
        app:descriptionVisibility="false"
        app:title="@string/component_betslip__one_match_cutting_tips"
        app:trianglePosition="top_left"/>
</RelativeLayout>
