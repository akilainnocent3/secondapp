<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/title_bar"
        android:background="?attr/colorTitleBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/goback"
            android:background="?android:attr/selectableItemBackground"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_action_bar_back"
            app:tint="?attr/colorTitleBarTint"/>
        <TextView
            android:textSize="20dp"
            android:textStyle="normal"
            android:textColor="?attr/colorTitleBarText"
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common_functions__details"
            android:maxLines="1"
            android:layout_toRightOf="@+id/goback"
            android:layout_centerVertical="true"
            android:lineSpacingExtra="8dp"
            android:fontFamily="sans-serif-medium"/>
        <ImageButton
            android:id="@+id/home_icon"
            android:background="?android:attr/selectableItemBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            app:srcCompat="@drawable/ic_home"
            app:tint="?attr/colorTitleBarTint"/>
    </RelativeLayout>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.Guideline
                    android:orientation="vertical"
                    android:id="@+id/guideline_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintGuide_begin="16dp"/>
                <androidx.constraintlayout.widget.Guideline
                    android:orientation="vertical"
                    android:id="@+id/guideline_end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintGuide_end="16dp"/>
                <include
                    android:id="@+id/trans_details_grey_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/layout_withdraw_block"/>
                <com.sportybet.android.widget.HintView
                    android:id="@+id/hint_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintText="@string/wap_me__due_to_the_abnormal_match_data_settlement_tip"
                    app:layout_constraintTop_toBottomOf="@+id/trans_details_grey_container"/>
                <View
                    android:id="@+id/line"
                    android:background="@color/line_type1_primary"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginLeft="18dp"
                    android:layout_marginTop="9dp"
                    android:layout_marginRight="17dp"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="17dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/hint_view"/>
                <TextView
                    android:textSize="14dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="center"
                    android:id="@+id/amount_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:fontFamily="sans-serif"
                    app:layout_constraintStart_toStartOf="@+id/guideline_start"
                    app:layout_constraintTop_toBottomOf="@+id/line"/>
                <TextView
                    android:textSize="14dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/fee_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="@string/common_functions__additional_fee"
                    android:fontFamily="sans-serif"
                    app:layout_constraintStart_toStartOf="@+id/guideline_start"
                    app:layout_constraintTop_toBottomOf="@+id/amount_label"/>
                <TextView
                    android:textSize="16dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_secondary"
                    android:id="@+id/amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    app:layout_constraintEnd_toEndOf="@+id/guideline_end"
                    app:layout_constraintTop_toTopOf="@+id/amount_label"/>
                <TextView
                    android:textSize="16dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_secondary"
                    android:id="@+id/fee"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    app:layout_constraintEnd_toEndOf="@+id/guideline_end"
                    app:layout_constraintTop_toTopOf="@+id/fee_label"/>
                <View
                    android:id="@+id/line2"
                    android:background="@color/line_type1_primary"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="19dp"
                    app:layout_constraintLeft_toLeftOf="@+id/line"
                    app:layout_constraintRight_toRightOf="@+id/line"
                    app:layout_constraintTop_toBottomOf="@+id/fee"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/winning_tax_layout"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="@+id/guideline_end"
                    app:layout_constraintStart_toStartOf="@+id/guideline_start"
                    app:layout_constraintTop_toBottomOf="@+id/line2">
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="normal"
                        android:textColor="@color/text_type1_primary"
                        android:id="@+id/winnings_tax_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="@string/page_transaction__winnings_tax"
                        android:fontFamily="sans-serif"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="normal"
                        android:textColor="@color/text_type1_primary"
                        android:id="@+id/winnings_tax_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/winnings_tax_label"/>
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="normal"
                        android:textColor="@color/brand_quaternary"
                        android:id="@+id/net_payout_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="@string/page_transaction__net_payout"
                        android:fontFamily="sans-serif"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/winnings_tax_label"/>
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="normal"
                        android:textColor="@color/brand_quaternary"
                        android:id="@+id/net_payout_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/net_payout_label"/>
                    <View
                        android:background="@color/line_type1_primary"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginTop="15dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/net_payout_amount"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/manual_hint"
                    android:background="@color/background_type1_primary"
                    android:padding="8dp"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:layout_constraintEnd_toEndOf="@+id/guideline_end"
                    app:layout_constraintStart_toStartOf="@+id/guideline_start"
                    app:layout_constraintTop_toBottomOf="@+id/winning_tax_layout">
                    <TextView
                        android:textColor="@color/text_type1_tertiary"
                        android:id="@+id/manual_hint_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"/>
                    <TextView
                        android:id="@+id/manual_hint_btn"
                        android:paddingLeft="0dp"
                        android:paddingTop="6dp"
                        android:paddingRight="0dp"
                        android:paddingBottom="6dp"
                        android:layout_width="88dp"
                        android:layout_height="wrap_content"
                        android:text="@string/app_common__update_now"
                        android:paddingHorizontal="0dp"
                        android:paddingVertical="6dp"
                        style="@style/Widget.App.CommonButton.Contained.Small"/>
                </LinearLayout>
                <TextView
                    android:textSize="13dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_secondary"
                    android:id="@+id/combinations_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/common_functions__status"
                    android:fontFamily="sans-serif"
                    app:layout_constraintStart_toStartOf="@+id/guideline_start"
                    app:layout_constraintTop_toBottomOf="@+id/manual_hint"/>
                <TextView
                    android:textSize="13dp"
                    android:textStyle="normal"
                    android:textColor="@color/warning_primary"
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintEnd_toEndOf="@+id/guideline_end"
                    app:layout_constraintTop_toTopOf="@+id/combinations_label"/>
                <TextView
                    android:textSize="10dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_secondary"
                    android:gravity="center"
                    android:id="@+id/reason"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="28dp"
                    android:lineSpacingExtra="6.8dp"
                    android:fontFamily="sans-serif"
                    app:layout_constraintEnd_toEndOf="@+id/guideline_end"
                    app:layout_constraintStart_toStartOf="@+id/guideline_start"
                    app:layout_constraintTop_toBottomOf="@+id/status"/>
                <TextView
                    android:textSize="13dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_secondary"
                    android:id="@+id/time_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/common_functions__time"
                    android:fontFamily="sans-serif"
                    app:layout_constraintStart_toStartOf="@+id/guideline_start"
                    app:layout_constraintTop_toBottomOf="@+id/reason"/>
                <TextView
                    android:textSize="13dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_secondary"
                    android:id="@+id/type_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="0dp"
                    android:layout_marginTop="20dp"
                    android:text="@string/common_functions__type"
                    android:fontFamily="sans-serif"
                    app:layout_constraintStart_toStartOf="@+id/guideline_start"
                    app:layout_constraintTop_toBottomOf="@+id/time_label"/>
                <TextView
                    android:textSize="13dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_secondary"
                    android:id="@+id/recipient_label"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="0dp"
                    android:layout_marginTop="20dp"
                    android:text="@string/page_transaction__transfer_to"
                    android:fontFamily="sans-serif"
                    app:layout_constraintStart_toStartOf="@+id/guideline_start"
                    app:layout_constraintTop_toBottomOf="@+id/type_label"/>
                <TextView
                    android:textSize="13dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    app:layout_constraintEnd_toEndOf="@+id/guideline_end"
                    app:layout_constraintTop_toTopOf="@+id/time_label"/>
                <TextView
                    android:textSize="13dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    app:layout_constraintEnd_toEndOf="@+id/guideline_end"
                    app:layout_constraintTop_toTopOf="@+id/type_label"/>
                <TextView
                    android:textSize="13dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/recipient"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    app:layout_constraintEnd_toEndOf="@+id/guideline_end"
                    app:layout_constraintTop_toTopOf="@+id/recipient_label"/>
                <TextView
                    android:textSize="13dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_secondary"
                    android:id="@+id/tx_source_target_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/page_transaction__deposit_from"
                    android:fontFamily="sans-serif"
                    app:layout_constraintStart_toStartOf="@+id/guideline_start"
                    app:layout_constraintTop_toBottomOf="@+id/recipient_label"/>
                <TextView
                    android:textSize="13dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="right"
                    android:id="@+id/tx_source_target"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:fontFamily="sans-serif"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintLeft_toRightOf="@+id/tx_source_target_label"
                    app:layout_constraintRight_toLeftOf="@+id/guideline_end"
                    app:layout_constraintTop_toTopOf="@+id/tx_source_target_label"/>
                <androidx.constraintlayout.widget.Barrier
                    android:id="@+id/from_barrier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:barrierDirection="bottom"
                    app:constraint_referenced_ids="tx_source_target_label,tx_source_target"/>
                <TextView
                    android:textSize="13dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="right"
                    android:id="@+id/trade"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:fontFamily="sans-serif"
                    app:layout_constraintEnd_toEndOf="@+id/guideline_end"
                    app:layout_constraintStart_toEndOf="@+id/trade_no_label"
                    app:layout_constraintTop_toTopOf="@+id/trade_no_label"/>
                <TextView
                    android:textSize="13dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/order"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:layout_marginRight="0dp"
                    android:fontFamily="sans-serif"
                    app:layout_constraintEnd_toEndOf="@+id/guideline_end"
                    app:layout_constraintTop_toTopOf="@+id/order_label"/>
                <TextView
                    android:textSize="13dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_secondary"
                    android:id="@+id/trade_no_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/page_transaction__trade_no"
                    android:fontFamily="sans-serif"
                    app:layout_constraintStart_toStartOf="@+id/guideline_start"
                    app:layout_constraintTop_toBottomOf="@+id/from_barrier"/>
                <TextView
                    android:textSize="13dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_secondary"
                    android:id="@+id/order_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/page_transaction__ticket_id"
                    android:fontFamily="sans-serif"
                    app:layout_constraintStart_toStartOf="@+id/guideline_start"
                    app:layout_constraintTop_toBottomOf="@+id/trade_no_label"/>
                <TextView
                    android:textSize="13dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_secondary"
                    android:id="@+id/trans_no_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/page_transaction__transaction_no"
                    android:fontFamily="sans-serif"
                    app:layout_constraintStart_toStartOf="@+id/guideline_start"
                    app:layout_constraintTop_toBottomOf="@+id/order_label"/>
                <TextView
                    android:textSize="13dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="right"
                    android:id="@+id/transaction"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:fontFamily="sans-serif"
                    app:layout_constraintEnd_toEndOf="@+id/guideline_end"
                    app:layout_constraintStart_toEndOf="@+id/trans_no_label"
                    app:layout_constraintTop_toTopOf="@+id/trans_no_label"/>
                <TextView
                    android:textSize="13dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_secondary"
                    android:id="@+id/session_label"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/page_transaction__session_id"
                    android:fontFamily="sans-serif"
                    app:layout_constraintStart_toStartOf="@+id/guideline_start"
                    app:layout_constraintTop_toBottomOf="@+id/trans_no_label"/>
                <TextView
                    android:textSize="13dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/session_id"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    app:layout_constraintEnd_toEndOf="@+id/guideline_end"
                    app:layout_constraintTop_toTopOf="@+id/session_label"/>
                <TextView
                    android:textSize="13dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_secondary"
                    android:id="@+id/balance_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/page_transaction__balance"
                    android:fontFamily="sans-serif"
                    app:layout_constraintStart_toStartOf="@+id/guideline_start"
                    app:layout_constraintTop_toBottomOf="@+id/session_label"/>
                <TextView
                    android:textSize="13dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/balance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:fontFamily="sans-serif"
                    app:layout_constraintEnd_toEndOf="@+id/guideline_end"
                    app:layout_constraintTop_toTopOf="@+id/balance_label"/>
                <TextView
                    android:textSize="13dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_secondary"
                    android:id="@+id/initial_balance_label"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/page_transaction__initial_balance"
                    android:fontFamily="sans-serif"
                    app:layout_constraintStart_toStartOf="@+id/guideline_start"
                    app:layout_constraintTop_toBottomOf="@+id/balance_label"/>
                <TextView
                    android:textSize="13dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/initial_balance_content"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:fontFamily="sans-serif"
                    app:layout_constraintEnd_toEndOf="@+id/guideline_end"
                    app:layout_constraintTop_toTopOf="@+id/initial_balance_label"/>
                <TextView
                    android:textSize="13sp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_secondary"
                    android:id="@+id/barcode_label"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/page_transaction__deposit_qr_code"
                    android:layout_below="@+id/initial_balance_label"
                    android:fontFamily="sans-serif"
                    app:layout_constraintStart_toStartOf="@+id/guideline_start"
                    app:layout_constraintTop_toBottomOf="@+id/initial_balance_label"/>
                <TextView
                    android:id="@+id/barcode_btn"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:text="@string/common_functions__view"
                    android:layout_alignTop="@+id/barcode_label"
                    android:paddingHorizontal="12dp"
                    app:layout_constraintBottom_toBottomOf="@+id/barcode_label"
                    app:layout_constraintEnd_toEndOf="@+id/guideline_end"
                    app:layout_constraintTop_toTopOf="@+id/barcode_label"
                    style="@style/Widget.App.CommonButton.Contained.Small"/>
                <RelativeLayout
                    android:id="@+id/rollback_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintTop_toBottomOf="@+id/barcode_btn">
                    <View
                        android:id="@+id/diver_line"
                        android:background="@color/line_type1_primary"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginLeft="-4dp"
                        android:layout_marginRight="-4dp"/>
                    <TextView
                        android:textSize="14dp"
                        android:textStyle="normal"
                        android:textColor="@color/text_type1_secondary"
                        android:gravity="center_horizontal"
                        android:id="@+id/rollback_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="@string/page_transaction__rollback_details"
                        android:layout_below="@+id/diver_line"
                        android:fontFamily="sans-serif"/>
                    <TextView
                        android:textSize="14dp"
                        android:textStyle="normal"
                        android:textColor="@color/text_type1_secondary"
                        android:id="@+id/game_id_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/page_transaction__game_id"
                        android:layout_below="@+id/rollback_title"
                        android:lineSpacingExtra="12dp"
                        android:fontFamily="sans-serif"/>
                    <TextView
                        android:textSize="14dp"
                        android:textStyle="normal"
                        android:textColor="@color/text_type1_primary"
                        android:gravity="end"
                        android:id="@+id/game_id"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
