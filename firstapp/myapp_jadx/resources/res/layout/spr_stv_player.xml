<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/live_event_score_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/spr_live_event_score"/>
    <com.sporty.android.common_ui.widgets.AspectRatioFrameLayout
        android:id="@+id/player_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/live_event_score_container">
        <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:controller_layout_id="@layout/exo_playback_control_view"/>
        <WebView
            android:id="@+id/web_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.sportybet.plugin.realsports.widget.EPLStreamingMentionView
            android:id="@+id/epl_streaming_mention_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"/>
    </com.sporty.android.common_ui.widgets.AspectRatioFrameLayout>
    <ImageView
        android:id="@+id/channel_switch"
        android:visibility="invisible"
        android:layout_width="38dp"
        android:layout_height="36dp"
        android:layout_marginTop="15dp"
        android:src="@drawable/ig_switch"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/live_event_score_container"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#e6ffffff"
        android:id="@+id/channel_switch_hint"
        android:background="@color/background_type2_primary"
        android:paddingLeft="6dp"
        android:paddingTop="4dp"
        android:paddingRight="6dp"
        android:paddingBottom="4dp"
        android:visibility="invisible"
        android:layout_width="210dp"
        android:layout_height="36dp"
        android:layout_marginTop="15dp"
        android:text="if the live stream isn&apos;t for this match,\10 click here to try other channels!"
        android:paddingHorizontal="6dp"
        android:paddingVertical="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/live_event_score_container"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/channels_container"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="15dp"
        android:layout_alignParentRight="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/live_event_score_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
