<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_gravity="center"
        android:id="@+id/fav_img_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_64sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/fav_error_image"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_100sdp"
            android:src="0x7f0805a0"/>
    </RelativeLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/_13sdp"
        android:gravity="center"
        android:id="@+id/fav_error_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No Favourites"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fav_img_layout"
        style="@style/TextSecondaryBold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/fav_error_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_4sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fav_error_title"
        style="@style/TextSecondaryRegular"/>
    <androidx.appcompat.widget.AppCompatButton
        android:gravity="center"
        android:id="@+id/fav_retry_button"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_24sdp"
        android:minWidth="@dimen/_120sdp"
        android:text="@string/retry"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fav_error_txt"
        style="@style/ButtonBold"/>
</androidx.constraintlayout.widget.ConstraintLayout>
