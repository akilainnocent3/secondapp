<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_type1_quaternary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/title_bar"
        android:background="?attr/colorTitleBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageButton
            android:id="@+id/back_icon"
            android:background="?android:attr/selectableItemBackground"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_action_bar_back"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="normal"
            android:textColor="?attr/colorTitleBarText"
            android:gravity="center_vertical"
            android:id="@+id/back_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/wap_setting__navbar_title"
            android:singleLine="true"
            android:layout_toRightOf="@+id/back_icon"
            android:lineSpacingExtra="8sp"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/back_icon"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageButton
            android:id="@+id/home"
            android:background="?android:attr/selectableItemBackground"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_home"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ScrollView
        android:id="@+id/scroll_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/text_type1_primary"
                android:gravity="center_vertical"
                android:id="@+id/profile"
                android:background="?android:attr/selectableItemBackground"
                android:paddingLeft="16dp"
                android:paddingRight="10dp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/wap_profile__navbar_title"
                android:drawablePadding="20dp"
                android:paddingStart="16dp"
                android:paddingEnd="10dp"
                app:drawableEndCompat="@drawable/ic_keyboard_arrow_right_black_24dp"
                app:drawableTint="@color/text_type1_secondary"/>
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/account_insights_compose_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <View
                android:background="@color/background_type1_primary"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/settings_dark_mode_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="center_vertical"
                    android:id="@+id/dark_mode"
                    android:background="@color/background_type1_primary"
                    android:paddingLeft="16dp"
                    android:paddingRight="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/wap_setting__dark_mode"
                    android:drawablePadding="20dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="10dp"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="center_vertical"
                    android:id="@+id/dark_mode_on"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/wap_setting__on"
                    android:paddingStart="16dp"
                    android:paddingEnd="14dp"
                    app:drawableEndCompat="@drawable/ic_radio_btn"/>
                <View
                    android:id="@+id/dark_mode_on_divider"
                    android:background="@color/background_type1_primary"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="center_vertical"
                    android:id="@+id/dark_mode_off"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/wap_setting__off"
                    android:paddingStart="16dp"
                    android:paddingEnd="14dp"
                    app:drawableEndCompat="@drawable/ic_radio_btn"/>
                <View
                    android:id="@+id/dark_mode_off_divider"
                    android:background="@color/background_type1_primary"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="center_vertical"
                    android:id="@+id/dark_mode_system"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/wap_setting__follow_system_settings"
                    android:paddingStart="16dp"
                    android:paddingEnd="14dp"
                    app:drawableEndCompat="@drawable/ic_radio_btn_selected"/>
                <View
                    android:id="@+id/dark_mode_system_divider"
                    android:background="@color/background_type1_primary"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>
            </LinearLayout>
            <TextView
                android:textSize="12dp"
                android:textStyle="bold"
                android:textColor="@color/text_type1_primary"
                android:gravity="center_vertical"
                android:id="@+id/preference"
                android:background="@color/background_type1_primary"
                android:paddingLeft="16dp"
                android:paddingRight="10dp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/wap_setting__preference"
                android:drawablePadding="20dp"
                android:paddingStart="16dp"
                android:paddingEnd="10dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/text_type1_primary"
                android:gravity="center_vertical"
                android:id="@+id/popovers"
                android:paddingLeft="16dp"
                android:paddingRight="10dp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/wap_setting__popovers"
                android:drawablePadding="20dp"
                android:paddingStart="16dp"
                android:paddingEnd="10dp"
                app:drawableEndCompat="@drawable/ic_keyboard_arrow_right_black_24dp"
                app:drawableTint="@color/text_type1_secondary"/>
            <View
                android:id="@+id/popovers_divider"
                android:background="@color/background_type1_primary"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/text_type1_primary"
                android:gravity="center_vertical"
                android:id="@+id/my_stakes"
                android:paddingLeft="16dp"
                android:paddingRight="10dp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/wap_setting__my_stakes"
                android:drawablePadding="20dp"
                android:paddingStart="16dp"
                android:paddingEnd="10dp"
                app:drawableEndCompat="@drawable/ic_keyboard_arrow_right_black_24dp"
                app:drawableTint="@color/text_type1_secondary"/>
            <View
                android:id="@+id/my_stakes_divider"
                android:background="@color/background_type1_primary"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/text_type1_primary"
                android:gravity="center_vertical"
                android:id="@+id/my_favorite_setting"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/wap_setting__my_favourites_settings"
                android:drawablePadding="20dp"
                android:paddingStart="16dp"
                android:paddingEnd="10dp"
                app:drawableEndCompat="@drawable/ic_keyboard_arrow_right_black_24dp"
                app:drawableTint="@color/text_type1_secondary"/>
            <View
                android:id="@+id/language_preference_divider"
                android:background="@color/background_type1_primary"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/limits_compose_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/select_language_layout"
                android:layout_width="match_parent"
                android:layout_height="48dp">
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="center_vertical"
                    android:id="@+id/language_preference"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingLeft="16dp"
                    android:paddingRight="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/common_functions__language_preference"
                    android:drawablePadding="20dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="10dp"
                    app:drawableEndCompat="@drawable/ic_keyboard_arrow_right_black_24dp"
                    app:drawableTint="@color/text_type1_secondary"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@android:color/white"
                    android:id="@+id/new_icon_language"
                    android:background="@drawable/spr_bg_red_betslip_num"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:text="@string/common_functions__u_new"
                    android:layout_centerVertical="true"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toLeftOf="@+id/language"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/brand_quaternary"
                    android:id="@+id/language"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="32dp"
                    android:text="@string/english"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:id="@+id/odds_format_divider"
                android:background="@color/background_type1_primary"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/odds_format_layout"
                android:layout_width="match_parent"
                android:layout_height="48dp">
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="center_vertical"
                    android:id="@+id/odds_format_preference"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingLeft="16dp"
                    android:paddingRight="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/odds_format__odds_format"
                    android:drawablePadding="20dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="10dp"
                    app:drawableEndCompat="@drawable/ic_keyboard_arrow_right_black_24dp"
                    app:drawableTint="@color/text_type1_secondary"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@android:color/white"
                    android:id="@+id/new_icon_odds_format"
                    android:background="@drawable/spr_bg_red_betslip_num"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:text="@string/common_functions__u_new"
                    android:layout_centerVertical="true"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toLeftOf="@+id/odds_format"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/brand_quaternary"
                    android:id="@+id/odds_format"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="32dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:id="@+id/betslip_customization_top_divider"
                android:background="@color/background_type1_primary"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/text_type1_primary"
                android:gravity="center_vertical"
                android:id="@+id/betslip_customization"
                android:background="?android:attr/selectableItemBackground"
                android:paddingLeft="16dp"
                android:paddingRight="10dp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/page_loyalty__betslip_customization"
                android:drawablePadding="20dp"
                android:paddingStart="16dp"
                android:paddingEnd="10dp"
                app:drawableEndCompat="@drawable/ic_keyboard_arrow_right_black_24dp"
                app:drawableTint="@color/text_type1_secondary"/>
            <View
                android:id="@+id/betslip_customization_divider"
                android:background="@color/background_type1_primary"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/add_widgets_compose_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <View
                android:id="@+id/my_favorite_setting_divider"
                android:background="@color/background_type1_primary"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <TextView
                android:textSize="12dp"
                android:textStyle="bold"
                android:textColor="@color/text_type1_primary"
                android:gravity="center_vertical"
                android:id="@+id/notifications"
                android:background="@color/background_type1_primary"
                android:paddingLeft="16dp"
                android:paddingRight="10dp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/wap_setting__notifications"
                android:drawablePadding="20dp"
                android:paddingStart="16dp"
                android:paddingEnd="10dp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/live_event_notifications_switch"
                android:background="?android:attr/selectableItemBackground"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:textSize="14dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/live_event_notifications_switch_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/wap_setting__live_event_notifications_title"
                    android:fontFamily="sans-serif"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wap_setting__live_event_notifications_content"
                    android:fontFamily="sans-serif"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/live_event_notifications_switch_title"/>
                <ImageView
                    android:id="@+id/live_event_notifications_switch_img"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:src="@drawable/banker_switch_on"
                    android:scaleType="fitXY"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:id="@+id/live_event_notifications_divider"
                android:background="@color/background_type1_primary"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/notification_switch"
                android:background="?android:attr/selectableItemBackground"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:textSize="14dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/notification_switch_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/wap_setting__notification_switch_title"
                    android:fontFamily="sans-serif"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wap_setting__notification_tips"
                    android:fontFamily="sans-serif"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/notification_switch_title"/>
                <ImageView
                    android:id="@+id/notification_switch_img"
                    android:layout_width="31dp"
                    android:layout_height="20dp"
                    android:src="@drawable/cmn_ic_switch_dark_on"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/notification_settings_compose_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="12dp"
                android:textStyle="bold"
                android:textColor="@color/text_type1_primary"
                android:gravity="center_vertical"
                android:id="@+id/responsible_gaming"
                android:background="@color/background_type1_primary"
                android:paddingLeft="16dp"
                android:paddingRight="10dp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/wap_setting__safety_security"
                android:drawablePadding="20dp"
                android:paddingStart="16dp"
                android:paddingEnd="10dp"/>
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/time_alert_compose_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/text_type1_primary"
                android:gravity="center_vertical"
                android:id="@+id/change_pass_word"
                android:background="?android:attr/selectableItemBackground"
                android:paddingLeft="16dp"
                android:paddingRight="10dp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:text="@string/wap_profile__change_password"
                android:drawablePadding="20dp"
                android:paddingStart="16dp"
                android:paddingEnd="10dp"
                app:drawableEndCompat="@drawable/ic_keyboard_arrow_right_black_24dp"
                app:drawableTint="@color/text_type1_secondary"/>
            <View
                android:id="@+id/change_pass_word_divider"
                android:background="@color/background_type1_primary"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="48dp">
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="center_vertical"
                    android:id="@+id/multifactor_authentication"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingLeft="16dp"
                    android:paddingRight="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:text="@string/wap_setting__multifactor_authentication"
                    android:drawablePadding="20dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="10dp"
                    app:drawableEndCompat="@drawable/ic_keyboard_arrow_right_black_24dp"
                    app:drawableTint="@color/text_type1_secondary"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@android:color/white"
                    android:id="@+id/new_icon_multi_factor"
                    android:background="@drawable/spr_bg_red_betslip_num"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="40dp"
                    android:text="@string/common_functions__u_new"
                    android:layout_centerVertical="true"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:id="@+id/multifactor_authentication_divider"
                android:background="@color/background_type1_primary"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/text_type1_primary"
                android:gravity="center_vertical"
                android:id="@+id/playtime_control"
                android:background="?android:attr/selectableItemBackground"
                android:paddingLeft="16dp"
                android:paddingRight="10dp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:text="@string/playtime_control__title"
                android:drawablePadding="20dp"
                android:paddingStart="16dp"
                android:paddingEnd="10dp"
                app:drawableEndCompat="@drawable/ic_keyboard_arrow_right_black_24dp"
                app:drawableTint="@color/text_type1_secondary"/>
            <View
                android:id="@+id/playtime_control_divider"
                android:background="@color/background_type1_primary"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/device_management_layout"
                android:layout_width="match_parent"
                android:layout_height="48dp">
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="center_vertical"
                    android:id="@+id/device_management"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingLeft="16dp"
                    android:paddingRight="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:text="@string/device_management__settings_row_title"
                    android:drawablePadding="20dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="10dp"
                    app:drawableEndCompat="@drawable/ic_keyboard_arrow_right_black_24dp"
                    app:drawableTint="@color/text_type1_secondary"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@android:color/white"
                    android:id="@+id/new_icon_device_management"
                    android:background="@drawable/spr_bg_red_betslip_num"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="40dp"
                    android:text="@string/common_functions__u_new"
                    android:layout_centerVertical="true"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:id="@+id/device_management_divider"
                android:background="@color/background_type1_primary"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/text_type1_primary"
                android:gravity="center_vertical"
                android:id="@+id/account_deactivation"
                android:background="?android:attr/selectableItemBackground"
                android:paddingLeft="16dp"
                android:paddingRight="10dp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:text="@string/common_info_setting__deactivation"
                android:drawablePadding="20dp"
                android:paddingStart="16dp"
                android:paddingEnd="10dp"
                app:drawableEndCompat="@drawable/ic_keyboard_arrow_right_black_24dp"
                app:drawableTint="@color/text_type1_secondary"/>
            <TextView
                android:textSize="12dp"
                android:textStyle="bold"
                android:textColor="@color/text_type1_primary"
                android:gravity="center_vertical"
                android:id="@+id/others"
                android:background="@color/background_type1_primary"
                android:paddingLeft="16dp"
                android:paddingRight="10dp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/wap_setting__others"
                android:drawablePadding="20dp"
                android:paddingStart="16dp"
                android:paddingEnd="10dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/item_change_region"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp">
                    <TextView
                        android:textSize="14dp"
                        android:textColor="@color/text_type1_primary"
                        android:gravity="center_vertical"
                        android:id="@+id/change_region"
                        android:background="?android:attr/selectableItemBackground"
                        android:paddingLeft="16dp"
                        android:paddingRight="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/wap_setting__change_region"
                        android:drawablePadding="20dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="10dp"
                        app:drawableEndCompat="@drawable/ic_keyboard_arrow_right_black_24dp"
                        app:drawableTint="@color/text_type1_secondary"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/brand_quaternary"
                        android:layout_gravity="center"
                        android:id="@+id/country"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="32dp"/>
                </FrameLayout>
                <View
                    android:background="@color/background_type1_primary"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/item_auto_update_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/auto_update_switch"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingLeft="16dp"
                    android:paddingTop="12dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="56dp">
                    <TextView
                        android:textSize="14dp"
                        android:textStyle="normal"
                        android:textColor="@color/text_type1_primary"
                        android:id="@+id/update_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wap_setting__wifi_auto_update_title"
                        android:fontFamily="sans-serif"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="normal"
                        android:textColor="@color/text_type1_secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="40dp"
                        android:text="@string/wap_setting__wifi_auto_update_content"
                        android:fontFamily="sans-serif"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/update_title"/>
                    <ImageView
                        android:id="@+id/update_switch_img"
                        android:layout_width="31dp"
                        android:layout_height="20dp"
                        android:src="@drawable/cmn_ic_switch_dark_off"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <View
                    android:background="@color/background_type1_primary"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/item_footer"
                android:background="#1b1e25"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/compose_footer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
