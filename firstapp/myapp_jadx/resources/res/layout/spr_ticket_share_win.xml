<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/share_c"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintLeft_toLeftOf="parent"
    app:layout_constraintRight_toRightOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/detail_container">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/upper_container"
        android:background="@drawable/ic_bet_share_new"
        android:paddingBottom="4dp"
        android:layout_width="0dp"
        android:layout_height="70dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/share_c_divider_line"
            android:background="@color/line_type2_secondary"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/text_type2_secondary"
            android:id="@+id/show_off_line_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="70dp"
            android:layout_marginTop="16dp"
            android:text="@string/bet_history__congratulations"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/B1_B"/>
        <TextView
            android:textColor="@color/text_type2_secondary"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/show_off_user_name"
            android:paddingRight="4dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="70dp"
            android:maxLines="1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/share"
            app:layout_constraintTop_toBottomOf="@+id/show_off_line_1"
            style="@style/B1_B"/>
        <TextView
            android:textColor="@color/text_type2_secondary"
            android:id="@+id/show_off_line_3"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="70dp"
            android:text="@string/bet_history__you_are_amazing"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/show_off_user_name"
            style="@style/B1_B"/>
        <com.sportybet.android.widget.ProgressButton
            android:textColor="@color/custom_absolute_type2_type3"
            android:id="@+id/share"
            android:background="@drawable/spr_yellow_btn_bg"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginRight="16dp"
            android:text="@string/component_pop_dialog__show_off"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:loadingText=""
            style="@style/Widget.App.ProgressButton.Contained.Medium"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
