<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/howtoplay_main_ll"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:id="@+id/game_limit_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_8sdp"
        app:cardBackgroundColor="@color/color_212121"
        app:cardCornerRadius="@dimen/_6sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.8"
        app:layout_constraintHorizontal_bias="0.487"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.142"
        app:layout_constraintWidth_percent="0.9">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:background="@color/color_212121"
            android:paddingBottom="@dimen/_30sdp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.202"
            app:layout_constraintWidth_percent="0.9">
            <TextView
                android:textSize="@dimen/_16ssp"
                android:gravity="center_horizontal"
                android:id="@+id/game_limit"
                android:tag="@string/game_limit_title_cms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_12ssp"
                android:layout_marginTop="@dimen/_22sdp"
                android:layout_marginRight="@dimen/_12ssp"
                android:text="@string/game_limits"
                android:lineSpacingExtra="2dp"
                android:layout_marginHorizontal="@dimen/_12ssp"
                app:layout_constraintBottom_toTopOf="@+id/min_bet"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextPrimaryBold"/>
            <TextView
                android:textSize="@dimen/_10ssp"
                android:id="@+id/multiplier"
                android:tag="@string/multiplier_text_cms"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_22sdp"
                android:maxLines="1"
                android:lineSpacingExtra="2dp"
                android:autoSizeTextType="uniform"
                app:layout_constraintEnd_toStartOf="@+id/min_bet"
                app:layout_constraintHorizontal_weight="1.6"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/game_limit"
                style="@style/TextPrimaryBold"/>
            <TextView
                android:textSize="@dimen/_10ssp"
                android:gravity="center"
                android:id="@+id/min_bet"
                android:tag="@string/min_bet_cms"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_2sdp"
                android:layout_marginTop="@dimen/_22sdp"
                android:layout_marginRight="@dimen/_2sdp"
                android:lineSpacingExtra="2dp"
                app:layout_constraintEnd_toStartOf="@+id/max_bet"
                app:layout_constraintHorizontal_weight="2"
                app:layout_constraintStart_toEndOf="@+id/multiplier"
                app:layout_constraintTop_toBottomOf="@+id/game_limit"
                style="@style/TextPrimaryBold"/>
            <TextView
                android:textSize="@dimen/_10ssp"
                android:gravity="center"
                android:id="@+id/max_bet"
                android:tag="@string/max_bet_cms"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_22sdp"
                android:layout_marginRight="@dimen/_8sdp"
                android:lineSpacingExtra="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="2.5"
                app:layout_constraintStart_toEndOf="@+id/min_bet"
                app:layout_constraintTop_toBottomOf="@+id/game_limit"
                style="@style/TextPrimaryBold"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/game_limit_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_16sdp"
                android:layout_marginRight="@dimen/_8sdp"
                app:layout_constraintTop_toBottomOf="@+id/max_bet"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/game_limit_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tint="@color/sb_black"
        android:backgroundTint="@color/white"
        app:fabSize="normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/game_limit_container"
        app:srcCompat="@drawable/close_icon_white"/>
</androidx.constraintlayout.widget.ConstraintLayout>
