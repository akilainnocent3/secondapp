<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/title_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp">
        <TextView
            android:textSize="16sp"
            android:textStyle="normal"
            android:textColor="#de000000"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:text="@string/sg_sporty_soccer_introduction"
            android:lineSpacingExtra="8sp"
            android:fontFamily="@font/roboto"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/step_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_below="@+id/title_container">
        <TextView
            android:textSize="14sp"
            android:textStyle="normal"
            android:textColor="#8b000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/sg_sporty_soccer_introduction_msg"
            android:lineSpacingExtra="6sp"
            android:fontFamily="@font/roboto"/>
    </LinearLayout>
    <View
        android:background="#eaecef"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="17dp"
        android:layout_below="@+id/step_details"/>
</RelativeLayout>
