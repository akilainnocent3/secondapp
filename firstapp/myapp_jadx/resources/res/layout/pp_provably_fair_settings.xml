<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:orientation="vertical"
        android:id="@+id/game_limit_container"
        android:paddingBottom="@dimen/_8sdp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/_8sdp"
        app:cardCornerRadius="@dimen/_6sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.62"
        app:layout_constraintHorizontal_bias="0.487"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.172"
        app:layout_constraintWidth_percent="0.93">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:background="@color/pp_setting_bg"
            android:paddingBottom="@dimen/_8sdp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHeight_percent="0.7"
            app:layout_constraintHorizontal_bias="0.487"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.202"
            app:layout_constraintWidth_percent="0.9">
            <TextView
                android:textSize="@dimen/_16ssp"
                android:gravity="center"
                android:id="@+id/text"
                android:tag="@string/provably_fair_settings_small_case_cms"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:text="Provably Fair Settings"
                android:lineSpacingExtra="2dp"
                app:layout_constraintHeight_percent="0.1"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextPrimaryBold"/>
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintHeight_percent="0.9"
                app:layout_constraintTop_toBottomOf="@+id/text">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/_11ssp"
                        android:textColor="@color/pp_text_color_brown"
                        android:id="@+id/provably_fair_text"
                        android:tag="@string/provably_fair_info_cms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_12ssp"
                        android:text="@string/provably_setting_text"
                        android:lineSpacingExtra="2dp"
                        android:justificationMode="inter_word"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TextPrimaryBold"/>
                    <TextView
                        android:textSize="@dimen/_12ssp"
                        android:id="@+id/what_provably"
                        android:tag="@string/what_is_provably_fair_cms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_12ssp"
                        android:text="@string/provably_fair"
                        android:lineSpacingExtra="2dp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/provably_fair_text"
                        style="@style/TextPrimaryBold"/>
                    <View
                        android:id="@+id/view"
                        android:background="@color/pp_brown_divider"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginTop="8sp"
                        android:layout_marginBottom="0x7f0702ae"
                        app:layout_constraintTop_toBottomOf="@+id/what_provably"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/client_seed_image"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_35sdp"
                        android:layout_marginLeft="0x7f0702ae"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:src="@drawable/client_seed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/view"
                        app:layout_constraintWidth_percent="0.2"
                        style="@style/TextPrimaryBold"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_12ssp"
                        android:id="@+id/client_seed_text"
                        android:tag="@string/next_client_seed_cms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:text="Your Next Client Seed"
                        app:layout_constraintStart_toEndOf="@+id/client_seed_image"
                        app:layout_constraintTop_toBottomOf="@+id/view"
                        style="@style/TextPrimaryBold"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:tag="@string/seed_cms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:text=" :"
                        app:layout_constraintStart_toEndOf="@+id/client_seed_text"
                        app:layout_constraintTop_toBottomOf="@+id/view"
                        app:layout_constraintWidth_percent="0.4"
                        style="@style/TextPrimaryBold"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_11ssp"
                        android:textColor="@color/pp_text_color_brown"
                        android:id="@+id/client_seed_sec_text"
                        android:tag="@string/seed_info_cms"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/_4sdp"
                        android:text="@string/client_seed_secondary"
                        android:justificationMode="inter_word"
                        app:layout_constraintLeft_toRightOf="@+id/client_seed_image"
                        app:layout_constraintTop_toBottomOf="@+id/client_seed_text"
                        app:layout_constraintWidth_percent="0.7"
                        style="@style/TextPrimaryBold"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/random_layout"
                        android:background="@drawable/pp_card_fairness"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_12ssp"
                        android:minHeight="@dimen/_48sdp"
                        app:layout_constraintTop_toBottomOf="@+id/client_seed_sec_text">
                        <androidx.appcompat.widget.AppCompatRadioButton
                            android:id="@+id/random_radio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:layout_marginStart="0x7f0702ae"
                            app:backgroundTint="@color/color_db6c31"
                            app:buttonTint="@color/color_db6c31"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/_11ssp"
                            android:textColor="@color/pp_text_color_brown"
                            android:id="@+id/random_text"
                            android:tag="@string/random_cms_new_game_cms"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Random on every new game"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/random_radio"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintWidth_percent="0.7"
                            style="@style/TextPrimaryBold"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/manual_layout"
                        android:background="@drawable/pp_card_fairness"
                        android:paddingBottom="@dimen/_6sdp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_12ssp"
                        android:minHeight="@dimen/_44sdp"
                        app:layout_constraintTop_toBottomOf="@+id/random_layout">
                        <androidx.appcompat.widget.AppCompatRadioButton
                            android:id="@+id/manual_radio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_6sdp"
                            android:checked="true"
                            android:layout_marginStart="0x7f0702ae"
                            app:backgroundTint="@color/color_db6c31"
                            app:buttonTint="@color/color_db6c31"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/_11ssp"
                            android:textColor="@color/pp_text_color_brown"
                            android:id="@+id/manual_text"
                            android:tag="@string/enter_manually_cms"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_16sdp"
                            android:text="Enter manually"
                            app:layout_constraintStart_toEndOf="@+id/manual_radio"
                            app:layout_constraintTop_toTopOf="parent"
                            style="@style/TextPrimaryBold"/>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/current_layout"
                            android:background="@drawable/card_fairness"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="0x7f0702ae"
                            android:minHeight="@dimen/_32sdp"
                            android:layout_marginStart="@dimen/_12ssp"
                            android:layout_marginEnd="@dimen/_12sdp"
                            android:backgroundTint="#1a1a1a"
                            app:layout_constraintTop_toBottomOf="@+id/manual_text">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="@dimen/_11ssp"
                                android:textColor="@color/pp_text_color_brown"
                                android:id="@+id/current_text"
                                android:tag="@string/current_cms"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Current"
                                android:layout_marginStart="0x7f0702ae"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                style="@style/TextPrimaryMedium"/>
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textColor="@color/pp_text_color_brown"
                                android:id="@+id/current_colon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=":"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/current_text"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintWidth_percent="0.4"
                                style="@style/TextPrimaryBold"/>
                            <EditText
                                android:textSize="@dimen/_11ssp"
                                android:id="@+id/current"
                                android:background="@null"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Current"
                                android:inputType="textNoSuggestions"
                                android:layout_marginStart="@dimen/_5sdp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/current_colon"
                                app:layout_constraintTop_toTopOf="parent"
                                style="@style/TextPrimaryMedium"/>
                            <androidx.appcompat.widget.AppCompatImageView
                                android:textSize="@dimen/_12ssp"
                                android:id="@+id/tick"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/tick"
                                android:layout_marginEnd="0x7f0702ae"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                style="@style/TextPrimaryRegular"/>
                            <androidx.appcompat.widget.AppCompatImageView
                                android:textSize="@dimen/_12ssp"
                                android:id="@+id/cross"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/cross_red"
                                android:layout_marginEnd="0x7f0702ae"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/tick"
                                app:layout_constraintTop_toTopOf="parent"
                                style="@style/TextPrimaryRegular"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <View
                        android:id="@+id/view1"
                        android:background="@color/pp_brown_divider"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginTop="8sp"
                        android:layout_marginBottom="0x7f0702ae"
                        app:layout_constraintTop_toBottomOf="@+id/manual_layout"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/server_seed_image"
                        android:layout_width="@dimen/_35sdp"
                        android:layout_height="@dimen/_35sdp"
                        android:layout_marginLeft="@dimen/_14sdp"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:src="@drawable/server_seed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/view1"
                        style="@style/TextPrimaryBold"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_12ssp"
                        android:id="@+id/server_seed_text"
                        android:tag="@string/server_seed_cms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="0x7f0702ae"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:text="Server seed SHA256"
                        app:layout_constraintStart_toEndOf="@+id/server_seed_image"
                        app:layout_constraintTop_toBottomOf="@+id/view1"
                        style="@style/TextPrimaryBold"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:tag="@string/seed_cms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:text=" :"
                        app:layout_constraintStart_toEndOf="@+id/server_seed_text"
                        app:layout_constraintTop_toBottomOf="@+id/view1"
                        app:layout_constraintWidth_percent="0.4"
                        style="@style/TextPrimaryBold"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_11ssp"
                        android:textColor="@color/pp_text_color_brown"
                        android:id="@+id/generated_text"
                        android:tag="@string/settings_generated_on_our_side_cms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="0x7f0702ae"
                        android:text="Generated on our side"
                        app:layout_constraintStart_toEndOf="@+id/server_seed_image"
                        app:layout_constraintTop_toBottomOf="@+id/server_seed_text"
                        style="@style/TextPrimaryBold"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_11ssp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/server_seed"
                        android:background="@drawable/card_fairness"
                        android:paddingLeft="@dimen/_12sdp"
                        android:paddingRight="@dimen/_12sdp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_8sdp"
                        android:minHeight="@dimen/_32sdp"
                        android:maxLines="1"
                        android:backgroundTint="@color/pp_server_seed_bg"
                        app:layout_constraintTop_toBottomOf="@+id/server_seed_image"
                        style="@style/TextPrimaryBold"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tint="@color/sb_black"
        app:backgroundTint="@color/white"
        app:fabSize="normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/game_limit_container"
        app:srcCompat="@drawable/close_icon_white"/>
</androidx.constraintlayout.widget.ConstraintLayout>
