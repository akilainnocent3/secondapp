<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/world_cup_top_bar_background"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/bg_code_hub_world_cup_top_bar"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/titleBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.sporty.android.common_ui.widgets.CommonTitleBar
        android:orientation="horizontal"
        android:id="@+id/titleBar"
        android:background="@color/brand_primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        app:layout_constraintEnd_toStartOf="@+id/ivSocial"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/page_code_hub__new_code_hub_header_title"
        app:titleLineSpacing="0dp"
        app:titleMaxLines="2"/>
    <ImageView
        android:id="@+id/ivHome"
        android:background="@color/brand_primary"
        android:padding="10dp"
        android:layout_width="44dp"
        android:layout_height="0dp"
        android:src="@drawable/ic_home"
        app:layout_constraintBottom_toBottomOf="@+id/titleBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivSocial"
        android:background="@color/brand_primary"
        android:padding="10dp"
        android:layout_width="44dp"
        android:layout_height="0dp"
        android:src="@drawable/ic_sporty_social"
        app:layout_constraintBottom_toBottomOf="@+id/titleBar"
        app:layout_constraintEnd_toStartOf="@+id/ivHome"
        app:layout_constraintTop_toTopOf="@+id/ivHome"
        app:tint="@color/text_type2_primary"/>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/code_hub_tab"
        android:background="@color/background_type1_secondary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/custom_code_tab"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleBar"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/brand_secondary"
        app:tabIndicatorHeight="4dp"
        app:tabMode="auto"
        app:tabPaddingEnd="8dp"
        app:tabPaddingStart="8dp"
        app:tabTextAppearance="@style/CustomTabAppearance"
        style="@style/Widget.App.TabLayout.Default.NoIndicator"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/custom_code_tab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/code_hub_tab"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/code_hub_tab"
        app:layout_constraintTop_toTopOf="@+id/code_hub_tab">
        <View
            android:id="@+id/tab_horizontal_divider"
            android:background="@color/line_type1_secondary"
            android:layout_width="1dp"
            android:layout_height="16dp"/>
        <ImageView
            android:id="@+id/custom_code"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_custom_code"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:tint="@color/brand_quaternary"/>
    </LinearLayout>
    <View
        android:id="@+id/tab_divider"
        android:background="@color/line_type1_primary"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/code_hub_tab"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tab_divider"/>
    <com.sportybet.android.widget.BubbleView
        android:id="@+id/creator_credits_entrance_hint"
        android:visibility="gone"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        app:closable="true"
        app:descriptionVisibility="false"
        app:layout_constraintEnd_toEndOf="@+id/custom_code_tab"
        app:layout_constraintTop_toBottomOf="@+id/custom_code_tab"
        app:title="@string/page_creator_credits__entry_hint"
        app:trianglePosition="top_right"/>
    <View
        android:id="@+id/overlay"
        android:background="@color/black_50"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.sportybet.android.widget.LoadingView
        android:id="@+id/loading"
        android:background="@color/transparent"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
