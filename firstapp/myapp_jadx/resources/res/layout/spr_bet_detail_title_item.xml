<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14dp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_secondary"
        android:gravity="center_vertical"
        android:id="@+id/bet_detail_bet_number"
        android:background="@color/background_type1_primary"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:fontFamily="sans-serif"/>
    <RelativeLayout
        android:background="@color/background_general_primary"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="10dp">
        <TextView
            android:textSize="12dp"
            android:textStyle="normal"
            android:textColor="@color/absolute_type2"
            android:id="@+id/bet_detail_bet_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bet_detail_title_layout"
            android:background="@color/brand_secondary"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:layout_below="@+id/bet_detail_bet_id"
            android:layout_marginHorizontal="10dp">
            <TextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@color/brand_tertiary"
                android:gravity="center_vertical"
                android:id="@+id/bet_detail_type"
                android:paddingLeft="6dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:drawablePadding="5dp"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textAppearance="@style/B2_R"
                android:textColor="@color/custom_text_type2_primary_type2"
                android:gravity="center_vertical"
                android:id="@+id/bet_detail_insure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="4dp"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/bet_detail_type"
                app:layout_constraintStart_toEndOf="@+id/bet_detail_type"
                app:layout_constraintTop_toTopOf="@+id/bet_detail_type"/>
            <TextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@color/brand_tertiary"
                android:gravity="center_vertical"
                android:id="@+id/bet_detail_status"
                android:paddingRight="6dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:drawablePadding="5dp"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bet_detail_return_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/bet_detail_title_layout"
            android:layout_alignLeft="@+id/bet_detail_title_layout">
            <TextView
                android:textSize="14dp"
                android:textStyle="normal"
                android:textColor="@color/text_type1_secondary"
                android:gravity="end"
                android:id="@+id/bet_detail_total_return"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="16dp"
                android:text="@string/common_functions__return"
                android:lineSpacingExtra="12sp"
                android:fontFamily="sans-serif"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="@color/brand_quinary"
                android:gravity="end"
                android:id="@+id/bet_detail_total_return_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:fontFamily="sans-serif"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/bet_detail_line1"
            android:background="@color/line_type1_primary"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="4dp"
            android:layout_below="@+id/bet_detail_return_layout"
            android:layout_alignLeft="@+id/bet_detail_return_layout"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bet_detail_stack_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:layout_below="@+id/bet_detail_line1"
            android:layout_alignLeft="@+id/bet_detail_line1">
            <TextView
                android:textSize="14dp"
                android:textStyle="normal"
                android:textColor="@color/text_type1_secondary"
                android:id="@+id/bet_detail_total_stake"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_functions__stake"
                android:lineSpacingExtra="12sp"
                android:fontFamily="sans-serif"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="14dp"
                android:textStyle="normal"
                android:textColor="@color/absolute_type2"
                android:id="@+id/bet_detail_total_stake_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="14dp"
            android:textStyle="normal"
            android:textColor="@color/text_type1_secondary"
            android:id="@+id/bet_detail_remain_stake_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/cashout__remaining_stake"
            android:layout_below="@+id/bet_detail_stack_layout"
            android:layout_alignLeft="@+id/bet_detail_stack_layout"
            android:lineSpacingExtra="12sp"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="normal"
            android:textColor="@color/absolute_type2"
            android:gravity="end"
            android:id="@+id/bet_detail_remain_stake_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:layout_alignTop="@+id/bet_detail_remain_stake_label"
            android:layout_alignParentRight="true"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="normal"
            android:textColor="@color/text_type1_secondary"
            android:id="@+id/bet_detail_gift_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/common_functions__free_bet_gift"
            android:layout_below="@+id/bet_detail_remain_stake_label"
            android:layout_alignLeft="@+id/bet_detail_remain_stake_label"
            android:lineSpacingExtra="12sp"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="normal"
            android:textColor="@color/absolute_type2"
            android:gravity="end"
            android:id="@+id/bet_detail_gift_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:layout_alignTop="@+id/bet_detail_gift_label"
            android:layout_alignParentRight="true"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="normal"
            android:textColor="@color/text_type1_secondary"
            android:id="@+id/bet_detail_odds_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/common_functions__odds_txt"
            android:layout_below="@+id/bet_detail_gift_label"
            android:layout_alignLeft="@+id/bet_detail_gift_label"
            android:lineSpacingExtra="12sp"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="normal"
            android:textColor="@color/absolute_type2"
            android:gravity="end"
            android:id="@+id/bet_detail_odds_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:layout_alignTop="@+id/bet_detail_odds_label"
            android:layout_alignParentRight="true"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="normal"
            android:textColor="@color/text_type1_secondary"
            android:id="@+id/bet_detail_final_odds_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/bet_history__void_after_total_odds"
            android:layout_below="@+id/bet_detail_odds_label"
            android:layout_alignLeft="@+id/bet_detail_odds_label"
            android:lineSpacingExtra="12sp"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="normal"
            android:textColor="@color/absolute_type2"
            android:gravity="end"
            android:id="@+id/bet_detail_final_odds_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:layout_alignTop="@+id/bet_detail_final_odds_label"
            android:layout_alignParentRight="true"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="normal"
            android:textColor="@color/text_type1_secondary"
            android:id="@+id/bet_detail_bonus_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/common_functions__bonus"
            android:layout_below="@+id/bet_detail_final_odds_label"
            android:layout_alignLeft="@+id/bet_detail_remain_stake_label"
            android:lineSpacingExtra="12sp"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="normal"
            android:textColor="@color/absolute_type2"
            android:gravity="end"
            android:id="@+id/bet_detail_bonus_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:layout_alignTop="@+id/bet_detail_bonus_label"
            android:layout_alignParentRight="true"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="normal"
            android:textColor="@color/text_type1_secondary"
            android:id="@+id/bet_detail_tax_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/bet_history__wh_tax"
            android:layout_below="@+id/bet_detail_bonus_label"
            android:layout_alignLeft="@+id/bet_detail_remain_stake_label"
            android:lineSpacingExtra="12sp"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="normal"
            android:textColor="@color/absolute_type2"
            android:gravity="end"
            android:id="@+id/bet_detail_tax_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:layout_alignTop="@+id/bet_detail_tax_label"
            android:layout_alignParentRight="true"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="normal"
            android:textColor="@color/text_type1_secondary"
            android:id="@+id/bet_detail_pot_win_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/component_betslip__pot_win"
            android:layout_below="@+id/bet_detail_tax_label"
            android:layout_alignLeft="@+id/bet_detail_remain_stake_label"
            android:lineSpacingExtra="12sp"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="normal"
            android:textColor="@color/absolute_type2"
            android:gravity="end"
            android:id="@+id/bet_detail_pot_win_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="5dp"
            android:layout_alignTop="@+id/bet_detail_pot_win_label"
            android:layout_alignParentRight="true"
            android:fontFamily="sans-serif"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/one_cut_still_win_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:layout_below="@+id/bet_detail_pot_win_label"
            android:layout_alignLeft="@+id/bet_detail_remain_stake_label">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/text_type1_secondary"
                android:id="@+id/one_cut_still_win_label"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_functions__one_cut_win"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/absolute_type2"
                android:id="@+id/one_cut_still_win"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_common__zero_point_zero"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </RelativeLayout>
</LinearLayout>
