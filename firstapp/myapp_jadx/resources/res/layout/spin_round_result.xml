<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_centerInParent="true"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <View
        android:id="@+id/view1"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.045"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view2"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/top_glow"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:src="@drawable/redblack_top_glow"
        android:scaleType="fitEnd"
        app:layout_constraintHeight_percent="0.1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view2"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_horizontal"
        android:id="@+id/evenodd_result_big_box"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.38"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_glow"
        app:layout_constraintWidth_percent="0.75">
        <TextView
            android:textSize="@dimen/_46ssp"
            android:gravity="center"
            android:id="@+id/result_card_name"
            android:tag="@string/list_game_name_cms"
            android:paddingLeft="@dimen/_2sdp"
            android:paddingTop="@dimen/_10sdp"
            android:paddingRight="@dimen/_2sdp"
            android:paddingBottom="@dimen/_10sdp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:includeFontPadding="false"
            android:autoSizeTextType="uniform"
            android:autoSizeStepGranularity="@dimen/_2sdp"
            android:paddingHorizontal="@dimen/_2sdp"
            android:paddingVertical="@dimen/_10sdp"
            android:autoSizeMaxTextSize="32dp"
            style="@style/TextPrimaryMedium"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/bottom_glow"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:src="@drawable/redblack_bottom_glow"
        android:scaleType="fitStart"
        app:layout_constraintHeight_percent="0.15"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/evenodd_result_big_box"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/view5"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.15"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/evenodd_result_big_box"/>
    <TextView
        android:id="@+id/view6"
        android:visibility="gone"
        android:layout_width="@dimen/_35sdp"
        android:layout_height="@dimen/_35sdp"
        app:layout_constraintBottom_toTopOf="@+id/view3"
        app:layout_constraintHeight_percent="0.18"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_horizontal"
        android:id="@+id/round_you_win_message"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/gift_round_detail"
        app:layout_constraintHeight_percent="0.25"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintWidth_percent="0.9">
        <TextView
            android:textSize="@dimen/_18ssp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/message"
            android:tag="@string/sorry_txt_cms"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:autoSizeTextType="uniform"
            android:autoSizeMaxTextSize="@dimen/_18ssp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.8"
            style="@style/TextPrimaryBold"/>
        <TextView
            android:textSize="@dimen/_18ssp"
            android:gravity="center_horizontal"
            android:id="@+id/message_win"
            android:tag="@string/you_won_cms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/redblack_win_msg"
            android:autoSizeTextType="uniform"
            android:autoSizeStepGranularity="@dimen/_1ssp"
            android:autoSizeMinTextSize="@dimen/_16ssp"
            android:autoSizeMaxTextSize="@dimen/_24ssp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/win_trophy"
            app:layout_constraintHeight_percent="1"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.8"
            app:layout_constraintWidth_percent="0.33"
            style="@style/TextPrimaryBold"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/win_trophy"
            android:visibility="gone"
            android:layout_width="@dimen/_33sdp"
            android:layout_height="@dimen/_30sdp"
            android:src="@drawable/sporty_trophy"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/win_amount"
            app:layout_constraintHeight_percent="1"
            app:layout_constraintStart_toEndOf="@+id/message_win"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.8"
            app:layout_constraintWidth_percent="0.33"/>
        <TextView
            android:textSize="@dimen/_14ssp"
            android:textColor="@color/win_color"
            android:id="@+id/win_amount"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NGN 40.00"
            android:autoSizeTextType="uniform"
            android:autoSizeStepGranularity="@dimen/_1ssp"
            android:autoSizeMinTextSize="@dimen/_8ssp"
            android:autoSizeMaxTextSize="@dimen/_16ssp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="1"
            app:layout_constraintStart_toEndOf="@+id/win_trophy"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.8"
            app:layout_constraintWidth_percent="0.33"
            style="@style/TextPrimaryBold"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/view3"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/view4"
        app:layout_constraintHeight_percent="0.2"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/gift_round_detail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_6sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        app:layout_constraintBottom_toTopOf="@+id/view4"
        app:layout_constraintHeight_percent="0.08"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <TextView
            android:textSize="@dimen/_10sdp"
            android:id="@+id/gift_minus_saperator_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" - "
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/RedBlackGiftDetailFontStyle"/>
        <TextView
            android:id="@+id/total_win_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ngn_10_000"
            app:layout_constraintBottom_toBottomOf="@+id/gift_minus_saperator_tv"
            app:layout_constraintRight_toLeftOf="@+id/gift_minus_saperator_tv"
            app:layout_constraintTop_toTopOf="@+id/gift_minus_saperator_tv"
            style="@style/RedBlackGiftDetailFontStyle"/>
        <TextView
            android:id="@+id/gift_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_4sdp"
            android:text="@string/ngn_10_000"
            app:layout_constraintBottom_toBottomOf="@+id/gift_icon"
            app:layout_constraintLeft_toRightOf="@+id/gift_icon"
            app:layout_constraintTop_toTopOf="@+id/gift_icon"
            style="@style/RedBlackGiftDetailFontStyle"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/total_win_icon"
            android:layout_width="@dimen/_15sdp"
            android:layout_height="@dimen/_15sdp"
            android:layout_marginRight="@dimen/_4sdp"
            android:src="@drawable/sporty_trophy"
            android:alpha="0.5"
            app:layout_constraintBottom_toBottomOf="@+id/total_win_amount"
            app:layout_constraintRight_toLeftOf="@+id/total_win_amount"
            app:layout_constraintTop_toTopOf="@+id/total_win_amount"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/gift_icon"
            android:layout_width="@dimen/_15sdp"
            android:layout_height="@dimen/_15sdp"
            android:src="@drawable/gift_icon_bethistory"
            android:scaleType="fitXY"
            android:alpha="0.5"
            app:layout_constraintBottom_toBottomOf="@+id/gift_minus_saperator_tv"
            app:layout_constraintLeft_toRightOf="@+id/gift_minus_saperator_tv"
            app:layout_constraintTop_toTopOf="@+id/gift_minus_saperator_tv"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="("
            app:layout_constraintBottom_toBottomOf="@+id/total_win_icon"
            app:layout_constraintRight_toLeftOf="@+id/total_win_icon"
            app:layout_constraintTop_toTopOf="@+id/total_win_icon"
            style="@style/RedBlackGiftDetailFontStyle"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=")"
            app:layout_constraintBottom_toBottomOf="@+id/gift_amount"
            app:layout_constraintLeft_toRightOf="@+id/gift_amount"
            app:layout_constraintTop_toTopOf="@+id/gift_amount"
            style="@style/RedBlackGiftDetailFontStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/view4"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.05"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
