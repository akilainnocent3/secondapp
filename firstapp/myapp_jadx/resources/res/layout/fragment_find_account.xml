<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_root"
    android:paddingTop="4dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <ImageButton
            android:id="@+id/back"
            android:background="?android:attr/selectableItemBackground"
            android:padding="6dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            app:srcCompat="@drawable/ic_action_bar_back"
            app:tint="@color/text_type1_secondary"/>
    </LinearLayout>
    <TextView
        android:textSize="22dp"
        android:textStyle="bold"
        android:textColor="@color/text_type1_primary"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/page_login__find_account"
        android:layout_below="@+id/toolbar"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/text_type1_primary"
        android:gravity="center"
        android:id="@+id/title2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="30dp"
        android:text="@string/page_login__to_reset_your_password_please_confirm_your_account_first"
        android:layout_below="@+id/title"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="29dp"
        android:layout_marginRight="30dp"
        android:layout_below="@+id/title2">
        <FrameLayout
            android:id="@+id/mobile_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.sporty.android.common_ui.widgets.ClearEditText
                android:textSize="14dp"
                android:id="@+id/mobile"
                android:background="@drawable/bg_outlined_line_type1_secondary_2_radius"
                android:paddingLeft="60dp"
                android:paddingRight="11dp"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="@string/page_login__mobile_number"
                android:maxLines="1"
                android:maxLength="@integer/mobile_max_length"
                android:digits="0123456789"
                android:inputType="phone"
                android:imeOptions="actionDone"/>
            <TextView
                android:textColor="@color/text_type1_secondary"
                android:layout_gravity="center_vertical"
                android:id="@+id/prefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18dp"/>
        </FrameLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="42dp">
            <TextView
                android:textAppearance="@style/ErrorTextView"
                android:id="@+id/error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:layout_below="@+id/mobile_container"/>
        </FrameLayout>
        <com.sportybet.android.widget.ProgressButton
            android:id="@+id/log_in"
            android:layout_width="match_parent"
            android:layout_height="44dp"/>
    </LinearLayout>
</RelativeLayout>
