<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/full_container"
    android:background="@drawable/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/header_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/check_icon"
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:layout_marginLeft="35dp"
                    android:layout_marginTop="26dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_check_circle_green_24dp"
                    app:tint="@color/brand_secondary"/>
                <TextView
                    android:textAppearance="@style/H4_B"
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/notify_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="20dp"
                    app:layout_constraintLeft_toRightOf="@+id/check_icon"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textAppearance="@style/B1_R"
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/notify_tint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:text="@string/component_withdraw_pin__your_account_is_now_protected"
                    app:layout_constraintLeft_toRightOf="@+id/check_icon"
                    app:layout_constraintTop_toBottomOf="@+id/notify_title"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:id="@+id/withdrawal_pin_divider"
                android:background="@color/line_type1_primary"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="32dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="32dp"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                app:layout_constraintTop_toBottomOf="@+id/header_container"/>
            <ImageView
                android:id="@+id/img_icon"
                android:layout_width="148dp"
                android:layout_height="120dp"
                android:layout_marginTop="20dp"
                android:scaleType="fitXY"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/withdrawal_pin_divider"
                app:srcCompat="@drawable/withdraw_enabled"/>
            <TextView
                android:textAppearance="@style/H1_B"
                android:textColor="@color/text_type1_primary"
                android:gravity="center"
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="32dp"
                android:layout_marginTop="24dp"
                android:layout_marginRight="32dp"
                android:text="@string/component_withdraw_pin__pin_protection"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/img_icon"/>
            <ImageView
                android:id="@+id/zero_point"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="32dp"
                android:layout_marginTop="16dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/title"
                app:srcCompat="@drawable/withdraw_dot"/>
            <TextView
                android:textAppearance="@style/B1_R"
                android:textColor="@color/text_type1_primary"
                android:id="@+id/content0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="32dp"
                android:text="@string/component_withdraw_pin__sporty_pin_is_required_for_any_deposit_with_a_save_card_tip"
                app:layout_constraintLeft_toRightOf="@+id/first_point"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/title"/>
            <ImageView
                android:id="@+id/first_point"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="32dp"
                android:layout_marginTop="16dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/content0"
                app:srcCompat="@drawable/withdraw_dot"/>
            <TextView
                android:textAppearance="@style/B1_R"
                android:textColor="@color/text_type1_primary"
                android:id="@+id/content1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="32dp"
                android:text="@string/component_withdraw_pin__please_never_reveal_your_sporty_pin_to_anyone_tip"
                app:layout_constraintLeft_toRightOf="@+id/first_point"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/content0"/>
            <ImageView
                android:id="@+id/second_point"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="32dp"
                android:layout_marginTop="16dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/content1"
                app:srcCompat="@drawable/withdraw_dot"/>
            <TextView
                android:textAppearance="@style/B1_R"
                android:textColor="@color/text_type1_primary"
                android:id="@+id/content2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="32dp"
                app:layout_constraintLeft_toRightOf="@+id/second_point"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/content1"/>
            <ImageView
                android:id="@+id/third_point"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="32dp"
                android:layout_marginTop="16dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/content2"
                app:srcCompat="@drawable/withdraw_dot"/>
            <TextView
                android:textAppearance="@style/B1_R"
                android:textColor="@color/text_type1_primary"
                android:id="@+id/content3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="32dp"
                android:text="@string/component_withdraw_pin__if_your_sporty_pin_has_been_compromised_tip"
                app:layout_constraintLeft_toRightOf="@+id/third_point"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/content2"/>
            <Button
                android:gravity="center"
                android:id="@+id/btn_continue"
                android:layout_width="0dp"
                android:layout_marginLeft="32dp"
                android:layout_marginTop="24dp"
                android:layout_marginRight="32dp"
                android:text="@string/common_functions__ok"
                android:textAllCaps="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/content3"
                style="@style/Widget.App.CommonButton.Contained.Large"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <FrameLayout
        android:id="@+id/grey_container"
        android:background="@drawable/opt_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/fingerprint_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/fingerprint_container"
        android:background="@color/background_general_primary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="270dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/center_guildline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.5"/>
        <ImageView
            android:id="@+id/finger_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_fingerprint"
            app:tint="@color/brand_secondary"/>
        <TextView
            android:textAppearance="@style/H3_B"
            android:textColor="@color/text_type1_tertiary"
            android:id="@+id/finger_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/app_common__fingerprint_authentication"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/finger_icon"/>
        <TextView
            android:textSize="18dp"
            android:textStyle="normal"
            android:textColor="@color/text_type1_tertiary"
            android:gravity="center"
            android:id="@+id/finger_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="32dp"
            android:text="@string/app_common__fingerprint_login_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/finger_title"/>
        <com.sporty.android.common_ui.widgets.CommonButton
            android:id="@+id/confirm_btn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="20dp"
            android:text="@string/common_functions__ok"
            app:layout_constraintLeft_toRightOf="@+id/center_guildline"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/finger_content"/>
        <com.sporty.android.common_ui.widgets.CommonButton
            android:id="@+id/cancel_btn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="10dp"
            android:text="@string/common_functions__cancel"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/center_guildline"
            app:layout_constraintTop_toBottomOf="@+id/finger_content"
            style="@style/Widget.App.CommonButton.Outline.Medium"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
