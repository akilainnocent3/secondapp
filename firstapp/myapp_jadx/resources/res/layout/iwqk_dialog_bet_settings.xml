<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_secondary_d_base"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="18dp"
        android:textStyle="bold"
        android:textColor="@color/text_type1_tertiary"
        android:gravity="center_vertical"
        android:id="@+id/bet_settings"
        android:background="@color/bg_primary_d_base"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="@string/component_betslip__bet_settings"
        android:paddingStart="48dp"
        app:layout_constraintBottom_toTopOf="@+id/my_stakes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/bet_settings"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bet_settings"
        app:srcCompat="@drawable/ic_bet_settings"
        app:tint="@color/text_type1_primary"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/text_type1_primary"
        android:gravity="center_vertical"
        android:id="@+id/my_stakes"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="@string/wap_setting__my_stakes"
        android:paddingStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/btn_goto_my_stakes"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btn_goto_my_stakes"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/my_stakes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/my_stakes"
        app:srcCompat="@drawable/iwqk_ic_arrow_right_white_24dp"
        app:tint="@color/text_type1_secondary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
