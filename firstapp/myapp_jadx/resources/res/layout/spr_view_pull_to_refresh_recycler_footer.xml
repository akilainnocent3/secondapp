<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/background_type1_primary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="39dp">
    <LinearLayout
        android:gravity="center_horizontal"
        android:id="@+id/loading_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="39dp">
        <ProgressBar
            android:layout_gravity="center_vertical"
            android:id="@+id/progress"
            android:layout_width="15dp"
            android:layout_height="15dp"
            style="@android:style/Widget.ProgressBar.Small"/>
        <TextView
            android:textSize="12dp"
            android:textStyle="normal"
            android:textColor="@color/text_type1_secondary"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:minHeight="14dp"
            android:fontFamily="sans-serif"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/hint_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="39dp">
        <TextView
            android:textSize="12dp"
            android:textColor="@color/text_type1_secondary"
            android:layout_gravity="center"
            android:id="@+id/older_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/page_transaction__show_only_histories_in_last_months"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/brand_secondary"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            android:text="@string/page_transaction__view_older_histories"/>
    </LinearLayout>
</LinearLayout>
