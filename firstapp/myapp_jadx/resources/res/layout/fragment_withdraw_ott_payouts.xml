<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_begin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="16dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="16dp"/>
    <com.sportybet.android.widget.HintView
        android:id="@+id/alert_hint_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="@+id/guideline_end"
        app:layout_constraintStart_toStartOf="@+id/guideline_begin"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ott_payout_logo"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="24dp"
        android:scaleType="fitStart"
        app:layout_constraintStart_toStartOf="@+id/guideline_begin"
        app:layout_constraintTop_toBottomOf="@+id/alert_hint_view"/>
    <TextView
        android:textColor="@color/text_type1_primary"
        android:id="@+id/ott_payout_mobile_number_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/page_payment__mobile_number"
        android:drawablePadding="4dp"
        app:drawableEndCompat="@drawable/ic_info_vector"
        app:layout_constraintStart_toStartOf="@+id/guideline_begin"
        app:layout_constraintTop_toBottomOf="@+id/ott_payout_logo"
        style="@style/B1_M"/>
    <com.sportybet.android.globalpay.customview.PaymentAccountView
        android:id="@+id/ott_payout_account_view"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="@+id/guideline_end"
        app:layout_constraintStart_toStartOf="@+id/guideline_begin"
        app:layout_constraintTop_toBottomOf="@+id/ott_payout_mobile_number_title"/>
    <TextView
        android:textColor="@color/text_type1_secondary"
        android:id="@+id/ott_payout_balance_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="21dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toStartOf="@+id/ott_payout_balance"
        app:layout_constraintTop_toBottomOf="@+id/ott_payout_account_view"
        style="@style/B2_M"/>
    <TextView
        android:textColor="@color/text_type1_secondary"
        android:id="@+id/ott_payout_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/guideline_end"
        app:layout_constraintTop_toTopOf="@+id/ott_payout_balance_label"
        style="@style/B2_M"/>
    <TextView
        android:textColor="@color/text_type1_primary"
        android:id="@+id/ott_payout_withdrawable_balance_label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toStartOf="@+id/ott_payout_withdrawable_balance"
        app:layout_constraintTop_toBottomOf="@+id/ott_payout_balance"
        style="@style/B2_M"/>
    <TextView
        android:textColor="@color/text_type1_primary"
        android:id="@+id/ott_payout_withdrawable_balance"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/ott_payout_balance"
        app:layout_constraintTop_toTopOf="@+id/ott_payout_withdrawable_balance_label"
        style="@style/B2_M"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ott_payout_withdrawable_balance_hint"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:tint="@color/text_type1_primary"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/ott_payout_withdrawable_balance_label"
        app:layout_constraintTop_toTopOf="@+id/ott_payout_withdrawable_balance_label"
        app:srcCompat="@drawable/ic_help_outline_black_19dp"/>
    <FrameLayout
        android:id="@+id/ott_payout_amount_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="@+id/guideline_end"
        app:layout_constraintStart_toStartOf="@+id/guideline_begin"
        app:layout_constraintTop_toBottomOf="@+id/ott_payout_withdrawable_balance_label">
        <TextView
            android:textColor="@color/text_type1_primary"
            android:gravity="center_vertical"
            android:id="@+id/ott_payout_amount_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:lineSpacingExtra="0sp"
            android:layout_marginStart="16dp"
            style="@style/B1_M"/>
        <com.sporty.android.common_ui.widgets.ClearEditText
            android:textSize="14dp"
            android:textColor="@color/text_type1_primary"
            android:textColorHint="@color/text_type1_secondary"
            android:gravity="center"
            android:id="@+id/ott_payout_amount"
            android:background="@drawable/comb_edit_text_bg"
            android:saveEnabled="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:maxLines="1"
            android:drawablePadding="8dp"
            android:lineSpacingExtra="0sp"
            android:inputType="numberDecimal"
            android:imeOptions="actionDone"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="110dp"
            android:paddingEnd="12dp"
            app:cancalDrawableSize="16dp"/>
    </FrameLayout>
    <TextView
        android:textSize="10dp"
        android:textStyle="normal"
        android:textColor="@color/warning_primary"
        android:id="@+id/ott_payout_amount_warning"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:minHeight="11dp"
        app:layout_constraintEnd_toEndOf="@+id/guideline_end"
        app:layout_constraintStart_toStartOf="@+id/guideline_begin"
        app:layout_constraintTop_toBottomOf="@+id/ott_payout_amount_container"/>
    <com.sportybet.android.widget.ProgressButton
        android:id="@+id/ott_payout_withdraw_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:minHeight="48dp"
        app:layout_constraintEnd_toEndOf="@+id/guideline_end"
        app:layout_constraintStart_toStartOf="@+id/guideline_begin"
        app:layout_constraintTop_toBottomOf="@+id/ott_payout_amount_warning"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ott_payout_description_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        app:layout_constraintEnd_toEndOf="@+id/guideline_end"
        app:layout_constraintStart_toStartOf="@+id/guideline_begin"
        app:layout_constraintTop_toBottomOf="@+id/ott_payout_withdraw_button"/>
    <com.sportybet.android.user.LoadingView
        android:id="@+id/ott_payout_loading"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
