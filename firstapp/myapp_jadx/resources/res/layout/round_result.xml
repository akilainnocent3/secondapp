<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parent_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginBottom="@dimen/_10sdp">
    <TextView
        android:textSize="@dimen/_20ssp"
        android:textColor="@color/sg_spin_match_better_luck_text_color"
        android:gravity="center"
        android:id="@+id/message"
        android:tag="@string/lost_msg_cms"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/sorry_text"
        android:autoSizeTextType="uniform"
        android:autoSizeMaxTextSize="@dimen/_20ssp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.8"
        style="@style/TextPrimaryBold"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.sportygames.commons.views.WinTextResponsiveLayout
            android:id="@+id/round_result_layout"
            android:paddingLeft="@dimen/_3sdp"
            android:paddingRight="@dimen/_3sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/_3sdp"
            app:layout_constraintBottom_toTopOf="@+id/gift_round_detail"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/_20ssp"
                android:gravity="center"
                android:id="@+id/message_win"
                android:tag="@string/you_won_text_cms"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/redblack_win_msg"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/TextPrimaryBold"/>
            <ImageView
                android:gravity="center"
                android:id="@+id/win_image"
                android:visibility="gone"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_40sdp"
                android:layout_marginLeft="@dimen/_3sdp"
                android:layout_marginRight="@dimen/_3sdp"
                android:src="@drawable/sporty_trophy"
                android:layout_marginHorizontal="@dimen/_3sdp"/>
            <TextView
                android:textSize="@dimen/_20ssp"
                android:textColor="@color/black_olive"
                android:gravity="center"
                android:id="@+id/message_win_amount"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                style="@style/TextPrimaryBold"/>
        </com.sportygames.commons.views.WinTextResponsiveLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/gift_round_detail"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/round_result_layout">
            <TextView
                android:textSize="@dimen/_12ssp"
                android:id="@+id/gift_minus_saperator_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" - "
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/total_win_amount"
                app:layout_constraintRight_toLeftOf="@+id/gift_icon"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/giftTextColor"/>
            <TextView
                android:textSize="@dimen/_12ssp"
                android:id="@+id/total_win_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NGN 10,000"
                app:layout_constraintBottom_toBottomOf="@+id/gift_minus_saperator_tv"
                app:layout_constraintLeft_toRightOf="@+id/total_win_icon"
                app:layout_constraintRight_toLeftOf="@+id/gift_minus_saperator_tv"
                app:layout_constraintTop_toTopOf="@+id/gift_minus_saperator_tv"
                style="@style/giftTextColor"/>
            <TextView
                android:textSize="@dimen/_12ssp"
                android:id="@+id/gift_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_4sdp"
                android:text="NGN 10,000"
                app:layout_constraintBottom_toBottomOf="@+id/gift_icon"
                app:layout_constraintLeft_toRightOf="@+id/gift_icon"
                app:layout_constraintRight_toLeftOf="@+id/gift_close_bracket_tv"
                app:layout_constraintTop_toTopOf="@+id/gift_icon"
                style="@style/giftTextColor"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/total_win_icon"
                android:layout_width="@dimen/_16sdp"
                android:layout_height="@dimen/_16sdp"
                android:layout_marginRight="@dimen/_4sdp"
                android:src="@drawable/sporty_trophy"
                android:alpha="0.5"
                app:layout_constraintBottom_toBottomOf="@+id/total_win_amount"
                app:layout_constraintLeft_toRightOf="@+id/gift_open_bracket_tv"
                app:layout_constraintRight_toLeftOf="@+id/total_win_amount"
                app:layout_constraintTop_toTopOf="@+id/total_win_amount"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/gift_icon"
                android:layout_width="@dimen/_16sdp"
                android:layout_height="@dimen/_16sdp"
                android:src="@drawable/gift_icon_bethistory"
                android:alpha="0.5"
                app:layout_constraintBottom_toBottomOf="@+id/gift_minus_saperator_tv"
                app:layout_constraintLeft_toRightOf="@+id/gift_minus_saperator_tv"
                app:layout_constraintRight_toLeftOf="@+id/gift_icon"
                app:layout_constraintTop_toTopOf="@+id/gift_minus_saperator_tv"/>
            <TextView
                android:textSize="@dimen/_12ssp"
                android:id="@+id/gift_open_bracket_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="( "
                app:layout_constraintBottom_toBottomOf="@+id/total_win_icon"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/total_win_icon"
                app:layout_constraintTop_toTopOf="@+id/total_win_icon"
                style="@style/giftTextColor"/>
            <TextView
                android:textSize="@dimen/_12ssp"
                android:id="@+id/gift_close_bracket_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" )"
                app:layout_constraintBottom_toBottomOf="@+id/gift_amount"
                app:layout_constraintLeft_toRightOf="@+id/gift_amount"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/gift_amount"
                style="@style/giftTextColor"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
