<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/trailingLineContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/mid"
        app:layout_constraintEnd_toEndOf="@+id/mid"
        app:layout_constraintHeight_percent="1.728"
        app:layout_constraintStart_toStartOf="@+id/mid"
        app:layout_constraintTop_toTopOf="@+id/mid"
        app:layout_constraintWidth_percent="0.03">
        <View
            android:id="@+id/guideLine"
            android:visibility="visible"
            android:layout_width="1px"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/viewTBottom"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.5813"
            app:layout_constraintStart_toStartOf="parent"/>
        <View
            android:id="@+id/trailingLineTop"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent="0.5"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/ivTrailAngle"
            android:background="@drawable/fh_knife_trail"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/trailingLineTop"
            app:layout_constraintHeight_percent="0.5813"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/guideLine"
            app:layout_constraintVertical_bias="0"
            app:layout_constraintWidth_percent="1"/>
        <View
            android:id="@+id/viewTBottom"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent="0.3"
            app:layout_constraintTop_toBottomOf="@+id/trailingLineTop"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivKnifeLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/fh_circle_knife"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toTopOf="@+id/bottom"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.2"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/mid"
        android:layout_width="1px"
        android:layout_height="1px"
        app:layout_constraintBottom_toBottomOf="@+id/ivKnifeLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivKnifeLayout"/>
    <View
        android:id="@+id/bottom"
        android:layout_width="1dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.0375"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/topGuide"
        android:layout_width="1dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.1625"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/ivTrailing"
        android:background="@drawable/fh_knife_trail"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/ivKnifeLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/topGuide"
        app:layout_constraintWidth_percent="0.03"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:rotation="-22"
        app:layout_constraintBottom_toBottomOf="@+id/mid"
        app:layout_constraintEnd_toEndOf="@+id/mid"
        app:layout_constraintHeight_percent="1.728"
        app:layout_constraintStart_toStartOf="@+id/mid"
        app:layout_constraintTop_toTopOf="@+id/mid"
        app:layout_constraintWidth_percent="0.0806">
        <include
            android:id="@+id/layoutKnifeLeft"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent="0.5"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/fh_knife_path"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/mid"
        app:layout_constraintEnd_toEndOf="@+id/mid"
        app:layout_constraintHeight_percent="1.728"
        app:layout_constraintStart_toStartOf="@+id/mid"
        app:layout_constraintTop_toTopOf="@+id/mid"
        app:layout_constraintWidth_percent="0.0806">
        <include
            android:id="@+id/layoutKnifeCenter"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent="0.5"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/fh_knife_path"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:rotation="22"
        app:layout_constraintBottom_toBottomOf="@+id/mid"
        app:layout_constraintEnd_toEndOf="@+id/mid"
        app:layout_constraintHeight_percent="1.728"
        app:layout_constraintStart_toStartOf="@+id/mid"
        app:layout_constraintTop_toTopOf="@+id/mid"
        app:layout_constraintWidth_percent="0.0806">
        <include
            android:id="@+id/layoutKnifeRight"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent="0.5"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/fh_knife_path"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lyKnifeArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/knifeContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/knifePosition"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:adjustViewBounds="true"
                app:layout_constraintBottom_toTopOf="@+id/offsetKnifeBottom"
                app:layout_constraintDimensionRatio="24:104"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.1625"
                app:layout_constraintStart_toStartOf="parent"/>
            <View
                android:id="@+id/bottomCopy"
                android:layout_width="1dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.0375"
                app:layout_constraintStart_toStartOf="parent"/>
            <View
                android:id="@+id/offsetKnifeBottom"
                android:layout_width="1dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@+id/bottomCopy"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.0188"
                app:layout_constraintStart_toStartOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivKnife"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/knife"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                app:layout_constraintBottom_toTopOf="@+id/offsetKnifeBottom"
                app:layout_constraintDimensionRatio="24:104"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.1625"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
