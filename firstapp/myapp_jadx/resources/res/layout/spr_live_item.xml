<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_type2_primary"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <android.widget.Space
        android:id="@+id/anchor"
        android:layout_width="10dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/live_virtual_sign"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/anchor"/>
    <ImageView
        android:id="@+id/simulate_img"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:layout_marginStart="-7dp"
        app:layout_constraintStart_toEndOf="@+id/live_virtual_sign"
        app:layout_constraintTop_toBottomOf="@+id/anchor"
        app:srcCompat="@drawable/spr_sport_sim_label"/>
    <ImageView
        android:id="@+id/hot_image"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:layout_marginStart="-7dp"
        app:layout_constraintStart_toEndOf="@+id/simulate_img"
        app:layout_constraintTop_toBottomOf="@+id/anchor"
        app:srcCompat="@drawable/spr_sports_hot"/>
    <ImageView
        android:id="@+id/boost_sign"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:layout_marginStart="-7dp"
        app:layout_constraintStart_toEndOf="@+id/hot_image"
        app:layout_constraintTop_toBottomOf="@+id/anchor"/>
    <com.sportybet.plugin.realsports.event.LiveTimerTextView
        android:textSize="12dp"
        android:textColor="@color/brand_secondary_variable_type3"
        android:gravity="center_vertical"
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:drawablePadding="4dp"
        android:layout_marginStart="9dp"
        app:layout_constraintStart_toEndOf="@+id/boost_sign"
        app:layout_constraintTop_toBottomOf="@+id/anchor"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/text_type2_tertiary"
        android:ellipsize="end"
        android:id="@+id/league"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="10dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/match_tracker_img"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/time"
        app:layout_constraintTop_toBottomOf="@+id/anchor"/>
    <ImageView
        android:id="@+id/match_tracker_img"
        android:padding="2dp"
        android:visibility="gone"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toStartOf="@+id/stats_img"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="10dp"
        app:srcCompat="@drawable/spr_ic_match_tracker_activated"
        app:tint="@color/text_type1_secondary"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/stats_img"
        android:padding="2dp"
        android:visibility="gone"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginTop="4dp"
        android:scaleType="fitCenter"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_codehub_statistic"
        app:tint="@color/text_type1_secondary"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/text_type2_tertiary"
        android:gravity="center_vertical"
        android:id="@+id/view_all"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="10dp"
        android:layout_marginHorizontal="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/team2"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/sporty_tv"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginLeft="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/view_all"
        app:layout_constraintStart_toEndOf="@+id/view_all"
        app:layout_constraintTop_toTopOf="@+id/view_all"
        app:srcCompat="@drawable/ic_sporty_tv"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/sporty_fm"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginLeft="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/view_all"
        app:layout_constraintStart_toEndOf="@+id/sporty_tv"
        app:layout_constraintTop_toTopOf="@+id/view_all"
        app:srcCompat="@drawable/ic_sporty_fm"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/sporty_gift"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginLeft="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/view_all"
        app:layout_constraintStart_toEndOf="@+id/sporty_fm"
        app:layout_constraintTop_toTopOf="@+id/view_all"
        app:srcCompat="@drawable/ic_sporty_gift"/>
    <TextView
        android:textSize="10dp"
        android:textStyle="normal"
        android:textColor="@color/text_type2_tertiary"
        android:gravity="center_horizontal"
        android:id="@+id/chat_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="6.8sp"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/view_all"/>
    <View
        android:id="@+id/specifier_spinner_bg"
        android:background="@color/background_disable_type1_primary"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-4dp"
        android:layout_marginBottom="-4dp"
        android:layout_marginStart="-4dp"
        android:layout_marginEnd="-4dp"
        android:elevation="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/sports_grid_space"
        app:layout_constraintEnd_toEndOf="@+id/sports_grid_space"
        app:layout_constraintStart_toStartOf="@+id/sports_grid_space"
        app:layout_constraintTop_toTopOf="@+id/sports_grid_space"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:gravity="center_vertical"
        android:id="@+id/market_title_icon"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="8dp"
        android:tint="@color/brand_secondary_variable_type3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/time"
        app:srcCompat="@drawable/ic_info"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/brand_secondary_variable_type3"
        android:gravity="center_vertical"
        android:id="@+id/market_title"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="1dp"
        app:layout_constraintStart_toEndOf="@+id/market_title_icon"
        app:layout_constraintTop_toTopOf="@+id/market_title_icon"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_market_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="market_title_icon,market_title"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/brand_secondary_variable_type3"
        android:gravity="center"
        android:id="@+id/specifier_title"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="1dp"
        app:layout_constraintEnd_toStartOf="@+id/title1"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="@+id/sports_grid_space"
        app:layout_constraintTop_toTopOf="@+id/market_title_icon"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/brand_secondary_variable_type3"
        android:gravity="center"
        android:id="@+id/title1"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="1dp"
        app:layout_constraintEnd_toStartOf="@+id/title2"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/specifier_title"
        app:layout_constraintTop_toTopOf="@+id/market_title_icon"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/brand_secondary_variable_type3"
        android:gravity="center"
        android:id="@+id/title2"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="1dp"
        app:layout_constraintEnd_toStartOf="@+id/title3"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/title1"
        app:layout_constraintTop_toTopOf="@+id/market_title_icon"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/brand_secondary_variable_type3"
        android:gravity="center"
        android:id="@+id/title3"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="1dp"
        app:layout_constraintEnd_toStartOf="@+id/title4"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/title2"
        app:layout_constraintTop_toTopOf="@+id/market_title_icon"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/brand_secondary_variable_type3"
        android:gravity="center"
        android:id="@+id/title4"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/anchor"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/title3"
        app:layout_constraintTop_toTopOf="@+id/market_title_icon"/>
    <View
        android:id="@+id/dynamic_market_underline"
        android:background="@color/brand_secondary_variable_type3"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginHorizontal="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/market_title_icon"/>
    <android.widget.Space
        android:id="@+id/sports_grid_space"
        android:layout_width="197dp"
        android:layout_height="34dp"
        android:layout_marginTop="3dp"
        app:layout_constraintEnd_toStartOf="@+id/anchor"
        app:layout_constraintTop_toBottomOf="@+id/dynamic_market_underline"/>
    <com.sportybet.plugin.realsports.widget.ListenableSpinner
        android:gravity="center"
        android:id="@+id/specifier_spinner"
        android:background="@color/transparent"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:spinnerMode="dropdown"
        app:layout_constraintBottom_toBottomOf="@+id/sports_grid_space"
        app:layout_constraintEnd_toStartOf="@+id/o1"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="@+id/sports_grid_space"
        app:layout_constraintTop_toTopOf="@+id/sports_grid_space"/>
    <com.sportybet.plugin.realsports.widget.OutcomeButton
        android:textSize="14dp"
        android:id="@+id/specifier_spinner_lock"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/sports_grid_space"
        app:layout_constraintEnd_toEndOf="@+id/specifier_spinner"
        app:layout_constraintStart_toStartOf="@+id/specifier_spinner"
        app:layout_constraintTop_toTopOf="@+id/sports_grid_space"
        style="@style/Widget.App.OutcomeButton.LiveMatches"/>
    <com.sportybet.plugin.realsports.widget.OutcomeButton
        android:textSize="14dp"
        android:id="@+id/o1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/sports_grid_space"
        app:layout_constraintEnd_toStartOf="@+id/o2"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/specifier_spinner"
        app:layout_constraintTop_toTopOf="@+id/sports_grid_space"
        style="@style/Widget.App.OutcomeButton.LiveMatches"/>
    <com.sportybet.plugin.realsports.widget.OutcomeButton
        android:textSize="14dp"
        android:id="@+id/o2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/sports_grid_space"
        app:layout_constraintEnd_toStartOf="@+id/o3"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/o1"
        app:layout_constraintTop_toTopOf="@+id/sports_grid_space"
        style="@style/Widget.App.OutcomeButton.LiveMatches"/>
    <com.sportybet.plugin.realsports.widget.OutcomeButton
        android:textSize="14dp"
        android:id="@+id/o3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/sports_grid_space"
        app:layout_constraintEnd_toStartOf="@+id/o4"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/o2"
        app:layout_constraintTop_toTopOf="@+id/sports_grid_space"
        style="@style/Widget.App.OutcomeButton.LiveMatches"/>
    <com.sportybet.plugin.realsports.widget.OutcomeButton
        android:textSize="14dp"
        android:id="@+id/o4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/sports_grid_space"
        app:layout_constraintEnd_toEndOf="@+id/sports_grid_space"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/o3"
        app:layout_constraintTop_toTopOf="@+id/sports_grid_space"
        style="@style/Widget.App.OutcomeButton.LiveMatches"/>
    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintEnd_toStartOf="@+id/sports_grid_space"
        app:layout_constraintStart_toEndOf="@+id/team1"
        app:layout_constraintTop_toBottomOf="@+id/market_title_icon"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/text_type2_secondary"
        android:ellipsize="end"
        android:id="@+id/team1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/score"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dynamic_market_underline"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/text_type2_secondary"
        android:ellipsize="end"
        android:id="@+id/team2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/score"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/team1"/>
    <View
        android:background="@color/custom_line_type1_tertiary_type1"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="10dp"
        android:layout_marginHorizontal="10dp"
        app:layout_constraintTop_toBottomOf="@+id/view_all"/>
</androidx.constraintlayout.widget.ConstraintLayout>
