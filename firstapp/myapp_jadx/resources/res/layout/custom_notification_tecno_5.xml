<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@color/notificationBackground"
    android:paddingRight="10dp"
    android:layout_width="match_parent"
    android:layout_height="64dp">
    <RelativeLayout
        android:id="@+id/btn_home"
        android:layout_width="64dp"
        android:layout_height="match_parent">
        <ImageView
            android:layout_width="50dp"
            android:layout_height="40dp"
            android:src="@mipmap/ic_launcher"
            android:scaleType="centerInside"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="12sp"
        android:id="@+id/btn_az_menu"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:text="@string/wap_main_bottom_nav__az_menu"
        android:drawableTop="@drawable/tool_notification_az_menu"
        android:layout_weight="1"
        style="@style/NotificationTheme.Toolbar"/>
    <TextView
        android:textSize="12sp"
        android:id="@+id/btn_today"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:text="@string/wap_home__today"
        android:drawableTop="@drawable/tool_notification_sports"
        android:layout_weight="1"
        style="@style/NotificationTheme.Toolbar"/>
    <TextView
        android:textSize="12sp"
        android:id="@+id/btn_live"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:text="@string/component_betslip__live"
        android:drawableTop="@drawable/tool_notification_live"
        android:layout_weight="1"
        style="@style/NotificationTheme.Toolbar"/>
    <TextView
        android:textSize="12sp"
        android:id="@+id/btn_result"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:text="@string/common_functions__results"
        android:drawableTop="@drawable/tool_notification_results"
        android:layout_weight="1"
        style="@style/NotificationTheme.Toolbar"/>
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <TextView
            android:textSize="12sp"
            android:id="@+id/btn_open_bets"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/common_functions__open_bets"
            android:drawableTop="@drawable/tool_notification_open_bet"
            style="@style/NotificationTheme.Toolbar"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/absolute_type1"
            android:gravity="center"
            android:id="@+id/open_bets_count"
            android:background="@drawable/spr_open_bet_count_bg"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="8dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
</LinearLayout>
