<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="84dp">
        <FrameLayout
            android:background="@drawable/triangle"
            android:layout_width="60dp"
            android:layout_height="40dp"
            android:layout_marginBottom="-8dp"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="16dp"
            android:layout_alignParentEnd="true"
            android:backgroundTint="@color/background_type1_quaternary">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/close_img"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_close_black_24dp"
                app:tint="@color/text_type2_tertiary"/>
        </FrameLayout>
    </RelativeLayout>
    <RelativeLayout
        android:background="@color/background_type1_quaternary"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/header_container"
        android:layout_alignParentBottom="true">
        <View
            android:id="@+id/diver_line1"
            android:background="@color/line_type1_primary"
            android:paddingLeft="18dp"
            android:paddingRight="17dp"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="30dp"
            android:paddingStart="18dp"
            android:paddingEnd="17dp"/>
        <TextView
            android:enabled="false"
            android:textSize="15dp"
            android:textStyle="normal"
            android:textColor="@color/text_color_brand_secondary"
            android:gravity="center"
            android:id="@+id/reset_button"
            android:layout_width="100dp"
            android:layout_height="48dp"
            android:layout_marginLeft="13dp"
            android:layout_marginBottom="10dp"
            android:text="@string/common_functions__reset"
            android:layout_alignParentBottom="true"
            android:fontFamily="sans-serif"
            android:layout_marginStart="13dp"
            style="@style/Widget.App.CommonButton.Outline"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="normal"
            android:gravity="center"
            android:id="@+id/apply_button"
            android:background="@drawable/bg_filled_brand_secondary_2_radius_with_line_type2_primary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:text="@string/common_functions__apply"
            android:layout_toRightOf="@+id/reset_button"
            android:layout_alignBottom="@+id/reset_button"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_toEndOf="@+id/reset_button"
            style="@style/Widget.App.CommonButton.Contained"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/results_match_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="10dp"
            android:layout_above="@+id/reset_button"
            android:layout_below="@+id/diver_line1"/>
        <com.sportybet.plugin.realsports.results.ResultsLoadingView
            android:id="@+id/loading"
            android:background="@color/background_type1_secondary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </RelativeLayout>
</RelativeLayout>
