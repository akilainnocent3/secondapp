<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layHowTo"
        android:background="@color/fh_how_to_play"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.7"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.2"
        app:layout_constraintWidth_percent="0.9">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_16ssp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/title"
            android:tag="@string/about_fruit_hunt_cms"
            android:paddingTop="@dimen/_15sdp"
            android:paddingBottom="@dimen/_4sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_fruit_hunt"
            app:fontFamily="@font/motley_forces"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ScrollView
            android:orientation="vertical"
            android:id="@+id/scrollView"
            android:background="@color/fh_how_to_play"
            android:paddingLeft="@dimen/_10sdp"
            android:paddingRight="@dimen/_10sdp"
            android:paddingBottom="@dimen/_15sdp"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:paddingHorizontal="@dimen/_10sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:paddingLeft="@dimen/_6sdp"
                android:paddingRight="@dimen/_6sdp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/_6sdp">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_11ssp"
                    android:layout_gravity="center"
                    android:id="@+id/htpText1"
                    android:tag="@string/fh_how_to_play_android_cms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:lineSpacingExtra="2dp"
                    android:breakStrategy="high_quality"
                    android:justificationMode="inter_word"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TextPrimaryMedium"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/htpImage1"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/_14sdp"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/htpText1"
                    app:layout_constraintWidth_percent="0.36"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_11ssp"
                    android:layout_gravity="center"
                    android:id="@+id/htpText2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_14sdp"
                    android:lineSpacingExtra="2dp"
                    android:breakStrategy="high_quality"
                    android:justificationMode="inter_word"
                    app:layout_constraintTop_toBottomOf="@+id/htpImage1"
                    style="@style/TextPrimaryMedium"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/htpImage2"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/_14sdp"
                    app:layout_constraintDimensionRatio="167:332"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/htpText2"
                    app:layout_constraintWidth_percent="0.515"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_11ssp"
                    android:layout_gravity="center"
                    android:id="@+id/htpText3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_14sdp"
                    android:lineSpacingExtra="2dp"
                    android:breakStrategy="high_quality"
                    android:justificationMode="inter_word"
                    app:layout_constraintTop_toBottomOf="@+id/htpImage2"
                    style="@style/TextPrimaryMedium"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/htpImage3"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/_14sdp"
                    app:layout_constraintDimensionRatio="214:131"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/htpText3"
                    app:layout_constraintWidth_percent="0.681"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_11ssp"
                    android:layout_gravity="center"
                    android:id="@+id/htpText4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_14sdp"
                    android:lineSpacingExtra="2dp"
                    android:breakStrategy="high_quality"
                    android:justificationMode="inter_word"
                    app:layout_constraintTop_toBottomOf="@+id/htpImage3"
                    style="@style/TextPrimaryMedium"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/htpImage4"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/_14sdp"
                    app:layout_constraintDimensionRatio="214:135"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/htpText4"
                    app:layout_constraintWidth_percent="0.681"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_11ssp"
                    android:layout_gravity="center"
                    android:id="@+id/htpText5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_14sdp"
                    android:lineSpacingExtra="2dp"
                    android:breakStrategy="high_quality"
                    android:justificationMode="inter_word"
                    app:layout_constraintTop_toBottomOf="@+id/htpImage4"
                    style="@style/TextPrimaryMedium"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/htpImage5"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/_14sdp"
                    app:layout_constraintDimensionRatio="214:131"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/htpText5"
                    app:layout_constraintWidth_percent="0.681"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_11ssp"
                    android:layout_gravity="center"
                    android:id="@+id/htpText6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_14sdp"
                    android:lineSpacingExtra="2dp"
                    android:breakStrategy="high_quality"
                    android:justificationMode="inter_word"
                    app:layout_constraintTop_toBottomOf="@+id/htpImage5"
                    style="@style/TextPrimaryMedium"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/htpImage6"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/_14sdp"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/htpText6"
                    app:layout_constraintWidth_percent="0.2"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_11ssp"
                    android:layout_gravity="center"
                    android:id="@+id/htpText7"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_14sdp"
                    android:lineSpacingExtra="2dp"
                    android:breakStrategy="high_quality"
                    android:justificationMode="inter_word"
                    app:layout_constraintTop_toBottomOf="@+id/htpImage6"
                    style="@style/TextPrimaryMedium"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tint="@color/sb_black"
        app:backgroundTint="@color/white"
        app:fabSize="normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layHowTo"
        app:srcCompat="@drawable/close_icon_white"/>
</androidx.constraintlayout.widget.ConstraintLayout>
