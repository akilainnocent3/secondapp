<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/background_general_primary"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header_container"
            android:layout_width="0dp"
            android:layout_height="56dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textAppearance="@style/B1_B"
                android:textColor="@color/text_type1_tertiary"
                android:gravity="center"
                android:id="@+id/choose_title_text"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingHorizontal="16dp"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:textAppearance="@style/B2_M"
                android:textColor="@color/text_type1_tertiary"
                android:gravity="center"
                android:id="@+id/change_default_btn"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/page_payment__change_default"
                android:paddingHorizontal="16dp"
                app:layout_constraintEnd_toEndOf="parent"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/choose_number_header_group"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:constraint_referenced_ids="choose_title_text,change_default_btn"/>
            <TextView
                android:textAppearance="@style/B1_B"
                android:textColor="@color/text_type1_tertiary"
                android:gravity="center"
                android:id="@+id/change_default_title_text"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/page_payment__change_default"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:textAppearance="@style/B1_M"
                android:textColor="@color/brand_secondary"
                android:gravity="center"
                android:id="@+id/change_default_cancel_btn"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/common_functions__cancel"
                android:paddingHorizontal="16dp"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:textAppearance="@style/B1_M"
                android:textColor="@color/text_button_text"
                android:gravity="center"
                android:id="@+id/change_default_save_btn"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/common_functions__save"
                android:paddingHorizontal="16dp"
                app:layout_constraintEnd_toEndOf="parent"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/change_default_header_group"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:constraint_referenced_ids="change_default_title_text,change_default_cancel_btn,change_default_save_btn"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toTopOf="@+id/add_new_btn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/header_container"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/add_new_btn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            app:layout_constraintBottom_toBottomOf="parent">
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/guideline_begin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_begin="16dp"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/guideline_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_end="16dp"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/check_image_view"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/guideline_begin"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_check"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/add_icon_image_view"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:scaleType="center"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/check_image_view"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/icon_plus2"
                app:tint="@color/text_type1_secondary"/>
            <TextView
                android:textAppearance="@style/B2_B"
                android:textColor="@color/text_type1_primary"
                android:id="@+id/add_new_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/add_icon_image_view"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.sportybet.android.widget.BubbleView
            android:id="@+id/newFeatureAlertView"
            android:visibility="gone"
            android:layout_width="256dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="-20dp"
            android:layout_marginEnd="12dp"
            app:closable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/header_container"
            app:trianglePosition="top_right"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/loading_mask"
        android:background="#99ffffff"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ProgressBar
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
