<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/text_type1_tertiary"
        android:gravity="center"
        android:id="@+id/vote_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/live__user_result_prediction"
        android:fontFamily="sans-serif"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/vote_container"
        android:paddingLeft="48dp"
        android:paddingRight="48dp"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_below="@+id/vote_tip">
        <View
            android:id="@+id/line1"
            android:background="@color/line_type1_primary"
            android:layout_width="0dp"
            android:layout_height="3dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/vote_1"
            app:layout_constraintRight_toLeftOf="@+id/vote_2"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/line2"
            android:background="@color/line_type1_primary"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_weight="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/vote_2"
            app:layout_constraintRight_toLeftOf="@+id/vote_3"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.sportybet.plugin.realsports.event.comment.prematch.view.VoteCircleView
            android:id="@+id/vote_1"
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.sportybet.plugin.realsports.event.comment.prematch.view.VoteCircleView
            android:id="@+id/vote_2"
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.sportybet.plugin.realsports.event.comment.prematch.view.VoteCircleView
            android:id="@+id/vote_3"
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/vote_container2"
        android:paddingLeft="48dp"
        android:paddingRight="48dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_below="@+id/vote_tip">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.35"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.65"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.37"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.63"/>
        <View
            android:background="@color/line_type1_primary"
            android:layout_width="0dp"
            android:layout_height="3dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="@+id/guideline5"
            app:layout_constraintRight_toRightOf="@+id/guideline6"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.sportybet.plugin.realsports.event.comment.prematch.view.VoteCircleView
            android:id="@+id/vote_4"
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="@+id/guideline7"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.sportybet.plugin.realsports.event.comment.prematch.view.VoteCircleView
            android:id="@+id/vote_5"
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="@+id/guideline8"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/divider1"
        android:background="@color/line_type1_primary"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginBottom="16dp"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
