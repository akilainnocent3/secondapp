<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageButton
        android:id="@+id/back"
        android:background="?android:attr/selectableItemBackground"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/close"
        app:srcCompat="@drawable/ic_back_gray_16dp"
        app:tint="@color/text_type1_secondary"/>
    <ImageButton
        android:id="@+id/close"
        android:background="?android:attr/selectableItemBackground"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_close_black_24dp"
        app:tint="@color/text_type1_secondary"/>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_type1_primary"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="30dp"
        android:text="@string/register_login_int__account_confirmation"
        android:layout_marginHorizontal="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/close"/>
    <TextView
        android:textColor="@color/text_type1_primary"
        android:gravity="center"
        android:id="@+id/reset_confirm_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="30dp"
        android:text="@string/register_login_int__reset_pwd"
        android:layout_marginHorizontal="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <com.sporty.android.common_ui.widgets.ClearEditText
        android:textSize="14sp"
        android:textColor="@color/text_type1_primary"
        android:textColorHint="@color/text_type1_secondary"
        android:id="@+id/email"
        android:background="@drawable/bg_outlined_line_type1_secondary_2_radius"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:hint="@string/register_login_int__enter_your_email"
        android:maxLines="1"
        android:inputType="textEmailAddress"
        android:imeOptions="actionDone"
        android:paddingHorizontal="18dp"
        app:layout_constraintEnd_toEndOf="@+id/reset_confirm_hint"
        app:layout_constraintStart_toStartOf="@+id/reset_confirm_hint"
        app:layout_constraintTop_toBottomOf="@+id/reset_confirm_hint"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/brand_primary"
        android:id="@+id/error"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="@+id/email"
        app:layout_constraintStart_toStartOf="@+id/email"
        app:layout_constraintTop_toBottomOf="@+id/email"/>
    <com.sportybet.android.widget.ProgressButton
        android:id="@+id/next"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="@+id/email"
        app:layout_constraintStart_toStartOf="@+id/email"
        app:layout_constraintTop_toBottomOf="@+id/error"/>
</androidx.constraintlayout.widget.ConstraintLayout>
