<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="top"
    android:id="@+id/category_layout"
    android:layout_width="wrap_content"
    android:layout_height="34dp"
    android:layout_marginStart="4dp">
    <View
        android:id="@+id/category_background"
        android:background="@drawable/category_dark"
        android:paddingRight="10dp"
        android:layout_width="0dp"
        android:layout_height="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:id="@+id/category_image_layout"
        android:paddingLeft="10dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="@+id/category_layout"
        app:layout_constraintEnd_toStartOf="@+id/name"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/category_layout"
        app:layout_constraintTop_toTopOf="@+id/category_layout">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/category_icon"
            android:background="@drawable/circle"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginRight="8dp"/>
    </LinearLayout>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/category_text_color"
        android:id="@+id/name"
        android:tag="@string/featured_list_categories_cms"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_4sdp"
        android:text="Category"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/category_layout"
        app:layout_constraintEnd_toEndOf="@+id/category_layout"
        app:layout_constraintStart_toEndOf="@+id/category_image_layout"
        app:layout_constraintTop_toTopOf="@+id/category_layout"
        style="@style/TextPrimaryRegular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
