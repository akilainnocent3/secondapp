<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/category_empty_text"
    android:background="@android:color/white"
    android:layout_width="match_parent"
    android:layout_height="@dimen/outright_tournament_height">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/no_data_img"
        android:paddingTop="74dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/no_data"
        app:tint="@color/unsuccessful_error_color"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14dp"
        android:textColor="@color/unsuccessful_error_color"
        android:gravity="center"
        android:paddingLeft="12dp"
        android:paddingTop="30dp"
        android:paddingRight="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/common_feedback__no_results_in_category"
        android:paddingHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/no_data_img"/>
</androidx.constraintlayout.widget.ConstraintLayout>
