<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <CheckBox
        android:textSize="12dp"
        android:textColor="@color/text_type1_secondary"
        android:id="@+id/check_box"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:button="@drawable/ic_sporty_insure_check_box"
        android:minHeight="16dp"
        android:text="@string/common_bet_ways__1up_and_2up"
        android:fontFamily="sans-serif"
        android:paddingHorizontal="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ProgressBar
        android:id="@+id/loading_view"
        android:background="@color/transparent"
        android:visibility="gone"
        android:layout_width="25dp"
        android:layout_height="0dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/text_type1_secondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/text_type1_secondary"
        android:ellipsize="end"
        android:id="@+id/loading_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="16dp"
        android:text="@string/common_bet_ways__1up_and_2up"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/loading_view"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginLeft="6dp"
        style="@style/B2_R"/>
</merge>
