<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="170dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/open_bet_no_data_recommend_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12dp"
        android:textColor="@color/text_type1_primary"
        android:gravity="center"
        android:id="@+id/open_bet_no_bet_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/cashout__no_bets_no_problem"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/open_bet_no_data_recommend_icon"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12dp"
        android:textColor="@color/text_type1_primary"
        android:gravity="center"
        android:id="@+id/open_bet_no_login_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cashout__get_started_with_popular_codes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/open_bet_no_bet_text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
