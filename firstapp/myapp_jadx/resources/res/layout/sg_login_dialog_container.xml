<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="@dimen/_300sdp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/error_dialog_content"
        android:padding="@dimen/_8sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_8sdp"
        android:layout_marginRight="@dimen/_8sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="vertical"
            android:background="@color/white"
            android:paddingTop="@dimen/_24sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/_14sdp"
                android:textColor="#212121"
                android:gravity="center"
                android:id="@+id/error_message"
                android:tag="@string/err_login_cms"
                android:paddingLeft="@dimen/_4sdp"
                android:paddingRight="@dimen/_4sdp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_24sdp"
                android:text="Error! Please login to start game."
                android:lineSpacingExtra="@dimen/_3sdp"
                android:textAlignment="center"
                style="@style/TextPrimaryMedium"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/_14sdp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/exit_button"
                    android:tag="@string/exit_btn_dialog_cms"
                    android:background="#2c2c2c"
                    android:padding="@dimen/_10sdp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_8sdp"
                    android:layout_marginRight="@dimen/_4sdp"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:text="@string/label_dialog_exit"
                    android:maxLines="1"
                    android:layout_weight="0.33"
                    android:textAllCaps="false"
                    android:textAlignment="center"
                    android:autoSizeTextType="uniform"
                    style="@style/TextPrimaryMedium"/>
                <TextView
                    android:textSize="@dimen/_14sdp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/login_button"
                    android:tag="@string/login_btn_dialog_cms"
                    android:background="#0f9737"
                    android:padding="@dimen/_10sdp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_4sdp"
                    android:layout_marginRight="@dimen/_8sdp"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:text="@string/label_dialog_login"
                    android:maxLines="1"
                    android:layout_weight="0.67"
                    android:textAllCaps="false"
                    android:textAlignment="center"
                    android:autoSizeTextType="uniform"
                    style="@style/TextPrimaryMedium"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
