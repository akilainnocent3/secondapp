<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@color/background_type2_primary"
    android:paddingRight="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <android.widget.Space
        android:id="@+id/anchor"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"/>
    <ImageView
        android:id="@+id/index_img"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_toRightOf="@+id/anchor"
        android:layout_toEndOf="@+id/anchor"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="@color/text_color_text_type2_primary"
        android:gravity="start|center_vertical"
        android:id="@+id/left_text"
        android:layout_width="100dp"
        android:layout_height="35dp"
        android:layout_marginLeft="23dp"
        android:text="@string/jackpot__correct_events"
        android:layout_toRightOf="@+id/anchor"
        android:fontFamily="sans-serif"
        android:layout_toEndOf="@+id/anchor"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="@color/text_color_text_type2_primary"
        android:gravity="center"
        android:id="@+id/mid_Text"
        android:layout_width="80dp"
        android:layout_height="35dp"
        android:layout_marginLeft="130dp"
        android:text="@string/bet_history__no_dot_tickets"
        android:layout_toRightOf="@+id/anchor"
        android:fontFamily="sans-serif"
        android:layout_toEndOf="@+id/anchor"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="@color/text_color_text_type2_primary"
        android:gravity="end|center_vertical"
        android:id="@+id/right_text"
        android:layout_width="wrap_content"
        android:layout_height="35dp"
        android:text="@string/bet_history__winning_per_ticket"
        android:layout_alignParentRight="true"
        android:fontFamily="sans-serif"
        android:layout_alignParentEnd="true"/>
    <View
        android:id="@+id/diver_line"
        android:background="@color/background_type2_tertiary"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="16dp"
        android:layout_below="@+id/right_text"/>
</RelativeLayout>
