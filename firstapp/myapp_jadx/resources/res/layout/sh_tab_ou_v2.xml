<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tab_btn_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/spacer_0"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toStartOf="@+id/bet1_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.0227"/>
    <View
        android:id="@+id/blur_1"
        android:background="@drawable/card_bet_amount_blur_bet"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toStartOf="@+id/spacer_1"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/spacer_0"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bet1_layout"
        android:background="@drawable/sh_bet_button_background_v2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toStartOf="@+id/spacer_1"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/spacer_0"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/_10ssp"
            android:textColor="@color/sh_bet_text_enable_color"
            android:id="@+id/bet1_button"
            android:tag="@string/bet_text_game_cms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bet 1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TextPrimaryBold"/>
        <ImageView
            android:id="@+id/bet1_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_5sdp"
            android:layout_marginRight="@dimen/_5sdp"
            android:src="@drawable/sh_bet_place_selector"
            android:layout_marginHorizontal="@dimen/_5sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/bet1_button"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/spacer_1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toStartOf="@+id/bet2_layout"
        app:layout_constraintStart_toEndOf="@+id/bet1_layout"
        app:layout_constraintWidth_percent="0.0227"/>
    <View
        android:id="@+id/blur_2"
        android:background="@drawable/card_bet_amount_blur_bet"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toStartOf="@+id/spacer_2"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/spacer_1"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bet2_layout"
        android:background="@drawable/sh_bet_button_background_v2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toStartOf="@+id/spacer_2"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/spacer_1"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/_10ssp"
            android:textColor="@color/color_9C9C9C"
            android:id="@+id/bet2_button"
            android:tag="@string/bet_text_game_cms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bet 2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TextPrimaryBold"/>
        <ImageView
            android:id="@+id/bet2_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_5sdp"
            android:layout_marginRight="@dimen/_5sdp"
            android:src="@drawable/sh_bet_place_selector"
            android:layout_marginHorizontal="@dimen/_5sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/bet2_button"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/spacer_2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/bet2_layout"
        app:layout_constraintWidth_percent="0.0227"/>
</androidx.constraintlayout.widget.ConstraintLayout>
