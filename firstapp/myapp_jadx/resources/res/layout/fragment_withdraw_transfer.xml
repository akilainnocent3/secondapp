<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/transfer_content_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14dp"
                        android:textStyle="bold"
                        android:textColor="@color/text_type1_primary"
                        android:id="@+id/mobile_tint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="24dp"
                        android:text="@string/component_supporter__send_to_sporty_user"
                        android:fontFamily="sans-serif"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <FrameLayout
                        android:id="@+id/mobile_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginHorizontal="16dp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/mobile_tint">
                        <com.sporty.android.common_ui.widgets.ClearEditText
                            android:textSize="14dp"
                            android:id="@+id/mobile_number"
                            android:background="@drawable/bg_outlined_line_type1_secondary_2_radius"
                            android:paddingLeft="60dp"
                            android:paddingRight="11dp"
                            android:focusableInTouchMode="true"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:hint="@string/my_account__mobile_number"
                            android:maxLines="1"
                            android:maxLength="@integer/mobile_max_length"
                            android:digits="0123456789"
                            android:inputType="phone"
                            android:imeOptions="actionDone"/>
                        <TextView
                            android:textColor="@color/text_type1_secondary"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/prefix"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="18dp"/>
                    </FrameLayout>
                    <TextView
                        android:textSize="10sp"
                        android:textStyle="normal"
                        android:textColor="@color/warning_primary"
                        android:id="@+id/mobile_number_warning"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:minHeight="11dp"
                        android:text="@string/page_withdraw__invalid_expiry_date"
                        android:fontFamily="sans-serif"
                        app:layout_constraintEnd_toEndOf="@+id/mobile_container"
                        app:layout_constraintStart_toStartOf="@+id/mobile_container"
                        app:layout_constraintTop_toBottomOf="@+id/mobile_container"/>
                    <TextView
                        android:textSize="12dp"
                        android:textStyle="normal"
                        android:textColor="@color/text_type1_primary"
                        android:gravity="center"
                        android:id="@+id/balance_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:layout_marginRight="10dp"
                        android:minHeight="19dp"
                        android:fontFamily="sans-serif"
                        app:layout_constraintEnd_toStartOf="@+id/balance"
                        app:layout_constraintTop_toBottomOf="@+id/mobile_container"/>
                    <TextView
                        android:textSize="12dp"
                        android:textStyle="normal"
                        android:textColor="@color/text_type1_primary"
                        android:gravity="center"
                        android:id="@+id/balance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="19dp"
                        android:fontFamily="sans-serif"
                        app:layout_constraintEnd_toEndOf="@+id/mobile_container"
                        app:layout_constraintTop_toTopOf="@+id/balance_label"/>
                    <TextView
                        android:textSize="12dp"
                        android:textStyle="normal"
                        android:textColor="@color/text_type1_primary"
                        android:gravity="center"
                        android:id="@+id/withdrawable_balance_label"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginRight="10dp"
                        android:minHeight="19dp"
                        android:text="@string/app_common__withdraw_balance_label"
                        android:fontFamily="sans-serif"
                        app:layout_constraintRight_toLeftOf="@+id/withdrawable_balance"
                        app:layout_constraintTop_toBottomOf="@+id/balance_label"/>
                    <TextView
                        android:textSize="12dp"
                        android:textStyle="normal"
                        android:textColor="@color/text_type1_primary"
                        android:gravity="center"
                        android:id="@+id/withdrawable_balance"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="19dp"
                        android:fontFamily="sans-serif"
                        app:layout_constraintRight_toRightOf="@+id/mobile_container"
                        app:layout_constraintTop_toTopOf="@+id/withdrawable_balance_label"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/withdrawable_help"
                        android:padding="10dp"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="19dp"
                        app:layout_constraintBottom_toBottomOf="@+id/withdrawable_balance_label"
                        app:layout_constraintRight_toLeftOf="@+id/withdrawable_balance_label"
                        app:layout_constraintTop_toTopOf="@+id/withdrawable_balance_label"
                        app:srcCompat="@drawable/ic_help_outline_black_19dp"
                        app:tint="@color/text_type1_primary"/>
                    <FrameLayout
                        android:id="@+id/amount_container"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:layout_constraintEnd_toEndOf="@+id/mobile_container"
                        app:layout_constraintStart_toStartOf="@+id/mobile_container"
                        app:layout_constraintTop_toBottomOf="@+id/withdrawable_balance_label">
                        <TextView
                            android:textSize="14dp"
                            android:textStyle="normal"
                            android:textColor="@color/text_type1_primary"
                            android:gravity="center_vertical"
                            android:id="@+id/amount_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="12dp"
                            android:minHeight="48dp"
                            android:lineSpacingExtra="0dp"
                            android:fontFamily="sans-serif-medium"/>
                        <com.sporty.android.common_ui.widgets.ClearEditText
                            android:textAppearance="@style/B1_R"
                            android:textColor="@color/text_type1_primary"
                            android:textColorHint="@color/text_type1_secondary"
                            android:gravity="center"
                            android:id="@+id/amount"
                            android:background="@drawable/comb_edit_text_bg"
                            android:paddingLeft="110dp"
                            android:paddingRight="12dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:maxLines="1"
                            android:maxLength="9"
                            android:lineSpacingExtra="0dp"
                            android:inputType="numberDecimal"
                            android:imeOptions="actionDone"/>
                    </FrameLayout>
                    <TextView
                        android:textSize="10dp"
                        android:textStyle="normal"
                        android:textColor="@color/warning_primary"
                        android:id="@+id/amount_warning"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:minHeight="11dp"
                        android:fontFamily="sans-serif"
                        app:layout_constraintEnd_toEndOf="@+id/amount_container"
                        app:layout_constraintStart_toStartOf="@+id/amount_container"
                        app:layout_constraintTop_toBottomOf="@+id/amount_container"/>
                    <com.sportybet.android.widget.ProgressButton
                        android:id="@+id/next"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:minHeight="48dp"
                        android:text="@string/component_supporter__transfer"
                        app:layout_constraintEnd_toEndOf="@+id/mobile_container"
                        app:layout_constraintStart_toStartOf="@+id/mobile_container"
                        app:layout_constraintTop_toBottomOf="@+id/amount_warning"
                        app:layout_goneMarginTop="20dp"/>
                    <TextView
                        android:textColor="@color/text_type1_primary"
                        android:id="@+id/wh_tax_description"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/page_payment__withdraw_gh_tax_info"
                        app:layout_constraintEnd_toEndOf="@+id/next"
                        app:layout_constraintStart_toStartOf="@+id/next"
                        app:layout_constraintTop_toBottomOf="@+id/next"
                        style="@style/C1_R"/>
                    <com.sportybet.android.widget.SimpleDescriptionListView
                        android:id="@+id/description_list_view"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:layout_constraintEnd_toEndOf="@+id/mobile_container"
                        app:layout_constraintStart_toStartOf="@+id/mobile_container"
                        app:layout_constraintTop_toBottomOf="@+id/wh_tax_description"/>
                    <com.sporty.android.common_ui.widgets.AspectRatioImageView
                        android:id="@+id/withdraw_banner"
                        android:background="@android:color/white"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="20dp"
                        android:scaleType="fitXY"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/description_list_view"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </ScrollView>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/transfer_verifying_view"
                android:background="@color/background_general_primary"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="22dp"
                    android:textStyle="bold"
                    android:textColor="@color/text_type1_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/component_supporter__enable_transfer_to_friend"/>
                <TextView
                    android:textSize="14dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="32dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="32dp"
                    android:text="@string/component_supporter__for_the_security_of_your_funds_you_must_verify_your_bvn_tip"
                    android:lineSpacingExtra="7dp"
                    android:layout_marginHorizontal="32dp"/>
                <TextView
                    android:textSize="16dp"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="center_vertical"
                    android:id="@+id/bvn_entrance"
                    android:background="?android:attr/selectableItemBackground"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/page_withdraw__bvn"
                    android:drawablePadding="20dp"
                    android:paddingStart="32dp"
                    android:paddingEnd="18dp"/>
                <View
                    android:background="@color/line_type1_primary"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginHorizontal="16dp"/>
                <TextView
                    android:textSize="16dp"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="center_vertical"
                    android:id="@+id/withdrawal_pin_entrance"
                    android:background="?android:attr/selectableItemBackground"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/wap_profile__sporty_pin"
                    android:drawablePadding="20dp"
                    android:paddingStart="32dp"
                    android:paddingEnd="18dp"/>
                <View
                    android:background="@color/line_type1_primary"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginHorizontal="16dp"/>
                <TextView
                    android:textSize="16dp"
                    android:textColor="@color/text_type1_primary"
                    android:gravity="center_vertical"
                    android:id="@+id/email_entrance"
                    android:background="?android:attr/selectableItemBackground"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/common_functions__email"
                    android:drawablePadding="20dp"
                    android:paddingStart="32dp"
                    android:paddingEnd="18dp"/>
                <View
                    android:background="@color/line_type1_primary"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginHorizontal="16dp"/>
                <com.sportybet.android.widget.ProgressButton
                    android:id="@+id/transfer_verifying_enable_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginRight="16dp"
                    android:minHeight="48dp"
                    android:text="@string/common_functions__enable"
                    android:layout_marginHorizontal="16dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/cool_down_view"
                android:background="@color/background_general_primary"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_width="154dp"
                    android:layout_height="140dp"
                    android:layout_marginTop="40dp"
                    app:srcCompat="@drawable/icon_cooldown_timer"/>
                <TextView
                    android:textSize="22dp"
                    android:textStyle="bold"
                    android:textColor="@color/text_type1_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/component_supporter__cooldown"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/text_type1_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/component_supporter__transfer_to_friend_will_be_enabled_for_you_in"/>
                <TextView
                    android:textSize="40dp"
                    android:textStyle="normal"
                    android:textColor="@color/brand_secondary"
                    android:id="@+id/cool_down_timer_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <FrameLayout
        android:id="@+id/anti_interaction_mask"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.sporty.android.common_ui.widgets.LoadingViewNew
        android:id="@+id/loading_mask"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/init_mask"
        android:background="@color/background_general_primary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.sporty.android.common_ui.widgets.LoadingViewNew
        android:id="@+id/init_failed_mask"
        android:background="@color/background_general_primary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
