<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:orientation="vertical"
        android:id="@+id/game_limit_container"
        android:background="@color/sh_dialog_bg_dark_theme"
        android:paddingBottom="@dimen/_8sdp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/_8sdp"
        app:cardBackgroundColor="@color/sg_transparent"
        app:cardCornerRadius="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.7"
        app:layout_constraintHorizontal_bias="0.487"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.172"
        app:layout_constraintWidth_percent="0.93">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:background="@drawable/sh_dialog_bg_v2"
            android:paddingBottom="@dimen/_8sdp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/_11ssp"
                android:gravity="center"
                android:id="@+id/text"
                android:tag="@string/provably_fair_settings_small_case_cms"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/_12sdp"
                android:text="Provably Fair Settings"
                android:lineSpacingExtra="2dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextPrimaryBold"/>
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintHeight_percent="0.9"
                app:layout_constraintTop_toBottomOf="@+id/text">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/_10ssp"
                        android:textColor="@color/color_7A7A7A"
                        android:id="@+id/provably_fair_text"
                        android:tag="@string/provably_fair_info_cms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_12ssp"
                        android:layout_marginTop="@dimen/_9sdp"
                        android:layout_marginRight="@dimen/_12ssp"
                        android:text="@string/provably_setting_text"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginHorizontal="@dimen/_12ssp"
                        android:justificationMode="inter_word"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TextPrimaryMedium"/>
                    <TextView
                        android:textSize="@dimen/_10ssp"
                        android:id="@+id/what_provably"
                        android:tag="@string/what_is_provably_fair_cms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_12ssp"
                        android:layout_marginTop="12dp"
                        android:text="@string/provably_fair"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginStart="16dp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/provably_fair_text"
                        style="@style/TextPrimaryBold"/>
                    <View
                        android:id="@+id/view"
                        android:background="@color/bg_secondary"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginTop="8sp"
                        android:layout_marginBottom="0x7f0702ae"
                        app:layout_constraintTop_toBottomOf="@+id/what_provably"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/client_seed_image"
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:src="@drawable/client_seed"
                        android:layout_marginStart="0x7f0702ae"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/view"
                        style="@style/TextPrimaryBold"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_10ssp"
                        android:id="@+id/client_seed_text"
                        android:tag="@string/next_client_seed_revamped_cms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your Next Client Seed"
                        android:layout_marginStart="@dimen/_9sdp"
                        app:layout_constraintBottom_toBottomOf="@+id/client_seed_image"
                        app:layout_constraintStart_toEndOf="@+id/client_seed_image"
                        app:layout_constraintTop_toTopOf="@+id/client_seed_image"
                        style="@style/TextPrimaryMedium"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_10ssp"
                        android:tag="@string/seed_cms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        app:layout_constraintBottom_toBottomOf="@+id/client_seed_text"
                        app:layout_constraintStart_toEndOf="@+id/client_seed_text"
                        app:layout_constraintTop_toTopOf="@+id/client_seed_text"
                        style="@style/TextPrimaryBold"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_10ssp"
                        android:textColor="@color/color_7A7A7A"
                        android:id="@+id/client_seed_sec_text"
                        android:tag="@string/seed_info_revamp_cms"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:text="@string/client_seed_secondary"
                        android:layout_marginStart="0x7f0702ae"
                        android:justificationMode="inter_word"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/client_seed_image"
                        app:layout_constraintWidth_percent="0.9"
                        style="@style/TextPrimaryMedium"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/random_layout"
                        android:background="@drawable/card_fairness"
                        android:paddingLeft="@dimen/_9sdp"
                        android:paddingTop="@dimen/_1sdp"
                        android:paddingRight="@dimen/_9sdp"
                        android:paddingBottom="@dimen/_1sdp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_12sdp"
                        android:layout_marginTop="@dimen/_7sdp"
                        android:layout_marginRight="@dimen/_12sdp"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        android:paddingHorizontal="@dimen/_9sdp"
                        android:paddingVertical="@dimen/_1sdp"
                        app:layout_constraintTop_toBottomOf="@+id/client_seed_sec_text">
                        <androidx.appcompat.widget.AppCompatRadioButton
                            android:id="@+id/random_radio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            app:backgroundTint="@color/swipe_color"
                            app:buttonTint="@color/swipe_color"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/_10ssp"
                            android:textColor="@color/fbg_929292_color"
                            android:id="@+id/random_text"
                            android:tag="@string/random_cms_new_game_cms"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Random on every new game"
                            android:layout_marginStart="-5dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/random_radio"
                            app:layout_constraintTop_toTopOf="parent"
                            style="@style/TextPrimaryBold"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/manual_layout"
                        android:background="@drawable/card_fairness"
                        android:paddingLeft="@dimen/_9sdp"
                        android:paddingTop="@dimen/_1sdp"
                        android:paddingRight="@dimen/_9sdp"
                        android:paddingBottom="@dimen/_1sdp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_12ssp"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:layout_marginRight="@dimen/_12ssp"
                        android:layout_marginHorizontal="@dimen/_12ssp"
                        android:paddingHorizontal="@dimen/_9sdp"
                        android:paddingVertical="@dimen/_1sdp"
                        app:layout_constraintTop_toBottomOf="@+id/random_layout">
                        <androidx.appcompat.widget.AppCompatRadioButton
                            android:id="@+id/manual_radio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:layout_marginStart="@dimen/_9sdp"
                            app:backgroundTint="@color/swipe_color"
                            app:buttonTint="@color/swipe_color"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/_10ssp"
                            android:textColor="@color/fbg_929292_color"
                            android:id="@+id/manual_text"
                            android:tag="@string/enter_manually_cms"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Enter manually"
                            android:layout_marginStart="-5dp"
                            app:layout_constraintBottom_toBottomOf="@+id/manual_radio"
                            app:layout_constraintStart_toEndOf="@+id/manual_radio"
                            app:layout_constraintTop_toTopOf="@+id/manual_radio"
                            style="@style/TextPrimaryBold"/>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/current_layout"
                            android:background="@drawable/card_fairness"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="0x7f0702ae"
                            android:minHeight="@dimen/_32sdp"
                            android:layout_marginStart="@dimen/_12ssp"
                            android:layout_marginEnd="@dimen/_12sdp"
                            android:backgroundTint="#1a1a1a"
                            app:layout_constraintTop_toBottomOf="@+id/manual_text">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="@dimen/_11ssp"
                                android:textColor="@color/sh_gray_text_dark_theme"
                                android:id="@+id/current_text"
                                android:tag="@string/current_cms"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Current"
                                android:layout_marginStart="0x7f0702ae"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                style="@style/TextPrimaryMedium"/>
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textColor="@color/sh_gray_text_dark_theme"
                                android:id="@+id/current_colon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" : "
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/current_text"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintWidth_percent="0.4"
                                style="@style/TextPrimaryBold"/>
                            <EditText
                                android:textSize="@dimen/_11ssp"
                                android:id="@+id/current"
                                android:background="@null"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="0x7f0701ed"
                                android:text="Current"
                                android:inputType="textNoSuggestions"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/current_colon"
                                app:layout_constraintTop_toTopOf="parent"
                                style="@style/TextPrimaryMedium"/>
                            <androidx.appcompat.widget.AppCompatImageView
                                android:textSize="@dimen/_12ssp"
                                android:id="@+id/tick"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/tick"
                                android:layout_marginEnd="0x7f0702ae"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                style="@style/TextPrimaryRegular"/>
                            <androidx.appcompat.widget.AppCompatImageView
                                android:textSize="@dimen/_12ssp"
                                android:id="@+id/cross"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/cross_red"
                                android:layout_marginEnd="0x7f0702ae"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/tick"
                                app:layout_constraintTop_toTopOf="parent"
                                style="@style/TextPrimaryRegular"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <View
                        android:id="@+id/view1"
                        android:background="@color/color_7A7A7A"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:layout_marginBottom="0x7f0702ae"
                        app:layout_constraintTop_toBottomOf="@+id/manual_layout"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/server_seed_image"
                        android:layout_width="@dimen/_23sdp"
                        android:layout_height="@dimen/_25sdp"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:src="@drawable/server_seed"
                        android:layout_marginStart="0x7f0702ae"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/view1"
                        style="@style/TextPrimaryBold"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_10ssp"
                        android:id="@+id/server_seed_text"
                        android:tag="@string/server_seed_revamp_cms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-2dp"
                        android:text="Server seed SHA256"
                        android:layout_marginStart="@dimen/_9sdp"
                        app:layout_constraintStart_toEndOf="@+id/server_seed_image"
                        app:layout_constraintTop_toTopOf="@+id/server_seed_image"
                        style="@style/TextPrimaryMedium"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_10ssp"
                        android:tag="@string/seed_cms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-1dp"
                        android:text=":"
                        app:layout_constraintBottom_toBottomOf="@+id/server_seed_text"
                        app:layout_constraintStart_toEndOf="@+id/server_seed_text"
                        app:layout_constraintTop_toTopOf="@+id/server_seed_text"
                        app:layout_constraintWidth_percent="0.4"
                        style="@style/TextPrimaryBold"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_10ssp"
                        android:textColor="@color/color_7A7A7A"
                        android:id="@+id/generated_text"
                        android:tag="@string/settings_generated_on_our_side_cms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Generated on our side"
                        android:layout_marginStart="@dimen/_9sdp"
                        app:layout_constraintStart_toEndOf="@+id/server_seed_image"
                        app:layout_constraintTop_toBottomOf="@+id/server_seed_text"
                        style="@style/TextPrimaryMedium"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_11ssp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/server_seed"
                        android:background="@drawable/card_fairness"
                        android:paddingLeft="@dimen/_12sdp"
                        android:paddingTop="@dimen/_3sdp"
                        android:paddingRight="@dimen/_12sdp"
                        android:paddingBottom="@dimen/_3sdp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_8sdp"
                        android:minHeight="@dimen/_32sdp"
                        android:backgroundTint="@color/sh_top_win_item_bg_dark_theme"
                        android:paddingVertical="@dimen/_3sdp"
                        app:layout_constraintTop_toBottomOf="@+id/generated_text"
                        style="@style/TextPrimaryBold"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <View
        android:id="@+id/spacer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.1"
        app:layout_constraintTop_toBottomOf="@+id/game_limit_container"/>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tint="@color/sb_black"
        app:backgroundTint="@color/white"
        app:fabSize="normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spacer"
        app:srcCompat="@drawable/close_icon_white"/>
</androidx.constraintlayout.widget.ConstraintLayout>
