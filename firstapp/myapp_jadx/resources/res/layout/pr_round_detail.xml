<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:id="@+id/container"
        android:paddingBottom="@dimen/_8sdp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="@color/color_212121"
        app:cardCornerRadius="@dimen/_6sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.43"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.197"
        app:layout_constraintWidth_percent="0.973">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/rocket_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/biggest_coeff"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_percent="0.16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textSize="@dimen/_14ssp"
                        android:textColor="@color/white"
                        android:id="@+id/round_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:layout_marginBottom="@dimen/_10sdp"
                        android:layout_marginStart="@dimen/_15sdp"
                        android:autoSizeTextType="uniform"
                        android:autoSizeStepGranularity="@dimen/_1ssp"
                        android:autoSizeMinTextSize="@dimen/_6ssp"
                        android:layout_marginVertical="@dimen/_10sdp"
                        android:autoSizeMaxTextSize="@dimen/_14ssp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/round_date"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TextPrimaryBold"/>
                    <TextView
                        android:textSize="@dimen/_14ssp"
                        android:textColor="@color/white"
                        android:id="@+id/round_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:layout_marginBottom="@dimen/_10sdp"
                        android:layout_marginEnd="@dimen/_15sdp"
                        android:autoSizeTextType="uniform"
                        android:autoSizeStepGranularity="@dimen/_1ssp"
                        android:autoSizeMinTextSize="@dimen/_6ssp"
                        android:layout_marginVertical="@dimen/_10sdp"
                        android:autoSizeMaxTextSize="@dimen/_14ssp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/round_name"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TextPrimaryRegular"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <View
                    android:id="@+id/view1"
                    android:background="@color/sg_color_charcoal_grey"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    app:layout_constraintTop_toBottomOf="@+id/biggest_coeff"/>
                <View
                    android:id="@+id/view_left1"
                    android:layout_width="5dp"
                    android:layout_height="match_parent"
                    app:layout_constraintLeft_toLeftOf="parent"/>
                <View
                    android:id="@+id/view_right1"
                    android:layout_width="5dp"
                    android:layout_height="match_parent"
                    app:layout_constraintEnd_toEndOf="parent"/>
                <com.sportygames.pocketrocket.component.RoundDetailBetList
                    android:id="@+id/Total_bets"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/_10sdp"
                    app:layout_constraintEnd_toStartOf="@+id/red_bets"
                    app:layout_constraintHeight_percent="0.22"
                    app:layout_constraintStart_toEndOf="@+id/view_left1"
                    app:layout_constraintTop_toBottomOf="@+id/view1"
                    app:layout_constraintWidth_percent="0.22"/>
                <com.sportygames.pocketrocket.component.RoundDetailBetList
                    android:id="@+id/red_bets"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/_10sdp"
                    app:layout_constraintEnd_toStartOf="@+id/purple_bets"
                    app:layout_constraintHeight_percent="0.22"
                    app:layout_constraintStart_toEndOf="@+id/Total_bets"
                    app:layout_constraintTop_toBottomOf="@+id/view1"
                    app:layout_constraintWidth_percent="0.22"/>
                <com.sportygames.pocketrocket.component.RoundDetailBetList
                    android:id="@+id/purple_bets"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/_10sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/blue_bets"
                    app:layout_constraintHeight_percent="0.22"
                    app:layout_constraintStart_toEndOf="@+id/red_bets"
                    app:layout_constraintTop_toBottomOf="@+id/view1"
                    app:layout_constraintWidth_percent="0.22"/>
                <com.sportygames.pocketrocket.component.RoundDetailBetList
                    android:id="@+id/blue_bets"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/_10sdp"
                    app:layout_constraintEnd_toStartOf="@+id/view_right1"
                    app:layout_constraintHeight_percent="0.22"
                    app:layout_constraintStart_toEndOf="@+id/purple_bets"
                    app:layout_constraintTop_toBottomOf="@+id/view1"
                    app:layout_constraintWidth_percent="0.22"/>
                <com.sportygames.pocketrocket.component.RoundDetailBetList
                    android:id="@+id/heighest_stake"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/_10sdp"
                    app:layout_constraintEnd_toStartOf="@+id/heighest_cashout_coeff"
                    app:layout_constraintHeight_percent="0.22"
                    app:layout_constraintStart_toEndOf="@+id/view_left1"
                    app:layout_constraintTop_toBottomOf="@+id/red_bets"
                    app:layout_constraintWidth_percent="0.46"/>
                <com.sportygames.pocketrocket.component.RoundDetailBetList
                    android:id="@+id/heighest_cashout_coeff"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/_10sdp"
                    app:layout_constraintEnd_toStartOf="@+id/view_right1"
                    app:layout_constraintHeight_percent="0.22"
                    app:layout_constraintStart_toEndOf="@+id/heighest_stake"
                    app:layout_constraintTop_toBottomOf="@+id/red_bets"
                    app:layout_constraintWidth_percent="0.46"/>
                <com.sportygames.pocketrocket.component.RoundDetailBetList
                    android:id="@+id/red_result"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/_10sdp"
                    app:layout_constraintEnd_toStartOf="@+id/purple_result"
                    app:layout_constraintHeight_percent="0.22"
                    app:layout_constraintStart_toEndOf="@+id/view_left1"
                    app:layout_constraintTop_toBottomOf="@+id/heighest_stake"
                    app:layout_constraintWidth_percent="0.3"/>
                <com.sportygames.pocketrocket.component.RoundDetailBetList
                    android:id="@+id/purple_result"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/_10sdp"
                    app:layout_constraintEnd_toStartOf="@+id/blue_result"
                    app:layout_constraintHeight_percent="0.22"
                    app:layout_constraintStart_toEndOf="@+id/red_result"
                    app:layout_constraintTop_toBottomOf="@+id/heighest_stake"
                    app:layout_constraintWidth_percent="0.3"/>
                <com.sportygames.pocketrocket.component.RoundDetailBetList
                    android:id="@+id/blue_result"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/_10sdp"
                    app:layout_constraintEnd_toStartOf="@+id/view_right1"
                    app:layout_constraintHeight_percent="0.22"
                    app:layout_constraintStart_toEndOf="@+id/purple_result"
                    app:layout_constraintTop_toBottomOf="@+id/heighest_stake"
                    app:layout_constraintWidth_percent="0.3"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.github.ybq.android.spinkit.SpinKitView
                android:id="@+id/spin_kit_symbol"
                android:layout_width="@dimen/_35sdp"
                android:layout_height="@dimen/_35ssp"
                android:layout_centerHorizontal="true"
                app:SpinKit_Color="@android:color/darker_gray"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/SpinKitStyle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tint="@color/sb_black"
        android:backgroundTint="@color/white"
        app:fabSize="normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/container"
        app:srcCompat="@drawable/close_icon_white"/>
</androidx.constraintlayout.widget.ConstraintLayout>
