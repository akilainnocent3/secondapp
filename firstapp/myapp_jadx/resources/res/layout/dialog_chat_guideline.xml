<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/dialog_layout"
    android:background="@color/background_general_primary"
    android:paddingTop="32dp"
    android:paddingBottom="32dp"
    android:clipToPadding="false"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:paddingVertical="32dp">
    <ImageView
        android:id="@+id/img_icon"
        android:layout_width="120dp"
        android:layout_height="120dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/chat_guideline"/>
    <TextView
        android:textSize="18dp"
        android:textStyle="bold"
        android:textColor="@color/text_type1_primary"
        android:gravity="center"
        android:id="@+id/tv_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/component_wap_share_bet__chat_room_guidelines_title"
        android:fontFamily="sans-serif"
        app:layout_constraintBottom_toTopOf="@+id/webview_description"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_icon"/>
    <WebView
        android:id="@+id/webview_description"
        android:layout_width="240dp"
        android:layout_height="198dp"
        android:layout_margin="20dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_ok"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_dialog_title"/>
    <com.sportybet.android.widget.ProgressButton
        android:enabled="false"
        android:id="@+id/btn_ok"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="20dp"
        android:text="@string/common_functions__ok"
        android:textAllCaps="false"
        android:layout_marginHorizontal="20dp"
        app:isLoading="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/webview_description"/>
</androidx.constraintlayout.widget.ConstraintLayout>
