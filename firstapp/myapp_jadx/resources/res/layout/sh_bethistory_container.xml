<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bethistory_main_ll"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:orientation="vertical"
        android:id="@+id/game_limit_container"
        android:background="@color/sh_dialog_bg_dark_theme"
        android:paddingBottom="@dimen/_8sdp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/_8sdp"
        app:cardBackgroundColor="@color/sh_dialog_bg_dark_theme"
        app:cardCornerRadius="@dimen/_6sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.7"
        app:layout_constraintHorizontal_bias="0.487"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.202"
        app:layout_constraintWidth_percent="0.93">
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/bethistory_container_list_layer"
            android:background="@color/sh_dialog_bg_dark_theme"
            android:padding="@dimen/_8sdp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHeight_percent="0.7"
            app:layout_constraintHorizontal_bias="0.487"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.201"
            app:layout_constraintWidth_percent="0.9">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/bet_history_tab"
                android:background="@drawable/bet_history_tab_strip_background"
                android:padding="1dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:layout_marginBottom="@dimen/_6sdp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent">
                <TextView
                    android:textSize="@dimen/_10ssp"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/classic_header"
                    android:tag="@string/classic_cms"
                    android:background="@drawable/history_eneble_disable_classic"
                    android:paddingTop="@dimen/_3sdp"
                    android:paddingBottom="@dimen/_3sdp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Classic"
                    android:textAlignment="center"
                    android:paddingVertical="@dimen/_3sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tab_divider_1"
                    app:layout_constraintHorizontal_chainStyle="spread"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TextPrimaryRegular"/>
                <View
                    android:id="@+id/tab_divider_1"
                    android:background="@drawable/bet_history_tab_divider"
                    android:layout_width="0.5dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/ou_header"
                    app:layout_constraintStart_toEndOf="@+id/classic_header"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/_10ssp"
                    android:gravity="center_horizontal"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/ou_header"
                    android:tag="@string/over_under_cms"
                    android:background="@drawable/sh_history_ou_background"
                    android:paddingTop="@dimen/_3sdp"
                    android:paddingBottom="@dimen/_3sdp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="O/U"
                    android:textAlignment="center"
                    android:paddingVertical="@dimen/_3sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tab_divider_2"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toEndOf="@+id/tab_divider_1"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TextPrimaryRegular"/>
                <View
                    android:id="@+id/tab_divider_2"
                    android:background="@drawable/bet_history_tab_divider"
                    android:layout_width="0.5dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/range_header"
                    app:layout_constraintStart_toEndOf="@+id/ou_header"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/_10ssp"
                    android:gravity="center_horizontal"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/range_header"
                    android:tag="@string/range_cms"
                    android:background="@drawable/sh_history_range_background"
                    android:paddingTop="@dimen/_3sdp"
                    android:paddingBottom="@dimen/_3sdp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Range"
                    android:textAlignment="center"
                    android:paddingVertical="@dimen/_3sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toEndOf="@+id/tab_divider_2"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TextPrimaryRegular"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/bet_history_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_3sdp"
                android:layout_marginRight="@dimen/_8sdp"
                android:layout_marginBottom="@dimen/_6sdp"
                android:layout_below="@+id/bet_history_tab"
                android:layout_marginHorizontal="@dimen/_8sdp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent">
                <TextView
                    android:textSize="@dimen/_11ssp"
                    android:id="@+id/time_header"
                    android:tag="@string/time_cms"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/bet_history_head_time"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="0.19"
                    style="@style/BetHistoryHeaderTextFontStyle"/>
                <TextView
                    android:textSize="@dimen/_11ssp"
                    android:gravity="center_horizontal"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/stake_header"
                    android:tag="@string/stake_cms"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/bet_history_head_stake"
                    android:textAlignment="center"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/time_header"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="0.26"
                    style="@style/BetHistoryHeaderTextFontStyle"/>
                <TextView
                    android:textSize="@dimen/_11ssp"
                    android:gravity="center_horizontal"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/status_header"
                    android:tag="@string/status_cms"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/bet_history_head_status"
                    android:textAlignment="center"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/stake_header"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="0.3"
                    style="@style/BetHistoryHeaderTextFontStyle"/>
                <TextView
                    android:textSize="@dimen/_11ssp"
                    android:gravity="center_horizontal"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/coeff"
                    android:tag="@string/coeff_cms"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/bet_history_head_coeff"
                    android:textAlignment="center"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/status_header"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="0"
                    style="@style/BetHistoryHeaderTextFontStyle"/>
                <TextView
                    android:textSize="@dimen/_12ssp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/coeff"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="0.25"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/_12sdp"
                android:layout_below="@+id/bet_history_header">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center"
                    android:id="@+id/no_record_found"
                    android:background="@color/color_111111"
                    android:paddingTop="@dimen/_8sdp"
                    android:paddingBottom="@dimen/_8sdp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:paddingVertical="@dimen/_8sdp">
                    <TextView
                        android:textSize="@dimen/_9ssp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/no_record_text"
                        android:tag="@string/no_history_text_cms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/bet_history_no_record"
                        style="@style/TextPrimaryBold"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/bethistory_container_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:overScrollMode="never"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <RelativeLayout
                android:id="@+id/loading_data"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true">
                <com.github.ybq.android.spinkit.SpinKitView
                    android:id="@+id/spin_kit"
                    android:visibility="visible"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_marginLeft="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_35sdp"
                    app:SpinKit_Color="@android:color/white"
                    style="@style/SpinKitView.Small.DoubleBounce"/>
            </RelativeLayout>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/bet_history_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/close"
        app:backgroundTint="@color/white"
        app:fabSize="normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/game_limit_container"
        app:srcCompat="@drawable/close_icon_white"/>
</androidx.constraintlayout.widget.ConstraintLayout>
