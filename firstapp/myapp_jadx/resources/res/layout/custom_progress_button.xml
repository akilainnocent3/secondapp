<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:background="@drawable/bg_filled_brand_secondary_2_radius_with_brand_secondary_disable"
    android:duplicateParentState="true"
    android:layout_width="match_parent"
    android:layout_height="44dp">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/progress_layout"
        android:duplicateParentState="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ProgressBar
            android:id="@+id/progress"
            android:visibility="gone"
            android:duplicateParentState="true"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginRight="14dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/text_color_brand_tertiary"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_color_brand_tertiary"
            android:gravity="center_horizontal"
            android:id="@+id/text"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="false"
            android:fontFamily="sans-serif"/>
    </LinearLayout>
    <TextView
        android:textSize="10sp"
        android:textStyle="normal"
        android:textColor="@color/text_color_brand_tertiary"
        android:gravity="center_horizontal"
        android:id="@+id/p_desc"
        android:visibility="visible"
        android:duplicateParentState="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/progress_layout"
        android:fontFamily="sans-serif"/>
</RelativeLayout>
