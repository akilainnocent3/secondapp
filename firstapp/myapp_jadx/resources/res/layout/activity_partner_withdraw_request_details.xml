<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/title_bar"
        android:background="?attr/colorTitleBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/back"
            android:background="?android:attr/selectableItemBackground"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_action_bar_back"
            app:tint="?attr/colorTitleBarTint"/>
        <TextView
            android:textSize="20dp"
            android:textStyle="normal"
            android:textColor="?attr/colorTitleBarText"
            android:gravity="center_vertical"
            android:id="@+id/back_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/page_transaction__request_details"
            android:singleLine="true"
            android:layout_toRightOf="@+id/back"
            android:lineSpacingExtra="8dp"
            android:fontFamily="sans-serif-medium"
            android:layout_toEndOf="@+id/back"/>
        <ImageButton
            android:id="@+id/home"
            android:background="?android:attr/selectableItemBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            app:srcCompat="@drawable/ic_home"
            app:tint="?attr/colorTitleBarTint"/>
    </RelativeLayout>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/total_info"
                    android:background="@color/background_type1_quaternary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="normal"
                        android:textColor="@color/text_type1_primary"
                        android:id="@+id/withdraw_amount_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="19dp"
                        android:layout_marginRight="16dp"
                        android:text="@string/page_withdraw__amount_label"
                        android:fontFamily="sans-serif"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_type1_primary"
                        android:id="@+id/amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="16dp"
                        android:fontFamily="sans-serif"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/withdraw_amount_label"/>
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="normal"
                        android:textColor="@color/text_type1_secondary"
                        android:id="@+id/fee_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="19dp"
                        android:text="@string/page_withdraw__commission_to_partner"
                        android:fontFamily="sans-serif"
                        app:layout_constraintLeft_toLeftOf="@+id/withdraw_amount_label"
                        app:layout_constraintTop_toBottomOf="@+id/withdraw_amount_label"/>
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="normal"
                        android:textColor="@color/text_type1_primary"
                        android:id="@+id/fee"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        app:layout_constraintRight_toRightOf="@+id/amount"
                        app:layout_constraintTop_toTopOf="@+id/fee_label"/>
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="normal"
                        android:textColor="@color/text_type1_secondary"
                        android:id="@+id/cancel_fee_label"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/page_withdraw__cancellation_fee"
                        android:fontFamily="sans-serif"
                        app:layout_constraintLeft_toLeftOf="@+id/fee_label"
                        app:layout_constraintTop_toBottomOf="@+id/fee_label"/>
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="normal"
                        android:textColor="@color/text_type1_primary"
                        android:id="@+id/cancel_fee"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        app:layout_constraintRight_toRightOf="@+id/fee"
                        app:layout_constraintTop_toTopOf="@+id/cancel_fee_label"/>
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="normal"
                        android:textColor="@color/text_type1_secondary"
                        android:gravity="center"
                        android:id="@+id/partner_code_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:minHeight="14dp"
                        android:text="@string/page_withdraw__partner_code"
                        android:lineSpacingExtra="6.8sp"
                        android:fontFamily="sans-serif"
                        app:layout_constraintLeft_toLeftOf="@+id/fee_label"
                        app:layout_constraintTop_toBottomOf="@+id/cancel_fee_label"/>
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="normal"
                        android:textColor="@color/text_type1_primary"
                        android:id="@+id/partner_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif"
                        app:layout_constraintRight_toRightOf="@+id/fee"
                        app:layout_constraintTop_toBottomOf="@+id/cancel_fee"/>
                    <TextView
                        android:textSize="13sp"
                        android:textStyle="normal"
                        android:textColor="@color/text_type1_secondary"
                        android:id="@+id/partner_info"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/common_functions__info"
                        android:fontFamily="sans-serif"
                        app:layout_constraintLeft_toLeftOf="@+id/partner_code_label"
                        app:layout_constraintTop_toBottomOf="@+id/partner_code_label"/>
                    <TextView
                        android:textSize="13sp"
                        android:textStyle="normal"
                        android:textColor="@color/text_type1_primary"
                        android:id="@+id/partner_info_text"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="sans-serif"
                        app:layout_constraintRight_toRightOf="@+id/fee"
                        app:layout_constraintTop_toBottomOf="@+id/partner_code"/>
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="normal"
                        android:textColor="@color/text_type1_secondary"
                        android:id="@+id/tradeNo_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/page_transaction__trade_no"
                        android:fontFamily="sans-serif"
                        app:layout_constraintLeft_toLeftOf="@+id/partner_code_label"
                        app:layout_constraintTop_toBottomOf="@+id/partner_info"/>
                    <TextView
                        android:textSize="13sp"
                        android:textStyle="normal"
                        android:textColor="@color/text_type1_primary"
                        android:id="@+id/tradeNo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:layout_marginBottom="16dp"
                        android:fontFamily="sans-serif"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintRight_toRightOf="@+id/partner_code"
                        app:layout_constraintTop_toTopOf="@+id/tradeNo_label"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/request_time_line_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="32dp"
                    android:layout_marginRight="16dp"
                    android:overScrollMode="never"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintLeft_toLeftOf="@+id/total_info"
                    app:layout_constraintTop_toBottomOf="@+id/total_info"/>
                <TextView
                    android:gravity="center"
                    android:id="@+id/offline_cancel"
                    android:visibility="gone"
                    android:layout_width="304dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:minHeight="36dp"
                    android:text="@string/page_withdraw__cancel_withdraw"
                    app:layout_constraintLeft_toLeftOf="@+id/total_info"
                    app:layout_constraintRight_toRightOf="@+id/total_info"
                    app:layout_constraintTop_toBottomOf="@+id/request_time_line_recycler_view"
                    style="@style/Widget.App.CommonButton.Outline"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <com.sporty.android.common_ui.widgets.LoadingViewNew
        android:id="@+id/loading_mask"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/init_mask"
        android:background="@color/background_general_primary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"/>
    <com.sporty.android.common_ui.widgets.LoadingViewNew
        android:id="@+id/init_failed_mask"
        android:background="@color/background_general_primary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
