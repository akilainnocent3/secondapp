<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/delete_event"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        android:maxWidth="24dp"
        android:maxHeight="24dp"
        android:paddingStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_cancel"
        app:tint="@color/text_type2_primary"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/mm_sport_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/delete_event"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_mm_football"
        app:tint="@color/text_type2_primary"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16dp"
        android:textColor="@color/text_type2_primary"
        android:ellipsize="marquee"
        android:id="@+id/outcome_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:marqueeRepeatLimit="1"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="7dp"
        app:layout_constraintEnd_toStartOf="@+id/mm_odds"
        app:layout_constraintStart_toEndOf="@+id/mm_sport_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14dp"
        android:textColor="@color/text_type2_primary"
        android:ellipsize="marquee"
        android:id="@+id/team_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:marqueeRepeatLimit="1"
        app:layout_constraintEnd_toStartOf="@+id/mm_odds"
        app:layout_constraintStart_toStartOf="@+id/mm_sport_icon"
        app:layout_constraintTop_toBottomOf="@+id/outcome_desc"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12dp"
        android:textColor="@color/text_type1_secondary"
        android:id="@+id/mm_event_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="@+id/team_name"
        app:layout_constraintTop_toBottomOf="@+id/team_name"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/text_type2_primary"
        android:gravity="end"
        android:id="@+id/mm_odds"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/odds_change_img"
        app:layout_constraintStart_toEndOf="@+id/team_name"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/odds_change_img"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/mm_odds"
        app:layout_constraintEnd_toStartOf="@+id/mm_lock_event_img"
        app:layout_constraintTop_toTopOf="@+id/mm_odds"
        app:srcCompat="@drawable/spr_ic_up"
        app:tint="@color/brand_secondary_variable_type3"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12dp"
        android:textColor="@color/background_type2_secondary"
        android:id="@+id/mm_event_state"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/mm_odds_disable"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/odds_change_img"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/mm_lock_event_img"
        android:paddingLeft="4dp"
        android:paddingRight="12dp"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/spr_ic_unlocked"/>
    <View
        android:id="@+id/multi_maker_divide_line"
        android:background="@color/background_type2_tertiary"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mm_event_date"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/multi_maker_breathe"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/mm_green_breathe"/>
</androidx.constraintlayout.widget.ConstraintLayout>
