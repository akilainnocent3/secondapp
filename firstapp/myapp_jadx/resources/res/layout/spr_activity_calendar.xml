<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/cancel_btn"
        android:background="?android:attr/selectableItemBackground"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"
        app:srcCompat="@drawable/cmn_ic_close_gray"
        app:tint="@color/text_type1_secondary"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@+id/cancel_btn">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_type1_primary"
            android:gravity="start"
            android:id="@+id/tv_range_start_date"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="36dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_type1_primary"
            android:gravity="center"
            android:id="@+id/tv_range_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/common_functions__select_date_range"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_type1_primary"
            android:gravity="end"
            android:id="@+id/tv_range_end_date"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="36dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif"/>
    </LinearLayout>
    <com.sportybet.plugin.realsports.betorder.calendar.view.CalendarView
        android:id="@+id/calendar_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="48dp"
        android:layout_above="@+id/update_btn"
        android:layout_below="@+id/cancel_btn"
        app:selectionType="range"
        style="@style/CustomCalendarView"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="normal"
        android:textColor="@color/brand_tertiary"
        android:gravity="center"
        android:id="@+id/update_btn"
        android:background="@color/brand_secondary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/calendar_button_height"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:text="@string/common_functions__update"
        android:layout_above="@+id/back_to_all_dates"
        android:layout_marginHorizontal="16dp"
        style="@style/B2_M"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="normal"
        android:textColor="@color/text_brand_sub_primary_d_base"
        android:gravity="center"
        android:id="@+id/back_to_all_dates"
        android:background="@drawable/btn_border_rounded_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/calendar_button_height"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        android:text="@string/bet_history__back_to_all_dates"
        android:layout_above="@+id/go_to_older"
        android:layout_marginHorizontal="16dp"
        style="@style/B2_M"/>
    <RelativeLayout
        android:id="@+id/go_to_older"
        android:padding="@dimen/calendar_go_to_older_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_alignParentBottom="true">
        <TextView
            android:textStyle="normal"
            android:textColor="@color/text_brand_sub_primary_d_base"
            android:gravity="center_horizontal"
            android:id="@+id/go_to_older_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bet_history__view_tickets_from_6_months_ago"
            android:layout_centerHorizontal="true"
            android:fontFamily="sans-serif"
            style="@style/B2_M"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-2dp"
            android:tint="@color/text_brand_sub_primary_d_base"
            android:layout_toRightOf="@+id/go_to_older_text"
            app:srcCompat="@drawable/spr_ic_keyboard_arrow_right_black_24dp"/>
    </RelativeLayout>
</RelativeLayout>
