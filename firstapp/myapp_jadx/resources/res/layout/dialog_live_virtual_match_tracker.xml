<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/constraintlayout_match_tracker_dialog_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="14dp"
    android:layout_marginRight="14dp"
    android:layout_marginHorizontal="14dp">
    <View
        android:id="@+id/view_match_tracker_dialog_top_bar"
        android:background="@color/background_dialog_title"
        android:layout_width="0dp"
        android:layout_height="36dp"
        app:layout_constraintBottom_toTopOf="@+id/webview_match_tracker_dialog"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ImageButton
        android:id="@+id/imagebutton_match_tracker_dialog_close"
        android:background="@null"
        android:layout_width="36dp"
        android:layout_height="36dp"
        app:layout_constraintBottom_toBottomOf="@+id/view_match_tracker_dialog_top_bar"
        app:layout_constraintEnd_toEndOf="@+id/view_match_tracker_dialog_top_bar"
        app:layout_constraintTop_toTopOf="@+id/view_match_tracker_dialog_top_bar"
        app:srcCompat="@drawable/spr_ic_close_white_16dp"
        app:tint="@color/brand_tertiary"/>
    <TextView
        android:textAppearance="@style/B1_M"
        android:textColor="@color/brand_tertiary"
        android:id="@+id/textview_match_tracker_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/common_functions__match_tracker"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/view_match_tracker_dialog_top_bar"
        app:layout_constraintStart_toStartOf="@+id/view_match_tracker_dialog_top_bar"
        app:layout_constraintTop_toTopOf="@+id/view_match_tracker_dialog_top_bar"/>
    <WebView
        android:id="@+id/webview_match_tracker_dialog"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_match_tracker_dialog_top_bar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
