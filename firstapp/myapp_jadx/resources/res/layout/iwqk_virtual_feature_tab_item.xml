<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="14dp"
        android:textStyle="normal"
        android:textColor="@color/text_type1_primary"
        android:layout_gravity="center"
        android:id="@+id/feature_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/new_feature_flag"
        android:visibility="gone"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:src="@drawable/shape_red_circle_item_18_bg"
        app:layout_constraintBottom_toBottomOf="@+id/feature_title"
        app:layout_constraintHorizontal_bias="0.65"
        app:layout_constraintStart_toEndOf="@+id/feature_title"
        app:layout_constraintTop_toTopOf="@+id/feature_title"
        app:layout_constraintVertical_bias="0.3"
        app:tint="@color/brand_primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
