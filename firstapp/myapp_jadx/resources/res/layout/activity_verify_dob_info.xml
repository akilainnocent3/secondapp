<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/title_bar"
            android:background="#e41827"
            android:layout_width="match_parent"
            android:layout_height="44dp">
            <ImageButton
                android:layout_gravity="center_vertical"
                android:id="@+id/back_btn"
                android:background="?android:attr/selectableItemBackground"
                android:padding="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_action_bar_back"
                app:tint="@color/absolute_type1"/>
            <TextView
                android:textSize="20dp"
                android:textStyle="normal"
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/back_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/component_bvn__verify_dob_info"
                android:singleLine="true"
                android:layout_toRightOf="@+id/back_btn"
                android:layout_centerVertical="true"
                android:lineSpacingExtra="8sp"
                android:fontFamily="sans-serif-medium"/>
            <ImageButton
                android:id="@+id/home"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="16dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                app:srcCompat="@drawable/ic_home"
                app:tint="@android:color/white"/>
        </RelativeLayout>
        <TextView
            android:textSize="14dp"
            android:textColor="#353a45"
            android:id="@+id/avdi_tv_info1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="26dp"
            android:layout_marginTop="25dp"
            android:layout_marginRight="20dp"
            android:text="@string/component_bvn__dob_info_content"
            android:layout_below="@+id/title_bar"
            android:lineSpacingMultiplier="1.4"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#353a45"
            android:id="@+id/avdi_tv_info2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginRight="20dp"
            android:text="2"
            android:layout_below="@+id/avdi_tv_info1"
            android:lineSpacingMultiplier="1.4"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#353a45"
            android:id="@+id/avdi_tv_info3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="26dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="25dp"
            android:text="3"
            android:layout_below="@+id/avdi_tv_info2"
            android:lineSpacingMultiplier="1.4"/>
    </RelativeLayout>
</ScrollView>
