<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/transaction_successful_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="20dp"
        android:textStyle="normal"
        android:textColor="#ffffff"
        android:gravity="center_vertical"
        android:id="@+id/title_bar"
        android:background="#e41827"
        android:paddingLeft="24dp"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/common_functions__details"
        android:singleLine="true"
        android:lineSpacingExtra="8sp"
        android:fontFamily="sans-serif-medium"/>
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="42dp"
        android:src="@drawable/ic_done"
        android:scaleType="fitXY"
        android:layout_below="@+id/title_bar"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textAppearance="@style/H1_B"
        android:textColor="@color/text_type1_primary"
        android:gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="@string/page_withdraw__withdrawal_succeeded"
        android:layout_below="@+id/imageView"/>
    <TextView
        android:textAppearance="@style/H4_M"
        android:textColor="@color/brand_quaternary"
        android:gravity="center_horizontal"
        android:id="@+id/submission_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="23dp"
        android:text="@string/page_withdraw__manual_process_result"
        android:layout_below="@+id/title"/>
    <View
        android:id="@+id/diver_line"
        android:background="@color/line_type1_primary"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="18dp"
        android:layout_marginRight="40dp"
        android:layout_below="@+id/submission_tip"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"/>
    <TextView
        android:textAppearance="@style/B1_R"
        android:textColor="@color/text_type1_primary"
        android:gravity="start"
        android:id="@+id/amount_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="45dp"
        android:layout_marginTop="21dp"
        android:text="@string/common_functions__amount"
        android:layout_below="@+id/diver_line"
        android:layout_alignParentLeft="true"
        android:layout_marginStart="45dp"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textAppearance="@style/B1_B"
        android:textColor="@color/text_type1_primary"
        android:gravity="end"
        android:id="@+id/amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="44dp"
        android:layout_below="@+id/diver_line"
        android:layout_alignTop="@+id/amount_info"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="44dp"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textAppearance="@style/B1_R"
        android:textColor="@color/text_type1_primary"
        android:gravity="start"
        android:id="@+id/fees"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="45dp"
        android:layout_marginTop="11dp"
        android:text="@string/common_functions__additional_fee"
        android:layout_below="@+id/amount_info"
        android:layout_alignParentLeft="true"
        android:layout_marginStart="45dp"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textAppearance="@style/B1_B"
        android:textColor="@color/text_type1_primary"
        android:gravity="end"
        android:id="@+id/fees_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="44dp"
        android:text="@string/common_payment_providers__fees_amount"
        android:layout_alignTop="@+id/fees"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="44dp"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textAppearance="@style/B1_R"
        android:textColor="@color/text_type1_primary"
        android:gravity="start"
        android:id="@+id/deposit_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="45dp"
        android:layout_marginTop="11dp"
        android:text="@string/page_payment__deposit_from"
        android:layout_below="@+id/fees"
        android:layout_alignParentLeft="true"
        android:layout_marginStart="45dp"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textAppearance="@style/B1_B"
        android:textColor="@color/text_type1_primary"
        android:gravity="end"
        android:id="@+id/deposit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="44dp"
        android:layout_alignTop="@+id/deposit_info"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="44dp"
        android:layout_alignParentEnd="true"/>
    <ImageView
        android:id="@+id/momo_telecom_icon"
        android:visibility="gone"
        android:layout_width="45dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="4dp"
        android:layout_toLeftOf="@+id/deposit"
        android:layout_alignTop="@+id/deposit"
        android:layout_alignBottom="@+id/deposit"/>
    <TextView
        android:textAppearance="@style/B1_R"
        android:textColor="@color/text_type1_primary"
        android:gravity="start"
        android:id="@+id/transaction_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="45dp"
        android:layout_marginTop="11dp"
        android:text="@string/page_transaction__trade_no"
        android:layout_below="@+id/deposit_info"
        android:layout_alignParentLeft="true"
        android:layout_marginStart="45dp"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textAppearance="@style/B1_B"
        android:textColor="@color/text_type1_primary"
        android:gravity="end"
        android:id="@+id/transaction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="44dp"
        android:layout_alignTop="@+id/transaction_info"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="44dp"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textAppearance="@style/H4_R"
        android:textStyle="normal"
        android:textColor="@color/brand_quaternary"
        android:gravity="center_horizontal"
        android:id="@+id/check_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/page_payment__check_status_in_transaction_with_arrow"
        android:layout_below="@+id/transaction_info"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"/>
    <com.sporty.android.common_ui.widgets.CommonButton
        android:id="@+id/done_btn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="32dp"
        android:layout_marginRight="30dp"
        android:text="@string/common_functions__done"
        android:layout_below="@+id/check_status"
        style="@style/Widget.App.CommonButton.Contained.Large"/>
</RelativeLayout>
