<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/background_type2_primary"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="15dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <TextView
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="@color/text_type2_tertiary"
        android:id="@+id/r_jackpot_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="@color/text_type2_tertiary"
        android:gravity="end"
        android:id="@+id/r_jackpot_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_alignParentRight="true"
        android:fontFamily="sans-serif"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="normal"
        android:textColor="@color/text_type2_primary"
        android:id="@+id/r_jackpot_order_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_below="@+id/r_jackpot_id"
        android:fontFamily="sans-serif"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="normal"
        android:textColor="@color/brand_secondary_variable_type3"
        android:gravity="end"
        android:id="@+id/r_jackpot_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:drawablePadding="3dp"
        android:layout_below="@+id/r_jackpot_date"
        android:layout_alignParentRight="true"
        android:fontFamily="sans-serif"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="normal"
        android:textColor="@color/text_type2_tertiary"
        android:id="@+id/r_jackpot_return_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/bet_history__total_return"
        android:layout_below="@+id/r_jackpot_order_type"
        android:fontFamily="sans-serif"/>
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/brand_secondary_variable_type3"
        android:gravity="end"
        android:id="@+id/r_jackpot_return_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/bet_history__total_return"
        android:layout_below="@+id/r_jackpot_status"
        android:layout_alignParentRight="true"
        android:fontFamily="sans-serif"
        android:layout_alignParentEnd="true"/>
    <View
        android:id="@+id/r_jackpot_divider_line"
        android:background="@color/line_type1_tertiary"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="10dp"
        android:layout_below="@+id/r_jackpot_return_value"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="normal"
        android:textColor="@color/text_type2_tertiary"
        android:id="@+id/r_jackpot_stake_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bet_history__total_stake"
        android:layout_below="@+id/r_jackpot_divider_line"
        android:lineSpacingExtra="8sp"
        android:fontFamily="sans-serif"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="normal"
        android:textColor="@color/text_type2_primary"
        android:gravity="end"
        android:id="@+id/r_jackpot_stake_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/r_jackpot_divider_line"
        android:layout_alignParentRight="true"
        android:lineSpacingExtra="8sp"
        android:fontFamily="sans-serif"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="normal"
        android:textColor="@color/text_type2_tertiary"
        android:id="@+id/r_jackpot_gift_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/common_functions__cash_gift"
        android:layout_below="@+id/r_jackpot_stake_label"
        android:lineSpacingExtra="8sp"
        android:fontFamily="sans-serif"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="normal"
        android:textColor="@color/text_type2_primary"
        android:gravity="end"
        android:id="@+id/r_jackpot_gift_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/r_jackpot_stake_value"
        android:layout_alignParentRight="true"
        android:lineSpacingExtra="8sp"
        android:fontFamily="sans-serif"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="normal"
        android:textColor="@color/text_type2_tertiary"
        android:id="@+id/r_jackpot_wh_tax_label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bet_history__wh_tax"
        android:layout_below="@+id/r_jackpot_gift_label"
        android:lineSpacingExtra="8sp"
        android:fontFamily="sans-serif"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="normal"
        android:textColor="@color/text_type2_primary"
        android:gravity="end"
        android:id="@+id/r_jackpot_wh_tax_value"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/r_jackpot_gift_value"
        android:layout_alignParentRight="true"
        android:lineSpacingExtra="8sp"
        android:fontFamily="sans-serif"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
