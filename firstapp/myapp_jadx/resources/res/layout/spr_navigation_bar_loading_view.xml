<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/entry_container"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="23dp"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp">
            <TextView
                android:textSize="10dp"
                android:textColor="@color/text_type1_primary"
                android:gravity="center"
                android:tag="@string/app_common__tag_today_football"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="19dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/pc_home__todays_football"
                android:drawablePadding="-8dp"
                android:layout_weight="1"
                app:drawableTint="@color/text_type1_primary"
                app:drawableTopCompat="@drawable/spr_banner_today"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/text_type1_primary"
                android:gravity="center"
                android:tag="@string/app_common__tag_all_sports"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="19dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/pc_home__all_sports"
                android:drawablePadding="-8dp"
                android:layout_weight="1"
                app:drawableTint="@color/text_type1_primary"
                app:drawableTopCompat="@drawable/spr_banner_sports"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/text_type1_primary"
                android:gravity="center"
                android:tag="@string/app_common__tag_live"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="19dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/common_functions__live"
                android:drawablePadding="-8dp"
                android:layout_weight="1"
                app:drawableTint="@color/text_type1_primary"
                app:drawableTopCompat="@drawable/spr_banner_live"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/text_type1_primary"
                android:gravity="center"
                android:tag="@string/app_common__tag_home"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="19dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/common_functions__home"
                android:drawablePadding="-8dp"
                android:layout_weight="1"
                app:drawableTint="@color/text_type1_primary"
                app:drawableTopCompat="@drawable/spr_banner_home"/>
        </LinearLayout>
        <com.sporty.android.common_ui.widgets.AspectRatioImageView
            android:id="@+id/banner_ad"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="23dp"
            android:layout_marginRight="23dp"
            android:layout_above="@+id/entry_container"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textColor="@color/text_type2_tertiary"
            android:id="@+id/empty"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="90dp"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="normal"
            android:textColor="@color/text_type2_tertiary"
            android:id="@+id/empty1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/empty"
            android:layout_centerHorizontal="true"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="12dp"
            android:textStyle="normal"
            android:textColor="@color/brand_quaternary"
            android:id="@+id/empty2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_below="@+id/empty1"
            android:layout_centerHorizontal="true"
            android:fontFamily="sans-serif"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/icon_sportbet"
            android:paddingTop="190dp"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            app:srcCompat="@drawable/ic_loading"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/text_disable_type1_primary"
            android:id="@+id/empty_message"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/bet_history__no_tickets_available"
            android:layout_below="@+id/icon_sportbet"
            android:layout_centerHorizontal="true"
            app:srcCompat="@drawable/ic_loading"
            style="@style/B1_M"/>
    </RelativeLayout>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"/>
    <com.sportybet.android.widget.ErrorView
        android:layout_gravity="center"
        android:id="@+id/error"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</merge>
