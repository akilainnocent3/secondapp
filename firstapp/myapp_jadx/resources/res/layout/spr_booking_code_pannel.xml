<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/booking_root"
    android:background="@color/background_general_primary"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="20dp"/>
    <HorizontalScrollView
        android:id="@+id/router_container"
        android:background="@color/custom_background_type1_primary_type2"
        android:paddingLeft="10dp"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:paddingRight="8dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingEnd="8dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="48dp">
                <androidx.constraintlayout.widget.Group
                    android:id="@+id/group_code_hub"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="ic_code_hub,tv_code_hub,code_hub_divider"/>
                <androidx.constraintlayout.widget.Group
                    android:id="@+id/group_multi_maker"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="ic_multi_maker,tv_multi_maker"/>
                <androidx.constraintlayout.widget.Group
                    android:id="@+id/group_recent_code"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="ic_recent_code, tv_recent_code, recent_code_divider"/>
                <androidx.constraintlayout.widget.Group
                    android:id="@+id/group_swipe_bet"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="ic_swipe_bet, tv_swipe_bet"/>
                <ImageView
                    android:id="@+id/ic_code_hub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="11dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_code_hub"
                    app:tint="@color/text_type1_primary"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/tv_code_hub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:text="@string/page_code_hub__code_hub_header_title"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/ic_code_hub"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:id="@+id/code_hub_divider"
                    android:background="@color/line_type1_secondary"
                    android:layout_width="1dp"
                    android:layout_height="20dp"
                    android:layout_marginLeft="6dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/tv_code_hub"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/ic_recent_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/code_hub_divider"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_recent_code"
                    app:tint="@color/text_type1_primary"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/tv_recent_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:text="@string/page_load_code__recent_codes"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/ic_recent_code"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:id="@+id/recent_code_divider"
                    android:background="@color/line_type1_secondary"
                    android:layout_width="1dp"
                    android:layout_height="20dp"
                    android:layout_marginLeft="6dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/tv_recent_code"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/ic_multi_maker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/recent_code_divider"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_multi_maker"
                    app:tint="@color/text_type1_primary"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/tv_multi_maker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:text="@string/multi_maker__title"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/ic_multi_maker"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:id="@+id/multi_maker_divider"
                    android:background="@color/line_type1_secondary"
                    android:layout_width="1dp"
                    android:layout_height="20dp"
                    android:layout_marginLeft="6dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/tv_multi_maker"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/ic_swipe_bet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/multi_maker_divider"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/swipebet"
                    app:tint="@color/text_type1_primary"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/text_type1_primary"
                    android:id="@+id/tv_swipe_bet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:text="@string/wap_home__swipebet"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/ic_swipe_bet"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>
    </HorizontalScrollView>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/recommended_code_header_compose_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/router_container"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/recommended_code_view_pager"
        android:background="@color/background_general_primary"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recommended_code_header_compose_view"/>
    <View
        android:id="@+id/recommended_code_view_pager_bottom_merging"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        app:layout_constraintTop_toBottomOf="@+id/recommended_code_view_pager"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/recommended_code_view_pager_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="recommended_code_view_pager, recommended_code_view_pager_bottom_merging"/>
    <View
        android:id="@+id/divider_recommended_header"
        android:background="@color/line_type1_primary"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recommended_code_view_pager_bottom_merging"/>
    <TextView
        android:textAppearance="@style/H4_B"
        android:textColor="@color/text_type1_primary"
        android:id="@+id/booking_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/component_betslip__please_insert_booking_code"
        app:layout_constraintLeft_toLeftOf="@+id/guideline_left"
        app:layout_constraintTop_toBottomOf="@+id/divider_recommended_header"/>
    <ImageView
        android:id="@+id/booking_title_info"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginLeft="9dp"
        android:layout_marginTop="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/booking_title"
        app:layout_constraintLeft_toRightOf="@+id/booking_title"
        app:layout_constraintTop_toTopOf="@+id/booking_title"
        app:srcCompat="@drawable/ic_info_vector"
        app:tint="@color/text_type1_primary"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/booking_container"
        android:background="@drawable/bg_booking_code_panel_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="20dp"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintTop_toBottomOf="@+id/booking_title">
        <com.sportybet.plugin.realsports.widget.ClearEditText
            android:textColor="@color/text_type1_primary"
            android:textColorHint="@color/text_disable_type1_primary"
            android:ellipsize="end"
            android:id="@+id/booking_edit_text"
            android:background="@android:color/transparent"
            android:paddingLeft="12dp"
            android:paddingRight="7dp"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:hint="@string/common_functions__booking_code"
            android:singleLine="true"
            android:drawablePadding="7dp"
            android:imeOptions="actionDone"
            android:paddingStart="12dp"
            android:paddingEnd="7dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/booking_loading_btn"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/B1_M"/>
        <com.sportybet.android.widget.ProgressButton
            android:id="@+id/booking_loading_btn"
            android:background="@drawable/bg_progress_button_no_radius"
            android:layout_width="80dp"
            android:layout_height="44dp"
            android:layout_marginTop="1dp"
            android:layout_marginRight="1dp"
            android:layout_marginBottom="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="10dp"
        android:textStyle="normal"
        android:textColor="@color/warning_primary"
        android:gravity="start|center_vertical"
        android:id="@+id/booking_error_text"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:minHeight="20dp"
        android:text="@string/page_load_code__load_bundle_error"
        android:maxLines="2"
        android:layout_below="@+id/booking_container"
        android:layout_alignLeft="@+id/booking_container"
        android:layout_alignRight="@+id/booking_container"
        android:lineSpacingExtra="0dp"
        android:fontFamily="sans-serif"
        android:layout_alignStart="@+id/booking_container"
        android:layout_alignEnd="@+id/booking_container"
        android:paddingHorizontal="5dp"
        app:layout_constraintLeft_toLeftOf="@+id/booking_container"
        app:layout_constraintTop_toBottomOf="@+id/booking_container"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/swipe_bet_container"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toBottomOf="@+id/booking_error_text"
        app:layout_goneMarginTop="16dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:background="#979797"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
            <TextView
                android:textSize="18dp"
                android:textColor="#9ca0ab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="36dp"
                android:layout_marginRight="36dp"
                android:text="@string/common_functions__l_or"
                android:layout_marginHorizontal="36dp"/>
            <View
                android:background="#979797"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/btn_swipe_bet"
            android:background="@drawable/bg_boarder_brand_quaternary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:layout_marginVertical="12dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginRight="4dp"
                android:src="@drawable/swipebet"
                app:tint="@color/brand_quaternary"/>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/brand_quaternary"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wap_home__swipebet"
                android:textAllCaps="false"/>
        </LinearLayout>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/multi_maker_container"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toBottomOf="@+id/swipe_bet_container"
        app:layout_goneMarginTop="16dp">
        <View
            android:background="#979797"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginEnd="38dp"
            app:layout_constraintBottom_toBottomOf="@+id/text_or"
            app:layout_constraintEnd_toStartOf="@+id/text_or"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="18dp"
            android:textColor="#9ca0ab"
            android:id="@+id/text_or"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common_functions__l_or"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:background="#979797"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="38dp"
            app:layout_constraintBottom_toBottomOf="@+id/text_or"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/text_or"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/multi_maker_btn"
            android:background="@drawable/bg_boarder_brand_quaternary"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_or"/>
        <ImageView
            android:id="@+id/ic_mm"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_quick_list"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/multi_maker_btn"
            app:layout_constraintEnd_toStartOf="@+id/tv_mm"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/multi_maker_btn"
            app:tint="@color/brand_quaternary"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/brand_quaternary"
            android:gravity="center"
            android:id="@+id/tv_mm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/multi_maker__title"
            android:textAllCaps="false"
            app:layout_constraintBottom_toBottomOf="@+id/multi_maker_btn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ic_mm"
            app:layout_constraintTop_toTopOf="@+id/multi_maker_btn"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/code_hub_container"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toBottomOf="@+id/multi_maker_container"
        app:layout_goneMarginTop="16dp">
        <View
            android:background="#979797"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginEnd="38dp"
            app:layout_constraintBottom_toBottomOf="@+id/text_or_code_hub"
            app:layout_constraintEnd_toStartOf="@+id/text_or_code_hub"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="18dp"
            android:textColor="#9ca0ab"
            android:id="@+id/text_or_code_hub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common_functions__l_or"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:background="#979797"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="38dp"
            app:layout_constraintBottom_toBottomOf="@+id/text_or_code_hub"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/text_or_code_hub"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/code_hub_btn"
            android:background="@drawable/bg_boarder_brand_quaternary"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_or_code_hub"/>
        <ImageView
            android:id="@+id/ic_code_hub_button"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_code_hub"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/code_hub_btn"
            app:layout_constraintEnd_toStartOf="@+id/tv_code_hub_button"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/code_hub_btn"
            app:tint="@color/brand_quaternary"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/brand_quaternary"
            android:gravity="center"
            android:id="@+id/tv_code_hub_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/page_code_hub__code_hub_header_title"
            android:textAllCaps="false"
            app:layout_constraintBottom_toBottomOf="@+id/code_hub_btn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ic_code_hub_button"
            app:layout_constraintTop_toTopOf="@+id/code_hub_btn"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/recent_container"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toBottomOf="@+id/code_hub_container"
        app:layout_goneMarginTop="16dp">
        <View
            android:background="#979797"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginEnd="38dp"
            app:layout_constraintBottom_toBottomOf="@+id/text_or_recent"
            app:layout_constraintEnd_toStartOf="@+id/text_or_recent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="18dp"
            android:textColor="#9ca0ab"
            android:id="@+id/text_or_recent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common_functions__l_or"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:background="#979797"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="38dp"
            app:layout_constraintBottom_toBottomOf="@+id/text_or_recent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/text_or_recent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/recent_btn"
            android:background="@drawable/bg_boarder_brand_quaternary"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_or_recent"/>
        <ImageView
            android:id="@+id/ic_recent_button"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_recent_code"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/recent_btn"
            app:layout_constraintEnd_toStartOf="@+id/tv_recent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/recent_btn"
            app:tint="@color/brand_quaternary"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/brand_quaternary"
            android:gravity="center"
            android:id="@+id/tv_recent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/page_load_code__recent_codes"
            android:textAllCaps="false"
            app:layout_constraintBottom_toBottomOf="@+id/ic_recent_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ic_recent_button"
            app:layout_constraintTop_toTopOf="@+id/ic_recent_button"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/book_bottom"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/recent_container">
        <TextView
            android:textSize="12dp"
            android:textStyle="normal"
            android:textColor="#9ea0ad"
            android:gravity="center_horizontal"
            android:id="@+id/load_tip_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/component_betslip__to_place_a_bet_click_on_the_odds_tip"
            android:fontFamily="sans-serif"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/entry_container"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="40dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="20dp"
            android:layout_below="@+id/load_tip_text"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp">
            <TextView
                android:textSize="10dp"
                android:textColor="@android:color/black"
                android:gravity="center"
                android:tag="@string/app_common__tag_today_football"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="19dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/pc_home__todays_football"
                android:drawablePadding="-8dp"
                android:layout_weight="1"
                app:drawableTopCompat="@drawable/spr_banner_today"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@android:color/black"
                android:gravity="center"
                android:tag="@string/app_common__tag_sports_menu"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="19dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/wap_home__sports"
                android:drawablePadding="-8dp"
                android:layout_weight="1"
                app:drawableTopCompat="@drawable/spr_banner_sports"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@android:color/black"
                android:gravity="center"
                android:tag="@string/app_common__tag_live"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="19dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/common_functions__live"
                android:drawablePadding="-8dp"
                android:layout_weight="1"
                app:drawableTopCompat="@drawable/spr_banner_live"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@android:color/black"
                android:gravity="center"
                android:tag="@string/app_common__tag_home"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="19dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/common_functions__home"
                android:drawablePadding="-8dp"
                android:layout_weight="1"
                app:drawableTopCompat="@drawable/spr_banner_home"/>
        </LinearLayout>
    </RelativeLayout>
    <View
        android:id="@+id/keyboard_spacer"
        android:background="@color/transparent"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        app:layout_constraintTop_toBottomOf="@+id/book_bottom"/>
    <com.sporty.android.common_ui.widgets.LoadingViewNew
        android:id="@+id/book_panel_loading_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
