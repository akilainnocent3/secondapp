<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.sportybet.android.widget.seekbar.RangeSeekBar
        android:id="@+id/total_range_slider"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/multi_maker_selection_odds"
        app:rsb_gravity="bottom"
        app:rsb_mode="single"
        app:rsb_progress_color="@color/brand_secondary_variable_type3"
        app:rsb_progress_height="4dp"
        app:rsb_progress_radius="2dp"
        app:rsb_step_auto_bonding="true"
        app:rsb_step_color="@color/transparent_white"
        app:rsb_step_height="1dp"
        app:rsb_step_width="1dp"
        app:rsb_thumb_drawable="@drawable/thumb_brand_secondary_variable_type3_with_alpha"
        app:rsb_thumb_height="16dp"
        app:rsb_thumb_inactivated_drawable="@drawable/thumb_brand_secondary_variable_type3"
        app:rsb_thumb_width="16dp"/>
    <com.sportybet.android.widget.seekbar.RangeSeekBar
        android:id="@+id/total_range_slider_fake"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/multi_maker_selection_odds"
        app:rsb_gravity="bottom"
        app:rsb_mode="single"
        app:rsb_progress_color="@color/sporty_black_pressed"
        app:rsb_progress_default_color="@color/sporty_black_pressed"
        app:rsb_progress_height="4dp"
        app:rsb_progress_radius="2dp"
        app:rsb_step_auto_bonding="true"
        app:rsb_step_color="@color/transparent_white"
        app:rsb_step_height="1dp"
        app:rsb_step_width="1dp"
        app:rsb_thumb_drawable="@drawable/thumb_deactivate"
        app:rsb_thumb_height="16dp"
        app:rsb_thumb_inactivated_drawable="@drawable/thumb_deactivate"
        app:rsb_thumb_width="16dp"/>
</merge>
