<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/top_layout"
        android:background="@color/custom_background_type2_secondary_type1"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="14sp"
            android:textStyle="normal"
            android:textColor="@color/text_type2_primary"
            android:gravity="center"
            android:id="@+id/choose_cancel"
            android:background="?android:attr/selectableItemBackground"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/common_functions__cancel"
            android:lineSpacingExtra="0sp"
            android:textAllCaps="false"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="normal"
            android:textColor="@color/text_type2_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/component_wap_share_bet__choose_a_bet"
            android:layout_centerInParent="true"
            android:lineSpacingExtra="0sp"
            android:fontFamily="sans-serif"/>
    </RelativeLayout>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/txt_select_hint"
        app:layout_constraintTop_toBottomOf="@+id/top_layout">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/text_type1_secondary"
        android:id="@+id/txt_select_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/component_wap_share_bet__share_btn_desc"
        app:layout_constraintBottom_toTopOf="@+id/btn_share_bet"
        app:layout_constraintStart_toStartOf="@+id/btn_share_bet"/>
    <com.sportybet.android.widget.ProgressButton
        android:enabled="false"
        android:id="@+id/btn_share_bet"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="16dp"
        android:text="@string/component_wap_share_bet__share_btn"
        android:textAllCaps="false"
        android:layout_marginHorizontal="12dp"
        app:isLoading="false"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <com.sportybet.android.widget.LoadingView
        android:id="@+id/loading_view"
        android:background="@color/background_type1_secondary"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.sportybet.plugin.realsports.widget.ProgressLoadingView
        android:id="@+id/pg_loading"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
