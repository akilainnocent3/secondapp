<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:background="@drawable/iwqk_spinner_bg"
    android:paddingLeft="2dp"
    android:paddingRight="2dp"
    android:layout_width="match_parent"
    android:layout_height="34dp"
    android:paddingHorizontal="2dp">
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/brand_secondary_variable_type2"
        android:gravity="center"
        android:id="@+id/spinner_text"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        app:autoSizeMaxTextSize="14dp"
        app:autoSizeMinTextSize="9dp"
        app:autoSizeStepGranularity="1dp"
        app:autoSizeTextType="uniform"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/spinner_arrow"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:src="@drawable/spr_ic_chevron_down"
        android:scaleType="fitCenter"
        app:tint="@color/brand_secondary_variable_type2"/>
</LinearLayout>
