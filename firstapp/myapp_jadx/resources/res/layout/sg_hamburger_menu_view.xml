<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parentConstraintMenu"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_area"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_100sdp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/_16ssp"
            android:textColor="@color/white"
            android:id="@+id/game_title"
            android:tag="@string/game_name_cms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginStart="@dimen/_16sdp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TextPrimaryMedium"/>
        <ImageView
            android:textColor="@color/white"
            android:id="@+id/game_title_image"
            android:tag="@string/game_name_cms"
            android:visibility="gone"
            android:layout_width="@dimen/_100sdp"
            android:layout_height="@dimen/_40sdp"
            android:scaleType="fitCenter"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/vip_crown_small"
            android:visibility="gone"
            android:layout_width="@dimen/_14sdp"
            android:layout_height="@dimen/_10sdp"
            android:layout_marginBottom="-2dp"
            android:src="@drawable/vip_crown_small"
            app:layout_constraintBottom_toTopOf="@+id/account_icon"
            app:layout_constraintEnd_toEndOf="@+id/account_icon"
            app:layout_constraintStart_toStartOf="@+id/account_icon"/>
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/account_icon"
            android:padding="1dp"
            android:layout_width="@dimen/_27sdp"
            android:layout_height="@dimen/_27sdp"
            android:layout_marginBottom="@dimen/_20sdp"
            android:src="0x7f0807c6"
            android:scaleType="fitXY"
            android:layout_marginStart="@dimen/_16sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:shapeAppearanceOverlay="@style/profileImage"/>
        <TextView
            android:textSize="@dimen/_6sdp"
            android:textColor="@color/color_EBAE25"
            android:id="@+id/vip_tag"
            android:background="@drawable/ham_vip_bg"
            android:paddingLeft="@dimen/_2sdp"
            android:paddingTop="1dp"
            android:paddingRight="@dimen/_2sdp"
            android:paddingBottom="1dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-6dp"
            android:text="VIP"
            android:paddingHorizontal="@dimen/_2sdp"
            android:paddingVertical="1dp"
            app:layout_constraintEnd_toEndOf="@+id/account_icon"
            app:layout_constraintStart_toStartOf="@+id/account_icon"
            app:layout_constraintTop_toBottomOf="@+id/account_icon"
            style="@style/TextPrimaryBlack"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_9sdp"
            app:layout_constraintBottom_toBottomOf="@+id/account_icon"
            app:layout_constraintStart_toEndOf="@+id/account_icon"
            app:layout_constraintTop_toTopOf="@+id/account_icon">
            <TextView
                android:textSize="@dimen/_14ssp"
                android:textColor="@color/white"
                android:id="@+id/user_name"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextPrimaryMedium"/>
            <TextView
                android:textSize="@dimen/_11ssp"
                android:textColor="@color/color_F0C461"
                android:id="@+id/vip_benefit"
                android:tag="@string/vip_benefits_cms"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/user_name"
                style="@style/TextPrimaryMedium"/>
            <ImageView
                android:id="@+id/vip_arrow"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:src="@drawable/vip_arrow"
                android:layout_marginStart="@dimen/_7sdp"
                app:layout_constraintBottom_toBottomOf="@+id/vip_benefit"
                app:layout_constraintStart_toEndOf="@+id/vip_benefit"
                app:layout_constraintTop_toTopOf="@+id/vip_benefit"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/menu_list"
        android:paddingLeft="@dimen/_10sdp"
        android:paddingRight="@dimen/_10sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:layout_marginEnd="@dimen/_5sdp"
        android:paddingHorizontal="@dimen/_10sdp"
        app:layout_constrainedHeight="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_area"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="bottom|center_horizontal"
        android:id="@+id/bottom_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_45sdp"
        android:translationZ="999dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <TextView
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/add_money_button"
            android:tag="@string/addmoney_text_cms"
            android:background="@drawable/hamberger_add_more_bg"
            android:padding="@dimen/_8sdp"
            android:layout_width="@dimen/_110sdp"
            android:layout_height="wrap_content"
            android:text="Add Money"
            android:translationZ="999dp"
            android:autoSizeTextType="uniform"
            android:autoSizeStepGranularity="@dimen/_1ssp"
            android:autoSizeMinTextSize="@dimen/_10ssp"
            android:autoSizeMaxTextSize="@dimen/_13ssp"
            style="@style/TextPrimaryBold"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="bottom|center_horizontal"
        android:id="@+id/bottom_rtp_info"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="2"
        android:translationZ="999dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottom_area">
        <TextView
            android:textSize="@dimen/_9sdp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_rng_value"
            android:tag="@string/rng_version"
            android:background="@drawable/hamberger_rtp_info_bg"
            android:paddingTop="@dimen/_3sdp"
            android:paddingBottom="@dimen/_3sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/_5sdp"
            android:paddingEnd="@dimen/_5sdp"
            android:translationZ="999dp"
            style="@style/TextPrimaryBold"/>
        <LinearLayout
            android:gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/ll_rtp_main"
            android:background="@drawable/hamberger_rtp_info_bg"
            android:paddingTop="@dimen/_3sdp"
            android:paddingBottom="@dimen/_3sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/_5sdp"
            android:paddingEnd="@dimen/_5sdp"
            android:layout_marginStart="4dp">
            <TextView
                android:textSize="@dimen/_9sdp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_rtp_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rtp_text"
                android:translationZ="999dp"
                style="@style/TextPrimaryBold"/>
            <TextView
                android:textSize="@dimen/_9sdp"
                android:textColor="@color/rtp_value_green"
                android:gravity="center"
                android:id="@+id/tv_rtp_value"
                android:tag="@string/rtp_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp"
                android:translationZ="999dp"
                style="@style/TextPrimaryBold"/>
        </LinearLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <ImageView
        android:id="@+id/menuBottomImage"
        android:tag="ham_bg_image:sg_game_name"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/ivIllustration"
        android:tag="ham_bg_image:sg_game_name"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
