<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/diver_line"
        android:background="@color/line_type1_primary"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginHorizontal="12dp"/>
    <RelativeLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp">
        <TextView
            android:textSize="12dp"
            android:textStyle="normal"
            android:textColor="#9ca0ab"
            android:id="@+id/results_load_more"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bet_history__no_more_tickets"
            android:layout_centerHorizontal="true"
            android:lineSpacingExtra="20dp"
            android:fontFamily="sans-serif"
            android:paddingHorizontal="12dp"/>
        <RelativeLayout
            android:id="@+id/view_older_order"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/results_load_more"
            android:layout_centerHorizontal="true">
            <TextView
                android:textSize="12dp"
                android:textStyle="normal"
                android:textColor="@color/brand_quaternary"
                android:id="@+id/view_older_order_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/bet_history__view_older_tickets"
                android:fontFamily="sans-serif"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:tint="@color/brand_secondary"
                android:layout_toRightOf="@+id/view_older_order_text"
                app:srcCompat="@drawable/spr_ic_keyboard_arrow_right_black_24dp"/>
        </RelativeLayout>
    </RelativeLayout>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/results_loading_progress"
        android:layout_width="30dp"
        android:layout_height="30dp"/>
</FrameLayout>
