<?xml version="1.0" encoding="utf-8"?>
<com.sportygames.sportysoccer.widget.CashOutLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#d3000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:splitMotionEvents="false">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <RelativeLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:splitMotionEvents="false">
            <ImageView
                android:id="@+id/winning_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                android:layout_centerHorizontal="true"/>
            <include
                android:id="@+id/btn_continue"
                android:layout_width="180dp"
                android:layout_height="48dp"
                android:layout_marginTop="0dp"
                android:layout_below="@+id/winning_image"
                android:layout_centerHorizontal="true"
                layout="@layout/sg_ss_layout_button"/>
            <include
                android:id="@+id/btn_cash_out"
                android:layout_width="180dp"
                android:layout_height="48dp"
                android:layout_marginTop="13dp"
                android:layout_below="@+id/btn_continue"
                android:layout_centerHorizontal="true"
                layout="@layout/sg_ss_layout_button"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="#99000000"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="90dp"
                android:layout_above="@+id/btn_continue">
                <TextView
                    android:textSize="15sp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sg_sporty_soccer_challenge_again_to_win"
                    android:fontFamily="@font/roboto_bold"/>
                <TextView
                    android:textSize="44sp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/ss_cash_out_next_win_amount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAllCaps="true"
                    android:fontFamily="@font/roboto_bold"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="34dp"
                    android:textColor="@android:color/white"
                    android:gravity="center_horizontal"
                    android:id="@+id/shot_round"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3rd Shot"
                    android:shadowColor="#80000000"
                    android:shadowDy="2"
                    android:shadowRadius="4"
                    android:fontFamily="@font/roboto_bold"/>
                <TextView
                    android:textSize="54dp"
                    android:textColor="@android:color/white"
                    android:gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sg_sporty_soccer_goal"
                    android:shadowColor="#80000000"
                    android:shadowDy="2"
                    android:shadowRadius="4"
                    android:fontFamily="@font/roboto_bold"/>
            </LinearLayout>
        </RelativeLayout>
    </ScrollView>
</com.sportygames.sportysoccer.widget.CashOutLayout>
